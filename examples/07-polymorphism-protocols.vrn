(protocol display (a)
  (display ((value a)) i32))

(implementation (display i32)
  (function display
    ((value i32))
    i32
    value))

(function print
  (for (a)
    ((display a)))
  ((value a))
  i32
  (display value))

(function answer () i32
  42)

(function main ((argc i32) (argv (pointer (pointer u8)))) exit-code
  (print (answer)))
