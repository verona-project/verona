               (0
                 (match (n:ge bits pointer-tag)
                   (true (do (resolve-pointer c bits 0) unit))
                   (false unit)))
               (_ (require c (valid-callback p signature bits) 0)))))
          ((n:eq bits 0) (fail c 6 0))
          ((n:gt bits length) (fail c 6 0))
          ((n:ge bits parent) (fail c 6 0))
          (true
            (let
              ((header scalar-value (values-at (deref (field c aggregates)) (n:sub bits 1)))
               (count u64 (base:convert (field header scalar)))
               (kind u64 (check:type-kind p ty)))
              (do
                (require c (n:eq (field header ty) ty) 0)
                (match (n:le count (n:sub length bits))
                  (false (fail c 6 0))
                  (true
                    (match kind
                      (49
                        (match (n:eq count (check:array-length p ty))
                          (true (validate-array-items c (check:array-element p ty) bits count bits))
                          (false (fail c 6 0))))
                      (21
                        (match (n:gt count 0)
                          (false (fail c 6 0))
                          (true
                            (let
                              ((tag scalar-value (values-at (deref (field c aggregates)) bits))
                               (case
                                 u64
                                 (check:component-at
                                   p
                                   (check:type-components p ty)
                                   (base:convert (field tag scalar)))))
                              (do
                                (require c (n:eq (field tag ty) 3) 0)
                                (require c (n:gt case 0) 0)
                                (require
                                  c
                                  (n:eq
                                    count
                                    (n:add (check:chain-length p (m:next p (m:child p case))) 1))
                                  0)
                                (match (field (deref (field c status)) code)
                                  (0
                                    (validate-components
                                      c
                                      (m:next p (m:child p case))
                                      (n:add bits 1)
                                      bits))
                                  (_ unit)))))))
                      (_
                        (do
                          (require c (match kind (20 true) (22 true) (_ false)) 0)
                          (require
                            c
                            (n:eq count (check:chain-length p (check:type-components p ty)))
                            0)
                          (match (field (deref (field c status)) code)
                            (0 (validate-components c (check:type-components p ty) bits bits))
                            (_ unit)))))))))))))))

(base:function validate-arguments ((c machine) (args values-array) (start u64) (count u64)) unit
  (match (field (deref (field c status)) code)
    (0
      (match count
        (0 unit)
        (1 (validate-value c (values-at args start) (base:maxBound)))
        (_
          (let ((half u64 (n:div count 2)))
            (do
              (validate-arguments c args start half)
              (validate-arguments c args (n:add start half) (n:sub count half)))))))
    (_ unit)))

(base:function destroy ((owner (pointer outcome))) unit
  (let
    ((v outcome (deref owner))
     (frames frames-array (field v trace))
     (aggregates values-array (field v aggregates)))
    (do
      (frames-destroy (& frames))
      (values-destroy (& aggregates))
      (store
        (deref owner)
        (outcome (field v code) (field v result) (field v site) (field v storage) frames aggregates))
      unit)))

(base:function message ((code u64)) (pointer u8)
  (match code
    (1 "division by zero")
    (2 "signed division overflow")
    (3 "evaluator step limit exceeded")
    (4 "evaluator call depth limit exceeded")
    (5 "evaluator storage allocation failed")
    (7 "array index out of bounds")
    (8 "native calls are unavailable in the evaluator")
    (9 "invalid pointer access")
    (10 "pointer refers to expired storage")
    (11 "cannot write read-only storage")
    (_ "internal error: invalid checked evaluator input")))

(base:function trace-range ((p m:context) (frames frames-array) (start u64) (count u64)) unit
  (match count
    (0 unit)
    (1
      (let ((f frame (frames-at frames start)))
        (do
          (m:text 2 "  in ")
          (m:write 2 (m:spelling p (m:next p (m:child p (field f function)))))
          (m:text 2 " at ")
          (m:location p (field (m:at p (field f site)) start))
          (m:text 2 "\n"))))
    (_
      (let ((half u64 (n:div count 2)))
        (do
          (trace-range p frames (n:add start half) (n:sub count half))
          (trace-range p frames start half))))))

(base:function report ((p m:context) (result outcome)) unit
  (do
    (m:location p (field (m:at p (field result site)) start))
    (m:text 2 (message (field result code)))
    (m:text 2 "\n")
    (trace-range p (field result trace) 0 (frames-length (field result trace)))))

(base:function signed-number ((value i64)) unit
  (let ((bits u64 (base:convert value)))
    (match (signed:lt value 0)
      (true (do (m:text 1 "-") (m:number 1 (n:sub 0 bits))))
      (false (m:number 1 bits)))))

(base:function write-components
  ((p m:context) (items values-array) (start u64) (count u64) (index u64)) unit
  (match (n:eq index count)
    (true unit)
    (false
      (do
        (match index (0 unit) (_ (m:text 1 ",")))
        (write-value p items (values-at items (n:add start index)))
        (write-components p items start count (n:add index 1))))))

(base:function write-float ((v scalar-value)) unit
  (do
    (m:text 1 (num:name (field v ty)))
    (m:text 1 ":")
    (m:number 1 (base:convert (field v scalar)))))

(base:function write-value ((p m:context) (items values-array) (v scalar-value)) unit
  (match (field v ty)
    (1 (m:text 1 "unit"))
    (2 (do (m:text 1 "bool:") (signed-number (field v scalar))))
    (3 (do (m:text 1 "i64:") (signed-number (field v scalar))))
    (11 (write-data p items (base:convert (field v scalar))))
    (12 (write-float v))
    (13 (write-float v))
    (_
      (match (num:integer-type (field v ty))
        (true
          (do
            (m:text 1 (num:name (field v ty)))
            (m:text 1 ":")
            (match (num:signed-type (field v ty))
              (true (signed-number (field v scalar)))
              (false (m:number 1 (base:convert (field v scalar)))))))
        (false
          (match (check:type-kind p (field v ty))
            (34 (m:text 1 "pointer"))
            (_
              (let
                ((handle u64 (base:convert (field v scalar)))
                 (count u64 (base:convert (field (values-at items (n:sub handle 1)) scalar)))
                 (sum bool (n:eq (check:type-kind p (field v ty)) 21))
                 (case
                   u64
                   (match sum
                     (false 0)
                     (true
                       (check:component-at
                         p
                         (check:type-components p (field v ty))
                         (base:convert (field (values-at items handle) scalar))))))
                 (head data:data (format:prefix p (field v ty) case)))
                (do
                  (m:text 1 (data:bytes head))
                  (write-components
                    p
                    items
                    (match sum (false handle) (true (n:add handle 1)))
                    (match sum (false count) (true (n:sub count 1)))
                    0)
                  (m:text 1 ")"))))))))))

(export
  run-with-aggregates
  write-value
  values-at
  scalar-value
  options
  outcome
