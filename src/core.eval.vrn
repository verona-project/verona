; Managed bytes and pointer descriptors share the outcome-owned aggregate tape.
; Addresses are tagged indices, never host pointers. Region flags are live=1,
; writable=2, permanent=4. Function storage is expired on return.
; Region metadata TY normally holds the object type. Read-only literal regions
; instead retain pointer-tag + literal ID, preserving identity across offsets.
(base:constant pointer-tag u64 9223372036854775808)

(base:constant region-tag u64 18446744073709551615)

(base:constant address-tag u64 18446744073709551614)

