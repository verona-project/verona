                (_ unit))
              (evaluate-expression c (m:next p (field v child))))))))))

; Checked source and tape are borrowed and remain reusable after every outcome.
; Zero options disable their respective limits. Depth includes the entry frame.
(base:function run-with-aggregates
  ((p m:context)
   (entry u64)
   (arguments values-array)
   (borrowed values-array)
   (config options)
   (backing allocator:backend)) outcome
  (let
    ((locals values-array (values-new backing))
     (values values-array (values-new backing))
     (frames frames-array (frames-new backing))
     (pending steps-array (steps-new backing))
     (slots ids-array (ids-new backing))
     (sizes ids-array (ids-new backing))
     (aggregates values-array (values-new backing))
     (status state (state 0 0 (error:success) 0))
     (c
       machine
       (machine
         p
         config
         (& status)
         (& locals)
         (& values)
         (& frames)
         (& pending)
         (& slots)
         (& sizes)
         (& aggregates)))
     (count u64 (m:nodes-length (deref (field p items)))))
    (do
      (require c (n:eq (deref (field p errors)) 0) entry)
      (require c (match (n:lt entry count) (true (n:gt entry 0)) (false false)) 0)
      (initialize c count)
      (match (field status code)
        (0
          (do
            (prepare c 0 count)
            (storage c (values-copy-into borrowed (& aggregates)))
            (storage c (values-copy-into arguments (& values)))
            (validate-arguments c arguments 0 (values-length arguments))
            (initialize-globals c 0 count)
            (match (field status code)
              (0
                (do
                  (require c (check:callable-shape p entry) entry)
                  (require c (n:gt (field (m:at p entry) ty) 0) entry)
                  (match (field status code)
                    (0 (do (invoke c entry entry 0) (pump c (base:maxBound))))
                    (_ unit))))
              (_ unit))))
        (_ unit))
      (match (field status code)
        (0
          (do
            (require c (n:eq (values-length values) 1) entry)
            (require c (n:eq (frames-length frames) 0) entry)))
        (_ unit))
      (expire-memory c 0 (values-length aggregates))
      (match (field status code) (0 (validate-output c (values-at values 0) entry)) (_ unit))
      (let
        ((result
           scalar-value
           (match (field status code) (0 (values-at values 0)) (_ (scalar-value 0 0)))))
        (do
          (values-destroy (& locals))
          (values-destroy (& values))
          (steps-destroy (& pending))
          (ids-destroy (& slots))
          (ids-destroy (& sizes))
          (outcome
            (field status code)
            result
            (field status site)
            (field status storage)
            frames
            aggregates))))))

; The legacy scalar entry rejects handles without backing storage. Structured
; callers borrow an outcome's aggregates; the new run copies them before use.
(base:function run
  ((p m:context) (entry u64) (arguments values-array) (config options) (backing allocator:backend))
  outcome
  (let ((empty values-array (values-new backing)))
    (run-with-aggregates p entry arguments empty config backing)))

(base:function validate-components ((c machine) (fields u64) (start u64) (parent u64)) unit
  (match fields
    (0 unit)
    (_
      (let ((v scalar-value (values-at (deref (field c aggregates)) start)))
        (do
          (require c (n:eq (field v ty) (field (m:at (field c program) fields) ty)) 0)
          (validate-value c v parent)
          (validate-components c (m:next (field c program) fields) (n:add start 1) parent))))))

(base:function valid-callback ((p m:context) (signature u64) (fn u64)) bool
  (base:cond
    ((n:eq fn 0) false)
    ((n:ge fn (m:nodes-length (deref (field p items)))) false)
    (true (check:callback-matches p signature fn))))

(base:function validate-array-items ((c machine) (element u64) (start u64) (count u64) (parent u64))
  unit
  (match count
    (0 unit)
    (1
      (let ((value scalar-value (values-at (deref (field c aggregates)) start)))
        (do (require c (n:eq (field value ty) element) 0) (validate-value c value parent))))
    (_
      (let ((half u64 (n:div count 2)))
        (do
          (validate-array-items c element start half parent)
          (validate-array-items c element (n:add start half) (n:sub count half) parent))))))

(base:function validate-value ((c machine) (v scalar-value) (parent u64)) unit
  (let
    ((ty u64 (field v ty))
     (bits u64 (base:convert (field v scalar)))
     (p m:context (field c program))
     (length u64 (values-length (deref (field c aggregates)))))
    (match ty
      (0 (fail c 6 0))
      (1 (require c (n:eq bits 0) 0))
      (2 (require c (n:le bits 1) 0))
      (3 unit)
      (12 (require c (n:le bits 4294967295) 0))
      (13 unit)
      (11
        (base:cond
          ((n:ge bits pointer-tag) (validate-output c v 0))
          ((n:eq bits 0) (fail c 6 0))
          ((n:ge bits (m:nodes-length (deref (field p items)))) (fail c 6 0))
          (true (require c (n:eq (field (m:at p bits) kind) 17) 0))))
      (_
        (base:cond
          ((num:integer-type ty) (require c (signed:eq (field v scalar) (num:normalize ty bits)) 0))
          ((n:le ty num:descriptor-base) (fail c 6 0))
          ((n:ge (n:sub ty num:descriptor-base) (m:nodes-length (deref (field p items))))
           (fail c 6 0))
          ((n:eq (check:type-kind p ty) 34)
           (let ((signature u64 (check:callback-signature p ty)))
