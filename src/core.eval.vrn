(import base)
(import libc.string :as cstring)
(import core.numeric :as num)
(import core.float :as float)
(import core.model :as m)
(import core.check :as check)
(import core.storage :as mem)
(import core.format :as format)
(import data)
(import allocator)
(import array)
(import error)
(import foundation.compat.arithmetic)
(import foundation.compat.arithmetic :as n)
(import foundation.compat.signed_arithmetic :as signed)

; Runtime values are distinct from syntax, tagged with checked type IDs.
; Runtime payload tagged with checked type IDs: unit=1, bool=2, i64=3.
; Unit uses zero; booleans use zero/one; i64 retains its signed payload.
; Structured types use one-based indices into the outcome-owned aggregates array.
(base:type scalar-value (product (ty u64) (scalar i64)))

; Active call with checked function/call-site IDs and a locals base in slots.
; Values/pending save caller stack lengths for result and return checks.
; All stack references are indices so array growth cannot invalidate them.
(base:type frame
  (product (function u64) (site u64) (slots u64) (values u64) (pending u64) (memory u64)))

; Pending opcodes: expression, choose, bind-next, install, arguments, primitive, return.
; Deferred action: expression=1, choose=2, bind-next=3, install=4, arguments=5,
; primitive=6, return=7, aggregate arguments=8, extraction=9, match selection=10, integer conversion=11;
; boolean inversion=12, pointer cast=13, indirect call=14, array index=15,
; literal/binding match selection=16.
; sequence continuation/discard=17, address=18, load=19, store=20,
; field address=21, array address=22, pointer offset=23, tuple match=24,
; pointer-null check=25.
; zero is preparation-only. Id/a/b are action-specific
; tape IDs or opcodes; mark saves the argument value-stack base.
(base:type step (product (kind u64) (id u64) (a u64) (b u64) (mark u64)))

; Per-run limits: steps bounds pending dispatches; depth bounds active calls,
; including the entry frame. Zero disables the corresponding limit.
(base:type options (product (steps u64) (depth u64)))

(array:define values scalar-value)

; Owning typed-value array: pointer, length, capacity, allocation layout. Used for
; arguments, local slots, intermediate values, and immutable aggregate storage;
; destroy each owner once.
(base:type values-array (tuple (pointer scalar-value) u64 u64 array:layout))

(base:function values-new ((backing allocator:backend)) values-array
  (values-empty (cast (pointer scalar-value) (m:empty-env)) (array:layout 16 8 backing)))

(base:function values-at ((items values-array) (id u64)) scalar-value
  (deref (pointer-offset (tuple-get items 0) id)))

(base:function values-trim ((owner (pointer values-array)) (count u64)) unit
  (let ((v values-array (deref owner)))
    (do (store (deref owner) (tuple (tuple-get v 0) count (tuple-get v 2) (tuple-get v 3))) unit)))

(array:define frames frame)

; Owning call-frame array: pointer, length, capacity, allocation layout.
; An outcome retains this storage as its outermost-first failure trace.
(base:type frames-array (tuple (pointer frame) u64 u64 array:layout))

(base:function frames-new ((backing allocator:backend)) frames-array
  (frames-empty (cast (pointer frame) (m:empty-env)) (array:layout 48 8 backing)))

(base:function frames-at ((items frames-array) (id u64)) frame
  (deref (pointer-offset (tuple-get items 0) id)))

(base:function frames-trim ((owner (pointer frames-array)) (count u64)) unit
  (let ((v frames-array (deref owner)))
    (do (store (deref owner) (tuple (tuple-get v 0) count (tuple-get v 2) (tuple-get v 3))) unit)))

(array:define steps step)

; Owning pending-action stack: pointer, length, capacity, allocation layout.
; Actions pop in reverse scheduling order; run releases this temporary storage.
(base:type steps-array (tuple (pointer step) u64 u64 array:layout))

(base:function steps-new ((backing allocator:backend)) steps-array
  (steps-empty (cast (pointer step) (m:empty-env)) (array:layout 40 8 backing)))

(base:function steps-at ((items steps-array) (id u64)) step
  (deref (pointer-offset (tuple-get items 0) id)))

(base:function steps-trim ((owner (pointer steps-array)) (count u64)) unit
  (let ((v steps-array (deref owner)))
    (do (store (deref owner) (tuple (tuple-get v 0) count (tuple-get v 2) (tuple-get v 3))) unit)))

(array:define ids u64)

; Owning u64 array: pointer, length, capacity, allocation layout. Preparation
; maps binder IDs to compact slot offsets and function IDs to local-slot counts.
; Global declaration entries in the size map instead hold permanent pointer bits.
(base:type ids-array (tuple (pointer u64) u64 u64 array:layout))

(base:function ids-new ((backing allocator:backend)) ids-array
  (ids-empty (cast (pointer u64) (m:empty-env)) (array:layout 8 8 backing)))

(base:function ids-at ((items ids-array) (id u64)) u64
  (deref (pointer-offset (tuple-get items 0) id)))

; Failure codes: division zero/overflow=1/2, step/depth=3/4, storage=5,
; invariant=6, array bounds=7, native call unavailable=8,
; invalid pointer=9, expired storage=10, read-only storage=11.
; Outcomes own their trace and aggregate arrays; temporary stacks are released by run.
; Owning run result. Code zero makes result valid; failures identify a site
; and may retain storage status and frames. Destroy every outcome, including
; success. Tape IDs require the borrowed checked program to remain alive.
(base:type outcome
  (product
    (code u64)
    (result scalar-value)
    (site u64)
    (storage error:status)
    (trace frames-array)
    (aggregates values-array)))

; Mutable per-run status. The first nonzero code retains its site and storage
; failure; ticks counts admitted execution dispatches.
(base:type state (product (code u64) (site u64) (storage error:status) (ticks u64)))

; Borrowed execution working set: checked program, limits, status, locals,
; values, frames, pending steps, and prepared slot/size maps. Run owns the
; pointed-to arrays and releases them or transfers the frame trace.
(base:type machine
  (product
    (program m:context)
    (config options)
    (status (pointer state))
    (locals (pointer values-array))
    (values (pointer values-array))
    (frames (pointer frames-array))
    (pending (pointer steps-array))
    (slots (pointer ids-array))
    (sizes (pointer ids-array))
    (aggregates (pointer values-array))))

(base:function fail ((c machine) (code u64) (site u64)) unit
  (let ((s state (deref (field c status))))
    (match (field s code)
      (0
        (do
          (store (deref (field c status)) (state code site (field s storage) (field s ticks)))
          unit))
      (_ unit))))

(base:function storage ((c machine) (status error:status)) unit
  (match status
    ((ok) unit)
    (_
      (do
        (fail c 5 0)
        (let ((s state (deref (field c status))))
          (do
            (store
              (deref (field c status))
              (state (field s code) (field s site) status (field s ticks)))
            unit))))))

(base:function require ((c machine) (valid bool) (site u64)) unit
  (match valid (true unit) (false (fail c 6 site))))

(base:function push ((c machine) (v scalar-value)) unit
  (storage c (values-append (field c values) v)))

(base:function schedule ((c machine) (kind u64) (id u64) (a u64) (b u64) (mark u64)) unit
  (storage c (steps-append (field c pending) (step kind id a b mark))))

(base:function evaluate-expression ((c machine) (id u64)) unit
  (schedule c 1 id 0 0 0))

(base:function evaluate-sequence ((c machine) (id u64)) unit
  (match id
    (0 (push c (scalar-value 1 0)))
    (_
      (match (m:next (field c program) id)
        (0 (evaluate-expression c id))
        (next (do (schedule c 17 id next 0 0) (evaluate-expression c id)))))))

(base:function current ((c machine)) frame
  (frames-at (deref (field c frames)) (n:sub (frames-length (deref (field c frames))) 1)))

(base:function pop ((c machine)) scalar-value
  (let ((count u64 (values-length (deref (field c values)))))
    (match count
      (0 (do (fail c 6 0) (scalar-value 0 0)))
      (_
        (let ((v scalar-value (values-at (deref (field c values)) (n:sub count 1))))
          (do (values-trim (field c values) (n:sub count 1)) v))))))

; Preparation walks each declaration's syntax by stable IDs, assigning compact slots.
; A typed kind-zero atom is a binder. Reuse the pending array for this traversal;
; no source spelling, source containment, or runtime name lookup determines a slot.
(base:function prepare-one ((c machine) (size (pointer u64))) unit
  (let
    ((count u64 (steps-length (deref (field c pending))))
     (id u64 (field (steps-at (deref (field c pending)) (n:sub count 1)) id))
     (v m:node (m:at (field c program) id)))
    (do
      (steps-trim (field c pending) (n:sub count 1))
      (match (match (n:eq (field v kind) 0) (true (n:gt (field v ty) 0)) (false false))
        (true
          (do
            (storage c (ids-replace (deref (field c slots)) id (deref size)))
            (store (deref size) (n:add (deref size) 1))
            unit))
        (false unit))
      (match (field v next) (0 unit) (_ (schedule c 0 (field v next) 0 0 0)))
      (match (field v child) (0 unit) (_ (schedule c 0 (field v child) 0 0 0))))))

(base:function prepare-walk ((c machine) (size (pointer u64)) (count u64)) unit
  (match (field (deref (field c status)) code)
    (0
      (match (steps-length (deref (field c pending)))
        (0 unit)
        (_
          (match count
            (0 unit)
            (1 (prepare-one c size))
            (_
              (let ((half u64 (n:div count 2)))
                (do (prepare-walk c size half) (prepare-walk c size (n:sub count half)))))))))
    (_ unit)))

(base:function prepare ((c machine) (start u64) (count u64)) unit
  (match (field (deref (field c status)) code)
    (0
      (match count
        (0 unit)
        (1
          (match (check:callable-shape (field c program) start)
            (false unit)
            (true
              (let ((size u64 0))
                (do
                  (schedule c 0 (m:child (field c program) start) 0 0 0)
                  (prepare-walk c (& size) (base:maxBound))
                  (storage c (ids-replace (deref (field c sizes)) start size)))))))
        (_
          (let ((half u64 (n:div count 2)))
            (do (prepare c start half) (prepare c (n:add start half) (n:sub count half)))))))
    (_ unit)))

(base:function initialize ((c machine) (count u64)) unit
  (match count
    (0 unit)
    (1 (do (storage c (ids-append (field c slots) 0)) (storage c (ids-append (field c sizes) 0))))
    (_
      (let ((half u64 (n:div count 2))) (do (initialize c half) (initialize c (n:sub count half)))))))

(base:function allocate-slots ((c machine) (count u64)) unit
  (match (field (deref (field c status)) code)
    (0
      (match count
        (0 unit)
        (1 (storage c (values-append (field c locals) (scalar-value 0 0))))
        (_
          (let ((half u64 (n:div count 2)))
            (do (allocate-slots c half) (allocate-slots c (n:sub count half)))))))
    (_ unit)))

(base:function slot ((c machine) (binder u64)) u64
  (n:add (field (current c) slots) (ids-at (deref (field c slots)) binder)))

(base:function install ((c machine) (binder u64) (v scalar-value)) unit
  (do
    (require c (n:eq (field v ty) (field (m:at (field c program) binder) ty)) binder)
    (match (check:stored-binder (field c program) binder)
      (false (storage c (values-replace (deref (field c locals)) (slot c binder) v)))
      (true
        (let
          ((old scalar-value (values-at (deref (field c locals)) (slot c binder)))
           (token
             u64
             (match (field old ty)
               (0
                 (new-memory c (field v ty) (field (mem:of (field c program) (field v ty)) size) 3))
               (_ (base:convert (field old scalar))))))
          (do
            (storage
              c
              (values-replace
                (deref (field c locals))
                (slot c binder)
                (scalar-value (field v ty) (base:convert token))))
            (store-memory c token (field v ty) v binder)))))))

; Parameter lists are bounded by analysis; balanced index traversal handles entry argument copying.
(base:function parameters ((c machine) (param u64) (index u64) (end u64)) unit
  (match param
    (0 (require c (n:eq index end) 0))
    (_
      (match (n:lt index end)
        (false (fail c 6 param))
        (true
          (do
            (install c (m:child (field c program) param) (values-at (deref (field c values)) index))
            (parameters c (m:next (field c program) param) (n:add index 1) end)))))))

(base:function invoke ((c machine) (fn u64) (site u64) (mark u64)) unit
  (match (field (m:at (field c program) fn) kind)
    (53 (fail c 8 site))
    (_ (invoke-internal c fn site mark))))

(base:function invoke-internal ((c machine) (fn u64) (site u64) (mark u64)) unit
  (let
    ((depth u64 (frames-length (deref (field c frames))))
     (limit u64 (field (field c config) depth)))
    (match (match (n:eq limit 0) (true false) (false (n:ge depth limit)))
      (true (fail c 4 site))
      (false
        (let
          ((base u64 (values-length (deref (field c locals))))
           (end u64 (values-length (deref (field c values)))))
          (do
            (storage
              c
              (frames-append
                (field c frames)
                (frame
                  fn
                  site
                  base
                  mark
                  (steps-length (deref (field c pending)))
                  (values-length (deref (field c aggregates))))))
            (allocate-slots c (ids-at (deref (field c sizes)) fn))
            (match (field (deref (field c status)) code)
              (0
                (do
                  (parameters
                    c
                    (m:child (field c program) (check:signature (field c program) fn))
                    mark
                    end)
                  (values-trim (field c values) mark)
                  (schedule c 7 fn 0 0 0)
                  (evaluate-expression c (check:body (field c program) fn))))
              (_ unit))))))))

; Use unsigned bit arithmetic deliberately for wrapping, and convert at the scalar boundary.
(base:function push-integer ((c machine) (ty u64) (bits u64)) unit
  (push c (scalar-value ty (num:normalize ty bits))))

(base:function integer-divide ((c machine) (id u64) (ty u64) (a i64) (b i64)) unit
  (base:cond
    ((signed:eq b 0) (fail c 1 id))
    ((num:signed-type ty)
     (match
       (match (signed:eq b -1)
         (false false)
         (true (signed:eq a (num:normalize ty (num:sign-bit ty)))))
       (true (fail c 2 id))
       (false (push c (scalar-value ty (/ a b))))))
    (true (push-integer c ty (n:div (base:convert a) (base:convert b))))))

(base:function less ((ty u64) (a i64) (b i64)) bool
  (match (num:signed-type ty)
    (true (signed:lt a b))
    (false (n:lt (base:convert a) (base:convert b)))))

(base:function compare ((op u64) (ty u64) (a i64) (b i64)) bool
  (match op
    (5 (signed:eq a b))
    (6 (less ty a b))
    (7 (match (less ty b a) (true false) (false true)))
    (8 (less ty b a))
    (9 (match (less ty a b) (true false) (false true)))
    (_ (match (signed:eq a b) (true false) (false true)))))

(base:function shift-right ((ty u64) (a i64) (divisor u64)) u64
  (let ((bits u64 (base:convert a)))
    (match (match (num:signed-type ty) (true (signed:lt a 0)) (false false))
      (false (n:div bits divisor))
      (true (n:sub 0 (n:add 1 (n:div (n:sub (n:sub 0 bits) 1) divisor)))))))

(base:function pointer-address ((c machine) (bits u64) (site u64)) (tuple u64 u64 u64)
  (let ((p m:context (field c program)) (length u64 (values-length (deref (field c aggregates)))))
    (match (n:lt bits pointer-tag)
      (true
        (match
          (match (base:and (n:gt bits 0) (n:lt bits (m:nodes-length (deref (field p items)))))
            (true (n:eq (field (m:at p bits) kind) 17))
            (false false))
          (true (tuple 2 bits 0))
          (false
            (match
              (match (base:and (n:gt bits 0) (n:lt bits (m:nodes-length (deref (field p items)))))
                (true (n:eq (field (m:at p bits) kind) 53))
                (false false))
              (true (tuple 3 bits 0))
              (false (tuple 0 bits 0))))))
      (false
        (let ((index u64 (n:sub bits pointer-tag)))
          (match (match (n:lt index length) (true (n:lt (n:add index 1) length)) (false false))
            (false (do (memory-check c false site) (tuple 0 0 0)))
            (true
              (let
                ((address scalar-value (heap-at c index))
                 (region u64 (base:convert (field address scalar)))
                 (offset u64 (base:convert (field (heap-at c (n:add index 1)) scalar))))
                (match
                  (match (n:eq (field address ty) address-tag)
                    (true
                      (match (n:lt region length)
                        (true (n:lt (n:add region 1) length))
                        (false false)))
                    (false false))
                  (false (do (memory-check c false site) (tuple 0 0 0)))
                  (true
                    (let
                      ((header scalar-value (heap-at c region))
                       (size u64 (base:convert (field header scalar)))
                       (origin u64 (field (heap-at c (n:add region 1)) ty)))
                      (do
                        (memory-check c (n:eq (field header ty) region-tag) site)
                        (memory-check c (n:le size (n:sub length (n:add region 2))) site)
                        (memory-check c (n:le offset size) site)
                        ; Equality does not access bytes, check alignment, or
                        ; require the represented storage to remain live.
                        (match (n:ge origin pointer-tag)
                          (true (tuple 2 (n:sub origin pointer-tag) offset))
                          (false (tuple 1 region offset)))))))))))))))

(base:function pointer-compare
  ((c machine) (id u64) (op u64) (left scalar-value) (right scalar-value)) unit
  (do
    (require c (check:pointer-value-type (field c program) (field left ty)) id)
    (require c (n:eq (field left ty) (field right ty)) id)
    (let
      ((a (tuple u64 u64 u64) (pointer-address c (base:convert (field left scalar)) id))
       (b (tuple u64 u64 u64) (pointer-address c (base:convert (field right scalar)) id))
       (same
         bool
         (match (n:eq (tuple-get a 0) (tuple-get b 0))
           (false false)
           (true
             (match (tuple-get a 0)
               (3
                 (match
                   (cstring:strcmp
                     (check:external-name (field c program) (tuple-get a 1))
                     (check:external-name (field c program) (tuple-get b 1)))
                   (0 true)
                   (_ false)))
               (_
                 (base:and
                   (n:eq (tuple-get a 1) (tuple-get b 1))
                   (n:eq (tuple-get a 2) (tuple-get b 2)))))))))
      (push c (scalar-value 2 (match (match op (18 same) (_ (base:not same))) (true 1) (false 0)))))))

(base:function primitive ((c machine) (id u64) (op u64) (x scalar-value) (y scalar-value)) unit
  (match op
    (18 (pointer-compare c id op x y))
    (19 (pointer-compare c id op x y))
    (_ (integer-primitive c id op x y))))

(base:function integer-primitive ((c machine) (id u64) (op u64) (x scalar-value) (y scalar-value))
  unit
  (let
    ((ty u64 (field x ty))
     (a i64 (field x scalar))
     (b i64 (field y scalar))
     (left u64 (base:convert a))
     (right u64 (base:convert b)))
    (do
      (require c (match ty (2 true) (_ (num:integer-type ty))) id)
      (require c (n:eq ty (field y ty)) id)
      (match op
        (1 (push-integer c ty (n:add left right)))
        (2 (push-integer c ty (n:sub left right)))
        (3 (push-integer c ty (n:mul left right)))
        (4 (integer-divide c id ty a b))
        (11 (push-integer c ty (num:bitwise op left right)))
        (12 (push-integer c ty (num:bitwise op left right)))
        (13 (push-integer c ty (num:bitwise op left right)))
        (14 (push-integer c ty (n:mul left (num:pow2 (num:remainder right (num:width ty))))))
        (15 (push-integer c ty (shift-right ty a (num:pow2 (num:remainder right (num:width ty))))))
        (_
          (do
            (require c (match (n:ge op 5) (true (n:le op 10)) (false false)) id)
            (push c (scalar-value 2 (match (compare op ty a b) (true 1) (false 0))))))))))

(base:function expression-inner ((c machine) (id u64)) unit
  (let
    ((p m:context (field c program)) (v m:node (m:at p id)) (args u64 (m:next p (field v child))))
    (do
      (require c (n:gt (field v ty) 0) id)
      (match (field v kind)
        (57 (do (schedule c 18 id (field v ty) 0 0) (evaluate-place c args)))
        (58 (do (schedule c 19 id (field v ty) 0 0) (evaluate-place c id)))
        (59
          (do
            (schedule c 23 id (field v target) 0 0)
            (evaluate-expression c (m:next p args))
            (evaluate-expression c args)))
        (60
          (do
            (schedule c 20 id (field (m:at p args) ty) 0 0)
            (evaluate-expression c (m:next p args))
            (evaluate-place c args)))
        (52 (evaluate-expression c (check:constant-initializer p (field v target))))
        (64 (do (schedule c 19 id (field v ty) 0 0) (evaluate-place c id)))
        (47 (push c (scalar-value (field v ty) (base:convert (field v target)))))
        (50
          (match (place-stored p id)
            (true (do (schedule c 19 id (field v ty) 0 0) (evaluate-place c id)))
            (false
              (do
                (schedule c 15 id (field v target) 0 0)
                (evaluate-expression c (m:next p args))
                (evaluate-expression c args)))))
        (48 (do (schedule c 14 id args (field v target) 0) (evaluate-expression c (field v child))))
        (45 (do (schedule c 13 id (field v ty) 0 0) (evaluate-expression c (m:next p args))))
        (36 (push c (scalar-value (field v ty) (field v value))))
        (17 (push c (scalar-value 11 (base:convert id))))
        (2
          (do
            (require c (num:integer-type (field v ty)) id)
            (push c (scalar-value (field v ty) (field v value)))))
        (3
          (do
            (require c (n:eq (field v ty) 2) id)
            (require c (match (field v value) (0 true) (1 true) (_ false)) id)
            (push c (scalar-value 2 (field v value)))))
        (4 (do (require c (n:eq (field v ty) 1) id) (push c (scalar-value 1 0))))
        (5
          (let ((local scalar-value (values-at (deref (field c locals)) (slot c (field v target)))))
            (do
              (require c (n:eq (field local ty) (field v ty)) id)
              (push
                c
                (match (check:stored-binder p (field v target))
                  (true (load-memory c (base:convert (field local scalar)) (field v ty) id))
                  (false local))))))
        (6 (do (schedule c 2 id args 0 0) (evaluate-expression c args)))
        (7 (do (schedule c 3 id (m:child p args) (m:next p args) 0)))
        (8 (schedule c 5 id args (field v target) (values-length (deref (field c values)))))
        (54 (schedule c 5 id args (field v target) (values-length (deref (field c values)))))
        (15
          (let ((mark u64 (values-length (deref (field c values)))))
            (do
              (push c (scalar-value 3 (base:convert (field (m:at p (field v target)) target))))
              (schedule c 8 id args 0 mark))))
        (16 (do (schedule c 10 id (m:next p args) 0 0) (evaluate-expression c args)))
        (55 (do (schedule c 16 id (m:next p args) 0 0) (evaluate-expression c args)))
        (61 (do (schedule c 24 id (m:next p args) 0 0) (evaluate-expression c args)))
        (56 (evaluate-sequence c args))
        (13 (schedule c 8 id args 0 (values-length (deref (field c values)))))
        (14
          (match (place-stored p id)
            (true (do (schedule c 19 id (field v ty) 0 0) (evaluate-place c id)))
            (false (do (schedule c 9 id (field v target) 0 0) (evaluate-expression c args)))))
        (9
          (match (field v target)
            (16 (do (schedule c 11 id (field v ty) 0 0) (evaluate-expression c args)))
            (17 (do (schedule c 12 id 0 0 0) (evaluate-expression c args)))
            (20 (do (schedule c 25 id 0 0 0) (evaluate-expression c args)))
            (_
              (do
                (schedule c 6 id (field v target) 0 0)
                (evaluate-expression c (m:next p args))
                (evaluate-expression c args)))))
        (_ (fail c 6 id))))))

; Reject unchecked/error expressions before scheduling any of their children.
(base:function expression ((c machine) (id u64)) unit
  (base:cond
    ((n:eq id 0) (fail c 6 0))
    ((n:ge id (m:nodes-length (deref (field (field c program) items)))) (fail c 6 0))
    ((n:eq (field (m:at (field c program) id) ty) 0) (fail c 6 id))
    (true (expression-inner c id))))

(base:function dispatch ((c machine) (s step)) unit
  (let
    ((p m:context (field c program)) (id u64 (field s id)) (a u64 (field s a)) (b u64 (field s b)))
    (match (field s kind)
      (1 (expression c id))
      (2
        (let ((condition scalar-value (pop c)))
          (do
            (require c (n:eq (field condition ty) 2) id)
            (evaluate-expression
              c
              (match (field condition scalar) (0 (m:next p (m:next p a))) (_ (m:next p a)))))))
      (3
        (match a
          (0 (evaluate-sequence c b))
          (_
            (do
              (schedule c 3 id (m:next p a) b 0)
              (schedule c 4 (m:child p a) 0 0 0)
              (evaluate-expression c (field (m:at p a) target))))))
      (4 (install c id (pop c)))
      (5
        (match a
          (0 (invoke c b id (field s mark)))
          (_ (do (schedule c 5 id (m:next p a) b (field s mark)) (evaluate-expression c a)))))
      (15
        (let
          ((offset scalar-value (pop c))
           (value scalar-value (pop c))
           (index u64 (base:convert (field offset scalar))))
          (do
            (require c (n:eq (field offset ty) 10) id)
            (require c (n:eq (field value ty) a) id)
            (match (n:lt index (check:array-length p a))
              (true (push c (component c value index id)))
              (false (fail c 7 id))))))
      (14
        (let ((fn u64 (base:convert (field (pop c) scalar))))
          (do
            (require c (valid-callback p b fn) id)
            (schedule c 5 id a fn (values-length (deref (field c values)))))))
      (13 (let ((value scalar-value (scalar-value a (field (pop c) scalar)))) (do (push c value))))
      (12
        (let ((v scalar-value (pop c)))
          (do
            (require c (n:eq (field v ty) 2) id)
            (push c (scalar-value 2 (match (field v scalar) (0 1) (_ 0)))))))
      (11
        (let ((v scalar-value (pop c)))
          (match (match (num:float-type a) (true true) (false (num:float-type (field v ty))))
            (true (push c (scalar-value a (float:convert (field v ty) a (field v scalar)))))
            (false (push-integer c a (base:convert (field v scalar)))))))
      (25
        (let ((v scalar-value (pop c)))
          (do
            (require c (check:pointer-value-type p (field v ty)) id)
            (push c (scalar-value 2 (match (signed:eq (field v scalar) 0) (true 1) (false 0)))))))
      (6
        (let ((right scalar-value (pop c)) (left scalar-value (pop c)) (ty u64 (field left ty)))
          (match (num:float-type ty)
            (true
              (do
                (require c (n:eq ty (field right ty)) id)
                (match (n:le a 4)
                  (true
                    (push
                      c
                      (scalar-value
                        ty
                        (float:arithmetic a ty (field left scalar) (field right scalar)))))
                  (false
                    (push
                      c
                      (scalar-value
                        2
                        (match (float:compare a ty (field left scalar) (field right scalar))
                          (true 1)
                          (false 0))))))))
            (false (primitive c id a left right)))))
      (7
        (let ((f frame (current c)))
          (do
            (require
              c
              (n:eq (values-length (deref (field c values))) (n:add (field f values) 1))
              id)
            (require c (n:eq (steps-length (deref (field c pending))) (field f pending)) id)
            (require
              c
              (n:eq
                (field (values-at (deref (field c values)) (field f values)) ty)
                (field (m:at p id) ty))
              id)
            (expire-memory
              c
              (field f memory)
              (n:sub (values-length (deref (field c aggregates))) (field f memory)))
            (values-trim (field c locals) (field f slots))
            (frames-trim (field c frames) (n:sub (frames-length (deref (field c frames))) 1)))))
      (8
        (match a
          (0 (aggregate c id (field s mark)))
          (_ (do (schedule c 8 id (m:next p a) 0 (field s mark)) (evaluate-expression c a)))))
      (9 (let ((v scalar-value (pop c))) (push c (component c v a id))))
      (10
        (let ((v scalar-value (pop c)) (tag scalar-value (component c v 0 id)))
          (select-arm c a (n:add (base:convert (field tag scalar)) 1) v false)))
      (24 (select-arm c a 1 (pop c) true))
      (16 (select-scalar-arm c a (pop c)))
      (17 (do (pop c) (evaluate-sequence c a)))
      (18 (let ((value scalar-value (pop c))) (push c (scalar-value a (field value scalar)))))
      (19
        (let ((pointer scalar-value (pop c)))
          (push c (load-memory c (base:convert (field pointer scalar)) a id))))
      (20
        (let ((value scalar-value (pop c)) (pointer scalar-value (pop c)))
          (do
