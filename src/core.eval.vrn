      (_ (fail c 6 id)))))

; Balanced execution pumping has at most 65 host frames, regardless of Verona call/expression depth.
; One step is one pending dispatch; the limit is checked before removing that step.
(base:function advance ((c machine)) unit
  (let
    ((s state (deref (field c status)))
     (limit u64 (field (field c config) steps))
     (count u64 (steps-length (deref (field c pending))))
     (next step (steps-at (deref (field c pending)) (n:sub count 1))))
    (match (match (n:eq limit 0) (true false) (false (n:ge (field s ticks) limit)))
      (true (fail c 3 (field next id)))
      (false
        (do
          (store (deref (field c status)) (state 0 0 (field s storage) (n:add (field s ticks) 1)))
          (steps-trim (field c pending) (n:sub count 1))
          (dispatch c next))))))

(base:function pump ((c machine) (count u64)) unit
  (match (field (deref (field c status)) code)
    (0
      (match (steps-length (deref (field c pending)))
        (0 unit)
        (_
          (match count
            (0 unit)
            (1 (advance c))
            (_ (let ((half u64 (n:div count 2))) (do (pump c half) (pump c (n:sub count half)))))))))
    (_ unit)))

; Aggregate handles are one-based indices into outcome-owned immutable storage.
; A header records the concrete type and arity, followed by typed component values.
(base:function aggregate-copy ((c machine) (start u64) (count u64)) unit
  (match count
    (0 unit)
    (1 (storage c (values-append (field c aggregates) (values-at (deref (field c values)) start))))
    (_
      (let ((half u64 (n:div count 2)))
        (do (aggregate-copy c start half) (aggregate-copy c (n:add start half) (n:sub count half)))))))

(base:function aggregate ((c machine) (id u64) (mark u64)) unit
  (assemble c (field (m:at (field c program) id) ty) mark))

(base:function assemble ((c machine) (ty u64) (mark u64)) unit
  (let
    ((handle u64 (n:add (values-length (deref (field c aggregates))) 1))
     (count u64 (n:sub (values-length (deref (field c values))) mark)))
    (do
      (storage c (values-append (field c aggregates) (scalar-value ty (base:convert count))))
      (aggregate-copy c mark count)
      (values-trim (field c values) mark)
      (push c (scalar-value ty (base:convert handle))))))

(base:function component ((c machine) (v scalar-value) (index u64) (site u64)) scalar-value
  (let
    ((handle u64 (base:convert (field v scalar)))
     (length u64 (values-length (deref (field c aggregates)))))
    (match (match (n:gt handle 0) (true (n:le handle length)) (false false))
      (false (do (fail c 6 site) (scalar-value 0 0)))
      (true
        (let
          ((header scalar-value (values-at (deref (field c aggregates)) (n:sub handle 1)))
           (count u64 (base:convert (field header scalar))))
          (match
            (match (n:eq (field header ty) (field v ty))
              (true
                (match (n:lt index count) (true (n:lt (n:add handle index) length)) (false false)))
              (false false))
            (false (do (fail c 6 site) (scalar-value 0 0)))
            (true (values-at (deref (field c aggregates)) (n:add handle index)))))))))

(base:function payload-install ((c machine) (names u64) (v scalar-value) (index u64)) unit
  (match names
    (0 unit)
    (_
      (do
        (match (field (m:at (field c program) names) kind)
          (0
            (match (field (m:at (field c program) names) ty)
              (0 unit)
              (_ (install c names (component c v index names)))))
          (_ unit))
        (payload-install c (m:next (field c program) names) v (n:add index 1))))))

(base:function pattern-components-match ((c machine) (names u64) (v scalar-value) (index u64)) bool
  (match names
    (0 true)
    (_
      (let ((p m:context (field c program)) (pattern m:node (m:at p names)))
        (match
          (match (field pattern kind)
            (0 true)
            (_
              (n:eq
                (base:convert (field pattern value))
                (base:convert (field (component c v index names) scalar)))))
          (false false)
          (true (pattern-components-match c (m:next p names) v (n:add index 1))))))))

(base:function select-arm ((c machine) (arm u64) (tag u64) (v scalar-value) (tuple bool)) unit
  (match arm
    (0 (fail c 6 0))
    (_
      (let
        ((p m:context (field c program))
         (target u64 (field (m:at p arm) target))
         (names u64 (m:next p (m:child p (m:child p arm))))
         (index u64 (match tuple (true 0) (false 1))))
        (match
          (match target
            (0 true)
            (_
              (match (n:eq target tag)
                (false false)
                (true (pattern-components-match c names v index)))))
          (false (select-arm c (m:next p arm) tag v tuple))
          (true
            (do
              (match target
                (0
                  (match (field (m:at p arm) value)
                    (0 unit)
                    (binder (install c (base:convert binder) v))))
                (_ (payload-install c names v index)))
              (evaluate-expression c (m:next p (m:child p arm))))))))))

(base:function select-scalar-arm ((c machine) (arm u64) (value scalar-value)) unit
  (match arm
    (0 (fail c 6 0))
    (_
      (let ((p m:context (field c program)) (v m:node (m:at p arm)))
