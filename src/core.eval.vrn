            (false (fail c 7 id))
            (true
              (push
                c
                (scalar-value
                  0
                  (base:convert
                    (shift-pointer
                      c
                      (base:convert (field pointer scalar))
                      false
                      (n:mul offset (field (mem:of p b) size))
                      id))))))))
      (23
        (let ((index scalar-value (pop c)) (pointer scalar-value (pop c)))
