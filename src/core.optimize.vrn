(import base)
(import core.model :as m)
(import core.numeric :as num)
(import core.check :as check)
(import arena)
(import libc.memory :as memory)

; UNKNOWN includes unsupported operations, possible runtime failures, and
; exhausted recursion budgets. A known value has the checked node's type.
(base:type constant-result (sum (unknown) (known i64)))

; Conservative properties of evaluating one checked expression. These answers
; are deliberately independent: discardable does not imply movable/duplicable
; for unsupported values. Unknown operations set every risk bit.
(base:type effects
  (product
    (discardable bool)
    (duplicable bool)
    (reads-memory bool)
    (writes-memory bool)
    (may-trap bool)
    (may-diverge bool)))

(base:function unknown-effects () effects
  (effects false false true true true true))

(base:function safe-effects () effects
  (effects true true false false false false))

; Compare canonical scalar payloads using the operand type's signedness.
(base:function less ((ty u64) (a i64) (b i64)) bool
  (match (num:signed-type ty)
    (true (< a b))
    (false
      (let ((left u64 (base:convert a)) (right u64 (base:convert b)))
        (< left right)))))

(base:function compare ((op u64) (ty u64) (a i64) (b i64)) bool
  (match op
    (5 (== a b)) ; Equal.
    (6 (less ty a b))
    (7 (base:not (less ty b a)))
    (8 (less ty b a))
    (9 (base:not (less ty a b)))
    (_ (base:not (== a b))))) ; Not equal (opcode 10).

; Match evaluator arithmetic right shift: division rounds negative values down.
; The divisor is a power of two from a count reduced modulo the operand width.
(base:function shift-right ((ty u64) (a i64) (divisor u64)) u64
  (let ((bits u64 (base:convert a)))
    (match (base:and (num:signed-type ty) (< a 0))
      (false (/ bits divisor))
      (true (- 0 (+ 1 (/ (- (- 0 bits) 1) divisor)))))))

(base:function divide ((ty u64) (a i64) (b i64)) constant-result
  (base:cond
    ((== b 0) (unknown))
    ((num:signed-type ty)
     (match (base:and (== b -1) (== a (num:normalize ty (num:sign-bit ty))))
       (true (unknown))
       (false (known (/ a b)))))
    (true
      (let ((left u64 (base:convert a)) (right u64 (base:convert b)))
        (known (num:normalize ty (/ left right)))))))

; Only resolved integer/boolean primitive opcodes reach this helper.
; Unsigned 64-bit intermediates deliberately wrap; normalize applies the
; checked operand width rather than the host's signed arithmetic semantics.
(base:function binary ((op u64) (ty u64) (a i64) (b i64)) constant-result
  (let ((left u64 (base:convert a)) (right u64 (base:convert b)))
    (base:cond
      ((base:and (>= op 5) (<= op 10))
       (known (match (compare op ty a b) (true 1) (false 0))))
      ((== op 4) (divide ty a b))
      (true
        (match op
          (1 (known (num:normalize ty (+ left right))))
          (2 (known (num:normalize ty (- left right))))
          (3 (known (num:normalize ty (* left right))))
          (11 (known (num:normalize ty (num:bitwise op left right))))
          (12 (known (num:normalize ty (num:bitwise op left right))))
          (13 (known (num:normalize ty (num:bitwise op left right))))
          (14
            (known
              (num:normalize
                ty
                (* left (num:pow2 (num:remainder right (num:width ty)))))))
          (15
            (known
              (num:normalize
                ty
                (shift-right
                  ty
                  a
                  (num:pow2 (num:remainder right (num:width ty)))))))
          (_ (unknown)))))))

; Read-only folding of checked literals, immutable local aliases and resolved
; primitive trees. No calls, memory accesses, pointers or floating-point folding.
; Fuel bounds nesting; exhausting it leaves normal lowering in control.
(base:function constant
  ((c m:context) (locals (pointer u64)) (id u64) (fuel u64)) constant-result
  (match fuel
    (0 (unknown))
    (_
      (let ((v m:node (m:at c id)))
        (match (field v kind)
          (2 ; Checked integer literal.
            (match (num:integer-type (field v ty))
              (true (known (field v value)))
              (false (unknown))))
          (3 ; Boolean literal; type 2 excludes untyped macro syntax.
            (match (field v ty) (2 (known (field v value))) (_ (unknown))))
          (5 ; Only immutable let binders have an initializer entry.
            (match (base:or (== (field v ty) 2) (num:integer-type (field v ty)))
              (false (unknown))
              (true
                (match (deref (pointer-offset locals (field v target)))
                  (0 (unknown))
                  (init (constant c locals init (- fuel 1)))))))
          (9 ; Checked primitive with a resolved opcode and concrete types.
            (let
              ((args u64 (m:next c (field v child)))
               (ty u64 (field (m:at c args) ty)))
              (match (base:or (== ty 2) (num:integer-type ty))
                (false (unknown))
                (true (primitive c locals v args ty (- fuel 1))))))
          (_ (unknown)))))))

(base:function primitive
  ((c m:context)
   (locals (pointer u64))
   (v m:node)
   (args u64)
   (ty u64)
   (fuel u64)) constant-result
  (match (constant c locals args fuel)
    ((unknown) (unknown))
    ((known a)
     (match (field v target)
       (16 ; Explicit integer conversion; floating conversions stay runtime.
         (match (base:and (num:integer-type ty) (num:integer-type (field v ty)))
           (true (known (num:normalize (field v ty) (base:convert a))))
           (false (unknown))))
       (17 ; Boolean negation.
         (known (match a (0 1) (_ 0))))
       (_
         (match (m:next c args)
           (0 (unknown))
           (right
             (match (constant c locals right fuel)
               ((unknown) (unknown))
               ((known b) (binary (field v target) ty a b))))))))))

; Read-only checked-expression rewrites. Call only after successful checking.
; Never replace tape nodes: binders, sibling links, source spans, and shared
; specialization identities remain owned by the checked program. Returning an
; existing branch ID lets lowering keep its normal expression/LLVM slot mapping.
; These rules allocate nothing, grow no graph, and need no fixed point.
; Zero means no branch rewrite. Only proven constant boolean computations
; can be discarded here; calls, loads, and references remain conservative.
(base:function known-branch
  ((c m:context) (locals (pointer u64)) (condition u64) (depth u64)) u64
  (let ((v m:node (m:at c condition)))
    ; Type 2 is bool. Reject untyped macro booleans, which have ty=0.
    (match (field v ty)
      (2
        (match (constant c locals condition depth)
          ((unknown) 0)
          ((known value)
           (match value
             (0 (m:next c (m:next c condition)))
             (_ (m:next c condition))))))
      (_ 0))))

; A pattern is rejected only by a proven mismatch. An unknown earlier pattern
; prevents selecting a later arm, even if that later arm is a catch-all.
(base:type pattern-result (sum (matches) (rejects) (undecided)))

(base:function components
  ((c m:context)
   (locals (pointer u64))
   (names u64)
   (values u64)
   (fuel u64)
   (depth u64)) pattern-result
  (match fuel
    (0 (undecided))
    (_
      (match names
        (0 (match values (0 (matches)) (_ (undecided))))
        (_
          (match values
            (0 (undecided))
            (_
              (let ((pattern m:node (m:at c names)))
                (match (field pattern kind)
                  (0 ; A checked component binder or wildcard always matches.
                    (components
                      c
                      locals
                      (m:next c names)
                      (m:next c values)
                      (- fuel 1)
                      depth))
                  (_
                    ; Only known integer/boolean literal comparisons simplify.
                    (match (constant c locals values depth)
                      ((unknown) (undecided))
                      ((known value)
                       (match (== value (field pattern value))
                         (false (rejects))
                         (true
                           (components
                             c
                             locals
                             (m:next c names)
                             (m:next c values)
                             (- fuel 1)
                             depth)))))))))))))))

; TARGET is a one-based sum tag, or 1 for a tuple pattern. Arm target 0 is
; a whole-value binder/wildcard. Identities and sibling chains stay untouched.
(base:function structured-arms
  ((c m:context)
   (locals (pointer u64))
   (arm u64)
   (target u64)
   (values u64)
   (fuel u64)
   (depth u64)) u64
  (match fuel
    (0 0)
    (_
      (match arm
        (0 0)
        (_
          (let ((tag u64 (field (m:at c arm) target)))
            (base:cond
              ((== tag 0) arm)
              ((== tag target)
               (match
                 (components
                   c
                   locals
                   (m:next c (m:child c (m:child c arm)))
                   values
                   fuel
                   depth)
                 ((matches) arm)
                 ((undecided) 0)
                 ((rejects)
                  (structured-arms
                    c
                    locals
                    (m:next c arm)
                    target
                    values
                    (- fuel 1)
                    depth))))
              (true
                (structured-arms
                  c
                  locals
                  (m:next c arm)
                  target
                  values
                  (- fuel 1)
                  depth)))))))))

(base:function scalar-arms ((c m:context) (arm u64) (value i64) (fuel u64)) u64
  (match fuel
    (0 0)
    (_
      (match arm
        (0 0)
        (_
          (let ((pattern m:node (m:at c arm)))
            (match
              (base:or
                (== (field pattern target) 0)
                (== (field pattern value) value))
              (true arm)
              (false (scalar-arms c (m:next c arm) value (- fuel 1))))))))))

; Select an existing checked arm, or zero to retain normal runtime matching.
; The emitter must evaluate the entire scrutinee exactly once BEFORE binding
; the selected arm, including unused/effectful constructor payloads.
; Only direct sum/tuple construction and proven scalar constants are supported.
; Scan at most 128 arms/components, with the existing 32-level folding budget.
(base:function known-match
  ((c m:context)
   (locals (pointer u64))
   (scrutinee u64)
   (sum bool)
   (tuple bool)
   (depth u64)
   (arms u64)) u64
  (let
    ((v m:node (m:at c scrutinee))
     (first u64 (m:next c scrutinee))
     (values u64 (m:next c (field v child))))
    (match sum
      (true
        (match (field v kind)
          (15 ; Checked sum constructor; its descriptor stores a zero-based tag.
            (structured-arms
              c
              locals
              first
              (+ (field (m:at c (field v target)) target) 1)
              values
              arms
              depth))
          (_ 0)))
      (false
        (match tuple
          (true
            (match (field v kind)
              (13 ; Checked aggregate construction, with a resolved tuple type.
                (structured-arms c locals first 1 values arms depth))
              (_ 0)))
          (false
            (match (constant c locals scrutinee depth)
              ((unknown) 0)
              ((known value) (scalar-arms c first value arms)))))))))

; One byte per checked tape identity. Scan the complete tape once, including
; references in other initializers and currently unreachable branches. Counting
; by resolved binder ID preserves shadowing and specialization identities.
; Deliberately do not subtract references when dropping another initializer:
; checked subtrees may be shared, so transitive liveness needs separate analysis.
(base:function mark-references
  ((c m:context) (used (pointer u8)) (start u64) (count u64)) unit
  (match count
    (0 unit)
    (1
      (let ((v m:node (m:at c start)))
        (match (field v kind)
          (5 ; Checked local reference, including references used as places/callees.
            (do
              (store (deref (pointer-offset used (field v target))) (cast u8 1))
              unit))
          (_ unit))))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (mark-references c used start half)
          (mark-references c used (+ start half) (- count half)))))))

; Arena-owned analysis storage lives as long as the borrowed checked program.
; Disabled optimization returns null and performs no scan/allocation.
(base:function references ((c m:context) (enabled bool)) (pointer u8)
  (match enabled
    (false (cast (pointer u8) (m:empty-env)))
    (true
      (let ((count u64 (m:nodes-length (deref (field c items)))))
        (match (arena:allocate (field c memory) count 1)
          ((allocated p)
           (let
             ((used (pointer u8) (cast (pointer u8) (cast (pointer void) p))))
             (do
               (memory:memset (cast (pointer void) used) 0 count)
               (mark-references c used 1 (- count 1))
               used)))
          (_
            (do
              (m:fatal "optimizer reference storage allocation failed")
              (cast (pointer u8) (m:empty-env)))))))))

; Map resolved immutable let binder IDs to their checked initializer IDs.
; Parameters, pattern binders, globals and stored/address-taken locals have no
; entry. Initializers are borrowed, never moved or removed by this analysis.
; Resolve chains on demand under the same depth budget as primitive folding.
(base:function local-bindings
  ((c m:context) (locals (pointer u64)) (binding u64)) unit
  (match binding
    (0 unit)
    (_
      (let ((name u64 (m:child c binding)))
        (do
          (match (check:stored-binder c name)
            (true unit)
            (false
              (store
                (deref (pointer-offset locals name))
                (field (m:at c binding) target))))
          (local-bindings c locals (m:next c binding)))))))

(base:function initializer-range
  ((c m:context) (locals (pointer u64)) (start u64) (count u64)) unit
  (match count
    (0 unit)
    (1
      (let ((v m:node (m:at c start)))
        (match (field v kind)
          (7 ; Checked let: bindings follow its operation head.
            (local-bindings c locals (m:child c (m:next c (field v child)))))
          (_ unit))))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (initializer-range c locals start half)
          (initializer-range c locals (+ start half) (- count half)))))))

(base:function initializers ((c m:context) (enabled bool)) (pointer u64)
  (match enabled
    (false (cast (pointer u64) (m:empty-env)))
    (true
      ; Each tape identity gets one u64 initializer ID: eight bytes, aligned
      ; to eight bytes on the supported 64-bit compiler hosts. Zero is unknown.
      (let
        ((count u64 (m:nodes-length (deref (field c items))))
         (bytes u64 (* count 8)))
        (match (arena:allocate (field c memory) bytes 8)
          ((allocated p)
           (let
             ((locals
                (pointer u64)
                (cast (pointer u64) (cast (pointer void) p))))
             (do
               (memory:memset (cast (pointer void) locals) 0 bytes)
               (initializer-range c locals 1 (- count 1))
               locals)))
          (_
            (do
              (m:fatal "optimizer initializer storage allocation failed")
              (cast (pointer u64) (m:empty-env)))))))))

; A deliberately small local CSE domain.  Leaves are stable scalar values and
; internal nodes are integer/boolean primitives which cannot read memory, call,
; or fail.  The comparison is used only for the two operands of one primitive:
; the left operand is consequently lowered first and dominates the right.
; This is not a general purity proof or a cross-block value-numbering pass.
(base:function cse-safe
  ((c m:context) (id u64) (fuel u64)) bool
  (match fuel
    (0 false)
    (_
      (let ((v m:node (m:at c id)) (args u64 (m:next c (field v child))))
        (match (field v kind)
          (2 true)
          (3 true)
          (5 (base:not (check:stored-binder c (field v target))))
          (9
            (let ((ty u64 (field (m:at c (field v child)) ty)))
              (base:and-then
                (base:or (== ty 2) (num:integer-type ty))
                (base:and-then
                  (base:or
                    (base:and (>= (field v target) 1) (<= (field v target) 3))
                    (base:and (>= (field v target) 5) (<= (field v target) 15))
                    (== (field v target) 17)
                    (base:and
                      (== (field v target) 16)
                      (num:integer-type (field v ty))))
                  (cse-safe-chain c args (- fuel 1))))))
          (_ false))))))

(base:function cse-safe-chain
  ((c m:context) (id u64) (fuel u64)) bool
  (match id
    (0 true)
    (_
      (base:and-then
        (cse-safe c id fuel)
        (cse-safe-chain c (m:next c id) fuel)))))

; Structural equality is bounded and is invoked only after both candidates
; satisfy CSE-SAFE.  Resolved local binder IDs, types and primitive opcodes keep
; shadowed names and integer widths distinct.
(base:function cse-equal
  ((c m:context) (left u64) (right u64) (fuel u64)) bool
  (match fuel
    (0 false)
    (_
      (let ((a m:node (m:at c left)) (b m:node (m:at c right)))
        (base:and-then
          (base:and
            (== (field a kind) (field b kind))
            (== (field a ty) (field b ty)))
          (match (field a kind)
            (2 (== (field a value) (field b value)))
            (3 (== (field a value) (field b value)))
            (5 (== (field a target) (field b target)))
            (9
              (base:and-then
                (== (field a target) (field b target))
                (cse-equal-chain
                  c
                  (m:next c (field a child))
                  (m:next c (field b child))
                  (- fuel 1))))
            (_ false)))))))

(base:function cse-equal-chain
  ((c m:context) (left u64) (right u64) (fuel u64)) bool
  (match left
    (0 (== right 0))
    (_
      (match right
        (0 false)
        (_
          (base:and-then
            (cse-equal c left right fuel)
            (cse-equal-chain c (m:next c left) (m:next c right) fuel)))))))

; Query the same conservative relation at the precise lowering site.  The
; caller has already emitted LEFT before it asks whether RIGHT can reuse it.
(base:function common-sibling ((c m:context) (id u64)) u64
  (let ((v m:node (m:at c id)))
    (match (field v kind)
      (9
        (let ((left u64 (m:next c (field v child))))
          (match left
            (0 0)
            (_
              (let ((right u64 (m:next c left)))
                (match right
                  (0 0)
                  (_
                    (match (m:next c right)
                      (0
                        (match
                          (base:and-then
                            (cse-safe c left 32)
                            (base:and-then
                              (cse-safe c right 32)
                              (cse-equal c left right 32)))
                          (true left)
                          (false 0)))
                      (_ 0)))))))))
      (_ 0))))

; A discardability proof, not a general purity/movement/duplication summary.
; Unknown nodes and exhausted budgets must keep their original evaluation.
(base:function effect-chain
  ((c m:context) (locals (pointer u64)) (id u64) (fuel u64)) effects
  (match fuel
    (0 (unknown-effects))
    (_
      (match id
        (0 (safe-effects))
        (_
          (let
            ((head effects (effect c locals id (- fuel 1)))
             (tail effects (effect-chain c locals (m:next c id) (- fuel 1))))
            (effects
              (base:and (field head discardable) (field tail discardable))
              (base:and (field head duplicable) (field tail duplicable))
              (base:or (field head reads-memory) (field tail reads-memory))
              (base:or (field head writes-memory) (field tail writes-memory))
              (base:or (field head may-trap) (field tail may-trap))
              (base:or (field head may-diverge) (field tail may-diverge)))))))))

(base:function effect
  ((c m:context) (locals (pointer u64)) (id u64) (fuel u64)) effects
  (match fuel
    (0 (unknown-effects))
    (_
      (let ((v m:node (m:at c id)) (args u64 (m:next c (field v child))))
        (match (field v kind)
          (2 (safe-effects)) ; Integer literal.
          (3 (safe-effects)) ; Boolean literal.
          (4 (safe-effects)) ; Unit literal.
          (17 (safe-effects)) ; Static data literal; no runtime allocation.
          (36 (safe-effects)) ; Floating literal; no runtime arithmetic/conversion.
          (5 ; Reading an immutable SSA local cannot trap or observe memory.
            (match (check:stored-binder c (field v target))
              (true (effects false false true false true false))
              (false (safe-effects))))
          (9 ; Resolved primitive; reject floating point and pointer operations.
            (let ((op u64 (field v target)) (ty u64 (field (m:at c args) ty)))
              (match (base:or (== ty 2) (num:integer-type ty))
                (false (unknown-effects))
                (true
                  (match op
                    (4 ; Division is discardable only when proven to succeed.
                      (match (constant c locals id fuel)
                        ((known value) (effect-chain c locals args (- fuel 1)))
                        ((unknown)
                          (effects false false false false true false))))
                    (_
                      (match
                        (base:or
                          (base:and (>= op 1) (<= op 15))
                          (== op 17)
                          (base:and (== op 16) (num:integer-type (field v ty))))
                        (false (unknown-effects))
                        (true (effect-chain c locals args (- fuel 1))))))))))
          (6 (effect-chain c locals args (- fuel 1)))
          (13 (effect-chain c locals args (- fuel 1)))
          (14 (effect c locals args (- fuel 1)))
          (15 (effect-chain c locals args (- fuel 1)))
          (56 (effect-chain c locals args (- fuel 1)))
          (_ (unknown-effects)))))))

(base:function discardable
  ((c m:context) (locals (pointer u64)) (id u64) (fuel u64)) bool
  (field (effect c locals id fuel) discardable))

; USED must be the reference table from an enabled analysis. Stored locals are
; retained defensively even when no ordinary checked reference was found.
(base:function dead-binding
  ((c m:context)
   (locals (pointer u64))
   (used (pointer u8))
   (id u64)
   (depth u64)) bool
  (let ((name u64 (m:child c id)))
    (base:and-then
      (== (deref (pointer-offset used name)) (cast u8 0))
      (base:not (check:stored-binder c name))
      (discardable c locals (field (m:at c id) target) depth))))

(export
  constant-result
  constant
  known-branch
  known-match
  references
  initializers
  common-sibling
  effects
  effect
  dead-binding)
