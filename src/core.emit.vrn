(import base)
(import core.numeric :as num)
(import core.float :as float)
(import core.constants :as constants)
(import allocator)
(import arena)
(import data)
(import number)
(import libc.string :as cstring)
(import llvm)
(import llvm.types :as t)
(import llvm.core :as ir)
(import llvm.enums :as enum)
(import llvm.target :as target)
(import core.model :as m)
(import core.check :as check)
(import core.layout :as layout)
(import core.cabi :as cabi)
(import core.format :as format)
(import foundation.compat.arithmetic :as n)

; Every checked node/binder/function has a unique syntax index. Its LLVM value
; lives in the matching slot, so lexical shadowing requires no textual names.
; Lowering state borrowing an LLVM session and arena-owned value-handle table.
; Divide is the guarded-division helper. Handles require a live session;
; the generation caller disposes that session after use.
(base:type backend
  (product
    (owner llvm:session)
    (slots (pointer t:value-ref))
    (helpers (pointer t:value-ref))
    (abi cabi:context)))

; Read a previously populated LLVM handle slot using its checked syntax/binder identity.
(base:function get ((b backend) (id u64)) t:value-ref
  (deref (pointer-offset (field b slots) id)))

; Store an LLVM handle under a checked identity and return the same handle.
(base:function put ((b backend) (id u64) (value t:value-ref)) t:value-ref
  (do (store (deref (pointer-offset (field b slots) id)) value) value))

(base:function bind-binder ((c m:context) (b backend) (id u64) (value t:value-ref)) unit
  (match (check:stored-binder c id)
    (false (do (put b id value) unit))
    (true
      (let
        ((ty u64 (field (m:at c id) ty))
         (address
           t:value-ref
           (ir:build-alloca
             (field (field b owner) builder)
             (cabi:storage-type (field b abi) ty)
             "local")))
        (do
          (ir:build-store
            (field (field b owner) builder)
            (cabi:convert (field b abi) ty value true)
            address)
          (put b id address)
          unit)))))

(base:function uses-storage ((c m:context) (id u64)) bool
  (let ((v m:node (m:at c id)))
    (match (field v kind)
      (64 true)
      (5 (check:stored-binder c (field v target)))
      (58 true)
      (14 (uses-storage c (m:next c (field v child))))
      (50 (uses-storage c (m:next c (field v child))))
      (_ false))))

(base:function place-address ((c m:context) (b backend) (id u64)) t:value-ref
  (let
    ((v m:node (m:at c id))
     (args u64 (m:next c (field v child)))
     (owner llvm:session (field b owner))
     (builder t:builder-ref (field owner builder)))
    (match (field v kind)
      (64 (get b (field v target)))
      (5 (get b (field v target)))
      (58 (expression c b args))
      (14
        (ir:struct-gep
          builder
          (cabi:storage-type (field b abi) (field (m:at c args) ty))
          (place-address c b args)
          (base:convert (field v target))
          ""))
      (50
        (let
          ((address t:value-ref (place-address c b args))
           (index t:value-ref (expression c b (m:next c args)))
           (fn t:value-ref (ir:block-parent (ir:builder-block builder)))
           (yes t:block-ref (ir:block-append (field owner context) fn "index.address"))
           (no t:block-ref (ir:block-append (field owner context) fn "index.address.oob")))
          (do
            (ir:build-cond-br
              builder
              (ir:build-icmp
                builder
                enum:int-ult
                index
                (ir:const-int (layout:integer-type owner) (check:array-length c (field v target)) 0)
                "")
              yes
              no)
            (ir:builder-position builder no)
            (llvm:call-1
              builder
              (deref (pointer-offset (field b helpers) 1))
              (source-location c b id))
            (ir:build-unreachable builder)
            (ir:builder-position builder yes)
            (ir:build-gep
              builder
              (cabi:storage-type (field b abi) (field v ty))
              address
              (& index)
              1
              ""))))
      (_ (do (m:fatal "invalid checked place") (get b id))))))

(base:function load-place ((c m:context) (b backend) (id u64)) t:value-ref
  (let
    ((ty u64 (field (m:at c id) ty))
     (address t:value-ref (place-address c b id))
     (value
       t:value-ref
       (ir:build-load
         (field (field b owner) builder)
         (cabi:storage-type (field b abi) ty)
         address
         "")))
    (cabi:convert (field b abi) ty value false)))

(base:function word ((owner llvm:session) (ty u64) (value i64)) t:value-ref
  (ir:const-int (layout:scalar-type owner ty) (base:convert value) 0))

(base:function construct ((c m:context) (b backend) (args u64) (value t:value-ref) (index u32))
  t:value-ref
  (match args
    (0 value)
    (_
      (let
        ((next
           t:value-ref
           (ir:build-insert (field (field b owner) builder) value (expression c b args) index ""))
         (i u32 (base:convert (n:add (base:convert index) 1))))
        (construct c b (m:next c args) next i)))))

; Create an LLVM integer constant from i64, converting to unsigned bits at the C API boundary.
(base:function integer ((owner llvm:session) (value i64)) t:value-ref
  (ir:const-int (layout:integer-type owner) (base:convert value) 0))

; Append a function entry block and move the session's builder to its end.
(base:function entry ((owner llvm:session) (function t:value-ref)) unit
  (do
    (ir:builder-position
      (field owner builder)
      (ir:block-append (field owner context) function "entry"))
    unit))

; Build native code that writes the supplied message to stderr, exits, and cannot return.
; Input message text is borrowed while LLVM copies it into a module-owned global string.
(base:function failure
  ((owner llvm:session)
   (write t:value-ref)
   (exit t:value-ref)
   (strlen t:value-ref)
   (location t:value-ref)
   (message (pointer u8))) unit
  (let
    ((builder t:builder-ref (field owner builder))
     (text t:value-ref (ir:build-global-string builder message "failure")))
    (do
      (llvm:call-3
        builder
        write
        (ir:const-int (ir:int-type (field owner context) constants:native-int-width) 2 0)
        location
        (llvm:call-1 builder strlen location))
      (llvm:call-3
        builder
        write
        (ir:const-int (ir:int-type (field owner context) constants:native-int-width) 2 0)
        text
        (ir:const-int (layout:integer-type owner) (cstring:strlen message) 0))
      (llvm:call-1
        builder
        exit
        (ir:const-int
          (ir:int-type (field owner context) constants:native-int-width)
          (base:convert constants:runtime-failure-status)
          0))
      (ir:build-unreachable builder)
      unit)))

; Declare native write/exit and build the internal guarded signed-division helper.
; Return the module-owned helper function handle for lowering division expressions.
(base:function runtime ((c m:context) (owner llvm:session)) (pointer t:value-ref)
  (let
    ((context t:context-ref (field owner context))
     (module t:module-ref (field owner module))
     (builder t:builder-ref (field owner builder))
     (word-type t:type-ref (layout:integer-type owner))
     (c-int-type t:type-ref (ir:int-type context constants:native-int-width))
     (write-params
       (tuple t:type-ref t:type-ref t:type-ref)
       (tuple c-int-type (ir:pointer-type context 0) word-type))
     (write
       t:value-ref
       (ir:function-add
         module
         "write"
         (ir:function-type
           word-type
           (cast (pointer t:type-ref) (cast (pointer void) (& write-params)))
           3
           0)))
     (exit
       t:value-ref
       (ir:function-add module "exit" (ir:function-type (ir:void-type context) (& c-int-type) 1 0)))
     (pointer-type t:type-ref (ir:pointer-type context 0))
     (strlen
       t:value-ref
       (ir:function-add module "strlen" (ir:function-type word-type (& pointer-type) 1 0)))
     ; Slots zero and one hold strlen and the array failure helper.
     ; Slots 3 through 10 are indexed by integer type.
     (helpers (pointer t:value-ref) (layout:values c 11)))
    (do
      (store (deref helpers) strlen)
      (store (deref (pointer-offset helpers 1)) (array-failure owner write exit strlen))
      (division-helpers owner helpers write exit strlen 3)
      helpers)))

(base:function array-failure
  ((owner llvm:session) (write t:value-ref) (exit t:value-ref) (strlen t:value-ref)) t:value-ref
  (let
    ((context t:context-ref (field owner context))
     (pointer-type t:type-ref (ir:pointer-type context 0))
     (fn
       t:value-ref
       (ir:function-add
         (field owner module)
         "array.failure"
         (ir:function-type (ir:void-type context) (& pointer-type) 1 0))))
    (do
      (ir:linkage-set fn enum:linkage-internal)
      (entry owner fn)
      (failure owner write exit strlen (ir:function-param fn 0) "array index out of bounds\n")
      fn)))

(base:function division-helpers
  ((owner llvm:session)
   (helpers (pointer t:value-ref))
   (write t:value-ref)
   (exit t:value-ref)
   (strlen t:value-ref)
   (ty u64)) unit
  (match (n:gt ty 10)
    (true unit)
    (false
      (do
        (store (deref (pointer-offset helpers ty)) (division-helper owner write exit strlen ty))
        (division-helpers owner helpers write exit strlen (n:add ty 1))))))

(base:function division-helper
  ((owner llvm:session) (write t:value-ref) (exit t:value-ref) (strlen t:value-ref) (ty u64))
  t:value-ref
  (let
    ((context t:context-ref (field owner context))
     (module t:module-ref (field owner module))
     (builder t:builder-ref (field owner builder))
     (word-type t:type-ref (layout:integer-type owner))
     (pointer-type t:type-ref (ir:pointer-type context 0))
     (params (tuple t:type-ref t:type-ref t:type-ref) (tuple word-type word-type pointer-type))
     (divide
       t:value-ref
       (ir:function-add
         module
         "core.div"
         (ir:function-type
           word-type
           (cast (pointer t:type-ref) (cast (pointer void) (& params)))
           3
           0)))
     (start t:block-ref (ir:block-append context divide "entry"))
     (check t:block-ref (ir:block-append context divide "overflow.check"))
     (zero t:block-ref (ir:block-append context divide "zero"))
     (ok t:block-ref (ir:block-append context divide "divide"))
     (x t:value-ref (ir:function-param divide 0))
     (y t:value-ref (ir:function-param divide 1))
     (location t:value-ref (ir:function-param divide 2)))
    (do
      (ir:linkage-set divide enum:linkage-internal)
      (ir:builder-position builder start)
      (ir:build-cond-br
        builder
        (ir:build-icmp builder enum:int-eq y (integer owner 0) "")
        zero
        check)
      (ir:builder-position builder zero)
      (failure owner write exit strlen location "division by zero\n")
      (ir:builder-position builder check)
      (match (num:signed-type ty)
        (false (do (ir:build-br builder ok) unit))
        (true
          (let
            ((minimum i64 (num:normalize ty (num:sign-bit ty)))
             (is-min t:value-ref (ir:build-icmp builder enum:int-eq x (integer owner minimum) ""))
             (is-minus t:value-ref (ir:build-icmp builder enum:int-eq y (integer owner -1) ""))
             (bad t:value-ref (ir:build-and builder is-min is-minus ""))
             (fail t:block-ref (ir:block-append context divide "signed.overflow")))
            (do
              (ir:build-cond-br builder bad fail ok)
              (ir:builder-position builder fail)
              (failure owner write exit strlen location "signed division overflow\n")))))
      (ir:builder-position builder ok)
      (ir:build-ret
        builder
        (match (num:signed-type ty)
          (true (ir:build-sdiv builder x y ""))
          (false (ir:build-udiv builder x y ""))))
      divide)))

; Fill an LLVM parameter-type buffer with the core integer type; return the total count.
(base:function parameter-types
  ((c m:context) (owner llvm:session) (param u64) (out (pointer t:type-ref)) (count u64)) u64
  (match param
    (0 count)
    (_
      (do
        (store
          (deref (pointer-offset out count))
          (layout:value-type c owner (field (m:at c (m:child c param)) ty)))
        (parameter-types c owner (m:next c param) out (n:add count 1))))))

; Declare every checked function before lowering bodies and store its LLVM handle.
; Use numeric names with internal linkage so source names cannot alter native symbols.
(base:function declarations-inner ((c m:context) (b backend) (fn u64)) unit
  (match fn
    (0 unit)
    (_
      (let
        ((owner llvm:session (field b owner))
         (params
           (pointer t:type-ref)
           (cast
             (pointer t:type-ref)
             (cast (pointer void) (layout:values c constants:parameter-limit))))
         (count u64 (parameter-types c owner (m:child c (check:signature c fn)) params 0))
         (size u32 (base:convert count))
         (name data:data (data:empty (arena:allocator (field c memory)))))
        (do
          (m:storage (number:format-u64 fn (& name)))
          (m:storage (data:append (& name) 0))
          (let
            ((function t:value-ref
               (ir:function-add
                 (field owner module)
                 (data:bytes name)
                 (ir:function-type (layout:value-type c owner (field (m:at c fn) ty)) params size 0))))
            (do
              (ir:linkage-set function enum:linkage-internal)
              (put b fn function)
              ; The declaration name's otherwise unused slot caches its native
              ; callback entry point. Every address of this function shares it.
              (put b (m:next c (m:child c fn)) (cast t:value-ref (target:null-pointer)))
              unit))
          (declarations c b (m:next c fn)))))))

; Lower call arguments left to right into the supplied handle buffer; return the final count.
(base:function arguments
  ((c m:context) (b backend) (arg u64) (out (pointer t:value-ref)) (index u64)) u64
  (match arg
    (0 index)
    (_
      (do
        (store (deref (pointer-offset out index)) (expression c b arg))
        (arguments c b (m:next c arg) out (n:add index 1))))))

; Lower each expression in order and return the final value.
(base:function sequence ((c m:context) (b backend) (id u64)) t:value-ref
  (match id
    (0 (integer (field b owner) 0))
    (_
      (let ((value t:value-ref (expression c b id)))
        (match (m:next c id) (0 value) (next (sequence c b next)))))))

; Lower sequential let initializers, associate binder IDs with their LLVM values, then lower the body.
(base:function bindings ((c m:context) (b backend) (id u64) (body u64)) t:value-ref
  (match id
    (0 (sequence c b body))
    (_
      (let ((name u64 (m:child c id)) (init u64 (field (m:at c id) target)))
        (do (bind-binder c b name (expression c b init)) (bindings c b (m:next c id) body))))))

; Build branches and a phi for a checked if expression.
; Use each branch's actual final block so nested conditionals produce valid incoming edges.
(base:function conditional ((c m:context) (b backend) (args u64)) t:value-ref
  (let
    ((owner llvm:session (field b owner))
     (builder t:builder-ref (field owner builder))
     (condition t:value-ref (expression c b args))
     (function t:value-ref (ir:block-parent (ir:builder-block builder)))
     (yes-block t:block-ref (ir:block-append (field owner context) function "then"))
     (no-block t:block-ref (ir:block-append (field owner context) function "else"))
     (end t:block-ref (ir:block-append (field owner context) function "merge")))
    (do
      (ir:build-cond-br
        builder
        (ir:build-icmp builder enum:int-ne condition (integer owner 0) "")
        yes-block
        no-block)
      (ir:builder-position builder yes-block)
      (let
        ((yes t:value-ref (expression c b (m:next c args)))
         (yes-end t:block-ref (ir:builder-block builder)))
        (do
          (ir:build-br builder end)
          (ir:builder-position builder no-block)
          (let
            ((no t:value-ref (expression c b (m:next c (m:next c args))))
             (no-end t:block-ref (ir:builder-block builder)))
            (do
              (ir:build-br builder end)
              (ir:builder-position builder end)
              (let
                ((phi
                   t:value-ref
                   (ir:build-phi
                     builder
                     (layout:value-type c owner (field (m:at c (m:next c args)) ty))
                     "")))
                (do (llvm:incoming phi yes yes-end) (llvm:incoming phi no no-end) phi)))))))))

; Append source-location digits without resetting the existing string.
(base:function append-number ((out (pointer data:data)) (v u64)) unit
  (do
    (match (n:ge v 10) (true (append-number out (n:div v 10))) (false unit))
    (m:storage (data:append out (base:convert (n:add 48 (n:sub v (n:mul (n:div v 10) 10))))))))

; LLVM owns the copied source-location string, including any filename punctuation.
(base:function source-location ((c m:context) (b backend) (id u64)) t:value-ref
  (let
    ((out data:data (data:empty (arena:allocator (field c memory))))
     (pos m:position (m:position 1 1 false)))
    (do
      (let ((offset u64 (field (m:at c id) start)) (start u64 (m:source-start c offset)))
        (m:locate c start (n:sub offset start) (& pos)))
      (m:storage
        (data:assign-bytes
          (& out)
          (data:view
            (m:source-path c (field (m:at c id) start))
            (cstring:strlen (m:source-path c (field (m:at c id) start))))))
      (m:storage (data:append (& out) 58))
      (append-number (& out) (field pos line))
      (m:storage (data:append (& out) 58))
      (append-number (& out) (field pos column))
      (m:storage (data:append (& out) 58))
      (m:storage (data:append (& out) 32))
      (m:storage (data:append (& out) 0))
      (ir:build-global-string (field (field b owner) builder) (data:bytes out) "location"))))

(base:function integer-conversion ((owner llvm:session) (from u64) (to u64) (value t:value-ref))
  t:value-ref
  (let
    ((builder t:builder-ref (field owner builder))
     (target t:type-ref (layout:scalar-type owner to)))
    (base:cond
      ((n:eq (num:width from) (num:width to)) value)
      ((n:gt (num:width from) (num:width to)) (ir:build-trunc builder value target ""))
      ((num:signed-type from) (ir:build-sext builder value target ""))
      (true (ir:build-zext builder value target "")))))

(base:function numeric-conversion ((owner llvm:session) (from u64) (to u64) (value t:value-ref))
  t:value-ref
  (let
    ((builder t:builder-ref (field owner builder))
     (target t:type-ref (layout:scalar-type owner to)))
    (base:cond
      ((num:float-type from)
       (base:cond
         ((n:eq to 12) (ir:build-fptrunc builder value target ""))
         ((n:eq to 13) (ir:build-fpext builder value target ""))
         ((num:signed-type to) (ir:build-fptosi builder value target ""))
         (true (ir:build-fptoui builder value target ""))))
      ((num:float-type to)
       (match (num:signed-type from)
         (true (ir:build-sitofp builder value target ""))
         (false (ir:build-uitofp builder value target ""))))
      (true (integer-conversion owner from to value)))))

; LLVMRealPredicate values. C inequality is true for unordered operands.
(base:function float-predicate ((op u64)) i32
  (match op (5 1) (6 4) (7 5) (8 2) (9 3) (_ 14)))

(base:function float-primitive
  ((owner llvm:session) (op u64) (left t:value-ref) (right t:value-ref)) t:value-ref
  (let ((builder t:builder-ref (field owner builder)))
    (match op
      (1 (ir:build-fadd builder left right ""))
      (2 (ir:build-fsub builder left right ""))
      (3 (ir:build-fmul builder left right ""))
      (4 (ir:build-fdiv builder left right ""))
      (_
        (ir:build-zext
          builder
          (ir:build-fcmp builder (float-predicate op) left right "")
          (layout:integer-type owner)
          "")))))

(base:function predicate ((op u64) (signed bool)) i32
  (match op
    (5 enum:int-eq)
    (10 enum:int-ne)
    (18 enum:int-eq)
    (19 enum:int-ne)
    (6 (match signed (true enum:int-slt) (false enum:int-ult)))
    (7 (match signed (true enum:int-sle) (false enum:int-ule)))
    (8 (match signed (true enum:int-sgt) (false enum:int-ugt)))
    (_ (match signed (true enum:int-sge) (false enum:int-uge)))))

(base:function primitive
  ((c m:context) (b backend) (id u64) (op u64) (ty u64) (left t:value-ref) (right t:value-ref))
  t:value-ref
  (let ((owner llvm:session (field b owner)) (builder t:builder-ref (field owner builder)))
    (match op
      (1 (ir:build-add builder left right ""))
      (2 (ir:build-sub builder left right ""))
      (3 (ir:build-mul builder left right ""))
      (4
        (let
          ((wide u64 (match (num:signed-type ty) (true 3) (false 10)))
           (result
             t:value-ref
             (llvm:call-3
               builder
               (deref (pointer-offset (field b helpers) ty))
               (integer-conversion owner ty wide left)
               (integer-conversion owner ty wide right)
               (source-location c b id))))
          (integer-conversion owner wide ty result)))
      (11 (ir:build-and builder left right ""))
      (12 (ir:build-or builder left right ""))
      (13 (ir:build-xor builder left right ""))
      (14 (ir:build-shl builder left (shift-count owner ty right) ""))
      (15
        (match (num:signed-type ty)
          (true (ir:build-ashr builder left (shift-count owner ty right) ""))
          (false (ir:build-lshr builder left (shift-count owner ty right) ""))))
      (_
        (ir:build-zext
          builder
          (ir:build-icmp builder (predicate op (num:signed-type ty)) left right "")
          (layout:integer-type owner)
          "")))))

(base:function shift-count ((owner llvm:session) (ty u64) (value t:value-ref)) t:value-ref
  (ir:build-urem (field owner builder) value (word owner ty (base:convert (num:width ty))) ""))

(base:function indirect-call ((c m:context) (b backend) (v m:node) (args u64)) t:value-ref
  (match (cabi:compatible c (field v target))
    (false (indirect-private c b v args))
    (true
      (let
        ((descriptor m:node (m:at c (field v target)))
         (callee t:value-ref (expression c b (field v child)))
         (buffer (pointer t:value-ref) (layout:values c constants:parameter-limit))
         (count u64 (arguments c b args buffer 0)))
        (cabi:call (field b abi) callee (field descriptor child) (field descriptor target) buffer)))))

(base:function indirect-private ((c m:context) (b backend) (v m:node) (args u64)) t:value-ref
  (let
    ((owner llvm:session (field b owner))
     (descriptor m:node (m:at c (field v target)))
     (callee t:value-ref (expression c b (field v child)))
     (params
       (pointer t:type-ref)
       (cast (pointer t:type-ref) (cast (pointer void) (layout:values c constants:parameter-limit))))
     (types u32 (layout:component-types c owner (field descriptor child) params 0))
     (result
       t:type-ref
       (match (field descriptor target)
         (14 (ir:void-type (field owner context)))
         (ty (layout:value-type c owner ty))))
     (signature t:type-ref (ir:function-type result params types 0))
     (buffer (pointer t:value-ref) (layout:values c constants:parameter-limit))
     (count u32 (base:convert (arguments c b args buffer 0)))
     (value t:value-ref (ir:build-call (field owner builder) signature callee buffer count "")))
    (match (field descriptor target) (14 (integer owner 0)) (_ value))))

(base:function array-storage ((owner llvm:session) (ty t:type-ref) (value t:value-ref)) t:value-ref
  (let
    ((builder t:builder-ref (field owner builder))
     (address t:value-ref (ir:build-alloca builder ty "")))
    (do (ir:build-store builder value address) address)))

(base:function array-load
  ((owner llvm:session)
   (ty t:type-ref)
   (element t:type-ref)
   (address t:value-ref)
   (offset t:value-ref)) t:value-ref
  (let
    ((builder t:builder-ref (field owner builder))
