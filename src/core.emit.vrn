     (end t:block-ref (ir:block-append (field owner context) fn "array.report.end")))
    (do
      (report-text b print "array(")
      (ir:build-cond-br
        builder
        (ir:build-icmp builder enum:int-eq length (integer owner 0) "")
        end
        loop-block)
      (ir:builder-position builder loop-block)
      (let ((index t:value-ref (ir:build-phi builder (layout:integer-type owner) "")))
        (do
          (llvm:incoming index (integer owner 0) start)
          (ir:build-cond-br
            builder
            (ir:build-icmp builder enum:int-eq index (integer owner 0) "")
            item
            separator)
          (ir:builder-position builder separator)
          (report-text b print ",")
          (ir:build-br builder item)
          (ir:builder-position builder item)
          (report-value c b print element (array-load owner array element-type address index))
          (let
            ((next t:value-ref (ir:build-add builder index (integer owner 1) ""))
             (last t:block-ref (ir:builder-block builder)))
            (do
              (ir:build-cond-br
                builder
                (ir:build-icmp builder enum:int-ult next length "")
                loop-block
                end)
              (llvm:incoming index next last)))
          (ir:builder-position builder end)
          (report-text b print ")"))))))

(base:function report-value
  ((c m:context) (b backend) (print t:value-ref) (ty u64) (value t:value-ref)) unit
  (let ((owner llvm:session (field b owner)) (builder t:builder-ref (field owner builder)))
    (match ty
      (1 (report-text b print "unit"))
      (2
        (do
          (llvm:call-2 builder print (ir:build-global-string builder "bool:%lld" "format") value)
          unit))
      (3
        (do
          (llvm:call-2 builder print (ir:build-global-string builder "i64:%lld" "format") value)
          unit))
      (11
        (do
          (llvm:call-3
            builder
            print
            (ir:build-global-string builder "data:%llu:%s" "format")
            (llvm:call-1 builder (deref (field b helpers)) value)
            value)
          unit))
      (12 (report-float b print ty value))
      (13 (report-float b print ty value))
      (_
        (match (num:integer-type ty)
          (true
            (do
              (report-text b print (num:name ty))
              (report-text b print ":")
              (llvm:call-2
                builder
                print
                (ir:build-global-string
                  builder
                  (match (num:signed-type ty) (true "%lld") (false "%llu"))
                  "format")
                (integer-conversion owner ty (match (num:signed-type ty) (true 3) (false 10)) value))
              unit))
          (false
            (match (check:type-kind c ty)
              (34 (report-text b print "pointer"))
              (49 (report-array c b print ty value))
              (21
                (let
                  ((function t:value-ref (ir:block-parent (ir:builder-block builder)))
                   (end t:block-ref (ir:block-append (field owner context) function "report.end")))
                  (do
                    (report-cases
                      c
                      b
                      print
                      ty
                      (check:type-components c ty)
                      value
                      (ir:build-extract builder value 0 "")
                      end)
                    (ir:builder-position builder end))))
              (_
                (let ((head data:data (format:prefix c ty 0)))
                  (do
                    (report-text b print (data:bytes head))
                    (report-components c b print (check:type-components c ty) value 0)
                    (report-text b print ")")))))))))))

; Build a module containing runtime helpers, checked functions, and a native main wrapper.
; The wrapper either reports the full result or returns its low byte.
; The caller owns and must destroy the returned session.
(base:function build ((c m:context) (all u64) (main u64) (report bool)) llvm:session
  (let
    ((owner llvm:session (llvm:create "verona.core"))
     (b
       backend
       (backend
         owner
         (layout:values c (tuple-get (deref (field c items)) 1))
         (runtime c owner)
         (cabi:create c owner))))
    (do
      (external-declarations c b all)
      (declarations c b all)
      (constants c b all)
      (native-exports c b all)
      (callback-addresses c b 1 (n:sub (m:nodes-length (deref (field c items))) 1))
      (bodies c b all)
      (match main
        (0 unit)
        (_
          (let
            ((i32 t:type-ref (ir:int-type (field owner context) constants:native-int-width))
             (command-line bool (check:command-line-main c main))
             (params
               (tuple t:type-ref t:type-ref)
               (tuple i32 (ir:pointer-type (field owner context) 0)))
             (function t:value-ref
               (ir:function-add
                 (field owner module)
                 "main"
                 (ir:function-type
                   i32
                   (cast (pointer t:type-ref) (cast (pointer void) (& params)))
                   (match command-line (true 2) (false 0))
                   0)))
             (builder t:builder-ref (field owner builder)))
            (do
              (entry owner function)
              (let
                ((result
                   t:value-ref
                   (match command-line
                     (true
                       (llvm:call-2
                         builder
                         (get b main)
                         (ir:function-param function 0)
                         (ir:function-param function 1)))
                     (false (llvm:call-0 builder (get b main))))))
                (match report
                  (true
                    (let
                      ((pointer-type t:type-ref (ir:pointer-type (field owner context) 0))
                       (print
                         t:value-ref
                         (cabi:native-function
                           (field b abi)
                           "printf"
                           (ir:function-type i32 (& pointer-type) 1 1)))
                       (format t:value-ref (ir:build-global-string builder "\n" "result")))
                      (do
                        (report-value c b print (field (m:at c main) ty) result)
                        (llvm:call-1 builder print format)
                        (ir:build-ret builder (ir:const-int i32 0 0))
                        unit)))
                  (false
                    (do
                      (ir:build-ret
                        builder
                        (match command-line
                          (true result)
                          (false
                            (match (num:integer-type (field (m:at c main) ty))
                              (true
                                (ir:build-zext
                                  builder
                                  (match (num:width (field (m:at c main) ty))
                                    (8 result)
                                    (_
                                      (ir:build-trunc
                                        builder
                                        result
                                        (ir:int-type
                                          (field owner context)
                                          constants:exit-status-width)
                                        "")))
                                  i32
                                  ""))
                              (false (ir:const-int i32 0 0))))))
                      unit))))
              unit))))
      (cabi:destroy (field b abi))
      owner)))

(export build)
