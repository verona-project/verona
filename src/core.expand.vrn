(base:function form ((c m:context) (id u64)) bool
  (let ((head u64 (m:child c id)))
    (base:cond
      ((== (field (m:at c id) kind) 1)
       (match (check:atom c head)
         (true (match (check:integer-node c head) (true false) (false true)))
         (false false)))
      (true false))))

(base:function validate-forms ((c m:context) (id u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (m:require c id (form c id) "expected a flat list of top-level forms")
        (validate-forms c (m:next c id))))))

; The reference compiler rehydrates every plain macro result in the invocation
; module. Copy shared templates and caller syntax before assigning that scope,
; retaining source spans for diagnostics.
(base:function result-tree ((c m:context) (id u64) (owner u64)) u64
  (match id
    (0 0)
    (_
      (let
        ((v m:node (m:at c id))
         (child u64 (result-tree c (field v child) owner))
         (next u64 (result-tree c (field v next) owner)))
        (m:add
          c
          (m:node
            (field v kind)
            (field v start)
            (field v length)
            child
            next
            0
            0
            ; Rehydration creates new source forms, including repeated unquotes.
            (match (field v kind) (1 0) (_ (field v value)))
            (field v generated)
            (+ owner 1)))))))

(base:function rehydrate ((c m:context) (value u64) (owner u64)) u64
  (let ((v m:node (m:at c value)) (child u64 (result-tree c (field v child) owner)))
    (m:add
      c
      (m:node
        (field v kind)
        (field v start)
        (field v length)
        child
        0
        0
        0
        (field v value)
        (field v generated)
        (+ owner 1)))))

; Generated declaration roots retain the invocation's location and module.
(base:function expand-results
  ((c m:context) (site m:node) (id u64) (fuel u64) (first (pointer u64)) (tail (pointer u64))) unit
  (match id
    (0 unit)
    (_
      (let
        ((root
           u64
           (m:add c (m:node 1 (field site start) (field site length) (m:child c id) 0 0 0 0 0 0))))
        (do (expand c root fuel first tail) (expand-results c site (m:next c id) fuel first tail))))))

(base:function append-declaration
  ((c m:context) (root u64) (first (pointer u64)) (tail (pointer u64))) unit
  (let ((v m:node (m:at c root)))
    (do
      (m:set c root (m:node 1 (field v start) (field v length) (field v child) 0 0 0 0 0 0))
      (match (deref tail) (0 (store (deref first) root)) (_ (m:link c (deref tail) root)))
      (store (deref tail) root)
      unit)))

(base:function expand
  ((c m:context) (root u64) (fuel u64) (first (pointer u64)) (tail (pointer u64))) unit
  (let ((head u64 (m:child c root)) (macro u64 (lookup c head)))
    (base:cond
      ((> macro 0)
       (do
         (m:require c root (> fuel 0) "macro expansion limit exceeded")
         (let
           ((params u64 (m:next c (m:next c (m:child c macro))))
            (args u64 (m:next c head))
            (v m:node (m:at c root))
            (remaining u64 (- fuel 1))
            (budget u64 100000))
           (do
             (check-arguments c root (m:child c params) args)
             (let
               ((value
                  u64
                  (invoke c (m:owner c root) root macro args (evaluation (& budget) 0 false)))
                (result u64 (attach c value (result-tree c (m:child c value) (m:owner c root)) 0)))
               (do
                 (m:require
                   c
                   root
                   (== (field (m:at c result) kind) 1)
                   "expected a top-level form or list of forms")
                 (match (form c result)
                   (true
                     (do
                       (m:set
                         c
                         root
                         (m:node 1 (field v start) (field v length) (m:child c result) 0 0 0 0 0 0))
                       (expand c root remaining first tail)))
                   (false
                     (do
                       (validate-forms c (m:child c result))
                       (expand-results c v (m:child c result) remaining first tail))))))))))
      ((m:is c head "%macro") (install c root))
      ; The seed installs the first source-defined macro, which can shadow it.
      ((m:is c head "macro") (install c root))
      ((base:or
         (state-operation c head)
         (m:is c head "let")
         (m:is c head "cond")
         (m:is c head "and")
         (m:is c head "or"))
       (let ((budget u64 100000))
         (do (eval c (m:owner c root) root (m:empty-env) (evaluation (& budget) 0 false)) unit)))
      (true (append-declaration c root first tail)))))

(base:function declaration ((c m:context) (root u64) (first (pointer u64)) (tail (pointer u64)))
  unit
  (expand c root expansion-limit first tail))

; Expand only the outer expression. The checker requests nested executable
; positions lazily, so patterns, type syntax, and unused templates are untouched.
(base:function expression-loop ((c m:context) (id u64) (fuel u64) (budget (pointer u64))) unit
  (match (field (m:at c id) kind)
    (1
      (let ((macro u64 (lookup c (m:child c id))))
        (match macro
          (0 unit)
          (_
            (do
              (m:require c id (> fuel 0) "macro expansion limit exceeded")
              (let
                ((site m:node (m:at c id))
                 (value
                   u64
                   (invoke
                     c
                     (m:owner c id)
                     id
                     macro
                     (m:next c (field site child))
                     (evaluation budget 0 false)))
                 (result
                   u64
                   (attach
                     c
                     value
                     (result-tree c (m:child c value) (m:owner c id))
                     (field site next)))
                 (v m:node (m:at c result)))
                (do
                  (m:set
                    c
                    id
                    (m:node
                      (field v kind)
                      (field v start)
                      (field v length)
                      (field v child)
                      (field site next)
                      0
                      0
                      (field v value)
                      (field v generated)
                      (+ (m:owner c id) 1)))
                  (expression-loop c id (- fuel 1) budget))))))))
    (_ unit)))

(base:function cached-expansion ((c m:context) (entry u64) (origin u64) (config evaluation)) u64
  (match entry
    (0 0)
    (_
      (do
        (tick c origin config)
        (match (== (m:child c entry) origin)
          (true (field (m:at c entry) target))
          (false (cached-expansion c (m:next c entry) origin config)))))))

(base:function expression ((c m:context) (id u64)) unit
  (let ((budget u64 100000) (site m:node (m:at c id)))
    (match
      (match (== (field site kind) 1)
        (true
          (match (m:is-empty (field c session))
            (true false)
            (false (> (lookup c (field site child)) 0))))
        (false false))
      (false (expression-loop c id expansion-limit (& budget)))
      (true
        (let
          ((session (pointer m:module-session) (cast (pointer m:module-session) (field c session)))
           (origin u64 (match (field site value) (0 id) (value (base:convert value))))
           (cached
             u64
             (cached-expansion
               c
               (field (deref session) expansions)
               origin
               (evaluation (& budget) 0 false))))
          (match cached
            (0
              (do
                (expression-loop c id expansion-limit (& budget))
                ; Detach siblings, and keep source identities on nested generated
                ; forms before any checker mutates the expanded expression.
                (let
                  ((copy u64 (m:copy-tree c (attach c id (m:child c id) 0)))
                   (entry
                     u64
                     (m:add
                       c
                       (m:node
                         67
                         (field site start)
                         0
                         origin
                         (field (deref session) expansions)
                         0
                         copy
                         0
                         0
                         0))))
                  (do
                    (store
                      (deref session)
                      (m:module-session
                        (field (deref session) files)
                        (field (deref session) edges)
                        (field (deref session) state)
                        entry
                        (field (deref session) configuration)
                        (field (deref session) macros)))
                    unit))))
            (_
              (let ((copy u64 (m:copy-tree c cached)) (v m:node (m:at c copy)))
                (do
                  (m:set
                    c
                    id
                    (m:node
                      (field v kind)
                      (field v start)
                      (field v length)
                      (field v child)
                      (field site next)
                      0
                      0
                      (field v value)
                      (field v generated)
                      (field v lookup-module)))
                  unit)))))))))

(export declaration expression)
