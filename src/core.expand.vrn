    (base:convert
      (syntax:character-byte
        (pointer-offset (field (field c source) bytes) (+ (field v start) 2))
        (- (field v length) 2)))))

(base:function floating-value ((c m:context) (id u64)) i64
  (let ((copy u64 (attach c id 0 0))) (do (float:parse c copy 13) (field (m:at c copy) value))))

(base:function unit-p ((c m:context) (id u64)) bool
  (let ((v m:node (m:at c id)))
    (match (== (field v kind) 0)
      (true (match (field v generated) (0 (m:is c id "unit")) (_ false)))
      (false false))))

(base:function qualified-value ((c m:context) (id u64)) bool
