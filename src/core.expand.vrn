              (m:require c site (< start end) "invalid numeric string")
              (let
                ((trimmed
                   data:view
                   (data:view (pointer-offset (field text bytes) start) (- end start)))
                 (first u8 (deref (field trimmed bytes)))
                 (skip u64 (match first (43 1) (45 1) (_ 0))))
