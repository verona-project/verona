          (true (boolean-value c site value))
          (false (eval-logical c module site (m:next c args) env config and)))))))

(base:function eval-items
  ((c m:context) (module u64) (args u64) (env (pointer void)) (config evaluation)) u64
  (match args
    (0 0)
    (_
      (let
        ((value u64 (eval c module args env config))
         (next u64 (eval-items c module (m:next c args) env config)))
        (attach c value (m:child c value) next)))))

; Reductions construct calls, as in the reference compiler; they never invoke
; HEAD. Copy sibling links so shared input lists and accumulators stay immutable.
(base:function reduction-call ((c m:context) (site u64) (head u64) (left u64) (right u64)) u64
  (let
    ((last u64 (attach c right (m:child c right) 0))
     (first u64 (attach c left (m:child c left) last)))
    (list-value c site (attach c head (m:child c head) first))))

(base:function reverse-reduction-items ((c m:context) (items u64) (tail u64) (config evaluation))
  u64
  ; Sibling traversal consumes steps without nesting evaluator calls.
  (match items
    (0 tail)
    (_
      (do
        (tick c items config)
        (let ((next u64 (attach c items (m:child c items) tail)))
          (reverse-reduction-items c (m:next c items) next config))))))

(base:function reduction-items
  ((c m:context) (site u64) (head u64) (initial u64) (items u64) (right bool) (config evaluation))
  u64
  (match items
    (0 initial)
    (_
      (do
        (tick c items config)
        (let
          ((next
             u64
             (match right
               (true (reduction-call c site head items initial))
               (false (reduction-call c site head initial items)))))
          (reduction-items c site head next (m:next c items) right config))))))

(base:function eval-reduction
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (right bool)) u64
  (do
    (m:require c site (check:arity c args 3) "compile-time reduction requires three arguments")
    (let
      ((head u64 (eval c module args env config))
       (initial u64 (eval c module (m:next c args) env config))
       (values u64 (eval c module (m:next c (m:next c args)) env config)))
      (do
        (m:require
          c
          args
          (match (check:atom c head)
            (true
              (base:and
                (base:not (check:integer-node c head))
                (base:not (boolean-p c head))
                (base:not (unit-p c head))))
            (false false))
          "compile-time reduction requires a callable name")
        (require-list c site values)
        ; All evaluator values are finite S-expression syntax. No host objects
        ; or improper/cyclic list values can enter these constructors.
        (let
          ((items
             u64
             (match right
               (true (reverse-reduction-items c (m:child c values) 0 config))
               (false (m:child c values)))))
          (reduction-items c site head initial items right config))))))

(base:function equal-items ((c m:context) (left u64) (right u64) (config evaluation)) bool
  (match left
    (0 (== right 0))
