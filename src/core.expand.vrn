    (match
      (base:or (== split (field v start)) (== split (+ (field v start) (field v length))))
      (true false)
      (false true))))

(base:function equal-value ((c m:context) (left u64) (right u64) (config evaluation)) bool
  (base:cond
    ((boolean-p c left)
     (match (boolean-p c right)
       (false false)
       (true
         (match (condition c left left)
           (true (condition c right right))
           (false (base:not (condition c right right)))))))
    ((boolean-p c right) false)
    ((unit-p c left) (unit-p c right))
    ((unit-p c right) false)
    ((== (syntax-kind c left) 1)
     (match (== (syntax-kind c right) 1)
       (false false)
       (true (equal-items c (m:child c left) (m:child c right) config))))
    ((== (syntax-kind c right) 1) false)
    ((check:integer-node c left)
     (match (check:integer-node c right) (false false) (true (equal-integers c left right))))
    ((check:integer-node c right) false)
    ((== (syntax-kind c left) (syntax-kind c right))
     (match (syntax-kind c left)
       (0
         (match (qualified-value c left)
           (true (match (qualified-value c right) (true (m:same c left right)) (false false)))
           (false (match (qualified-value c right) (true false) (false (m:same c left right))))))
       (25 (data:equal (data-value c left) (data-value c right)))
       (26 (== (character-value c left) (character-value c right)))
       (35 (== (floating-value c left) (floating-value c right)))
       (28 (equal-value c (operand c left) (operand c right) (tick c left config)))
       (29 (equal-value c (operand c left) (operand c right) (tick c left config)))
       (30 (equal-value c (operand c left) (operand c right) (tick c left config)))
       (31 (equal-value c (operand c left) (operand c right) (tick c left config)))
       (_ (m:same c left right))))
    (true false)))

; Internal state keys use kind 66 for a canonical module/member pair. Entry
; nodes use kind 65: child=key, target=value (zero when removed), next=entry.
; None of these nodes enter the semantic declaration chain.
(base:function state-operation ((c m:context) (head u64)) bool
  (base:or
    (m:is c head "compiler:state-ref")
    (m:is c head "compiler:state-has?")
    (m:is c head "compiler:state-set!")
    (m:is c head "compiler:state-remove!")))

(base:function state-module
  ((c m:context)
   (module u64)
   (site u64)
   (name data:view)
   (index u64)
   (found u64)
   (self bool)
   (config evaluation)) u64
  (let
    ((session m:module-session (deref (cast (pointer m:module-session) (field c session))))
     (edges m:imports-array (deref (field session edges))))
    (match (>= index (m:imports-length edges))
      (true (do (m:require c site (> found 0) "unknown state module qualifier") (- found 1)))
      (false
        (let
          ((edge m:import-info (deref (pointer-offset (tuple-get edges 0) index)))
           (target u64 (+ (field edge target) 1)))
          (do
            (tick c site config)
            (match
              (base:and
                (== module (field edge owner))
                (base:or
                  (data:equal name (m:spelling c (field edge alias)))
                  (data:equal name (module-name c (field edge target)))))
              (false (state-module c module site name (+ index 1) found self config))
              (true
                (do
                  (m:require
                    c
                    site
                    (base:and (base:not self) (base:or (== found 0) (== found target)))
                    "ambiguous state module qualifier")
                  (state-module c module site name (+ index 1) target self config))))))))))

(base:function module-name ((c m:context) (id u64)) data:view
  (let ((name (pointer u8) (field (m:file-info c id) name))) (data:view name (cstring:strlen name))))

(base:function snapshot-items
  ((c m:context) (module u64) (items u64) (key bool) (config evaluation)) u64
  (match items
    (0 0)
    (_
      (let
        ((value u64 (snapshot c module items key config))
         (next u64 (snapshot-items c module (m:next c items) key config)))
        (attach c value (m:child c value) next)))))

(base:function snapshot ((c m:context) (module u64) (id u64) (key bool) (config evaluation)) u64
  (let ((next evaluation (tick c id config)) (v m:node (m:at c id)))
    (match
      (match key
        (true (match (check:atom c id) (true (qualified-value c id)) (false false)))
        (false false))
      (true
        (let
          ((split u64 (check:name-colon c id))
           (member u64 (+ split 1))
           (name
             data:view
             (data:view
               (pointer-offset (field (field c source) bytes) (field v start))
               (- split (field v start))))
           (self bool (data:equal name (module-name c module)))
           (owner
             u64
             (state-module
               c
               module
               id
               name
               0
               (match self (true (+ module 1)) (false 0))
               self
               next)))
          (m:add
            c
            (m:node
              66
              member
              (- (+ (field v start) (field v length)) member)
              0
              0
              0
              owner
              0
              0
              0))))
      (false (attach c id (snapshot-items c module (field v child) key next) 0)))))

; Collection/state key equality follows the reference's plain data equality.
; Floating-point keys distinguish signed zero, rather than using runtime =.
(base:function key-items-equal ((c m:context) (left u64) (right u64) (config evaluation)) bool
  (match left
    (0 (== right 0))
    (_
      (match right
        (0 false)
        (_
          (match (key-equal c left right config)
            (false false)
            (true (key-items-equal c (m:next c left) (m:next c right) config))))))))

(base:function key-equal ((c m:context) (left u64) (right u64) (config evaluation)) bool
  (let ((next evaluation (tick c left config)) (kind u64 (syntax-kind c left)))
    (match (== kind (syntax-kind c right))
      (false (equal-value c left right next))
      (true
        (match kind
          (66
            (base:and
              (== (field (m:at c left) target) (field (m:at c right) target))
              (m:same c left right)))
          (1 (key-items-equal c (m:child c left) (m:child c right) next))
          (35 (== (floating-value c left) (floating-value c right)))
          (28 (key-equal c (operand c left) (operand c right) next))
          (29 (key-equal c (operand c left) (operand c right) next))
          (30 (key-equal c (operand c left) (operand c right) next))
          (31 (key-equal c (operand c left) (operand c right) next))
          (_ (equal-value c left right next)))))))

(base:function state-find ((c m:context) (id u64) (key u64) (config evaluation)) u64
  (match id
    (0 0)
    (_
      (do
        (tick c key config)
        (match (key-equal c key (m:child c id) config)
          (true id)
          (false (state-find c (m:next c id) key config)))))))

(base:function eval-state
  ((c m:context)
   (module u64)
   (site u64)
   (head u64)
   (args u64)
   (env (pointer void))
   (config evaluation)) u64
  (let
    ((set bool (m:is c head "compiler:state-set!")) (ref bool (m:is c head "compiler:state-ref")))
    (do
      (m:require
        c
        site
        (match set
          (true (check:arity c args 2))
          (false (base:or (check:arity c args 1) (base:and ref (check:arity c args 2)))))
        "invalid compiler state operation arity")
      (let
        ((input u64 (eval c module args env config))
         (value
           u64
           (match (m:next c args) (0 (list-value c site 0)) (id (eval c module id env config)))))
        (do
          (m:require
            c
            site
            (base:not (m:is-empty (field c session)))
            "compiler context operation requires an active compilation session")
          (let
            ((session
               (pointer m:module-session)
               (cast (pointer m:module-session) (field c session)))
             (key u64 (snapshot c module input true config))
             (entry u64 (state-find c (field (deref session) state) key config))
             (old u64 (match entry (0 0) (_ (field (m:at c entry) target)))))
            (base:cond
              (set
                (let ((stored u64 (snapshot c module value false config)))
                  (do
                    (match entry
                      (0
                        (store
                          (deref session)
                          (m:module-session
                            (field (deref session) files)
                            (field (deref session) edges)
                            (m:add
                              c
                              (m:node
                                65
                                (field (m:at c site) start)
                                0
                                key
                                (field (deref session) state)
                                0
                                stored
                                0
                                0
                                0))
                            (field (deref session) expansions)
                            (field (deref session) configuration)
                            (field (deref session) macros))))
                      (_ (do (m:typed c entry 65 0 stored 0) unit)))
                    (snapshot c module stored false config))))
              (ref (snapshot c module (match old (0 value) (_ old)) false config))
              ((m:is c head "compiler:state-has?") (boolean-value c site (> old 0)))
              (true
                (do
                  (match entry (0 unit) (_ (do (m:typed c entry 65 0 0 0) unit)))
                  (boolean-value c site (> old 0)))))))))))

(base:function index-digits
  ((c m:context) (site u64) (start u64) (count u64) (value (pointer u64)) (config evaluation)) unit
  (match count
    (0 unit)
    (1
      (let
        ((byte u64 (m:spelling-byte c site (- start (field (m:at c site) start))))
         (digit u64 (- byte 48)))
        (do
          (tick c site config)
          (m:require c site (check:digit byte) "list index out of bounds")
          (m:require
            c
            site
            (<= (deref value) (/ (- (cast u64 18446744073709551615) digit) (cast u64 10)))
            "list index out of bounds")
          (store (deref value) (+ (* (deref value) 10) digit))
          unit)))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (index-digits c site start half value config)
          (index-digits c site (+ start half) (- count half) value config))))))

(base:function nth-item ((c m:context) (site u64) (items u64) (index u64) (config evaluation)) u64
  (do
    (tick c site config)
    (m:require c site (> items 0) "list index out of bounds")
    (match index
      (0 (attach c items (m:child c items) 0))
      (_ (nth-item c site (m:next c items) (- index 1) config)))))

(base:function eval-nth
  ((c m:context) (module u64) (site u64) (args u64) (env (pointer void)) (config evaluation)) u64
  (do
    (m:require c site (check:arity c args 2) "nth requires two arguments")
    (let
      ((index u64 (eval c module args env config))
       (values u64 (require-list c site (eval c module (m:next c args) env config)))
       (v m:node (m:at c index))
       (value u64 0))
      (do
        (m:require c site (check:integer-node c index) "list index out of bounds")
        (let
          ((sign u64 (m:spelling-byte c index 0))
           (start
             u64
             (match sign
               (43 (+ (field v start) 1))
               (45 (+ (field v start) 1))
               (_ (field v start)))))
          (do
            (index-digits
              c
              index
              start
              (- (+ (field v start) (field v length)) start)
              (& value)
              config)
            (m:require
              c
              site
              (base:or (base:not (== sign 45)) (== value 0))
              "list index out of bounds")
            (nth-item c site (m:child c values) value config)))))))

(base:function plist-search ((c m:context) (site u64) (items u64) (key u64) (config evaluation)) u64
  (match items
    (0 0)
    (_
      (let ((value u64 (m:next c items)))
        (do
          (tick c site config)
          (m:require c site (> value 0) "property list requires key/value pairs")
          (match (key-equal c items key config)
            (true value)
            (false (plist-search c site (m:next c value) key config))))))))

(base:function plist-shape ((c m:context) (site u64) (items u64) (config evaluation)) unit
  (match items
    (0 unit)
    (_
      (let ((value u64 (m:next c items)))
        (do
          (tick c site config)
          (m:require c site (> value 0) "property list requires key/value pairs")
          (plist-shape c site (m:next c value) config))))))

(base:function validate-plist ((c m:context) (site u64) (items u64) (config evaluation)) unit
  (match items
    (0 unit)
    (_
      (let ((value u64 (m:next c items)))
        (do
          (tick c site config)
          (m:require c site (> value 0) "property list requires key/value pairs")
          (m:require
            c
            site
            (== (plist-search c site (m:next c value) items config) 0)
            "duplicate collection key")
          (validate-plist c site (m:next c value) config))))))

(base:function eval-plist-ref
  ((c m:context) (module u64) (site u64) (args u64) (env (pointer void)) (config evaluation)) u64
  (do
    (m:require
      c
      site
      (base:or (check:arity c args 2) (check:arity c args 3))
      "invalid collection operation arity")
    (let
      ((value u64 (eval c module args env config))
       (key u64 (eval c module (m:next c args) env config))
       (last u64 (m:next c (m:next c args)))
       (default u64 (match last (0 (list-value c site 0)) (_ (eval c module last env config)))))
      (do
        (require-list c site value)
        (plist-shape c site (m:child c value) config)
        (validate-plist c site (m:child c value) config)
        (let ((found u64 (plist-search c site (m:child c value) key config)))
          (match found (0 default) (_ (attach c found (m:child c found) 0))))))))

(base:function invoke-parameters
  ((c m:context)
   (module u64)
   (param u64)
   (args u64)
   (body u64)
   (env (pointer void))
   (config evaluation)) u64
  (match param
    (0 (eval c module body env config))
    (_
      (match (m:is c param "&rest")
        (true
          (let ((binding m:binding (m:binding (m:next c param) (list-value c param args) 0 env)))
            (eval c module body (cast (pointer void) (& binding)) config)))
        (false
          (let ((binding m:binding (m:binding param args 0 env)))
            (invoke-parameters
              c
              module
              (m:next c param)
              (m:next c args)
              body
              (cast (pointer void) (& binding))
              config)))))))

(base:function invoke
  ((c m:context) (module u64) (site u64) (macro u64) (args u64) (config evaluation)) u64
  (let ((params u64 (m:next c (m:next c (m:child c macro)))) (values u64 (quoted-items c args)))
    (do
      (check-arguments c site (m:child c params) args)
      (invoke-parameters c module (m:child c params) values (m:next c params) (m:empty-env) config))))

(base:function append-view ((c m:context) (out (pointer data:data)) (text data:view)) unit
  (let ((start u64 (data:length (deref out))))
    (do
      (m:storage (data:resize out (+ start (field text length))))
      (allocator:copy-bytes
        (pointer-offset (data:bytes (deref out)) start)
        (field text bytes)
        (field text length)))))

; Computed literals own their spelling in the compilation arena while retaining
; the invocation location. Kind 69 distinguishes numeric text from generated names.
(base:function text-node ((c m:context) (site u64) (kind u64) (text data:view)) u64
  (let ((out data:data (data:empty (arena:allocator (field c memory)))) (v m:node (m:at c site)))
    (do
      (m:storage (data:assign-bytes (& out) text))
      (m:add
        c
        (m:node
          kind
          (field v start)
          (field text length)
          0
          0
          0
          0
          0
          (m:address (cast (pointer void) (data:bytes out)))
          (field v lookup-module))))))

(base:function decimal-digits ((out (pointer data:data)) (value u64)) unit
  (do
    (match (>= value 10) (true (decimal-digits out (/ value 10))) (false unit))
    (m:storage
      (data:append out (base:convert (+ 48 (- value (* (/ value 10) 10))))))))

(base:function unsigned-value ((c m:context) (site u64) (value u64)) u64
  (let ((out data:data (data:empty (arena:allocator (field c memory)))))
    (do (decimal-digits (& out) value) (text-node c site 69 (data:borrow out)))))

(base:function encoded-bytes
  ((c m:context)
   (site u64)
   (out (pointer data:data))
   (bytes (pointer u8))
   (count u64)
   (config evaluation)) unit
  (match count
    (0 unit)
    (1
      (let ((byte u8 (deref bytes)))
        (do
          (tick c site config)
          (match byte
            (10 (do (m:storage (data:append out 92)) (m:storage (data:append out 110))))
            (9 (do (m:storage (data:append out 92)) (m:storage (data:append out 116))))
            (34 (do (m:storage (data:append out 92)) (m:storage (data:append out 34))))
            (92 (do (m:storage (data:append out 92)) (m:storage (data:append out 92))))
            (_ (m:storage (data:append out byte)))))))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (encoded-bytes c site out bytes half config)
          (encoded-bytes c site out (pointer-offset bytes half) (- count half) config))))))

(base:function string-value ((c m:context) (site u64) (text data:view) (config evaluation)) u64
  (let ((out data:data (data:empty (arena:allocator (field c memory)))))
    (do
      (m:storage (data:append (& out) 34))
      (encoded-bytes c site (& out) (field text bytes) (field text length) config)
      (m:storage (data:append (& out) 34))
      (text-node c site 25 (data:borrow out)))))

(base:function string-input ((c m:context) (site u64) (id u64)) data:view
  (do (m:require c site (== (syntax-kind c id) 25) "expected a string") (data-value c id)))

(base:function callable-name ((c m:context) (value u64)) bool
  (base:and
    (check:atom c value)
    (base:not (check:integer-node c value))
    (base:not (boolean-p c value))
    (base:not (unit-p c value))))

(base:function list-size ((c m:context) (items u64) (config evaluation)) u64
  (match items (0 0) (_ (do (tick c items config) (+ 1 (list-size c (m:next c items) config))))))

(base:function symbol-input ((c m:context) (site u64) (id u64)) data:view
  (do
    (m:require
      c
      site
      (base:and (callable-name c id) (base:not (qualified-value c id)))
      "symbol-name requires a symbol")
    (m:spelling c id)))

(base:function keyword-p ((c m:context) (id u64)) bool
  (match (base:and (callable-name c id) (base:not (qualified-value c id)))
    (false false)
    (true
      (let ((name data:view (m:spelling c id)))
        (base:and-then
          (> (field name length) 1)
          (== (deref (field name bytes)) (cast u8 58)))))))

(base:function map-arguments
  ((c m:context) (site u64) (lists u64) (advance bool) (config evaluation)) u64
  (match lists
    (0 0)
    (_
      (let ((list u64 (require-list c site lists)) (item u64 (m:child c list)))
        (do
          (tick c site config)
          (m:require c site (> item 0) "compiler:map requires lists of equal length")
          (let
            ((value
               u64
               (match advance
                 (true (list-value c site (m:next c item)))
                 (false (attach c item (m:child c item) 0)))))
            (attach
              c
              value
              (m:child c value)
              (map-arguments c site (m:next c lists) advance config))))))))

(base:function empty-lists ((c m:context) (site u64) (lists u64) (config evaluation)) unit
  (match lists
    (0 unit)
    (_
      (do
        (tick c site config)
        (m:require
          c
          site
          (== (m:child c (require-list c site lists)) 0)
          "compiler:map requires lists of equal length")
        (empty-lists c site (m:next c lists) config)))))

(base:function map-calls ((c m:context) (site u64) (head u64) (lists u64) (config evaluation)) u64
  (let ((first u64 (m:child c (require-list c site lists))))
    (match first
      (0 (do (empty-lists c site lists config) 0))
      (_
        (let
          ((args u64 (map-arguments c site lists false config))
           (rest u64 (map-arguments c site lists true config))
           (call u64 (list-value c site (attach c head (m:child c head) args)))
           (tail u64 (map-calls c site head rest config)))
          (attach c call (m:child c call) tail))))))

(base:function append-lists ((c m:context) (site u64) (lists u64) (config evaluation)) u64
  (match lists
    (0 0)
    (_
      (let ((value u64 (require-list c site lists)))
        (do
          (tick c site config)
          (copy-items c (m:child c value) (append-lists c site (m:next c lists) config) config))))))

(base:function copy-items ((c m:context) (items u64) (tail u64) (config evaluation)) u64
  (match items
    (0 tail)
    (_
      (do
        (tick c items config)
        (attach c items (m:child c items) (copy-items c (m:next c items) tail config))))))

(base:function index-value ((c m:context) (site u64) (id u64) (config evaluation)) u64
  (let
    ((v m:node (m:at c id))
     (value u64 0)
     (sign u64 (m:spelling-byte c id 0))
     (skip u64 (match sign (43 1) (45 1) (_ 0))))
    (do
      (m:require c site (check:integer-node c id) "list index out of bounds")
      (index-digits
        c
        id
        (+ (field v start) skip)
        (- (field v length) skip)
        (& value)
        config)
      (m:require
        c
        site
        (base:or (base:not (== sign 45)) (== value 0))
        "list index out of bounds")
      value)))

(base:function slice-items
  ((c m:context) (site u64) (items u64) (count u64) (take bool) (config evaluation)) u64
  (match count
    (0 (match take (true 0) (false (copy-items c items 0 config))))
    (_
      (do
        (tick c site config)
        (m:require c site (> items 0) "list index out of bounds")
        (let ((rest u64 (slice-items c site (m:next c items) (- count 1) take config)))
          (match take (true (attach c items (m:child c items) rest)) (false rest)))))))

; Dispatch codes are internal, independent of semantic primitive opcodes.
(base:function helper-code ((c m:context) (head u64)) u64
  (base:cond
    ((m:is c head "definitions") 1)
    ((m:is c head "compiler:call") 2)
    ((m:is c head "compiler:map") 3)
    ((base:or (m:is c head "compiler:reverse") (m:is c head "reverse")) 4)
    ((base:or (m:is c head "symbol") (m:is c head "keyword")) 5)
    ((m:is c head "symbol-name") 6)
    ((m:is c head "keyword-concat") 7)
    ((m:is c head "append") 8)
    ((m:is c head "length") 9)
    ((m:is c head "take") 10)
    ((m:is c head "drop") 11)
    ((m:is c head "number?") 12)
    ((m:is c head "integer?") 13)
    ((m:is c head "string?") 14)
    ((m:is c head "symbol?") 15)
    ((m:is c head "keyword?") 16)
    ((m:is c head "list?") 17)
    ((m:is c head "boolean?") 18)
    ((m:is c head "keyword-name") 19)
    ((m:is c head "symbol->keyword") 20)
    ((m:is c head "keyword->symbol") 21)
    (true 0)))

(base:function helper-call
  ((c m:context)
   (module u64)
   (site u64)
   (head u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (code u64)) u64
  (match code
    (7 (symbol-concat c module site args env config))
    (_
      (let
        ((values u64 (eval-items c module args env config))
         (first u64 values)
         (second u64 (m:next c values)))
        (base:cond
          ((== code 1) (list-value c site values))
          ((== code 2)
           (do
             (m:require c site (> first 0) "compiler:call requires a callable name")
             (m:require c site (callable-name c first) "compiler:call requires a callable name")
             (list-value c site (copy-items c values 0 config))))
          ((== code 3)
           (do
             (m:require
               c
               site
               (base:and (> first 0) (> second 0))
               "compiler:map requires a head and at least one proper list")
             (m:require c site (callable-name c first) "compiler:map requires a callable name")
             (list-value c site (map-calls c site first second config))))
          ((== code 8) (list-value c site (append-lists c site values config)))
          ((base:or (== code 10) (== code 11))
           (do
             (m:require c site (check:arity c values 2) "list slice requires two arguments")
             (require-list c site second)
             (list-value
               c
               site
               (slice-items
                 c
                 site
                 (m:child c second)
                 (index-value c site first config)
                 (== code 10)
                 config))))
          (true
            (do
              (m:require
                c
                site
                (check:arity c values 1)
                "compile-time helper requires one argument")
              (base:cond
                ((== code 4)
                 (list-value
                   c
                   site
                   (reverse-reduction-items c (m:child c (require-list c site first)) 0 config)))
                ((== code 5)
                 (let ((text data:view (string-input c site first)))
                   (do
                     (m:require
                       c
                       site
                       (> (field text length) 0)
                       "symbol requires a non-empty string")
                     (text-node c site 0 text))))
                ((== code 6) (string-value c site (symbol-input c site first) config))
                ((== code 9)
                 (unsigned-value
                   c
                   site
                   (match (syntax-kind c first)
                     (25 (field (data-value c first) length))
                     (_ (list-size c (m:child c (require-list c site first)) config)))))
                ((== code 12)
                 (boolean-value
                   c
                   site
                   (base:or (check:integer-node c first) (== (syntax-kind c first) 35))))
                ((== code 13) (boolean-value c site (check:integer-node c first)))
                ((== code 14) (boolean-value c site (== (syntax-kind c first) 25)))
                ((== code 15) (boolean-value c site (callable-name c first)))
                ((== code 16) (boolean-value c site (keyword-p c first)))
                ((== code 17) (boolean-value c site (== (syntax-kind c first) 1)))
                ((== code 18) (boolean-value c site (boolean-p c first)))
                (true
                  (let ((name data:view (symbol-input c site first)))
                    (base:cond
                      ((== code 20)
                       (match (keyword-p c first)
                         (true (attach c first 0 0))
                         (false
                           (let ((out data:data (data:empty (arena:allocator (field c memory)))))
                             (do
                               (m:storage (data:append (& out) 58))
                               (append-view c (& out) name)
                               (text-node c site 0 (data:borrow out)))))))
                      (true
                        (do
                          (m:require c site (keyword-p c first) "expected a colon-prefixed keyword")
                          (let
                            ((text
                               data:view
                               (data:view
                                 (pointer-offset (field name bytes) 1)
                                 (- (field name length) 1))))
                            (match code
                              (19 (string-value c site text config))
                              (_ (text-node c site 0 text)))))))))))))))))

(base:function string-code ((c m:context) (head u64)) u64
  (base:cond
    ((m:is c head "string-concat") 1)
    ((m:is c head "string-length") 2)
    ((m:is c head "substring") 3)
    ((m:is c head "string=") 4)
    ((m:is c head "string-prefix?") 5)
    ((m:is c head "string-suffix?") 6)
    ((m:is c head "string-split") 7)
    ((m:is c head "string-join") 8)
    ((m:is c head "string-replace") 9)
    (true 0)))

(base:function join-strings
  ((c m:context)
   (site u64)
   (items u64)
   (separator data:view)
   (out (pointer data:data))
   (config evaluation)) unit
  (match items
    (0 unit)
    (_
      (do
        (tick c site config)
        (append-view c out (string-input c site items))
        (match (m:next c items) (0 unit) (_ (append-view c out separator)))
        (join-strings c site (m:next c items) separator out config)))))

(base:function matching-bytes
  ((c m:context) (site u64) (a (pointer u8)) (b (pointer u8)) (count u64) (config evaluation)) bool
  (match count
    (0 true)
    (1 (do (tick c site config) (== (deref a) (deref b))))
    (_
      (let ((half u64 (/ count 2)))
        (base:and-then
          (matching-bytes c site a b half config)
          (matching-bytes
            c
            site
            (pointer-offset a half)
            (pointer-offset b half)
            (- count half)
            config))))))

(base:function find-substring
  ((c m:context) (site u64) (text data:view) (part data:view) (start u64) (config evaluation)) u64
  (do
    (tick c site config)
    (match (> (field part length) (- (field text length) start))
      (true (field text length))
      (false
        (match
          (matching-bytes
            c
            site
            (pointer-offset (field text bytes) start)
            (field part bytes)
            (field part length)
            config)
          (true start)
          (false (find-substring c site text part (+ start 1) config)))))))

(base:function split-string
  ((c m:context) (site u64) (text data:view) (separator data:view) (start u64) (config evaluation))
  u64
  (let
    ((end u64 (find-substring c site text separator start config))
     (item
       u64
       (string-value
         c
         site
         (data:view (pointer-offset (field text bytes) start) (- end start))
         config))
     (rest
       u64
       (match (== end (field text length))
         (true 0)
         (false (split-string c site text separator (+ end (field separator length)) config)))))
    (attach c item 0 rest)))

(base:function string-call
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (code u64)) u64
  (let
    ((values u64 (eval-items c module args env config))
     (first u64 values)
     (second u64 (m:next c values))
     (third u64 (m:next c second)))
    (base:cond
      ((== code 1)
       (let ((out data:data (data:empty (arena:allocator (field c memory)))))
         (do
           (join-strings c site values (data:view "" 0) (& out) config)
           (string-value c site (data:borrow out) config))))
      ((== code 2)
       (do
         (m:require c site (check:arity c values 1) "string-length requires one argument")
         (unsigned-value c site (field (string-input c site first) length))))
      ((== code 3)
       (do
         (m:require
           c
           site
           (base:or (check:arity c values 2) (check:arity c values 3))
           "substring requires a string and bounds")
         (let
           ((text data:view (string-input c site first))
            (start u64 (index-value c site second config))
            (end u64 (match third (0 (field text length)) (_ (index-value c site third config)))))
           (do
             (m:require
               c
               site
               (base:and (<= start end) (<= end (field text length)))
               "substring bounds out of range")
             (string-value
               c
               site
               (data:view (pointer-offset (field text bytes) start) (- end start))
               config)))))
      ((== code 8)
       (do
         (m:require c site (check:arity c values 2) "string-join requires two arguments")
         (let
           ((items u64 (m:child c (require-list c site first)))
            (separator data:view (string-input c site second))
            (out data:data (data:empty (arena:allocator (field c memory)))))
           (do
             (join-strings c site items separator (& out) config)
             (string-value c site (data:borrow out) config)))))
      (true
        (do
          (m:require
            c
            site
            (check:arity c values (match code (9 3) (_ 2)))
            "invalid string operation arity")
          (let
            ((left data:view (string-input c site first))
             (right data:view (string-input c site second)))
            (base:cond
              ((== code 4) (boolean-value c site (data:equal left right)))
              ((base:or (== code 5) (== code 6))
               (boolean-value
                 c
                 site
                 (base:and-then
                   (<= (field left length) (field right length))
                   (matching-bytes
                     c
                     site
                     (field left bytes)
                     (pointer-offset
                       (field right bytes)
                       (match code
                         (5 (cast u64 0))
                         (_ (- (field right length) (field left length)))))
                     (field left length)
                     config))))
              (true
                (do
                  (m:require c site (> (field right length) 0) "separator must not be empty")
                  (let ((items u64 (split-string c site left right 0 config)))
                    (match code
                      (7 (list-value c site items))
                      (_
                        (let
                          ((replacement data:view (string-input c site third))
                           (out data:data (data:empty (arena:allocator (field c memory)))))
                          (do
                            (join-strings c site items replacement (& out) config)
                            (string-value c site (data:borrow out) config)))))))))))))))

(base:function collection-code ((c m:context) (head u64)) u64
  (base:cond
    ((m:is c head "plist-ref") 1)
    ((m:is c head "plist-has?") 2)
    ((m:is c head "plist-set") 3)
    ((m:is c head "plist-remove") 4)
    ((m:is c head "plist-keys") 5)
    ((m:is c head "alist-ref") 11)
    ((m:is c head "alist-has?") 12)
    ((m:is c head "alist-set") 13)
    ((m:is c head "alist-remove") 14)
    ((m:is c head "alist-keys") 15)
    ((m:is c head "alist-values") 16)
    (true 0)))

(base:function collection-entries
  ((c m:context) (site u64) (items u64) (plist bool) (config evaluation)) u64
  (match items
    (0 0)
    (_
      (do
        (tick c site config)
        (let
          ((key u64 (match plist (true items) (false (m:child c (require-list c site items)))))
           (value u64 (m:next c key))
           (rest u64 (match plist (true (m:next c value)) (false (m:next c items)))))
          (do
            (m:require
              c
              site
              (> value 0)
              (match plist
                (true "property list requires key/value pairs")
                (false "association list entries require two elements")))
            (m:require
              c
              site
              (base:or plist (check:arity c key 2))
              "association list entries require two elements")
            (let
              ((pair
                 u64
                 (list-value
                   c
                   site
                   (attach c key (m:child c key) (attach c value (m:child c value) 0)))))
              (attach c pair (m:child c pair) (collection-entries c site rest plist config)))))))))

(base:function entry-find ((c m:context) (entries u64) (key u64) (config evaluation)) u64
  (match entries
    (0 0)
    (_
      (do
        (tick c entries config)
        (match (key-equal c (m:child c entries) key config)
          (true entries)
          (false (entry-find c (m:next c entries) key config)))))))

(base:function validate-entries ((c m:context) (site u64) (entries u64) (config evaluation)) unit
  (match entries
    (0 unit)
    (_
      (do
        (tick c site config)
        (m:require
          c
          site
          (== (entry-find c (m:next c entries) (m:child c entries) config) 0)
          "duplicate collection key")
        (validate-entries c site (m:next c entries) config)))))

(base:function collect-output
  ((c m:context) (site u64) (entries u64) (plist bool) (config evaluation)) u64
  (match entries
    (0 0)
    (_
      (let ((rest u64 (collect-output c site (m:next c entries) plist config)))
        (do
          (tick c site config)
          (match plist
            (true (copy-items c (m:child c entries) rest config))
            (false (attach c entries (m:child c entries) rest))))))))

(base:function collect-components
  ((c m:context) (site u64) (entries u64) (values bool) (config evaluation)) u64
  (match entries
    (0 0)
    (_
      (let
        ((key u64 (m:child c entries)) (value u64 (match values (true (m:next c key)) (false key))))
        (do
          (tick c site config)
          (attach
            c
            value
            (m:child c value)
            (collect-components c site (m:next c entries) values config)))))))

(base:function update-entries
  ((c m:context) (site u64) (entries u64) (key u64) (value u64) (remove bool) (config evaluation))
  u64
  (do
    (tick c site config)
    (match entries
      (0
        (match remove
          (true 0)
          (false
            (list-value c site (attach c key (m:child c key) (attach c value (m:child c value) 0))))))
      (_
        (match (key-equal c (m:child c entries) key config)
          (true
            (match remove
              (true (copy-items c (m:next c entries) 0 config))
              (false
                (let
                  ((pair
                     u64
                     (list-value
                       c
                       site
                       (attach c key (m:child c key) (attach c value (m:child c value) 0)))))
                  (attach c pair (m:child c pair) (copy-items c (m:next c entries) 0 config))))))
          (false
            (attach
              c
              entries
              (m:child c entries)
              (update-entries c site (m:next c entries) key value remove config))))))))

(base:function collection-call
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (code u64)) u64
  (let
    ((values u64 (eval-items c module args env config))
     (operation u64 (match (> code 10) (true (- code 10)) (false code)))
     (plist bool (< code 10)))
    (do
      (m:require
        c
        site
        (match operation
          (1 (base:or (check:arity c values 2) (check:arity c values 3)))
          (3 (check:arity c values 3))
          (5 (check:arity c values 1))
          (6 (check:arity c values 1))
          (_ (check:arity c values 2)))
        "invalid collection operation arity")
      (let
        ((entries
           u64
           (collection-entries c site (m:child c (require-list c site values)) plist config))
         (key u64 (m:next c values))
         (value u64 (m:next c key)))
        (do
          (validate-entries c site entries config)
          (match operation
            (1
              (let ((entry u64 (entry-find c entries key config)))
                (match entry
                  (0
                    (match value (0 (list-value c site 0)) (_ (attach c value (m:child c value) 0))))
                  (_
                    (let ((found u64 (m:next c (m:child c entry))))
                      (attach c found (m:child c found) 0))))))
            (2 (boolean-value c site (> (entry-find c entries key config) 0)))
            (5 (list-value c site (collect-components c site entries false config)))
            (6 (list-value c site (collect-components c site entries true config)))
            (_
              (list-value
                c
                site
                (collect-output
                  c
                  site
                  (update-entries c site entries key value (== operation 4) config)
                  plist
                  config)))))))))

(base:function context-code ((c m:context) (head u64)) u64
  (base:cond
    ((m:is c head "compiler:feature?") 1)
    ((m:is c head "compiler:features") 2)
    ((m:is c head "compiler:target-info") 3)
    (true 0)))

(base:function contains-value ((c m:context) (items u64) (value u64) (config evaluation)) bool
  (match items
    (0 false)
    (_
      (do
        (tick c items config)
        (base:or-else
          (equal-value c items value config)
          (contains-value c (m:next c items) value config))))))

(base:function feature-value ((c m:context) (site u64) (text (pointer u8)) (config evaluation)) u64
  (let ((copy (pointer u8) (info:copy (field c memory) (data:view text (cstring:strlen text)))))
    (do
      (info:lower copy (cstring:strlen copy))
      (string-value c site (data:view copy (cstring:strlen copy)) config))))

(base:function feature-extras
  ((c m:context) (site u64) (head (pointer void)) (items u64) (config evaluation)) u64
  (match (m:is-empty head)
    (true items)
    (false
      (let
        ((link syntax:feature (deref (cast (pointer syntax:feature) head)))
         (value u64 (feature-value c site (field link name) config)))
        (do
          (tick c site config)
          (feature-extras
            c
            site
            (field link next)
            (match (contains-value c items value config)
              (true items)
              (false (copy-items c items (attach c value 0 0) config)))
            config))))))

(base:function effective-features ((c m:context) (site u64) (config evaluation)) u64
  (let
    ((facts syntax:features (info:reader-features c))
     (format
       (pointer u8)
       (match (info:equal (field facts platform) "darwin") (true "macho") (false "elf")))
     (items
       u64
       (attach
         c
         (feature-value c site (field facts platform) config)
         0
         (attach
           c
           (feature-value c site (field facts architecture) config)
           0
           (attach
             c
             (feature-value c site "pointer_64" config)
             0
             (attach
               c
               (feature-value c site "little_endian" config)
               0
               (attach c (feature-value c site format config) 0 0)))))))
    (feature-extras c site (field facts extra) items config)))

(base:function info-pair ((c m:context) (site u64) (key (pointer u8)) (value u64) (next u64)) u64
  (attach
    c
    (text-node c site 0 (data:view key (cstring:strlen key)))
    0
    (attach c value (m:child c value) next)))

(base:function target-values ((c m:context) (site u64) (config evaluation)) u64
  (let ((pointer (pointer void) (info:from-context c)) (absent u64 (list-value c site 0)))
    (match (m:is-empty pointer)
      (true
        (list-value
          c
          site
          (info-pair
            c
            site
            ":triple"
            absent
            (info-pair
              c
              site
              ":cpu"
              absent
              (info-pair
                c
                site
                ":pointer-width"
                absent
                (info-pair
                  c
                  site
                  ":data-layout"
                  absent
                  (info-pair c site ":object-format" absent 0)))))))
      (false
        (let
          ((target info:configuration (deref (cast (pointer info:configuration) pointer)))
           (object
             (pointer u8)
             (match (info:equal (field target platform) "darwin") (true "macho") (false "elf"))))
          (list-value
            c
            site
            (info-pair
              c
              site
              ":triple"
              (feature-value c site (field target triple) config)
              (info-pair
                c
                site
                ":cpu"
                (feature-value c site (field target cpu) config)
                (info-pair
                  c
                  site
                  ":pointer-width"
                  (unsigned-value c site 64)
                  (info-pair
                    c
                    site
                    ":data-layout"
                    (string-value
                      c
                      site
                      (data:view (field target layout) (cstring:strlen (field target layout)))
                      config)
                    (info-pair c site ":object-format" (feature-value c site object config) 0)))))))))))

(base:function context-call
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (code u64)) u64
  (do
    (m:require
      c
      site
      (base:not (m:is-empty (field c session)))
      "compiler context operation requires an active compilation session")
    (m:require
      c
      site
      (check:arity c args (match code (1 1) (_ 0)))
      "invalid compiler context arity")
    (match code
      (1
        (let
          ((value u64 (eval c module args env config))
           (name
             data:view
             (match (syntax-kind c value) (25 (data-value c value)) (_ (symbol-input c site value))))
           (text (pointer u8) (info:copy (field c memory) name)))
          (do
            (info:lower text (field name length))
            (boolean-value
              c
              site
              (contains-value
                c
                (effective-features c site config)
                (string-value c site (data:view text (field name length)) config)
                config)))))
      (2 (list-value c site (effective-features c site config)))
      (_ (target-values c site config)))))

(base:function numeric-code ((c m:context) (head u64)) u64
  (base:cond
    ((m:is c head "+") 1)
    ((m:is c head "-") 2)
    ((m:is c head "*") 3)
    ((m:is c head "/") 4)
    ((m:is c head "quotient") 5)
    ((m:is c head "remainder") 6)
    ((m:is c head "min") 7)
    ((m:is c head "max") 8)
    ((m:is c head "abs") 9)
    ((m:is c head "==") 10)
    ((m:is c head "/=") 11)
    ((m:is c head "<") 12)
    ((m:is c head "<=") 13)
    ((m:is c head ">") 14)
    ((m:is c head ">=") 15)
    (true 0)))

(base:function integer-result ((c m:context) (site u64) (value big:number) (config evaluation)) u64
  (text-node c site 69 (big:text (big:work c site (field config steps)) value)))

(base:function float-result ((c m:context) (site u64) (bits i64)) u64
  (let ((v m:node (m:at c site)))
    (do
      (m:require
        c
        site
        (float:finite 13 (base:convert bits))
        "compile-time floating-point overflow")
      (m:add c (m:node 71 (field v start) (field v length) 0 0 0 0 bits 0 (field v lookup-module))))))

(base:function numeric-float ((c m:context) (site u64) (id u64)) i64
  (let ((copy u64 (attach c id 0 0)))
    (do
      (m:require c site (== (float:parse c copy 13) 13) "compile-time floating-point overflow")
      (field (m:at c copy) value))))

(base:function numeric-inputs ((c m:context) (site u64) (items u64) (config evaluation)) bool
  (match items
    (0 true)
    (_
      (do
        (tick c site config)
        (m:require
          c
          site
          (base:or (check:integer-node c items) (== (syntax-kind c items) 35))
          "expected an integer or floating-point number")
        (let ((rest bool (numeric-inputs c site (m:next c items) config)))
          (base:and (check:integer-node c items) rest))))))

(base:function numeric-test
  ((c m:context) (site u64) (left u64) (right u64) (config evaluation) (code u64)) bool
  (match (base:and (check:integer-node c left) (check:integer-node c right))
    (true
      (let
        ((w big:work (big:work c site (field config steps)))
         (comparison i32 (big:compare w (big:parse w left) (big:parse w right))))
        (match code
          (10 (%=-primitive-i32 comparison 0))
          (11 (%/=-primitive-i32 comparison 0))
          (12 (%<-primitive-i32 comparison 0))
          (13 (%<=-primitive-i32 comparison 0))
          (14 (%>-primitive-i32 comparison 0))
          (_ (%>=-primitive-i32 comparison 0)))))
    (false
      (float:compare
        (match code (10 5) (11 0) (12 6) (13 7) (14 8) (_ 9))
        13
        (numeric-float c site left)
        (numeric-float c site right)))))

(base:function distinct-from ((c m:context) (site u64) (item u64) (rest u64) (config evaluation))
  bool
  (match rest
    (0 true)
    (_
      (do
        (tick c site config)
        (base:and-then
          (numeric-test c site item rest config 11)
          (distinct-from c site item (m:next c rest) config))))))

(base:function numeric-comparison
  ((c m:context) (site u64) (items u64) (config evaluation) (code u64)) bool
  (let ((rest u64 (m:next c items)))
    (match rest
      (0 true)
      (_
        (base:and-then
          (match code
            (11 (distinct-from c site items rest config))
            (_ (numeric-test c site items rest config code)))
          (numeric-comparison c site rest config code))))))

(base:function numeric-fold
  ((c m:context)
   (site u64)
   (items u64)
   (current u64)
   (config evaluation)
   (code u64)
   (integers bool)) u64
  (match items
    (0 current)
    (_
      (let
        ((w big:work (big:work c site (field config steps)))
         (value
           u64
           (match integers
             (true
               (let ((a big:number (big:parse w current)) (b big:number (big:parse w items)))
                 (match code
                   (1 (integer-result c site (big:add w a b) config))
                   (2 (integer-result c site (big:add w a (big:negate b)) config))
                   (3 (integer-result c site (big:multiply w a b) config))
                   (7 (match (big:compare w a b) (1 items) (_ current)))
                   (_ (match (big:compare w a b) (-1 items) (_ current))))))
             (false
               (let ((a i64 (numeric-float c site current)) (b i64 (numeric-float c site items)))
                 (base:cond
                   ((== code 7)
                    (float-result c site (match (float:compare 6 13 a b) (true a) (false b))))
                   ((== code 8)
                    (float-result c site (match (float:compare 8 13 a b) (true a) (false b))))
                   (true
                     (do
                       (m:require
                         c
                         site
                         (base:or (base:not (== code 4)) (base:not (float:compare 5 13 b 0)))
                         "division by zero")
                       (float-result c site (float:arithmetic code 13 a b))))))))))
        (numeric-fold c site (m:next c items) value config code integers)))))

(base:function fraction-digits
  ((c m:context)
   (site u64)
   (remainder big:number)
   (denominator big:number)
   (ten big:number)
   (out (pointer data:data))
   (count u64)
   (config evaluation)) unit
  (match (big:zero remainder)
    (true unit)
    (false
      (match count
        ; A nonzero sticky digit preserves the direction of rounding at any
        ; binary64 midpoint after its terminating decimal expansion.
        (0 (m:storage (data:append out 49)))
        (_
          (let
            ((w big:work (big:work c site (field config steps)))
             (part
               (tuple big:number big:number)
               (big:divide w (big:multiply w remainder ten) denominator))
             (digit data:view (big:text w (tuple-get part 0))))
            (do
              (m:storage (data:append out (deref (field digit bytes))))
              (fraction-digits c site (tuple-get part 1) denominator ten out (- count 1) config))))))))

(base:function integer-division
  ((c m:context) (site u64) (numerator u64) (denominator u64) (config evaluation) (code u64)) u64
  (let
    ((w big:work (big:work c site (field config steps)))
     (a big:number (big:parse w numerator))
     (b big:number (big:parse w denominator))
     (parts (tuple big:number big:number) (big:divide w a b))
     (q big:number (tuple-get parts 0))
     (r big:number (tuple-get parts 1)))
    (base:cond
      ((== code 5) (integer-result c site q config))
      ((== code 6) (integer-result c site r config))
      ((big:zero r) (integer-result c site q config))
      (true
        (let
          ((out data:data (data:empty (arena:allocator (field c memory))))
           (ten big:number (big:parse w (unsigned-value c site 10)))
           (negative
             bool
             (base:not
               (==
                 (match (field a negative) (true (cast i32 1)) (false (cast i32 0)))
                 (match (field b negative) (true (cast i32 1)) (false (cast i32 0)))))))
          (do
            (match negative (true (m:storage (data:append (& out) 45))) (false unit))
            (append-view c (& out) (big:text w (big:number false (field q digits))))
            (m:storage (data:append (& out) 46))
            (fraction-digits
              c
              site
              (big:number false (field r digits))
              (big:number false (field b digits))
              ten
              (& out)
              1100
              config)
