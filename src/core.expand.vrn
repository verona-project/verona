(base:constant expansion-limit u64 256)

; Shared evaluation budget across helper macros, unquotes, and local bodies.
(base:type evaluation (product (steps (pointer u64)) (depth u64) (unquote bool)))

(base:function tick ((c m:context) (site u64) (config evaluation)) evaluation
  (do
    (m:require
      c
      site
      (> (deref (field config steps)) 0)
      "compile-time evaluation step limit exceeded")
    (m:require
      c
      site
      (< (field config depth) 256)
      "compile-time evaluation depth limit exceeded")
    (store (deref (field config steps)) (- (deref (field config steps)) 1))
    (evaluation (field config steps) (+ (field config depth) 1) (field config unquote))))

(base:function lookup ((c m:context) (head u64)) u64
  (match (check:atom c head)
    (false 0)
    (true
      (let
        ((v m:node (m:at c head))
         (owner u64 (m:owner c head))
         (end u64 (+ (field v start) (field v length)))
         (colon u64 (check:name-colon c head)))
        (match (== colon end)
          (true (check:macro-in c owner (m:spelling c head)))
          (false
            (let
              ((bytes (pointer u8) (field (field c source) bytes))
               (target
                 u64
                 (match (m:is-empty (field c session))
                   (true 0)
                   (false
                     (check:import-target
                       c
                       owner
                       (data:view
                         (pointer-offset bytes (field v start))
                         (- colon (field v start)))
                       0))))
               (member u64 (+ colon 1))
               (name data:view (data:view (pointer-offset bytes member) (- end member))))
              (match target
                (0 0)
                (_
                  (let ((id u64 (- target 1)) (exports u64 (field (m:file-info c id) exports)))
                    (match (check:exported c (m:next c (m:child c exports)) name)
                      (true (check:macro-in c id name))
                      (false 0))))))))))))

(base:function parameters ((c m:context) (param u64)) unit
  (match param
    (0 unit)
    (_
      (match (m:is c param "&rest")
        (true
          (m:require
            c
            param
            (match (check:arity c param 2) (true (check:atom c (m:next c param))) (false false))
            "&rest requires a final parameter"))
        (false
          (do
            (m:require c param (check:atom c param) "expected macro parameter")
            (parameters c (m:next c param))))))))

(base:function install ((c m:context) (root u64)) unit
  (let ((head u64 (m:child c root)) (name u64 (m:next c head)) (params u64 (m:next c name)))
    (do
      (m:require c root (check:arity c head 4) "macro requires a name, parameters, and one body")
      (m:require c name (check:atom c name) "expected macro name")
      (m:require c params (== (field (m:at c params) kind) 1) "expected macro parameter list")
      (parameters c (m:child c params))
      (let ((id u64 (attach c root head 0)))
        (do
          (m:typed c id 27 0 0 0)
          (match (m:is-empty (field c session))
            (true unit)
            (false
              (let
                ((session
                   (pointer m:module-session)
                   (cast (pointer m:module-session) (field c session)))
                 (v m:module-session (deref session))
                 (entry
                   u64
                   (m:add
                     c
                     (m:node
                       70
                       (field (m:at c id) start)
                       0
                       id
                       (field v macros)
                       0
                       (m:owner c id)
                       0
                       0
                       0))))
                (do
                  (store
                    (deref session)
                    (m:module-session
                      (field v files)
                      (field v edges)
                      (field v state)
                      (field v expansions)
                      (field v configuration)
                      entry))
                  unit)))))))))

(base:function list-value ((c m:context) (site u64) (child u64)) u64
  (let ((v m:node (m:at c site)))
    (m:add c (m:node 1 (field v start) (field v length) child 0 0 0 0 0 0))))

(base:function check-arguments ((c m:context) (site u64) (param u64) (arg u64)) unit
  (base:cond
    ((== param 0) (m:require c site (== arg 0) "too many macro arguments"))
    ((m:is c param "&rest") unit)
    (true
      (do
        (m:require c site (> arg 0) "missing macro argument")
        (check-arguments c site (m:next c param) (m:next c arg))))))

(base:function attach ((c m:context) (id u64) (child u64) (next u64)) u64
  (let ((v m:node (m:at c id)))
    (m:add
      c
      (m:node
        (field v kind)
        (field v start)
        (field v length)
        child
        next
        0
        (match (field v kind) (66 (field v target)) (_ 0))
        (field v value)
        (field v generated)
        (field v lookup-module)))))

; Templates are immutable until the final declaration is copied for checking.
; Keep the original node when neither of its links changes.
(base:function template-links ((c m:context) (id u64) (child u64) (next u64)) u64
  (let ((v m:node (m:at c id)))
    (match (== (field v child) child)
      (true (match (== (field v next) next) (true id) (false (attach c id child next))))
      (false (attach c id child next)))))

; Share each spliced element's subtree, but copy its sibling link.
(base:function splice-list ((c m:context) (id u64) (tail u64)) u64
  (match id (0 tail) (_ (template-links c id (m:child c id) (splice-list c (m:next c id) tail)))))

; The reference reader desugars these prefixes to named forms. Accept both
; spellings while retaining the original span and shape in nested templates.
(base:function syntax-kind ((c m:context) (id u64)) u64
  (let ((v m:node (m:at c id)) (head u64 (field v child)))
    (base:cond
      ((== (field v kind) 1)
       (base:cond
         ((m:is c head "quote") 28)
         ((m:is c head "quasiquote") 29)
         ((m:is c head "unquote") 30)
         ((m:is c head "unquote-splicing") 31)
         (true 1)))
      ((== (field v kind) 69) 0)
      ((== (field v kind) 71) 35)
      (true (field v kind)))))

(base:function operand ((c m:context) (id u64)) u64
  (let ((child u64 (m:child c id)))
    (match (field (m:at c id) kind)
      (1
        (do
          (m:require c id (check:arity c child 2) "quote form requires one operand")
          (m:next c child)))
      (_ child))))

(base:function template-items
  ((c m:context)
   (invocation-module u64)
   (id u64)
   (env (pointer void))
   (config evaluation)
   (depth u64)) u64
  (match id
    (0 0)
    (_
      (match (== depth 1)
        (true
          (match (syntax-kind c id)
            (31
              (let
                ((value
                   u64
                   (eval
                     c
                     invocation-module
                     (operand c id)
                     env
                     (evaluation (field config steps) (field config depth) true))))
                (do
                  (m:require
                    c
                    id
                    (== (field (m:at c value) kind) 1)
                    "unquote-splicing requires a list")
                  (splice-list
                    c
                    (m:child c value)
                    (template-items c invocation-module (m:next c id) env config depth)))))
            (_ (template-item c invocation-module id env config depth))))
        (false (template-item c invocation-module id env config depth))))))

(base:function template-item
  ((c m:context)
   (invocation-module u64)
   (id u64)
   (env (pointer void))
   (config evaluation)
   (depth u64)) u64
  (let
    ((value u64 (template c invocation-module id env config depth))
     (next u64 (template-items c invocation-module (m:next c id) env config depth)))
    (template-links c value (m:child c value) next)))

(base:function wrap-template ((c m:context) (id u64) (child u64)) u64
  (let ((value u64 (template-links c child (m:child c child) 0)))
    (match (field (m:at c id) kind)
      (1
        (let ((head u64 (m:child c id)))
          (template-links c id (template-links c head 0 value) (m:next c id))))
      (_ (template-links c id value (m:next c id))))))

; Nested quasiquotes preserve their escapes until the matching depth.
(base:function template
  ((c m:context)
   (invocation-module u64)
   (id u64)
   (env (pointer void))
   (config evaluation)
   (depth u64)) u64
  (let ((child u64 (m:child c id)))
    (match (syntax-kind c id)
      (1
        (template-links
          c
          id
          (template-items c invocation-module child env config depth)
          (m:next c id)))
      (28 (wrap-template c id (template c invocation-module (operand c id) env config depth)))
      (29
        (wrap-template
          c
          id
          (template c invocation-module (operand c id) env config (+ depth 1))))
      (30
        (match (== depth 1)
          (true
            (eval
              c
              invocation-module
              (operand c id)
              env
              (evaluation (field config steps) (field config depth) true)))
          (false
            (wrap-template
              c
              id
              (template c invocation-module (operand c id) env config (- depth 1))))))
      (31
        (match (== depth 1)
          (true (do (m:error c id "unquote-splicing requires a list element") 0))
          (false
            (wrap-template
              c
              id
              (template c invocation-module (operand c id) env config (- depth 1))))))
      (_ (quoted c id)))))

(base:function symbol-value ((c m:context) (id u64)) bool
  (let ((v m:node (m:at c id)))
    (base:cond
      ((check:integer-node c id) false)
      ((> (field v generated) 0) true)
      ((m:is c id "true") false)
      ((m:is c id "false") false)
      ((m:is c id "unit") false)
      (true (== (check:name-colon c id) (+ (field v start) (field v length)))))))

(base:function symbol-part ((c m:context) (site u64) (value u64) (out (pointer data:data))) unit
  (let ((v m:node (m:at c value)) (start u64 (data:length (deref out))))
    (match (field v kind)
      (25
        (let ((cursor u64 start) (escaped bool false) (length u64 (- (field v length) 2)))
          (do
            (grow-symbol c site out length)
            (check:decode-data
              c
              (data:bytes (deref out))
              (& cursor)
              (& escaped)
              (+ (field v start) 1)
              length)
            (m:storage (data:resize out cursor)))))
      (0
        (let ((name data:view (m:spelling c value)))
          (do
            (m:require c site (symbol-value c value) "symbol-concat requires data or symbols")
            (grow-symbol c site out (field name length))
            (allocator:copy-bytes
              (pointer-offset (data:bytes (deref out)) start)
              (field name bytes)
              (field name length)))))
      (_ (m:error c site "symbol-concat requires data or symbols")))))

(base:function grow-symbol ((c m:context) (site u64) (out (pointer data:data)) (length u64)) unit
  (let ((start u64 (data:length (deref out))))
    (do
      (m:require
        c
        site
        (<= length (- (cast u64 18446744073709551615) start))
        "generated symbol size overflow")
      (m:storage (data:resize out (+ start length))))))

(base:function symbol-parts
  ((c m:context)
   (invocation-module u64)
   (id u64)
   (env (pointer void))
   (config evaluation)
   (out (pointer data:data))) unit
  (match id
    (0 unit)
    (_
      (do
        (symbol-part c id (eval c invocation-module id env config) out)
        (symbol-parts c invocation-module (m:next c id) env config out)))))

(base:function symbol-concat
  ((c m:context)
   (invocation-module u64)
   (site u64)
   (first u64)
   (env (pointer void))
   (config evaluation)) u64
  (let ((out data:data (data:empty (arena:allocator (field c memory)))))
    (do
      (m:require c site (> first 0) "symbol-concat requires at least one component")
      (symbol-parts c invocation-module first env config (& out))
      (m:require c site (> (data:length out) 0) "symbol-concat cannot construct an empty name")
      (m:add
        c
        (m:node
          0
          (field (m:at c site) start)
          (data:length out)
          0
          0
          0
          0
          0
          (m:address (cast (pointer void) (data:bytes out)))
          (+ invocation-module 1))))))

; Compile-time values are immutable syntax IDs, with lexical environments made
; from borrowed stack bindings. Helper macros receive syntax, then their expansion
; is evaluated in the caller's compile-time environment, as in the reference.
(base:function boolean-value ((c m:context) (site u64) (value bool)) u64
  (let ((v m:node (m:at c site)))
    (m:add
      c
      (m:node 3 (field v start) (field v length) 0 0 0 0 (match value (true 1) (false 0)) 0 0))))

(base:function boolean-p ((c m:context) (id u64)) bool
  (match (field (m:at c id) kind)
    (3 true)
    (0
      (match (field (m:at c id) generated)
        (0 (base:or (m:is c id "true") (m:is c id "false")))
        (_ false)))
    (_ false)))

(base:function condition ((c m:context) (site u64) (value u64)) bool
  (do
    (m:require c site (boolean-p c value) "compile-time condition requires a boolean")
    (match (field (m:at c value) kind)
      (3 (== (field (m:at c value) value) (cast i64 1)))
      (_ (m:is c value "true")))))

(base:function require-list ((c m:context) (site u64) (value u64)) u64
  (do
    (m:require c site (== (field (m:at c value) kind) 1) "compile-time operation requires a list")
    value))

; NIL denotes an empty list even when quoted, recursively through list data.
(base:function quoted-items ((c m:context) (id u64)) u64
  (match id
    (0 0)
    (_
      (let ((value u64 (quoted c id)))
        (template-links c value (m:child c value) (quoted-items c (m:next c id)))))))

(base:function quoted ((c m:context) (id u64)) u64
  (match (field (m:at c id) kind)
    (0 (match (m:is c id "nil") (true (list-value c id 0)) (false id)))
    (1 (template-links c id (quoted-items c (m:child c id)) (m:next c id)))
    (28 (wrap-template c id (quoted c (operand c id))))
    (29 (wrap-template c id (quoted c (operand c id))))
    (30 (wrap-template c id (quoted c (operand c id))))
    (31 (wrap-template c id (quoted c (operand c id))))
    (_ id)))

(base:function eval-body
  ((c m:context) (module u64) (forms u64) (env (pointer void)) (config evaluation)) u64
  (do
    (m:require c forms (> forms 0) "compile-time body requires an expression")
    (let ((value u64 (eval c module forms env config)))
      (match (m:next c forms) (0 value) (next (eval-body c module next env config))))))

(base:function eval-bindings
  ((c m:context)
   (module u64)
   (bindings u64)
   (body u64)
   (env (pointer void))
   (seen (pointer void))
   (config evaluation)) u64
  (match bindings
    (0 (eval-body c module body env config))
    (_
      (let ((name u64 (m:child c bindings)) (init u64 (m:next c name)))
        (do
          (m:require
            c
            bindings
            (match (== (field (m:at c bindings) kind) 1)
              (true (check:arity c name 2))
              (false false))
            "compile-time let binding requires a name and initializer")
          (m:require
            c
            name
            (match (check:atom c name) (true (symbol-value c name)) (false false))
            "expected compile-time binding name")
          (m:require
            c
            name
            (match (m:is c name "nil") (true false) (false (== (m:lookup c name seen) 0)))
            "duplicate or reserved compile-time let binding")
          (let
            ((value u64 (eval c module init env config))
             (binding m:binding (m:binding name value 0 env))
             (local m:binding (m:binding name value 0 seen)))
            (eval-bindings
              c
              module
              (m:next c bindings)
              body
              (cast (pointer void) (& binding))
              (cast (pointer void) (& local))
              config)))))))

(base:function validate-clauses ((c m:context) (clauses u64)) unit
  (match clauses
    (0 unit)
    (_
      (do
        (m:require
          c
          clauses
          (match (== (field (m:at c clauses) kind) 1)
            (true (> (m:next c (m:child c clauses)) 0))
            (false false))
          "compile-time cond clauses require a test and body")
        (validate-clauses c (m:next c clauses))))))

(base:function eval-clauses
  ((c m:context) (module u64) (site u64) (clauses u64) (env (pointer void)) (config evaluation)) u64
  (match clauses
    (0 (list-value c site 0))
    (_
      (let ((test u64 (m:child c clauses)))
        (match (condition c test (eval c module test env config))
          (true (eval-body c module (m:next c test) env config))
          (false (eval-clauses c module site (m:next c clauses) env config)))))))

(base:function eval-logical
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (and bool)) u64
  (match args
    (0 (boolean-value c site and))
