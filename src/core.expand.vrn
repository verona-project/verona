(base:function numeric-call
  ((c m:context)
   (module u64)
   (site u64)
   (args u64)
   (env (pointer void))
   (config evaluation)
   (code u64)) u64
  (let
    ((values u64 (eval-items c module args env config))
     (integers bool (numeric-inputs c site values config))
     (count u64 (list-size c values config))
     (w big:work (big:work c site (field config steps))))
    (do
      (m:require
        c
        site
        (match code
          (1 true)
          (3 true)
          (5 (== count 2))
          (6 (== count 2))
          (9 (== count 1))
          (_ (match (>= code 10) (true (>= count 2)) (false (> count 0)))))
        "invalid numeric operation arity")
      (base:cond
        ((>= code 10) (boolean-value c site (numeric-comparison c site values config code)))
        ((base:or (== code 5) (== code 6))
         (do
           (m:require c site integers "integer division requires integer operands")
           (integer-division c site values (m:next c values) config code)))
        ((== code 9)
         (match integers
           (true
             (let ((value big:number (big:parse w values)))
               (integer-result c site (big:number false (field value digits)) config)))
           (false
             (float-result
               c
               site
               (let
                 ((bits u64 (base:convert (numeric-float c site values))))
                 (base:convert
                   (-
                     bits
                     (*
                       (/ bits (cast u64 9223372036854775808))
                       (cast u64 9223372036854775808)))))))))
        ((== code 4)
         (match integers
           (true
             (let
               ((one u64 (unsigned-value c site 1))
                (numerator u64 (match count (1 one) (_ values)))
                (denominator
                  u64
                  (match count
                    (1 values)
                    (_ (numeric-fold c site (m:next c values) one config 3 true)))))
               (integer-division c site numerator denominator config code)))
           (false
             (numeric-fold
               c
               site
               (match count (1 values) (_ (m:next c values)))
               (match count (1 (float-result c site (float:pack64 1.0))) (_ values))
               config
               code
               false))))
        ((base:and (== code 2) (== count 1))
         (match integers
           (true (integer-result c site (big:negate (big:parse w values)) config))
           (false
             (float-result
               c
               site
               (base:convert
                 (num:bitwise 13 (base:convert (numeric-float c site values)) 9223372036854775808))))))
        ((base:or (== code 1) (== code 3))
         (numeric-fold
           c
           site
           values
           (unsigned-value c site (match code (1 0) (_ 1)))
           config
           code
           integers))
        (true (numeric-fold c site (m:next c values) values config code integers))))))

; gcvt has a fixed C signature (unlike printf's variadic interface). Probe
; increasing significant precision until binary64 round-trips, then expand its
; exponent into the reference API's decimal-only string representation.
(base:external-function gcvt-digits "gcvt" (f64 i32 (pointer u8)) (pointer u8))

(base:function shortest-float
  ((c m:context) (site u64) (bits i64) (precision i32) (out (pointer u8)) (config evaluation))
  data:view
  (do
    (tick c site config)
    (gcvt-digits (float:unpack64 bits) precision out)
    (let
      ((text data:view (data:view out (cstring:strlen out)))
       (end (pointer u8) out)
       (parsed i64 (float:pack64 (float:decimal-to-double out (& end)))))
      (match
        (base:or (== parsed bits) (%=-primitive-i32 precision 17))
        (true
          (do
            (m:require
              c
              site
              (== parsed bits)
              "floating-point decimal conversion did not round trip")
            text))
        (false (shortest-float c site bits (%+-primitive-i32 precision 1) out config))))))

(base:function decimal-parts
  ((c m:context)
   (site u64)
   (text data:view)
   (index u64)
   (out (pointer data:data))
   (point (pointer u64))
   (dot (pointer bool))
   (config evaluation)) u64
  (match (== index (field text length))
    (true index)
    (false
      (let ((byte u8 (deref (pointer-offset (field text bytes) index))))
        (do
          (tick c site config)
          (match byte
            (101 index)
            (69 index)
            (46
              (do
                (store (deref dot) true)
                (decimal-parts c site text (+ index 1) out point dot config)))
            (_
              (do
                (m:storage (data:append out byte))
                (match (deref dot)
                  (true unit)
                  (false (do (store (deref point) (+ (deref point) 1)) unit)))
                (decimal-parts c site text (+ index 1) out point dot config)))))))))

(base:function exponent-magnitude ((text data:view) (index u64) (value i64)) i64
  (match (== index (field text length))
    (true value)
    (false
      (let ((byte u64 (base:convert (deref (pointer-offset (field text bytes) index)))))
        (exponent-magnitude
          text
          (+ index 1)
          (%+-primitive-i64
            (%*-primitive-i64 value 10)
            (base:convert (- byte (cast u64 48)))))))))

(base:function exponent-value ((text data:view) (index u64)) i64
  (match (== index (field text length))
    (true 0)
    (false
      (let
        ((start u64 (+ index 1))
         (sign u8 (deref (pointer-offset (field text bytes) start)))
         (skip u64 (match sign (43 1) (45 1) (_ 0)))
         (value i64 (exponent-magnitude text (+ start skip) 0)))
        (match sign (45 (%--primitive-i64 0 value)) (_ value))))))

(base:function zero-digits
  ((c m:context) (site u64) (out (pointer data:data)) (count u64) (config evaluation)) unit
  (match count
    (0 unit)
    (_
      (do
        (tick c site config)
        (m:storage (data:append out 48))
        (zero-digits c site out (- count 1) config)))))

(base:function float-string ((c m:context) (site u64) (bits i64) (config evaluation)) u64
  (let
    ((storage data:data (data:empty (arena:allocator (field c memory))))
     (digits data:data (data:empty (arena:allocator (field c memory))))
     (out data:data (data:empty (arena:allocator (field c memory))))
     (point u64 0)
     (dot bool false))
    (do
      (m:storage (data:resize (& storage) 1024))
      (let
        ((text data:view (shortest-float c site bits 1 (data:bytes storage) config))
         (negative bool (== (deref (field text bytes)) (cast u8 45)))
         (start u64 (match negative (true 1) (false 0)))
         (end u64 (decimal-parts c site text start (& digits) (& point) (& dot) config))
         (position i64 (%+-primitive-i64 (base:convert point) (exponent-value text end)))
         (offset u64 (base:convert position))
         (length u64 (data:length digits)))
        (do
          (match negative (true (m:storage (data:append (& out) 45))) (false unit))
          (base:cond
            ((%<=-primitive-i64 position 0)
             (do
               (m:storage (data:append (& out) 48))
               (m:storage (data:append (& out) 46))
               (zero-digits c site (& out) (base:convert (%--primitive-i64 0 position)) config)
               (append-view c (& out) (data:borrow digits))))
            ((>= offset length)
             (do
               (append-view c (& out) (data:borrow digits))
               (zero-digits c site (& out) (- offset length) config)
               (m:storage (data:append (& out) 46))
               (m:storage (data:append (& out) 48))))
            (true
              (do
                (append-view c (& out) (data:view (data:bytes digits) (base:convert position)))
                (m:storage (data:append (& out) 46))
                (append-view
                  c
                  (& out)
                  (data:view
                    (pointer-offset (data:bytes digits) offset)
                    (- length offset))))))
          (string-value c site (data:borrow out) config))))))

(base:function whitespace-byte ((byte u8)) bool
  (match byte (32 true) (9 true) (10 true) (13 true) (_ false)))

(base:function trim-left ((c m:context) (site u64) (text data:view) (index u64) (config evaluation))
  u64
  (match (== index (field text length))
    (true index)
    (false
      (match (whitespace-byte (deref (pointer-offset (field text bytes) index)))
        (false index)
        (true (do (tick c site config) (trim-left c site text (+ index 1) config)))))))

(base:function trim-right ((c m:context) (site u64) (text data:view) (end u64) (config evaluation))
  u64
  (match end
    (0 0)
    (_
      (match (whitespace-byte (deref (pointer-offset (field text bytes) (- end 1))))
        (false end)
        (true (do (tick c site config) (trim-right c site text (- end 1) config)))))))

(base:function validate-number-text
  ((c m:context)
   (site u64)
   (text data:view)
   (index u64)
   (dot (pointer bool))
   (digits (pointer u64))
   (config evaluation)) unit
  (match (== index (field text length))
    (true (m:require c site (> (deref digits) 0) "invalid numeric string"))
    (false
      (let ((byte u64 (base:convert (deref (pointer-offset (field text bytes) index)))))
        (do
          (tick c site config)
          (match (check:digit byte)
            (true (do (store (deref digits) (+ (deref digits) 1)) unit))
            (false
              (do
                (m:require
                  c
                  site
                  (base:and (== byte 46) (base:not (deref dot)) (> (deref digits) 0))
                  "invalid numeric string")
                (store (deref dot) true)
                (store (deref digits) 0)
                unit)))
          (validate-number-text c site text (+ index 1) dot digits config))))))

(base:function conversion-call
  ((c m:context)
   (module u64)
   (site u64)
   (head u64)
   (args u64)
   (env (pointer void))
   (config evaluation)) u64
