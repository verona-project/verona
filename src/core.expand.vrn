                      (float-result c site (numeric-float c site (text-node c site 35 trimmed))))))))))))))

(base:function eval-call
  ((c m:context)
   (module u64)
   (site u64)
   (head u64)
   (args u64)
   (env (pointer void))
   (config evaluation)) u64
  (base:cond
    ((m:is c head "let")
     (do
       (m:require
         c
         site
         (match (== (field (m:at c args) kind) 1) (true (> (m:next c args) 0)) (false false))
         "compile-time let requires bindings and a body")
       (eval-bindings c module (m:child c args) (m:next c args) env (m:empty-env) config)))
    ((m:is c head "cond")
     (do (validate-clauses c args) (eval-clauses c module site args env config)))
    ((m:is c head "and") (eval-logical c module site args env config true))
    ((m:is c head "or") (eval-logical c module site args env config false))
    (true
      (let ((macro u64 (lookup c head)))
        (do
          (m:require c head (== (m:lookup c head env) 0) "compile-time value is not callable")
          (base:cond
            ((> macro 0)
