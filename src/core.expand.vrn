               (eval c module result env config)))
            ((base:or (m:is c head "number->string") (m:is c head "string->number"))
             (conversion-call c module site head args env config))
            ((> (numeric-code c head) 0)
             (numeric-call c module site args env config (numeric-code c head)))
            ((> (collection-code c head) 0)
             (collection-call c module site args env config (collection-code c head)))
            ((> (context-code c head) 0)
             (context-call c module site args env config (context-code c head)))
            ((> (string-code c head) 0)
             (string-call c module site args env config (string-code c head)))
            ((> (helper-code c head) 0)
             (helper-call c module site head args env config (helper-code c head)))
            ((m:is c head "symbol-concat") (symbol-concat c module site args env config))
            ((state-operation c head) (eval-state c module site head args env config))
            ((m:is c head "nth") (eval-nth c module site args env config))
            ((m:is c head "plist-ref") (eval-plist-ref c module site args env config))
            ((base:or (m:is c head "compiler:reduce") (m:is c head "compiler:reduce-right"))
             (eval-reduction c module site args env config (m:is c head "compiler:reduce-right")))
            ((m:is c head "list") (list-value c site (eval-items c module args env config)))
            ((m:is c head "cons")
             (do
               (m:require c site (check:arity c args 2) "compile-time cons requires two arguments")
               (let
                 ((item u64 (eval c module args env config))
                  (tail u64 (require-list c site (eval c module (m:next c args) env config))))
                 (list-value c site (attach c item (m:child c item) (m:child c tail))))))
            ((m:is c head "equal?")
             (do
               (m:require
                 c
                 site
                 (check:arity c args 2)
                 "compile-time equal? requires two arguments")
               (let
                 ((left u64 (eval c module args env config))
                  (right u64 (eval c module (m:next c args) env config)))
                 (boolean-value c site (equal-value c left right config)))))
            ((m:is c head "not")
             (do
               (m:require c site (check:arity c args 1) "compile-time not requires one argument")
               (boolean-value c site (base:not (condition c site (eval c module args env config))))))
            ((base:or (m:is c head "car") (m:is c head "cdr") (m:is c head "empty?"))
             (do
               (m:require
                 c
                 site
                 (check:arity c args 1)
                 "compile-time list operation requires one argument")
               (let
                 ((value u64 (require-list c site (eval c module args env config)))
                  (child u64 (m:child c value)))
                 (base:cond
                   ((m:is c head "empty?") (boolean-value c site (== child 0)))
                   ((== child 0) (do (m:error c site "car/cdr require a non-empty list") 0))
                   ((m:is c head "cdr") (list-value c site (m:next c child)))
                   (true (attach c child (m:child c child) 0))))))
            (true (m:error c site "unsupported compile-time call") 0)))))))

(base:function eval ((c m:context) (module u64) (site u64) (env (pointer void)) (config evaluation))
  u64
  (let ((next evaluation (tick c site config)))
    (match (syntax-kind c site)
      (0
        (base:cond
          ((check:integer-node c site) site)
          ((match (field (m:at c site) generated) (0 (m:is c site "true")) (_ false)) site)
          ((match (field (m:at c site) generated) (0 (m:is c site "false")) (_ false)) site)
          ((match (field (m:at c site) generated) (0 (m:is c site "unit")) (_ false)) site)
          ((m:is c site "nil") (list-value c site 0))
          (true
            (let ((value u64 (m:lookup c site env)))
              (do (m:require c site (> value 0) "unknown compile-time name") value)))))
      (3 site)
      (25 site)
      (26 site)
      (35 site)
      (28 (quoted c (operand c site)))
      (29 (template c module (operand c site) env next 1))
