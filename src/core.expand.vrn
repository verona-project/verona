        (match (< found end) (true found) (false (first-nonzero c id end (- count half))))))))

(base:function integer-magnitude ((c m:context) (id u64)) u64
  (let ((v m:node (m:at c id)) (start u64 (match (m:spelling-byte c id 0) (43 1) (45 1) (_ 0))))
    (first-nonzero c id start (- (field v length) start))))

(base:function equal-integers ((c m:context) (left u64) (right u64)) bool
  (let
    ((a data:view (m:spelling c left))
     (b data:view (m:spelling c right))
     (astart u64 (integer-magnitude c left))
     (bstart u64 (integer-magnitude c right))
