      (== alen blen)
      (base:or
        (== alen 0)
        (base:and
          (==
            (match (m:spelling-byte c left 0) (45 (cast u64 1)) (_ (cast u64 0)))
            (match (m:spelling-byte c right 0) (45 (cast u64 1)) (_ (cast u64 0))))
          (data:equal
            (data:view (pointer-offset (field a bytes) astart) alen)
            (data:view (pointer-offset (field b bytes) bstart) blen)))))))

(base:function data-value ((c m:context) (id u64)) data:view
  (let
    ((v m:node (m:at c id))
     (out data:data (data:empty (arena:allocator (field c memory))))
     (cursor u64 0)
     (escaped bool false))
    (do
      (m:storage (data:resize (& out) (field v length)))
      (check:decode-node c id (data:bytes out) (& cursor) (& escaped) 1 (- (field v length) 2))
      (data:view (data:bytes out) cursor))))

