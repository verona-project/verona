    (m:require c site (check:arity c args 1) "numeric conversion requires one argument")
    (let ((value u64 (eval c module args env config)))
      (match (m:is c head "number->string")
        (true
          (do
            (m:require
              c
              site
              (base:or (check:integer-node c value) (== (syntax-kind c value) 35))
              "expected an integer or floating-point number")
            (match (check:integer-node c value)
              (true
                (let ((w big:work (big:work c site (field config steps))))
                  (string-value c site (big:text w (big:parse w value)) config)))
              (false (float-string c site (numeric-float c site value) config)))))
        (false
          (let
            ((text data:view (string-input c site value))
             (start u64 (trim-left c site text 0 config))
             (end u64 (trim-right c site text (field text length) config))
             (dot bool false)
             (digits u64 0))
