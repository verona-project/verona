(import base)
(import core.model :as m)
(import core.sexpr :as syntax)
(import arena)
(import data)
(import libc.string :as cstring)
(import foundation.compat.arithmetic :as n)

; Strings and feature links belong to the invocation arena. Configurations
; are immutable while borrowed by a compilation session; LLVM machines are
; separately owned and released at their call boundaries.
(base:type configuration
  (product
    (triple (pointer u8))
    (platform (pointer u8))
    (architecture (pointer u8))
    (cpu (pointer u8))
    (machine-features (pointer u8))
    (level i32)
    (features syntax:features)
    (layout (pointer u8))))

(base:function equal ((a (pointer u8)) (b (pointer u8))) bool
  (match (cstring:strcmp a b) (0 true) (_ false)))

(base:function copy ((memory (pointer arena:arena)) (value data:view)) (pointer u8)
  (let ((out data:data (data:empty (arena:allocator memory))))
    (do
      (m:storage (data:assign-bytes (& out) value))
      (m:storage (data:append (& out) 0))
      (data:bytes out))))

(base:function lower ((bytes (pointer u8)) (count u64)) unit
  (match count
    (0 unit)
    (_
      (let ((b u8 (deref bytes)))
        (do
          (store
            (deref bytes)
            (match (base:and (n:ge (base:convert b) 65) (n:le (base:convert b) 90))
              (true (base:convert (n:add (base:convert b) 32)))
              (false b)))
          (lower (pointer-offset bytes 1) (n:sub count 1)))))))

(base:function add-feature
  ((memory (pointer arena:arena)) (head (pointer (pointer void))) (name (pointer u8))) unit
  (let ((text (pointer u8) (copy memory (data:view name (cstring:strlen name)))))
    (do
      (lower text (cstring:strlen text))
      (match (arena:allocate memory 16 8)
        ((allocated bytes)
         (let
           ((link
              (pointer syntax:feature)
              (cast (pointer syntax:feature) (cast (pointer void) bytes))))
           (do
             (store (deref link) (syntax:feature text (m:empty-env)))
             (append-feature head (cast (pointer void) link)))))
        (_ (m:fatal "cannot allocate reader feature"))))))

(base:function append-feature ((head (pointer (pointer void))) (link (pointer void))) unit
  (match (m:is-empty (deref head))
    (true (do (store (deref head) link) unit))
    (false (append-after (cast (pointer syntax:feature) (deref head)) link))))

(base:function append-after ((current (pointer syntax:feature)) (link (pointer void))) unit
  (let ((v syntax:feature (deref current)))
    (match (m:is-empty (field v next))
      (true (do (store (deref current) (syntax:feature (field v name) link)) unit))
      (false (append-after (cast (pointer syntax:feature) (field v next)) link)))))

(base:function has ((text (pointer u8)) (part (pointer u8))) bool
  (base:not (m:is-empty (cast (pointer void) (cstring:strstr text part)))))

(base:function architecture ((triple (pointer u8))) (pointer u8)
  (base:cond
    ((base:or
       (n:eq (base:convert (cstring:strncmp triple "aarch64-" 8)) 0)
       (n:eq (base:convert (cstring:strncmp triple "arm64-" 6)) 0))
     "aarch64")
    ((base:or
       (n:eq (base:convert (cstring:strncmp triple "x86_64-" 7)) 0)
       (n:eq (base:convert (cstring:strncmp triple "amd64-" 6)) 0))
     "x86_64")
    (true (do (m:fatal "unsupported target architecture: expected 64-bit AArch64 or x86-64") ""))))

(base:function platform ((triple (pointer u8))) (pointer u8)
  (base:cond
    ((has triple "darwin") "darwin")
    ((base:or (has triple "linux") (has triple "gnu")) "linux")
    (true (do (m:fatal "unsupported target platform: expected Darwin or Linux") ""))))

(base:function from-context ((p m:context)) (pointer void)
  (match (m:is-empty (field p session))
    (true (m:empty-env))
    (false (field (deref (cast (pointer m:module-session) (field p session))) configuration))))

(base:function reader-features ((p m:context)) syntax:features
  (let ((config (pointer void) (from-context p)))
    (match (m:is-empty config)
      (true (syntax:features (syntax:native-platform) (syntax:native-architecture) (m:empty-env)))
      (false (field (deref (cast (pointer configuration) config)) features)))))

(base:function x86 ((p m:context)) bool
  (equal (field (reader-features p) architecture) "x86_64"))

(base:function target-platform ((p m:context)) (pointer u8)
  (field (reader-features p) platform))

(export
  configuration
  reader-features
  from-context
  x86
  target-platform
  add-feature
  append-feature
  copy
  equal
  lower
  architecture
  platform)
