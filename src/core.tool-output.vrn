(import base)
(import core.source :as source)
(import data)
(import error)
(import libc.constants :as c)
(import libc.descriptor :as fd)
(import libc.errno :as errno)
(import libc.stdio :as stdio)
(import libc.types :as types)

; A temporary file lets native tools write arbitrarily large diagnostics
; without blocking the parent in waitpid.
(base:function open () (pointer types:file-stream)
  (stdio:tmpfile))

(base:function descriptor ((file (pointer types:file-stream))) i32
  (match (base:is-null file) (true -1) (false (stdio:fileno file))))

(base:function close ((file (pointer types:file-stream))) unit
  (match (base:is-null file) (true unit) (false (do (stdio:fclose file) unit))))

(base:function redirect ((destination i32)) bool
  (match (fd:dup2 destination c:STDERR-FILENO)
    (-1
      (match (== (deref (errno:errno-pointer)) c:EINTR)
        (true (redirect destination))
        (false false)))
    (_ true)))

(base:function rewind-descriptor ((input i32)) bool
  (match (fd:lseek input 0 c:SEEK-SET)
    (-1
      (match (== (deref (errno:errno-pointer)) c:EINTR)
        (true (rewind-descriptor input))
        (false false)))
    (_ true)))

; Take ownership of the stream after the child has exited.
(base:function read
  ((file (pointer types:file-stream)) (out (pointer data:data))) error:status
  (match (rewind-descriptor (descriptor file))
    (true (source:read-open file out))
    (false (do (close file) (error:invalid)))))

(export open descriptor close redirect read)
