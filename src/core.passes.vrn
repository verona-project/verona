(import base)
(import core.model :as m)
(import core.optimize :as simplify)

; One invocation borrows a fully checked, specialization-complete program.
; No pass may mutate nodes, binder identities, types, spans or sibling links.
; Reference analysis precedes lowering queries. Queries return existing IDs or
; scalar values; there is one lowering sweep, no fixed point and zero growth.
; Future mutating/inlining passes must define invalidation and growth/version
; limits explicitly rather than inheriting this read-only contract.
(base:type limits (product (depth u64) (arms u64)))

(base:type context
  (product
    (program m:context)
    (enabled bool)
    (remarks bool)
    (budget limits)
    (references (pointer u8))
    (initializers (pointer u64))))

(base:function defaults () limits
  (limits 32 128))

(base:function prepare
  ((c m:context) (enabled bool) (remarks bool) (budget limits)) context
  (context
    c
    enabled
    remarks
    budget
    (simplify:references c enabled)
    (simplify:initializers c enabled)))

; Called by primitive lowering after its left operand is materialized.  Return
; that left ID only when its right sibling is a safe structural duplicate.
(base:function common-sibling ((p context) (id u64)) u64
  (match (field p enabled)
    (false 0)
    (true
      (let ((left u64 (simplify:common-sibling (field p program) id)))
        (do
          (match left
            (0 unit)
            (_ (remark p (m:next (field p program) left) "local-cse" left)))
          left)))))

; Tail lowering performs the actual rewrite, because only it knows that a
; direct call is immediately returned.  Keep the optimization-level gate and
; diagnostic policy here with the other lowering decisions.
(base:function tail-call ((p context) (id u64) (fn u64) (eligible bool)) bool
  (match (base:and (field p enabled) eligible)
    (false false)
    (true (do (remark p id "tail-call" fn) true))))

; Remarks never increment the semantic error count. Node IDs and source spans
; refer to the original checked program, including imported module locations.
(base:function remark ((p context) (id u64) (rule (pointer u8)) (selected u64))
  unit
  (match (field p remarks)
    (false unit)
    (true
      (do
        (m:location (field p program) (field (m:at (field p program) id) start))
        (m:text 2 "optimization: ")
        (m:text 2 rule)
        (m:text 2 " node=")
        (m:number 2 id)
        (m:text 2 " selected=")
        (m:number 2 selected)
        (m:text 2 "\n")))))

(base:function fold ((p context) (id u64)) simplify:constant-result
  (let
    ((result
       simplify:constant-result
       (simplify:constant
         (field p program)
         (field p initializers)
         id
         (match (field p enabled)
           (true (field (field p budget) depth))
           (false 0)))))
    (do
      (match result
        ((known value)
         ; Literal emission is not a simplification decision.
         (match (field (m:at (field p program) id) kind)
           (9 (remark p id "constant-fold" 0))
           (5 (remark p id "constant-propagation" 0))
           (_ unit)))
        (_ unit))
      result)))

(base:function arm
  ((p context) (id u64) (scrutinee u64) (sum bool) (tuple bool)) u64
  (let
    ((selected
       u64
       (match (field p enabled)
         (true
           (simplify:known-match
             (field p program)
             (field p initializers)
             scrutinee
             sum
             tuple
             (field (field p budget) depth)
             (field (field p budget) arms)))
         (false 0))))
    (do
      (match selected (0 unit) (_ (remark p id "known-match" selected)))
      selected)))

(base:function dead ((p context) (id u64)) bool
  (let
    ((result
       bool
       (base:and-then
         (field p enabled)
         (simplify:dead-binding
           (field p program)
           (field p initializers)
           (field p references)
           id
           (field (field p budget) depth)))))
    (do
      (match result (true (remark p id "dead-binding" 0)) (false unit))
      result)))

; Deterministic tape-order traversal, including shared nodes exactly once.
; Split ranges bound stack depth logarithmically in the checked tape length.
; Omit pointer-bearing payloads: allocator addresses are not stable dump data.
(base:function dump-range ((c m:context) (start u64) (count u64)) unit
  (match count
    (0 unit)
    (1
      (let ((v m:node (m:at c start)))
        (do
          (m:text 1 "node ")
          (m:number 1 start)
          (m:text 1 " kind=")
          (m:number 1 (field v kind))
          (m:text 1 " type=")
          (m:number 1 (field v ty))
          (m:text 1 " child=")
          (m:number 1 (field v child))
          (m:text 1 " next=")
          (m:number 1 (field v next))
          (m:text 1 " start=")
          (m:number 1 (field v start))
          (m:text 1 " length=")
          (m:number 1 (field v length))
          (m:text 1 "\n"))))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (dump-range c start half)
          (dump-range c (+ start half) (- count half)))))))

(base:function dump ((c m:context) (stage (pointer u8))) unit
  (do
    (m:text 1 stage)
    (m:text 1 "\n")
    (dump-range c 1 (- (m:nodes-length (deref (field c items))) 1))))

(export
  limits
  context
  defaults
  prepare
  common-sibling
  tail-call
  fold
  arm
  dead
  dump)
