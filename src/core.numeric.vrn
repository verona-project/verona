(import base)
(import core.model :as m)
(import data)
(import libc.string :as cstring)
(import foundation.compat.arithmetic :as n)

; Scalar identities are disjoint from nominal and structural descriptors.
(base:constant descriptor-base u64 16)

(base:type operation (product (code u64) (input u64) (result u64) (arity u64)))

(base:function integer-type ((ty u64)) bool
  (match (n:ge ty 3) (true (n:le ty 10)) (false false)))

(base:function float-type ((ty u64)) bool
  (match ty (12 true) (13 true) (_ false)))

(base:function signed-type ((ty u64)) bool
  (match (n:ge ty 3) (true (n:le ty 6)) (false false)))

(base:function width ((ty u64)) u64
  (match ty (4 8) (5 16) (6 32) (7 8) (8 16) (9 32) (12 32) (_ 64)))

(base:function name ((ty u64)) (pointer u8)
  (match ty
    (3 "i64")
    (4 "i8")
    (5 "i16")
    (6 "i32")
    (7 "u8")
    (8 "u16")
    (9 "u32")
    (10 "u64")
    (12 "f32")
    (13 "f64")
    (_ "<invalid>")))

(base:function type-name ((c m:context) (id u64)) u64
  (base:cond
    ((m:is c id "i64") 3)
    ((m:is c id "i8") 4)
    ((m:is c id "i16") 5)
    ((m:is c id "i32") 6)
    ((m:is c id "u8") 7)
    ((m:is c id "u16") 8)
    ((m:is c id "u32") 9)
    ((m:is c id "u64") 10)
    ((m:is c id "f32") 12)
    ((m:is c id "f64") 13)
    ((m:is c id "isize") 3)
    ((m:is c id "usize") 10)
    ((m:is c id "exit-code") 6)
    (true 0)))

(base:function pow2 ((exponent u64)) u64
  (match exponent
    (0 1)
    (_
      (let ((half u64 (pow2 (n:div exponent 2))) (square u64 (n:mul half half)))
        (match (n:eq (n:mul (n:div exponent 2) 2) exponent) (true square) (false (n:mul square 2)))))))

(base:function modulus ((ty u64)) u64
  (pow2 (width ty)))

(base:function sign-bit ((ty u64)) u64
  (pow2 (n:sub (width ty) 1)))

(base:function narrow ((ty u64) (bits u64)) u64
  (match (width ty)
    (64 bits)
    (_ (let ((limit u64 (modulus ty))) (n:sub bits (n:mul (n:div bits limit) limit))))))

; Canonical evaluator payload: signed values sign extend, unsigned values zero
; extend. u64 retains all its bits in the existing i64 payload field.
(base:function normalize ((ty u64) (bits u64)) i64
  (let ((low u64 (narrow ty bits)))
    (base:convert
      (match (signed-type ty)
        (false low)
        (true (match (n:ge low (sign-bit ty)) (false low) (true (n:sub low (modulus ty)))))))))

(base:function remainder ((value u64) (divisor u64)) u64
  (n:sub value (n:mul (n:div value divisor) divisor)))

(base:function bitwise ((code u64) (a u64) (b u64)) u64
  (match (match a (0 (n:eq b 0)) (_ false))
    (true 0)
    (false
      (let
        ((x u64 (remainder a 2))
         (y u64 (remainder b 2))
         (bit
           u64
           (match code
             (11 (n:mul x y))
             (12 (n:sub (n:add x y) (n:mul x y)))
             (_ (remainder (n:add x y) 2)))))
        (n:add bit (n:mul 2 (bitwise code (n:div a 2) (n:div b 2))))))))

(base:function text-is ((value data:view) (text (pointer u8))) bool
  (data:equal value (data:view text (cstring:strlen text))))

(base:function slice ((value data:view) (start u64) (end u64)) data:view
  (data:view (pointer-offset (field value bytes) start) (n:sub end start)))

; The longest concrete integer primitive name is under 32 bytes.
(base:function last-dash ((value data:view) (end u64)) u64
  (match end
    (0 0)
    (_
      (let ((index u64 (n:sub end 1)))
        (match (deref (pointer-offset (field value bytes) index))
          (45 index)
          (_ (last-dash value index)))))))

(base:function numeric-suffix ((value data:view)) u64
  (base:cond
    ((text-is value "i64") 3)
    ((text-is value "i8") 4)
    ((text-is value "i16") 5)
    ((text-is value "i32") 6)
    ((text-is value "u8") 7)
    ((text-is value "u16") 8)
    ((text-is value "u32") 9)
    ((text-is value "u64") 10)
    ((text-is value "f32") 12)
    ((text-is value "f64") 13)
    (true 0)))

(base:function binary-code ((prefix data:view)) u64
  (base:cond
    ((text-is prefix "%+-primitive") 1)
    ((text-is prefix "%--primitive") 2)
    ((text-is prefix "%*-primitive") 3)
    ((text-is prefix "%/-primitive") 4)
    ((text-is prefix "%=-primitive") 5)
    ((text-is prefix "%<-primitive") 6)
    ((text-is prefix "%<=-primitive") 7)
    ((text-is prefix "%>-primitive") 8)
    ((text-is prefix "%>=-primitive") 9)
    ((text-is prefix "%/=-primitive") 10)
    ((text-is prefix "%and-primitive") 11)
    ((text-is prefix "%or-primitive") 12)
    ((text-is prefix "%xor-primitive") 13)
    ((text-is prefix "%shl-primitive") 14)
    ((text-is prefix "%shr-primitive") 15)
    (true 0)))

; Default generic spellings are distinct from concrete primitive names.
(base:function default-code ((c m:context) (id u64)) u64
  (base:cond
    ((m:is c id "+") 1)
    ((m:is c id "-") 2)
    ((m:is c id "*") 3)
    ((m:is c id "/") 4)
    ((m:is c id "==") 5)
    ((m:is c id "<") 6)
    ((m:is c id "<=") 7)
    ((m:is c id ">") 8)
    ((m:is c id ">=") 9)
    ((m:is c id "!=") 10)
    (true 0)))

(base:function numeric-type ((ty u64)) bool
  (base:or (integer-type ty) (float-type ty)))

(base:function default-result ((code u64) (input u64)) u64
  (match (n:lt code 5) (true input) (false 2)))

(base:function conversion-prefix ((from u64) (to u64)) (pointer u8)
  (base:cond
    ((float-type from)
     (base:cond
       ((float-type to) (match from (12 "%fext-primitive") (_ "%ftrunc-primitive")))
       ((signed-type to) "%fptosi-primitive")
       (true "%fptoui-primitive")))
    ((float-type to)
     (match (signed-type from) (true "%sitofp-primitive") (false "%uitofp-primitive")))
    ((n:gt (width from) (width to)) "%trunc-primitive")
    ((n:eq (width from) (width to)) "%reinterpret-primitive")
    ((signed-type from) "%sext-primitive")
    (true "%zext-primitive")))

(base:function conversion ((value data:view) (split u64) (to u64)) operation
  (let
    ((earlier u64 (last-dash value split))
     (from u64 (numeric-suffix (slice value (n:add earlier 1) split))))
    (base:cond
      ((n:eq earlier 0) (operation 0 0 0 0))
      ((n:eq from 0) (operation 0 0 0 0))
      ((n:eq from to) (operation 0 0 0 0))
      ((text-is (slice value 0 earlier) (conversion-prefix from to)) (operation 16 from to 1))
      (true (operation 0 0 0 0)))))

(base:function boolean-primitive ((prefix data:view)) operation
  (base:cond
    ((text-is prefix "%not-primitive") (operation 17 2 2 1))
    ((text-is prefix "%and-primitive") (operation 11 2 2 2))
    ((text-is prefix "%or-primitive") (operation 12 2 2 2))
    ((text-is prefix "%=-primitive") (operation 5 2 2 2))
    ((text-is prefix "%/=-primitive") (operation 10 2 2 2))
    (true (operation 0 0 0 0))))

; Resolve a concrete spelling once in the checker. Both execution paths use
; the operation code and checked types, independent of the source text.
(base:function primitive ((c m:context) (id u64)) operation
  (let ((value data:view (m:spelling c id)) (length u64 (field value length)))
    (base:cond
      ((n:lt length 4) (operation 0 0 0 0))
      ((n:gt length 32) (operation 0 0 0 0))
      ((text-is value "%is-null-primitive-pointer") (operation 20 0 2 1))
      ((n:eq (base:convert (deref (field value bytes))) 37)
       (let
         ((split u64 (last-dash value length))
          (ty u64 (numeric-suffix (slice value (n:add split 1) length)))
          (code u64 (binary-code (slice value 0 split))))
         (base:cond
           ((text-is (slice value (n:add split 1) length) "bool")
            (boolean-primitive (slice value 0 split)))
           ((n:eq ty 0) (operation 0 0 0 0))
           ((n:eq code 0) (conversion value split ty))
           ((match (float-type ty) (true (n:gt code 10)) (false false)) (operation 0 0 0 0))
           (true
             (operation
               code
               ty
               (match (n:ge code 5) (false ty) (true (match (n:le code 10) (true 2) (false ty))))
               2)))))
      (true (operation 0 0 0 0)))))

(export
  descriptor-base
  operation
  integer-type
  float-type
  signed-type
  width
  name
  type-name
  pow2
  modulus
  sign-bit
  narrow
  normalize
  remainder
  bitwise
  primitive
  default-code
  numeric-type
  default-result)
