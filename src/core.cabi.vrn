(import base)
(import core.model :as m)
(import core.check :as check)
(import core.layout :as layout)
(import core.configuration :as config)
(import core.target :as backend-target)
(import core.numeric :as num)
(import llvm)
(import llvm.types :as t)
(import llvm.core :as ir)
(import llvm.enums :as enum)
(import llvm.target :as target)
(import libc.string :as cstring)
(import foundation.compat.arithmetic :as n)

; Native data layout is owned here; the LLVM module and checked tape are borrowed.
(base:type context (product (program m:context) (owner llvm:session) (data t:layout-ref)))

(base:function create ((p m:context) (owner llvm:session)) context
  (let
    ((message (pointer u8) (cast (pointer u8) (target:null-pointer)))
     (machine
       t:machine-ref
       (backend-target:configured-machine p (field owner module) enum:codegen-default (& message))))
    (do
      (match (is-null machine)
        (true (m:fatal "cannot create native C ABI data layout"))
        (false unit))
      (match (is-null message)
        (true unit)
        (false (ir:message-dispose message)))
      (let ((data t:layout-ref (target:machine-layout machine)))
        (do (target:machine-dispose machine) (context p owner data))))))

(base:function destroy ((c context)) unit
  (target:layout-dispose (field c data)))

(base:function integer ((c context) (width u32)) t:type-ref
  (ir:int-type (field (field c owner) context) width))

(base:function pointer ((c context)) t:type-ref
  (ir:pointer-type (field (field c owner) context) 0))

(base:function minimum ((a u64) (b u64)) u64
  (match (n:lt a b) (true a) (false b)))

(base:function maximum ((a u64) (b u64)) u64
  (match (n:gt a b) (true a) (false b)))

(base:function size ((c context) (ty t:type-ref)) u64
  (target:abi-size (field c data) ty))

(base:function alignment ((c context) (ty t:type-ref)) u64
  (base:convert (target:abi-align (field c data) ty)))

(base:function types ((c context) (count u64)) (pointer t:type-ref)
  (cast (pointer t:type-ref) (cast (pointer void) (layout:values (field c program) count))))

(base:function components ((c context) (id u64) (out (pointer t:type-ref)) (index u64)) u32
  (match id
    (0 (base:convert index))
    (_
      (do
        (store
          (deref (pointer-offset out index))
          (storage-type c (check:parameter-type (field c program) id)))
        (components c (m:next (field c program) id) out (n:add index 1))))))

(base:function record-type ((c context) (id u64)) t:type-ref
  (let
    ((buffer (pointer t:type-ref) (types c (check:chain-length (field c program) id)))
     (count u32 (components c id buffer 0)))
    (ir:struct-type (field (field c owner) context) buffer count 0)))

(base:type union-layout (product (anchor t:type-ref) (anchor-size u64) (size u64) (alignment u64)))

(base:function union-layout-of ((c context) (id u64) (best union-layout)) union-layout
  (match id
    (0 best)
    (_
      (let
        ((p m:context (field c program))
         (ty t:type-ref (record-type c (m:next p (m:child p id))))
         (length u64 (size c ty))
         (align u64 (alignment c ty))
         (next
           union-layout
           (match (n:gt align (field best alignment))
             (true (union-layout ty length (maximum length (field best size)) align))
             (false
               (union-layout
                 (field best anchor)
                 (field best anchor-size)
                 (maximum length (field best size))
                 (field best alignment))))))
        (union-layout-of c (m:next p id) next)))))

(base:function sum-layout ((c context) (ty u64)) union-layout
  (let ((empty t:type-ref (record-type c 0)))
    (union-layout-of c (check:type-components (field c program) ty) (union-layout empty 0 0 0))))

(base:function storage-type ((c context) (ty u64)) t:type-ref
  (let ((p m:context (field c program)) (owner llvm:session (field c owner)))
    (base:cond
      ((n:eq ty 2) (integer c 8))
      ((n:eq ty 14) (ir:void-type (field owner context)))
      ((match (check:type-kind p ty) (20 true) (22 true) (_ false))
       (record-type c (check:type-components p ty)))
      ((n:eq (check:type-kind p ty) 49)
       (let
         ((array
            t:type-ref
            (ir:array-type (storage-type c (check:array-element p ty)) (check:array-length p ty))))
         (ir:struct-type (field owner context) (& array) 1 0)))
      ((n:eq (check:type-kind p ty) 21)
       (let ((union union-layout (sum-layout c ty)) (buffer (pointer t:type-ref) (types c 2)))
         (do
           (store (deref buffer) (integer c 32))
           (match (field union size)
             (0 (ir:struct-type (field owner context) buffer 1 0))
             (_
               (let
                 ((members (pointer t:type-ref) (types c 2))
                  (tail u64 (n:sub (field union size) (field union anchor-size))))
                 (do
                   (store (deref members) (field union anchor))
                   (store (deref (pointer-offset members 1)) (ir:array-type (integer c 8) tail))
                   (store
                     (deref (pointer-offset buffer 1))
                     (ir:struct-type (field owner context) members (match tail (0 1) (_ 2)) 0))
                   (ir:struct-type (field owner context) buffer 2 0))))))))
      (true (layout:value-type p owner ty)))))

(base:function same-type ((a t:type-ref) (b t:type-ref)) bool
  (n:eq (m:address (cast (pointer void) a)) (m:address (cast (pointer void) b))))

; Allocate padded, zeroed storage when register coercions exceed an object's size.
(base:function repack ((c context) (value t:value-ref) (to t:type-ref)) t:value-ref
  (match (same-type (ir:value-type value) to)
    (true value)
    (false
      (let
        ((builder t:builder-ref (field (field c owner) builder))
         (length u64 (maximum (size c (ir:value-type value)) (size c to)))
         (buffer t:type-ref (ir:array-type (integer c 64) (n:div (n:add length 7) 8)))
         (address t:value-ref (ir:build-alloca builder buffer "abi.storage")))
        (do
          (ir:build-store builder (ir:const-null buffer) address)
          (ir:build-store builder value address)
          (ir:build-load builder to address ""))))))

(base:function convert-components
  ((c context) (fields u64) (source t:value-ref) (out t:value-ref) (index u32) (to-c bool))
  t:value-ref
  (match fields
    (0 out)
    (_
      (let
        ((p m:context (field c program))
         (builder t:builder-ref (field (field c owner) builder))
         (value
           t:value-ref
           (convert
             c
             (check:parameter-type p fields)
             (ir:build-extract builder source index "")
             to-c))
         (next t:value-ref (ir:build-insert builder out value index "")))
        (convert-components
          c
          (m:next p fields)
          source
          next
          (base:convert (n:add (base:convert index) 1))
          to-c)))))

(base:function convert-array ((c context) (ty u64) (value t:value-ref) (to-c bool)) t:value-ref
  (let
    ((p m:context (field c program))
     (owner llvm:session (field c owner))
     (builder t:builder-ref (field owner builder))
     (element u64 (check:array-element p ty))
     (length u64 (check:array-length p ty))
     (out-type
       t:type-ref
       (match to-c (true (storage-type c ty)) (false (layout:value-type p owner ty))))
     (in-element
       t:type-ref
       (match to-c (true (layout:value-type p owner element)) (false (storage-type c element))))
     (out-element
       t:type-ref
       (match to-c (true (storage-type c element)) (false (layout:value-type p owner element))))
     (source t:value-ref (ir:build-alloca builder (ir:value-type value) "abi.array.in"))
     (out t:value-ref (ir:build-alloca builder out-type "abi.array.out")))
    (do
      (ir:build-store builder value source)
      (ir:build-store builder (ir:const-null out-type) out)
      (match length
        (0 unit)
        (_
          (let
            ((start t:block-ref (ir:builder-block builder))
             (fn t:value-ref (ir:block-parent start))
             (loop t:block-ref (ir:block-append (field owner context) fn "abi.array"))
             (end t:block-ref (ir:block-append (field owner context) fn "abi.array.end")))
            (do
              (ir:build-br builder loop)
              (ir:builder-position builder loop)
              (let
                ((index t:value-ref (ir:build-phi builder (integer c 64) ""))
                 (input t:value-ref (ir:build-gep builder in-element source (& index) 1 ""))
                 (output t:value-ref (ir:build-gep builder out-element out (& index) 1 "")))
                (do
                  (llvm:incoming index (ir:const-int (integer c 64) 0 0) start)
                  (ir:build-store
                    builder
                    (convert c element (ir:build-load builder in-element input "") to-c)
                    output)
                  (let
                    ((next
                       t:value-ref
                       (ir:build-add builder index (ir:const-int (integer c 64) 1 0) ""))
                     (last t:block-ref (ir:builder-block builder)))
                    (do
                      (ir:build-cond-br
                        builder
                        (ir:build-icmp
                          builder
                          enum:int-ult
                          next
                          (ir:const-int (integer c 64) length 0)
                          "")
                        loop
                        end)
                      (llvm:incoming index next last)))))
              (ir:builder-position builder end)))))
      (ir:build-load builder out-type out ""))))

(base:function convert-cases
  ((c context)
   (ty u64)
   (cases u64)
   (tag t:value-ref)
   (source t:value-ref)
   (out t:value-ref)
   (to-c bool)
   (end t:block-ref)) unit
  (match cases
    (0 (do (ir:build-br (field (field c owner) builder) end) unit))
    (_
      (let
        ((p m:context (field c program))
         (owner llvm:session (field c owner))
         (builder t:builder-ref (field owner builder))
         (v m:node (m:at p cases))
         (index u64 (field v target))
         (fields u64 (m:next p (field v child)))
         (payload t:type-ref (record-type c fields))
         (fn t:value-ref (ir:block-parent (ir:builder-block builder)))
         (yes t:block-ref (ir:block-append (field owner context) fn "abi.case"))
         (no t:block-ref (ir:block-append (field owner context) fn "abi.case.next")))
        (do
          (ir:build-cond-br
            builder
            (ir:build-icmp builder enum:int-eq tag (ir:const-int (integer c 64) index 0) "")
            yes
            no)
          (ir:builder-position builder yes)
          (match (n:gt (size c payload) 0)
            (false unit)
            (true
              (match to-c
                (true
                  (let
                    ((value
                       t:value-ref
                       (ir:build-extract builder source (base:convert (n:add index 1)) ""))
                     (converted
                       t:value-ref
                       (convert-components c fields value (ir:const-null payload) 0 true))
                     (address t:value-ref (ir:struct-gep builder (storage-type c ty) out 1 "")))
                    (do (ir:build-store builder converted address) unit)))
                (false
                  (let
                    ((address t:value-ref (ir:struct-gep builder (storage-type c ty) source 1 ""))
                     (value t:value-ref (ir:build-load builder payload address ""))
                     (internal-types (pointer t:type-ref) (types c (check:chain-length p fields)))
                     (count u32 (layout:component-types p owner fields internal-types 0))
                     (internal
                       t:type-ref
                       (ir:struct-type (field owner context) internal-types count 0))
                     (converted
                       t:value-ref
                       (convert-components c fields value (ir:const-null internal) 0 false))
                     (whole t:type-ref (layout:value-type p owner ty))
                     (result
                       t:value-ref
                       (ir:build-insert
                         builder
                         (ir:build-load builder whole out "")
                         converted
                         (base:convert (n:add index 1))
                         "")))
                    (do (ir:build-store builder result out) unit))))))
          (ir:build-br builder end)
          (ir:builder-position builder no)
          (convert-cases c ty (field v next) tag source out to-c end))))))

(base:function convert-sum ((c context) (ty u64) (value t:value-ref) (to-c bool)) t:value-ref
  (let
    ((p m:context (field c program))
     (owner llvm:session (field c owner))
     (builder t:builder-ref (field owner builder))
     (internal t:type-ref (layout:value-type p owner ty))
     (external t:type-ref (storage-type c ty))
     (out-type t:type-ref (match to-c (true external) (false internal)))
     (out t:value-ref (ir:build-alloca builder out-type "abi.sum"))
     (raw t:value-ref (ir:build-extract builder value 0 ""))
     (tag t:value-ref (match to-c (true raw) (false (ir:build-zext builder raw (integer c 64) ""))))
     (source
       t:value-ref
       (match to-c
         (true value)
         (false
           (let ((address t:value-ref (ir:build-alloca builder external "")))
             (do (ir:build-store builder value address) address)))))
     (stored-tag
       t:value-ref
       (match to-c (true (ir:build-trunc builder tag (integer c 32) "")) (false tag)))
     (fn t:value-ref (ir:block-parent (ir:builder-block builder)))
     (end t:block-ref (ir:block-append (field owner context) fn "abi.sum.end")))
    (do
      (ir:build-store
        builder
        (ir:build-insert builder (ir:const-null out-type) stored-tag 0 "")
        out)
      (convert-cases c ty (check:type-components p ty) tag source out to-c end)
      (ir:builder-position builder end)
      (ir:build-load builder out-type out ""))))

(base:function convert ((c context) (ty u64) (value t:value-ref) (to-c bool)) t:value-ref
  (let
    ((p m:context (field c program))
     (owner llvm:session (field c owner))
     (builder t:builder-ref (field owner builder)))
    (match ty
      (2
        (match to-c
          (true (ir:build-trunc builder value (integer c 8) ""))
          (false (ir:build-zext builder value (integer c 64) ""))))
      (_
        (match (check:type-kind p ty)
          (20
            (let
              ((out-type
                 t:type-ref
                 (match to-c (true (storage-type c ty)) (false (layout:value-type p owner ty)))))
              (convert-components
                c
                (check:type-components p ty)
                value
                (ir:const-null out-type)
                0
                to-c)))
          (22
            (let
              ((out-type
                 t:type-ref
                 (match to-c (true (storage-type c ty)) (false (layout:value-type p owner ty)))))
              (convert-components
                c
                (check:type-components p ty)
                value
                (ir:const-null out-type)
                0
                to-c)))
          (21 (convert-sum c ty value to-c))
          (49 (convert-array c ty value to-c))
          (_ value))))))

; Classify native aggregate registers rather than passing the private SSA layout.
(base:type homogeneous (product (ty u64) (count u64)))

(base:function hfa-fields ((c context) (id u64) (best homogeneous)) homogeneous
  (match id
    (0 best)
    (_
      (let ((p m:context (field c program)) (part homogeneous (hfa c (check:parameter-type p id))))
        (match (n:eq (size c (storage-type c (check:parameter-type p id))) 0)
          (true (hfa-fields c (m:next p id) best))
          (false
            (match
              (match (n:eq (field part ty) 0)
                (true true)
                (false
                  (match (field best count)
                    (0 false)
                    (_ (match (n:eq (field best ty) (field part ty)) (true false) (false true))))))
              (true (homogeneous 0 0))
              (false
                (hfa-fields
                  c
                  (m:next p id)
                  (homogeneous (field part ty) (n:add (field best count) (field part count))))))))))))

(base:function hfa ((c context) (ty u64)) homogeneous
  (let ((p m:context (field c program)))
    (match ty
      (12 (homogeneous 12 1))
      (13 (homogeneous 13 1))
      (_
        (match (check:type-kind p ty)
          (20 (hfa-fields c (check:type-components p ty) (homogeneous 0 0)))
          (49
            (let ((element homogeneous (hfa c (check:array-element p ty))))
              (homogeneous
                (field element ty)
                (n:mul (field element count) (check:array-length p ty)))))
          (_ (homogeneous 0 0)))))))

; SysV merges every eightbyte touched by an integer/pointer field into INTEGER;
; a chunk containing only floating fields is SSE. Large objects use memory.
(base:function classify-chunk ((classes (pointer u64)) (offset u64) (length u64) (kind u64)) unit
  (match length
    (0 unit)
    (_
      (let ((index u64 (n:div offset 8)) (old u64 (deref (pointer-offset classes index))))
        (do
          (store (deref (pointer-offset classes index)) (match old (1 1) (_ kind)))
          (match (n:gt (n:add (num:remainder offset 8) length) 8)
            (true (store (deref (pointer-offset classes (n:add index 1))) kind))
            (false unit))
          unit)))))

(base:function classify-fields
  ((c context) (fields u64) (ty t:type-ref) (offset u64) (index u32) (classes (pointer u64))) unit
  (match fields
    (0 unit)
    (_
      (let
        ((p m:context (field c program))
         (position u64 (n:add offset (target:element-offset (field c data) ty index))))
        (do
          (classify c (check:parameter-type p fields) position classes)
          (classify-fields
            c
            (m:next p fields)
            ty
            offset
            (base:convert (n:add (base:convert index) 1))
            classes))))))

(base:function classify-elements
  ((c context) (ty u64) (offset u64) (length u64) (stride u64) (classes (pointer u64))) unit
  (match length
    (0 unit)
    (_
      (do
        (classify c ty offset classes)
        (classify-elements c ty (n:add offset stride) (n:sub length 1) stride classes)))))

(base:function classify-cases ((c context) (id u64) (offset u64) (classes (pointer u64))) unit
  (match id
    (0 unit)
    (_
      (let ((p m:context (field c program)) (fields u64 (m:next p (m:child p id))))
        (do
          (classify-fields c fields (record-type c fields) offset 0 classes)
          (classify-cases c (m:next p id) offset classes))))))

(base:function classify ((c context) (ty u64) (offset u64) (classes (pointer u64))) unit
  (let ((p m:context (field c program)) (storage t:type-ref (storage-type c ty)))
    (match (check:type-kind p ty)
      (20 (classify-fields c (check:type-components p ty) storage offset 0 classes))
      (21
        (do
          (classify-chunk classes offset 4 1)
          (match (field (sum-layout c ty) size)
            (0 unit)
            (_
              (classify-cases
                c
                (check:type-components p ty)
                (n:add offset (target:element-offset (field c data) storage 1))
                classes)))))
      (49
        (let ((element u64 (check:array-element p ty)))
          (classify-elements
            c
            element
            offset
            (check:array-length p ty)
            (size c (storage-type c element))
            classes)))
      (_
        (classify-chunk
          classes
          offset
          (size c storage)
          (match (num:float-type ty) (true 2) (false 1)))))))

; A SysV register aggregate may occupy two distinct LLVM parameters. The sum
; keeps register counts and pieces out of ignored and indirect passing modes.
(base:type passing
  (sum
    (ignored t:type-ref)
    (registers t:type-ref u64 u64 u64)
    (indirect t:type-ref)))

(base:function passing-representation ((value passing)) t:type-ref
  (match value
    ((ignored representation) representation)
    ((registers representation _ _ _) representation)
    ((indirect representation) representation)))

(base:function passing-pieces ((value passing)) u64
  (match value ((ignored _) 0) ((registers _ pieces _ _) pieces) ((indirect _) 1)))

(base:function passing-ints ((value passing)) u64
  (match value ((registers _ _ ints _) ints) (_ 0)))

(base:function passing-floats ((value passing)) u64
  (match value ((registers _ _ _ floats) floats) (_ 0)))

(base:function sret ((value passing)) u64
  (match value ((indirect _) 1) (_ 0)))

(base:function aggregate ((c context) (ty u64)) bool
  (match (check:type-kind (field c program) ty) (20 true) (21 true) (49 true) (_ false)))

(base:function chunk-type ((c context) (kind u64) (length u64)) t:type-ref
  (match kind
    (2
      (match (n:le length 4)
        (true (ir:float-type (field (field c owner) context)))
        (false (ir:double-type (field (field c owner) context)))))
    (_ (integer c (base:convert (n:mul length 8))))))

(base:function passing-for ((c context) (ty u64) (return bool) (ints u64) (floats u64)) passing
  (let ((owner llvm:session (field c owner)) (storage t:type-ref (storage-type c ty)))
    (base:cond
      ((n:eq ty 14) (ignored storage))
      ((match (aggregate c ty) (true false) (false true))
       (registers
         (match ty (2 (integer c 1)) (_ storage))
         1
         (match (num:float-type ty) (true 0) (false 1))
         (match (num:float-type ty) (true 1) (false 0))))
      ((n:eq (size c storage) 0) (ignored (ir:void-type (field owner context))))
      ((match (config:x86 (field c program)) (true false) (false true))
       (let ((homogeneous homogeneous (hfa c ty)) (length u64 (size c storage)))
         (base:cond
           ((match (n:gt (field homogeneous ty) 0)
              (true (n:le (field homogeneous count) 4))
              (false false))
            (registers
              (match return
                (true storage)
                (false
                  (ir:array-type (storage-type c (field homogeneous ty)) (field homogeneous count))))
              1
              0
              (field homogeneous count)))
           ((n:gt length 16) (indirect storage))
           ((n:gt length 8) (registers (ir:array-type (integer c 64) 2) 1 2 0))
           (true
             (registers
               (integer c (match return (true (base:convert (n:mul length 8))) (false 64)))
               1
               1
               0)))))
      ((n:gt (size c storage) 16) (indirect storage))
      (true
        (let
          ((classes (tuple u64 u64) (tuple 0 0))
           (length u64 (size c storage))
           (buffer (pointer u64) (cast (pointer u64) (cast (pointer void) (& classes))))
           (classified unit (classify c ty 0 buffer))
           (first u64 (tuple-get classes 0))
           (second u64 (tuple-get classes 1))
           (integer-count u64 (n:add (match first (1 1) (_ 0)) (match second (1 1) (_ 0))))
           (float-count u64 (n:add (match first (2 1) (_ 0)) (match second (2 1) (_ 0)))))
          (match
            (match return
              (true false)
              (false
                (match (n:gt (n:add ints integer-count) 6)
                  (true true)
                  (false (n:gt (n:add floats float-count) 8)))))
            (true (indirect storage))
            (false
              (let
                ((members (pointer t:type-ref) (types c 2))
                 (first-type
                   t:type-ref
                   (chunk-type c first (match (n:gt length 8) (true 8) (false length)))))
                (do
                  (store (deref members) first-type)
                  (match (n:gt length 8)
                    (false (registers first-type 1 integer-count float-count))
                    (true
                      (do
                        (store
                          (deref (pointer-offset members 1))
                          (chunk-type c second (n:sub length 8)))
                        (registers
                          (ir:struct-type (field owner context) members 2 0)
                          2
                          integer-count
                          float-count)))))))))))))

(base:function count-ints ((old u64) (add u64)) u64
  (minimum (n:add old add) 6))

(base:function count-floats ((old u64) (add u64)) u64
  (minimum (n:add old add) 8))

(base:function function-parameters
  ((c context) (params u64) (out (pointer t:type-ref)) (index u64) (ints u64) (floats u64)) u32
  (match params
    (0 (base:convert index))
    (_
      (let
        ((p m:context (field c program))
         (ty u64 (check:parameter-type p params))
         (pass passing (passing-for c ty false ints floats)))
        (do
          (match pass
            ((ignored _) unit)
            ((indirect _) (store (deref (pointer-offset out index)) (pointer c)))
            ((registers representation pieces _ _)
              (match pieces
                (2
                  (do
                    (store
                      (deref (pointer-offset out index))
                      (ir:struct-element representation 0))
                    (store
                      (deref (pointer-offset out (n:add index 1)))
                      (ir:struct-element representation 1))
                    unit))
                (_ (store (deref (pointer-offset out index)) representation)))))
          (function-parameters
            c
            (m:next p params)
            out
            (n:add index (passing-pieces pass))
            (count-ints ints (passing-ints pass))
            (count-floats floats (passing-floats pass))))))))

(base:function function-type ((c context) (params u64) (result u64)) t:type-ref
  (let
    ((pass passing (passing-for c result true 0 0))
     (buffer (pointer t:type-ref) (types c 129))
     (sret u64 (sret pass))
     (stored unit (match sret (1 (do (store (deref buffer) (pointer c)) unit)) (_ unit)))
     (count
       u32
       (function-parameters
         c
         params
         buffer
         sret
         (match (config:x86 (field c program)) (true sret) (false 0))
         0))
     (return-type
       t:type-ref
       (match pass
         ((indirect _) (ir:void-type (field (field c owner) context)))
         (_ (passing-representation pass)))))
    (ir:function-type return-type buffer count 0)))

(base:function add-attribute
  ((value t:value-ref) (index u32) (attribute t:attribute-ref) (call bool)) unit
  (match call
    (true (ir:call-attribute value index attribute))
    (false (ir:function-attribute value index attribute))))

(base:function enum-attribute ((c context) (name (pointer u8)) (value u64)) t:attribute-ref
  (ir:enum-attribute
    (field (field c owner) context)
    (ir:attribute-kind name (cstring:strlen name))
    value))

(base:function typed-attribute ((c context) (name (pointer u8)) (ty t:type-ref)) t:attribute-ref
  (ir:type-attribute
    (field (field c owner) context)
    (ir:attribute-kind name (cstring:strlen name))
    ty))

(base:function extension ((c context) (value t:value-ref) (index u32) (ty u64) (call bool)) unit
  (base:cond
    ((n:eq ty 2) (add-attribute value index (enum-attribute c "zeroext" 0) call))
    ((match (num:integer-type ty) (true (n:lt (num:width ty) 32)) (false false))
     (add-attribute
       value
       index
       (enum-attribute c (match (num:signed-type ty) (true "signext") (false "zeroext")) 0)
       call))
    (true unit)))

(base:function parameter-attributes
  ((c context) (value t:value-ref) (params u64) (index u64) (ints u64) (floats u64) (call bool))
  unit
  (match params
    (0 unit)
    (_
      (let
        ((p m:context (field c program))
         (ty u64 (check:parameter-type p params))
         (pass passing (passing-for c ty false ints floats)))
        (do
          (match pass
            ((indirect representation)
              (do
                (match (config:x86 (field c program))
                  (true
                    (add-attribute
                      value
                      (base:convert index)
                      (typed-attribute c "byval" representation)
                      call))
                  (false unit))
                (add-attribute
                  value
                  (base:convert index)
                  (enum-attribute c "align" (alignment c representation))
                  call)))
            ((registers _ _ _ _) (extension c value (base:convert index) ty call))
            (_ unit))
          (parameter-attributes
            c
            value
            (m:next p params)
            (n:add index (passing-pieces pass))
            (count-ints ints (passing-ints pass))
            (count-floats floats (passing-floats pass))
            call))))))

(base:function attributes ((c context) (value t:value-ref) (params u64) (result u64) (call bool))
  unit
  (let
    ((pass passing (passing-for c result true 0 0))
     (sret u64 (sret pass)))
    (do
      (match sret
        (1
          (do
            (add-attribute value 1 (typed-attribute c "sret" (passing-representation pass)) call)
            (add-attribute
              value
              1
              (enum-attribute c "align" (alignment c (passing-representation pass)))
              call)))
        (_ (extension c value 0 result call)))
      (parameter-attributes
        c
        value
        params
        (n:add sret 1)
        (match (config:x86 (field c program)) (true sret) (false 0))
        0
        call))))

(base:function native-function ((c context) (name (pointer u8)) (signature t:type-ref)) t:value-ref
  (let
    ((owner llvm:session (field c owner))
     (existing t:value-ref (ir:function-get (field owner module) name))
     (function t:value-ref
       (match (is-null existing)
         (true (ir:function-add (field owner module) name signature))
         (false
           (do
             (match
               (match (same-type (ir:function-type-of existing) signature)
                 (true (match (ir:linkage-get existing) (8 false) (_ true)))
                 (false false))
               (true unit)
               (false (m:fatal "external symbol conflicts with a runtime declaration")))
             existing)))))
    function))

(base:function declare ((c context) (name (pointer u8)) (params u64) (result u64)) t:value-ref
  (let ((function t:value-ref (native-function c name (function-type c params result))))
    (do (attributes c function params result false) function)))

(base:function native-arguments
  ((c context)
   (params u64)
   (source (pointer t:value-ref))
   (source-index u64)
   (out (pointer t:value-ref))
   (index u64)
   (ints u64)
   (floats u64)) u32
  (match params
    (0 (base:convert index))
    (_
      (let
        ((p m:context (field c program))
         (builder t:builder-ref (field (field c owner) builder))
         (ty u64 (check:parameter-type p params))
         (pass passing (passing-for c ty false ints floats))
         (value t:value-ref (convert c ty (deref (pointer-offset source source-index)) true)))
        (do
          (match pass
            ((ignored _) unit)
            ((indirect representation)
              (let
                ((address
                   t:value-ref
                   (ir:build-alloca builder representation "abi.argument")))
                (do
                  (ir:build-store builder value address)
                  (store (deref (pointer-offset out index)) address)
                  unit)))
            ((registers representation pieces _ _)
              (let ((coerced t:value-ref (repack c value representation)))
                (match pieces
                  (2
                    (do
                      (store
                        (deref (pointer-offset out index))
                        (ir:build-extract builder coerced 0 ""))
                      (store
                        (deref (pointer-offset out (n:add index 1)))
                        (ir:build-extract builder coerced 1 ""))
                      unit))
                  (_ (do (store (deref (pointer-offset out index)) coerced) unit))))))
          (native-arguments
            c
            (m:next p params)
            source
            (n:add source-index 1)
            out
            (n:add index (passing-pieces pass))
            (count-ints ints (passing-ints pass))
            (count-floats floats (passing-floats pass))))))))

(base:function call
  ((c context) (function t:value-ref) (params u64) (result u64) (args (pointer t:value-ref)))
  t:value-ref
  (let
    ((p m:context (field c program))
     (owner llvm:session (field c owner))
     (builder t:builder-ref (field owner builder))
     (pass passing (passing-for c result true 0 0))
     (buffer (pointer t:value-ref) (layout:values p 129))
     (sret u64 (sret pass))
     (address
       t:value-ref
       (match sret
         (1 (ir:build-alloca builder (passing-representation pass) "abi.result"))
         (_ function)))
     (stored unit (match sret (1 (do (store (deref buffer) address) unit)) (_ unit)))
     (count
       u32
       (native-arguments
         c
         params
         args
         0
         buffer
         sret
         (match (config:x86 (field c program)) (true sret) (false 0))
         0))
     (value
       t:value-ref
       (ir:build-call builder (function-type c params result) function buffer count "")))
    (do
      (attributes c value params result true)
      (match pass
        ((ignored _)
          (match result
            (14 (ir:const-int (integer c 64) 0 0))
            (_ (ir:const-null (layout:value-type p owner result)))))
        ((indirect representation) (convert c result (ir:build-load builder representation address "") false))
        ((registers _ _ _ _) (convert c result (repack c value (storage-type c result)) false))))))

(base:function adapter-arguments
  ((c context)
   (function t:value-ref)
   (params u64)
   (out (pointer t:value-ref))
   (source-index u64)
   (index u64)
   (ints u64)
   (floats u64)) u32
  (match params
    (0 (base:convert index))
    (_
      (let
        ((p m:context (field c program))
         (builder t:builder-ref (field (field c owner) builder))
         (ty u64 (check:parameter-type p params))
         (pass passing (passing-for c ty false ints floats))
         (value
           t:value-ref
           (match pass
             ((ignored _) (ir:const-null (storage-type c ty)))
             ((indirect representation)
               (ir:build-load
                 builder
                 representation
                 (ir:function-param function (base:convert source-index))
                 ""))
             ((registers representation pieces _ _)
               (let
                 ((native
                    t:value-ref
                    (match pieces
                      (2
                        (ir:build-insert
                          builder
                          (ir:build-insert
                            builder
                            (ir:const-null representation)
                            (ir:function-param function (base:convert source-index))
                            0
                            "")
                          (ir:function-param function (base:convert (n:add source-index 1)))
                          1
                          ""))
                      (_ (ir:function-param function (base:convert source-index))))))
                 (repack c native (storage-type c ty)))))))
        (do
          (store (deref (pointer-offset out index)) (convert c ty value false))
          (adapter-arguments
            c
            function
            (m:next p params)
            out
            (n:add source-index (passing-pieces pass))
            (n:add index 1)
            (count-ints ints (passing-ints pass))
            (count-floats floats (passing-floats pass))))))))

(base:function adapter
  ((c context) (name (pointer u8)) (internal t:value-ref) (params u64) (result u64)) t:value-ref
  (let
    ((owner llvm:session (field c owner))
     (builder t:builder-ref (field owner builder))
     (function t:value-ref (native-function c name (function-type c params result)))
     (entry t:block-ref (ir:block-append (field owner context) function "entry"))
     (pass passing (passing-for c result true 0 0))
     (sret u64 (sret pass))
     (args (pointer t:value-ref) (layout:values (field c program) 64)))
    (do
      (ir:linkage-set function enum:linkage-internal)
      (attributes c function params result false)
      (ir:builder-position builder entry)
      (let
        ((count
           u32
           (adapter-arguments
             c
             function
             params
             args
             sret
             0
             (match (config:x86 (field c program)) (true sret) (false 0))
             0))
         (value
           t:value-ref
           (ir:build-call builder (ir:function-type-of internal) internal args count "")))
        (match pass
          ((ignored _) (do (ir:build-ret-void builder) unit))
          ((indirect _)
            (do
              (ir:build-store builder (convert c result value true) (ir:function-param function 0))
              (ir:build-ret-void builder)
              unit))
          ((registers representation _ _ _)
            (do
              (ir:build-ret
                builder
                (repack c (convert c result value true) representation))
              unit))))
      function)))

(base:function compatible ((p m:context) (signature u64)) bool
  (let ((v m:node (m:at p signature)))
    (match (check:c-components p (field v child) (m:empty-env))
      (false false)
      (true (match (field v target) (14 true) (result (check:c-value-type p result (m:empty-env))))))))

(export
  storage-type
  convert
  context
  create
  destroy
  function-type
  declare
  call
  adapter
  compatible
  native-function)
