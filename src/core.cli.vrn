(import base)
(import core.constants :as constants)
(import allocator)
(import arena)
(import data)
(import system_allocator :as system)
(import libc.stdio :as stdio)
(import libc.filesystem :as fs)
(import libc.errno :as errno)
(import libc.constants :as c)
(import libc.types :as types)
(import libc.descriptor :as fd)
(import libc.process :as process)
(import libc.string :as cstring)
(import core.model :as m)
(import core.reader :as reader)
(import core.source :as source)
(import core.modules :as modules)
(import array)
(import error)
(import core.check :as check)
(import core.eval :as eval)
(import core.emit :as emit)
(import core.inline :as inline)
(import core.passes :as optimization)
(import core.link :as link)
(import core.header :as header)
(import core.format :as format)
(import core.configuration :as config)
(import core.target :as backend-target)
(import core.build :as build)
(import llvm)
(import llvm.core :as ir)
(import llvm.enums :as enum)
(import llvm.types :as t)
(import llvm.target :as target)
(import llvm.passes :as passes)

(base:type machine-options
  (product (triple (pointer u8)) (cpu (pointer u8)) (features (pointer u8))))

(base:type source-state
  (product (path (pointer u8)) (provided bool) (stopped bool)))

(base:type build-state
  (product
    (target (pointer u8))
    (output (pointer u8))
    (operands u64)
    (stopped bool)))

; Compare two borrowed NUL-terminated strings for exact byte equality.
(base:function equal ((x (pointer u8)) (y (pointer u8))) bool
  (match (cstring:strcmp x y) (0 true) (_ false)))

; Print an i64 decimal result to stdout without a newline.
; Format negative magnitudes with unsigned arithmetic so minBound remains representable.
(base:function signed-number ((value i64)) unit
  (let ((bits u64 (base:convert value)))
    (match (< value 0)
      (true (do (m:text c:STDOUT-FILENO "-") (m:number 1 (- 0 bits))))
      (false (m:number 1 bits)))))

; Wait for the selected child, retrying interrupted waits; return true only for status zero.
(base:function wait-result ((pid i32)) bool
  (let ((status i32 0) (result i32 (process:waitpid pid (& status) 0)))
    (match result
      (-1
        (match (== (deref (errno:errno-pointer)) c:EINTR)
          (true (wait-result pid))
          (false false)))
      (_ (match status (0 true) (_ false))))))

; Run Clang with owned argv storage. Option strings are borrowed; generated
; library flags live in MEMORY until the parent has waited for the child.
(base:function native-tool
  ((input (pointer u8))
   (output (pointer u8))
   (config link:options)
   (kind (pointer u8))
   (platform (pointer u8))) bool
  (let
    ((configured
       (pointer u8)
       (process:getenv
         (match (equal kind "static-library")
           (true "VERONA_CORE_AR")
           (false "VERONA_CORE_CLANG"))))
     (fallback
       (pointer u8)
       (process:getenv
         (match (equal kind "static-library")
           (true "VERONA_AR")
           (false "VERONA_LINKER"))))
     (tool
       (pointer u8)
       (match (base:is-null (cast (pointer void) configured))
         (true
           (match (base:is-null (cast (pointer void) fallback))
             (true
               (match (equal kind "static-library") (true "ar") (false "clang")))
             (false fallback)))
         (false configured)))
     (memory arena:arena (arena:create (system:create) 4096))
     (args link:strings-array (link:strings-new (system:create)))
     (status
       error:status
       (link:artifact-arguments-for
         (& args)
         (& memory)
         tool
         input
         output
         config
         kind
         platform))
     (result
       bool
       (match status
         ((ok)
          (let ((pid i32 (process:fork)))
            (match pid
              (-1 false)
              (0
                (do
                  (process:execvp tool (tuple-get args 0))
                  (process:exit 127)
                  false))
              (_ (wait-result pid)))))
         (_
           (do
             (m:text
               c:STDERR-FILENO
               "cannot allocate native linker arguments\n")
             false)))))
    (do (link:strings-destroy (& args)) (arena:destroy (& memory)) result)))

; Release a transferred LLVM diagnostic/text message if nonnull, including success messages.
(base:function dispose-message ((message (pointer u8))) unit
  (match (base:is-null message)
    (true unit)
    (false (do (ir:message-dispose message) unit))))

; Print a transferred LLVM diagnostic (or fallback text) and release the message.
(base:function llvm-error ((message (pointer u8))) unit
  (do
    (m:text c:STDERR-FILENO "LLVM: ")
    (match (base:is-null message)
      (true (m:text c:STDERR-FILENO "operation failed"))
      (false (m:text c:STDERR-FILENO message)))
    (m:text c:STDERR-FILENO "\n")
    (dispose-message message)
    unit))

; Object output has no linker or entry wrapper. Own every LLVM diagnostic.
(base:function emit-object
  ((owner llvm:session) (machine t:machine-ref) (output (pointer u8))) exit-code
  (let
    ((message (pointer u8) (cast (pointer u8) (target:null-pointer)))
     (status
       i32
       (target:emit-file
         machine
         (field owner module)
         output
         enum:object-file
         (& message))))
    (match status
      (0 (do (dispose-message message) 0))
      (_ (do (llvm-error message) 2)))))

; Emit an object to a private mkstemp file, invoke the native linker, and remove the file.
; Borrow the LLVM session/machine and return zero on success or compiler-error status on failure.
(base:function object-and-link
  ((c m:context)
   (owner llvm:session)
   (machine t:machine-ref)
   (output (pointer u8))
   (links link:options)
   (kind (pointer u8))) exit-code
  (let ((path data:data (data:empty (arena:allocator (field c memory)))))
    (do
      (m:storage
        (data:assign-bytes
          (& path)
          (data:view
            constants:temporary-object-template
            (+ (cstring:strlen constants:temporary-object-template) 1))))
      (let ((descriptor i32 (fs:mkstemp (data:bytes path))))
        (match descriptor
          (-1
            (do
              (m:text c:STDERR-FILENO "cannot create temporary object file\n")
              2))
          (_
            (let ((closed i32 (fd:close descriptor)))
              (match closed
                (0
                  (let
                    ((message
                       (pointer u8)
                       (cast (pointer u8) (target:null-pointer)))
                     (status
                       i32
                       (target:emit-file
                         machine
                         (field owner module)
                         (data:bytes path)
                         enum:object-file
                         (& message)))
                     (result
                       exit-code
                       (match status
                         (0
                           (do
                             (dispose-message message)
                             (match
                               (native-tool
                                 (data:bytes path)
                                 output
                                 links
                                 kind
                                 (config:target-platform c))
                               (true 0)
                               (false
                                 (do
                                   (m:text
                                     c:STDERR-FILENO
                                     "native compilation failed\n")
                                   2)))))
                         (_ (do (llvm-error message) 2)))))
                    (do (fs:unlink (data:bytes path)) result)))
                (_
                  (do
                    (fs:unlink (data:bytes path))
                    (m:text
                      c:STDERR-FILENO
                      "cannot close temporary object file\n")
                    2))))))))))

(base:function optimization-level ((level (pointer u8))) i32
  (base:cond
    ((equal level "-O0") 0)
    ((equal level "-O1") 1)
    ((equal level "-O2") 2)
    (true 3)))

; Target-aware middle-end passes run once before any native output is written.
; O0 keeps the unoptimized baseline. emit-llvm prints the pre-pipeline module.
; Verify after the pipeline as well as before it; own diagnostics on every path.
(base:function optimize-native
  ((owner llvm:session) (machine t:machine-ref) (level (pointer u8))) exit-code
  (match (equal level "-O0")
    (true 0)
    (false
      (let
        ((pipeline
           (pointer u8)
           (base:cond
             ((equal level "-O1") "default<O1>")
             ((equal level "-O2") "default<O2>")
             (true "default<O3>")))
         (message (pointer u8) (cast (pointer u8) (target:null-pointer)))
         (status
           i32
           (do
             ; Passes can erase blocks that the lowering builder still points at.
             (ir:builder-clear (field owner builder))
             (passes:run (field owner module) machine pipeline (& message))))
         (verified
           i32
           (match status (0 (llvm:verify owner (& message))) (_ status))))
        (match verified
          (0 (do (dispose-message message) 0))
          (_ (do (llvm-error message) 2)))))))

; Create and own a native LLVM target machine while emitting/linking the borrowed module.
; Release the machine and transferred diagnostics before returning the command status.
(base:function compile
  ((c m:context)
   (all u64)
   (owner llvm:session)
   (output (pointer u8))
   (optimization (pointer u8))
   (links link:options)
   (kind (pointer u8))) exit-code
  (let
    ((message (pointer u8) (cast (pointer u8) (target:null-pointer)))
     (machine
       t:machine-ref
       (backend-target:configured-machine
         c
         (field owner module)
         (optimization-level optimization)
         (& message))))
    (match (base:is-null machine)
      (true (do (llvm-error message) 2))
      (false
        (do
          (dispose-message message)
          (let
            ((result
               exit-code
               (match (optimize-native owner machine optimization)
                 (0
                   (do
                     (inline:remarks c owner all all (equal optimization "-O0"))
                     (match (equal kind "object")
                       (true (emit-object owner machine output))
                       (false
                         (object-and-link c owner machine output links kind)))))
                 (failure failure))))
            (do (target:machine-dispose machine) result)))))))

; Build and verify an owned LLVM session, then print IR or compile the executable.
; Release printed text, diagnostics, and the session before returning.
(base:function generate
  ((c m:context)
   (all u64)
   (main u64)
   (mode (pointer u8))
   (output (pointer u8))
   (optimization (pointer u8))
   (links link:options)
   (kind (pointer u8))) exit-code
  (let
    ((snapshot
       unit
       (match (equal mode "optimization-report")
         (true (optimization:dump c "before-lowering"))
         (false unit)))
     (owner
       llvm:session
       (emit:build
         c
         all
         main
         (equal mode "compile-report")
         (base:or
           (equal mode "emit-llvm")
           (equal mode "optimization-report")
           (base:not (equal optimization "-O0")))
         (equal mode "optimization-report")))
     (message (pointer u8) (cast (pointer u8) (target:null-pointer)))
     (status i32 (llvm:verify owner (& message)))
     (result
       exit-code
       (match status
         (0
           (do
             (dispose-message message)
             (match (equal mode "optimization-report")
               (true (do (optimization:dump c "after-lowering") 0))
               (false
                 (match (equal mode "emit-llvm")
                   (true
                     (let
                       ((text
                          (pointer u8)
                          (ir:module-string (field owner module))))
                       (do
                         (m:text c:STDOUT-FILENO text)
                         (ir:message-dispose text)
                         0)))
                   (false
                     (let
                       ((code
                          exit-code
                          (compile c all owner output optimization links kind)))
                       (match
                         (base:and-then
                           (== code 0)
                           (base:or
                             (equal kind "static-library")
                             (equal kind "shared-library")))
                         (true
                           (match (header:write c all output)
                             (true 0)
                             (false 2)))
                         (false code)))))))))
         (_ (do (llvm-error message) 2)))))
    (do (llvm:destroy owner) result)))

; Read a source file for syntax inspection.
; Own the source/tape arena for this invocation and destroy it on normal command return.
(base:function execute-reader
  ((path (pointer u8)) (requested (pointer u8)) (features (pointer void)))
  exit-code
  (let
    ((memory
       arena:arena
       (arena:create (system:create) constants:initial-arena-bytes))
     (input data:data (data:empty (arena:allocator (& memory))))
     (configuration
       config:configuration
       (backend-target:resolve (& memory) requested "generic" "" 0 features))
     (items m:tape (m:empty (arena:allocator (& memory))))
     (file (pointer types:file-stream) (stdio:fopen path "rb")))
    (do
      (match (base:is-null (cast (pointer void) file))
        (true (m:fatal "cannot open source file"))
        (false unit))
      (match (source:read-open file (& input))
        ((ok) unit)
        ((invalid-input) (m:fatal "cannot read source file"))
        (status (m:storage status)))
      (let
        ((errors u64 0)
         (c
           m:context
           (m:context
             path
             (data:borrow input)
             (& items)
             (& memory)
             (& errors)
             (m:empty-env)
             0)))
        (do
          (reader:dump-with-features c (field configuration features))
          (arena:destroy (& memory))
          0)))))

(base:function link-policy ((links link:options) (platform (pointer u8))) unit
  (match
    (base:and
      (> (link:strings-length (field links frameworks)) 0)
      (base:not (equal platform "darwin")))
    (true (m:fatal "frameworks are supported only on Darwin targets"))
    (false unit)))

; Return the final dot after DIRECTORY, or END when the filename has no extension.
(base:function source-extension
  ((path (pointer u8)) (index u64) (end u64) (directory u64) (last u64)) u64
  (match (== index end)
    (true last)
    (false
      (source-extension
        path
        (+ index 1)
        end
        directory
        (match (deref (pointer-offset path index))
          (46 (match (> index directory) (true index) (false last)))
          (_ last))))))

; Match the reference driver's source-adjacent default artifact names.
(base:function default-output
  ((memory (pointer arena:arena))
   (path (pointer u8))
   (kind (pointer u8))
   (platform (pointer u8))) (pointer u8)
  (let
    ((length u64 (cstring:strlen path))
     (directory u64 (modules:directory-end path 0 length))
     (stem-end u64 (source-extension path directory length directory length))
     (out data:data (data:empty (arena:allocator memory))))
    (do
      (m:storage
        (format:append-view (& out) (data:view path length) 0 directory))
      (match
        (base:or (equal kind "static-library") (equal kind "shared-library"))
        (true (format:append (& out) "lib"))
        (false unit))
      (match (== directory stem-end)
        (true (format:append (& out) "a.out"))
        (false
          (m:storage
            (format:append-view
              (& out)
              (data:view path length)
              directory
              (- stem-end directory)))))
      (base:cond
        ((equal kind "object") (format:append (& out) ".o"))
        ((equal kind "static-library") (format:append (& out) ".a"))
        ((equal kind "shared-library")
         (format:append
           (& out)
           (match (equal platform "darwin") (true ".dylib") (false ".so"))))
        (true unit))
      (m:storage (data:append (& out) 0))
      (data:bytes out))))

; Load named modules once using the configured search path and execute the command.
(base:function execute
  ((mode (pointer u8))
   (path (pointer u8))
   (output (pointer u8))
   (optimization (pointer u8))
   (roots modules:paths-array)
   (links link:options)
   (kind (pointer u8))
   (requested (pointer u8))
   (cpu (pointer u8))
   (machine-features (pointer u8))
   (features (pointer void))
   (selected (pointer void))) exit-code
  (match (equal mode "read")
    (true (execute-reader path requested features))
    (false
      (let
        ((memory
           arena:arena
           (arena:create (system:create) constants:initial-arena-bytes))
         (configuration
           config:configuration
           (match (base:is-null selected)
             (true
               (backend-target:resolve
                 (& memory)
                 requested
                 cpu
                 machine-features
                 (optimization-level optimization)
                 features))
             (false (deref (cast (pointer config:configuration) selected)))))
         (items m:tape (m:empty (arena:allocator (& memory))))
         (errors u64 0)
         (files
           m:modules-array
           (m:modules-empty
             (cast (pointer m:module-info) (m:empty-env))
             (array:layout
               constants:module-byte-size
               constants:node-alignment
               (arena:allocator (& memory)))))
         (edges
           m:imports-array
           (m:imports-empty
             (cast (pointer m:import-info) (m:empty-env))
             (array:layout
               constants:import-byte-size
               constants:node-alignment
               (arena:allocator (& memory)))))
         (session
           m:module-session
           (m:module-session
             (& files)
             (& edges)
             0
             0
             (cast (pointer void) (& configuration))
             0))
         (source data:data (data:empty (arena:allocator (& memory))))
         (search modules:paths-array roots)
         (loader
           modules:loader
           (modules:loader
             (& memory)
             (& source)
             (& items)
             (& session)
             (& errors)
             (& search)))
         (policy unit (link-policy links (field configuration platform)))
         (functions u64 (modules:run loader path))
         (c m:context (modules:context loader))
         (main
           u64
           (check:check-with-entry c functions (equal kind "executable")))
         (actual-output
           (pointer u8)
           (match (equal output "")
             (true
               (default-output
                 (& memory)
                 path
                 kind
                 (field configuration platform)))
             (false output)))
         (result
           exit-code
           (base:cond
             ((> errors 0) 2)
             ((equal mode "check") 0)
             ((base:and (equal mode "eval") (check:command-line-main c main))
              (do
                (m:report
                  c
                  main
                  "eval requires a parameterless main; command-line arguments are unavailable")
                2))
             ((equal mode "eval")
              (let
                ((args eval:values-array (eval:values-new (system:create)))
                 (outcome
                   eval:outcome
                   (eval:run
                     c
                     main
                     args
                     (eval:options 0 constants:evaluator-call-depth-limit)
                     (system:create)))
                 (code
                   exit-code
                   (match (field outcome code)
                     (0
                       (do
                         (match (field (field outcome result) ty)
                           (3
                             (signed-number
                               (field (field outcome result) scalar)))
                           (_
                             (eval:write-value
                               c
                               (field outcome aggregates)
                               (field outcome result))))
                         (m:text c:STDOUT-FILENO "\n")
                         0))
                     (_
                       (do
                         (eval:report c outcome)
                         constants:runtime-failure-status)))))
                (do
                  (eval:destroy (& outcome))
                  (eval:values-destroy (& args))
                  code)))
             (true
               (generate
                 c
                 functions
                 main
                 mode
                 actual-output
                 optimization
                 links
                 kind)))))
        (do (arena:destroy (& memory)) result)))))

; Print the compact top-level synopsis used with malformed invocations.
(base:function usage () exit-code
  (do
    (m:text
      c:STDERR-FILENO
      "usage: verona [--help|-h] [--version|-V] COMMAND [OPTIONS]\n       verona {read|check|eval|emit-llvm|optimization-report} [OPTIONS] FILE\n       verona {compile|compile-report} [OPTIONS] FILE\n       verona build [OPTIONS] TARGET OUTPUT-DIRECTORY\n")
    2))

; Help is an interface contract, rather than the error-only synopsis above.
(base:function help () exit-code
  (do
    (m:text
      c:STDOUT-FILENO
      "usage: verona [--help|-h] [--version|-V] COMMAND [OPTIONS]\n\ncommands:\n  read FILE                 parse and print source\n  check FILE                load and type-check source\n  eval FILE                 evaluate a parameterless main\n  emit-llvm FILE            print checked LLVM IR\n  optimization-report FILE  print lowering optimization reports\n  compile FILE              emit an artifact\n  compile-report FILE       emit an executable result reporter\n  build TARGET DIRECTORY    build a target from verona.build\n\nUse 'verona COMMAND --help' for command options. Options may precede or follow operands; '--' ends option processing.\n")
    0))

(base:function source-help ((mode (pointer u8))) exit-code
  (do
    (m:text c:STDOUT-FILENO "usage: verona ")
    (m:text c:STDOUT-FILENO mode)
    (m:text c:STDOUT-FILENO " [OPTIONS] FILE\n\n")
    (m:text
      c:STDOUT-FILENO
      "source options:\n  --module-path DIRECTORY  add a module search path (repeatable)\n  --feature NAME           enable a reader feature (repeatable)\n  --target TRIPLE          select a target triple (last value wins)\n")
    (match (base:or-else (equal mode "compile") (equal mode "compile-report"))
      (true
        (m:text
          c:STDOUT-FILENO
          "native options:\n  -o, --output OUTPUT      select the artifact output (once)\n  --emit KIND              object, executable, static-library, or shared-library (last value wins)\n  -O0, -O1, -O2, -O3       select optimization level (last value wins; default -O0)\n  -l, --library NAME       add a native library (repeatable)\n  -L, --library-path DIR   add a native library search path (repeatable)\n  --framework NAME         add a Darwin framework (repeatable)\n  --cpu CPU                select a target CPU (last value wins; default generic)\n  --features FEATURES      select target machine features (last value wins)\n"))
      (false unit))
    (m:text
      c:STDOUT-FILENO
      "\nOptions may precede or follow FILE. Use '--' before a FILE whose name begins with '-'. Long options require a separate value; repeated --output and inapplicable options are errors.\n")
    0))

(base:function build-help () exit-code
  (do
    (m:text
      c:STDOUT-FILENO
      "usage: verona build [--feature NAME ...] TARGET OUTPUT-DIRECTORY\n\nBuild TARGET from ./verona.build and write it below OUTPUT-DIRECTORY. --feature is repeatable; all artifact, target, optimization, and link configuration comes from the manifest. Options may precede or follow operands; '--' ends option processing.\n")
    0))

(base:function option-like ((value (pointer u8))) bool
  (base:and-then
    (== (deref value) 45)
    (base:and-then (> (cstring:strlen value) 1) (base:not (equal value "-")))))

; The existing option decoder owns validation. This count only gives it the
; smallest complete argument slice, so source operands can appear anywhere.
(base:function command-option-count ((option (pointer u8))) u64
  (match
    (base:or-else
      (base:or-else
        (base:or-else (equal option "-O0") (equal option "-O1"))
        (base:or-else (equal option "-O2") (equal option "-O3")))
      (equal option "--"))
    (true 1)
    (false 2)))

; Parse module search paths and grouped native link options in command-line order.
; The CLI owns ROOTS and LINKS; execute borrows both for this invocation.
(base:function command-options
  ((argv (pointer (pointer u8)))
   (index u64)
   (end u64)
   (compile bool)
   (roots (pointer modules:paths-array))
   (output (pointer (pointer u8)))
   (level (pointer (pointer u8)))
   (links (pointer link:options))
   (kind (pointer (pointer u8)))
   (machine (pointer machine-options))
   (features (pointer (pointer void)))
   (memory (pointer arena:arena))) bool
  (match (== index end)
    (true true)
    (false
      (let ((option (pointer u8) (deref (pointer-offset argv index))))
        (base:cond
          ((base:or-else
             (base:or (equal option "--target") (equal option "--feature"))
             (base:or (equal option "--cpu") (equal option "--features")))
           (match
             (base:and
               (< (+ index 1) end)
               (base:or
                 compile
                 (base:not
                   (base:or (equal option "--cpu") (equal option "--features")))))
             (false false)
             (true
               (let
                 ((value (pointer u8) (deref (pointer-offset argv (+ index 1)))))
                 (match
                   (base:or
                     (equal option "--features")
                     (> (cstring:strlen value) 0))
                   (false false)
                   (true
                     (do
                       (base:cond
                         ((equal option "--target")
                          (store
                            (deref machine)
                            (machine-options
                              value
                              (field (deref machine) cpu)
                              (field (deref machine) features))))
                         ((equal option "--cpu")
                          (store
                            (deref machine)
                            (machine-options
                              (field (deref machine) triple)
                              value
                              (field (deref machine) features))))
                         ((equal option "--features")
                          (store
                            (deref machine)
                            (machine-options
                              (field (deref machine) triple)
                              (field (deref machine) cpu)
                              value)))
                         (true (config:add-feature memory features value)))
                       (command-options
                         argv
                         (+ index 2)
                         end
                         compile
                         roots
                         output
                         level
                         links
                         kind
                         machine
                         features
                         memory))))))))
          ((equal option "--emit")
           (match (base:and-then compile (< (+ index 1) end))
             (false false)
             (true
               (let
                 ((value (pointer u8) (deref (pointer-offset argv (+ index 1)))))
                 (match
                   (base:or-else
                     (equal value "object")
                     (equal value "executable")
                     (equal value "static-library")
                     (equal value "shared-library"))
                   (false false)
                   (true
                     (do
                       (store (deref kind) value)
                       (command-options
                         argv
                         (+ index 2)
                         end
                         compile
                         roots
                         output
                         level
                         links
                         kind
                         machine
                         features
                         memory))))))))
          ((equal option "--module-path")
           (match (< (+ index 1) end)
             (false false)
             (true
               (let
                 ((path (pointer u8) (deref (pointer-offset argv (+ index 1)))))
                 (match (> (cstring:strlen path) 0)
                   (false false)
                   (true
                     (do
                       (m:storage (modules:paths-append roots path))
                       (command-options
                         argv
                         (+ index 2)
                         end
                         compile
                         roots
                         output
                         level
                         links
                         kind
                         machine
                         features
                         memory))))))))
          ((base:or-else (equal option "--library") (equal option "-l"))
           (link-option
             argv
             index
             end
             compile
             roots
             output
             level
             links
             kind
             (library)
             machine
             features
             memory))
          ((base:or-else (equal option "--library-path") (equal option "-L"))
           (link-option
             argv
             index
             end
             compile
             roots
             output
             level
             links
             kind
             (search-path)
             machine
             features
             memory))
          ((equal option "--framework")
           (link-option
             argv
             index
             end
             compile
             roots
             output
             level
             links
             kind
             (framework)
             machine
             features
             memory))
          ((base:or (equal option "-o") (equal option "--output"))
           (match (base:and-then compile (< (+ index 1) end))
             (false false)
             (true
               (match (equal (deref output) "")
                 (false false)
                 (true
                   (do
                     (store
                       (deref output)
                       (deref (pointer-offset argv (+ index 1))))
                     (command-options
                       argv
                       (+ index 2)
                       end
                       compile
                       roots
                       output
                       level
                       links
                       kind
                       machine
                       features
                       memory)))))))
          ((base:or-else
             (equal option "-O0")
             (equal option "-O1")
             (equal option "-O2")
             (equal option "-O3"))
           (optimization-option
             argv
             index
             end
             compile
             roots
             output
             level
             links
             kind
             option
             machine
             features
             memory))
          (true false))))))

(base:function link-option
  ((argv (pointer (pointer u8)))
   (index u64)
   (end u64)
   (compile bool)
   (roots (pointer modules:paths-array))
   (output (pointer (pointer u8)))
   (level (pointer (pointer u8)))
   (links (pointer link:options))
   (artifact (pointer (pointer u8)))
   (kind link:option-kind)
   (machine (pointer machine-options))
   (features (pointer (pointer void)))
   (memory (pointer arena:arena))) bool
  (match (base:and-then compile (< (+ index 1) end))
    (false false)
    (true
      (match
        (link:add-option links kind (deref (pointer-offset argv (+ index 1))))
        ((ok)
         (command-options
           argv
           (+ index 2)
           end
           compile
           roots
           output
           level
           links
           artifact
           machine
           features
           memory))
        (_ (do (m:text c:STDERR-FILENO "cannot allocate link options\n") false))))))

(base:function optimization-option
  ((argv (pointer (pointer u8)))
   (index u64)
   (end u64)
   (compile bool)
   (roots (pointer modules:paths-array))
   (output (pointer (pointer u8)))
   (level (pointer (pointer u8)))
   (links (pointer link:options))
   (kind (pointer (pointer u8)))
   (option (pointer u8))
   (machine (pointer machine-options))
   (features (pointer (pointer void)))
   (memory (pointer arena:arena))) bool
  (match compile
    (false false)
    (true
      (do
        (store (deref level) option)
        (command-options
          argv
          (+ index 1)
          end
          compile
          roots
          output
          level
          links
          kind
          machine
          features
          memory)))))

(base:function source-options
  ((argv (pointer (pointer u8)))
   (index u64)
   (end u64)
   (compile bool)
   (state (pointer source-state))
   (roots (pointer modules:paths-array))
   (output (pointer (pointer u8)))
   (level (pointer (pointer u8)))
   (links (pointer link:options))
   (kind (pointer (pointer u8)))
   (machine (pointer machine-options))
   (features (pointer (pointer void)))
   (memory (pointer arena:arena))) bool
  (match (== index end)
    (true (field (deref state) provided))
    (false
      (let ((argument (pointer u8) (deref (pointer-offset argv index))))
        (base:cond
          ((base:and
             (base:not (field (deref state) stopped))
             (equal argument "--"))
           (do
             (store
               (deref state)
               (source-state
                 (field (deref state) path)
                 (field (deref state) provided)
                 true))
             (source-options
               argv
               (+ index 1)
               end
               compile
               state
               roots
               output
               level
               links
               kind
               machine
               features
               memory)))
          ((base:and
             (base:not (field (deref state) stopped))
             (option-like argument))
           (let ((count u64 (command-option-count argument)))
             (match (<= (+ index count) end)
               (false false)
               (true
                 (match
                   (command-options
                     argv
                     index
                     (+ index count)
                     compile
                     roots
                     output
                     level
                     links
                     kind
                     machine
                     features
                     memory)
                   (false false)
                   (true
                     (source-options
                       argv
                       (+ index count)
                       end
                       compile
                       state
                       roots
                       output
                       level
                       links
                       kind
                       machine
                       features
                       memory)))))))
          ((field (deref state) provided) false)
          (true
            (do
              (store
                (deref state)
                (source-state argument true (field (deref state) stopped)))
              (source-options
                argv
                (+ index 1)
                end
                compile
                state
                roots
                output
                level
                links
                kind
                machine
                features
                memory))))))))

(base:function source-command ((argc i32) (argv (pointer (pointer u8))))
  exit-code
  (match (< argc 3)
    (true (usage))
    (false
      (let
        ((mode (pointer u8) (deref (pointer-offset argv 1)))
         (state source-state (source-state "" false false))
         (compile
           bool
           (base:or-else (equal mode "compile") (equal mode "compile-report")))
         (valid
           bool
           (base:or-else
             (equal mode "read")
             (equal mode "check")
             (equal mode "eval")
             (equal mode "emit-llvm")
             (equal mode "optimization-report")
             compile))
         (memory arena:arena (arena:create (system:create) 4096))
         (machine machine-options (machine-options "native" "generic" ""))
         (features (pointer void) (m:empty-env))
         (roots modules:paths-array (modules:paths-new (system:create)))
         (links link:options (link:options-new (system:create)))
         (output (pointer u8) "")
         (level (pointer u8) "-O0")
         (kind (pointer u8) "executable")
         (count u64 (base:convert argc))
         (options
           bool
           (source-options
             argv
             2
             count
             compile
             (& state)
             (& roots)
             (& output)
             (& level)
             (& links)
             (& kind)
             (& machine)
             (& features)
             (& memory)))
         (result
           exit-code
           (match
             (base:or-else
               (base:or (base:not valid) (base:not options))
               (base:and
                 (equal mode "compile-report")
                 (base:not (equal kind "executable"))))
             (true (usage))
             (false
               (execute
                 mode
                 (field state path)
                 output
                 level
                 roots
                 links
                 kind
                 (field machine triple)
                 (field machine cpu)
                 (field machine features)
                 features
                 (m:empty-env))))))
        (do
          (link:options-destroy (& links))
          (modules:paths-destroy (& roots))
          (arena:destroy (& memory))
          result)))))

(base:function build-features
  ((argv (pointer (pointer u8)))
   (index i32)
   (end i32)
   (memory (pointer arena:arena))
   (features (pointer (pointer void)))) bool
  (match (== index end)
    (true true)
    (false
      (match
        (base:and-then
          (< (+ index 1) end)
          (equal (deref (pointer-offset argv index)) "--feature")
          (> (cstring:strlen (deref (pointer-offset argv (+ index 1)))) 0))
        (false false)
        (true
          (do
            (config:add-feature
              memory
              features
              (deref (pointer-offset argv (+ index 1))))
            (build-features argv (+ index 2) end memory features)))))))

(base:function build-options
  ((argv (pointer (pointer u8)))
   (index i32)
   (end i32)
   (memory (pointer arena:arena))
   (features (pointer (pointer void)))
   (state (pointer build-state))) bool
  (match (== index end)
    (true (== (field (deref state) operands) 2))
    (false
      (let ((argument (pointer u8) (deref (pointer-offset argv index))))
        (base:cond
          ((base:and
             (base:not (field (deref state) stopped))
             (equal argument "--"))
           (do
             (store
               (deref state)
               (build-state
                 (field (deref state) target)
                 (field (deref state) output)
                 (field (deref state) operands)
                 true))
             (build-options argv (+ index 1) end memory features state)))
          ((base:and
             (base:not (field (deref state) stopped))
             (option-like argument))
           (match
             (base:and-then
               (< (+ index 1) end)
               (base:and
                 (equal argument "--feature")
                 (>
                   (cstring:strlen (deref (pointer-offset argv (+ index 1))))
                   0)))
             (false false)
             (true
               (do
                 (config:add-feature
                   memory
                   features
                   (deref (pointer-offset argv (+ index 1))))
                 (build-options argv (+ index 2) end memory features state)))))
          ((== (field (deref state) operands) 0)
           (do
             (store
               (deref state)
               (build-state
                 argument
                 (field (deref state) output)
                 1
                 (field (deref state) stopped)))
             (build-options argv (+ index 1) end memory features state)))
          ((== (field (deref state) operands) 1)
           (do
             (store
               (deref state)
               (build-state
                 (field (deref state) target)
                 argument
                 2
                 (field (deref state) stopped)))
             (build-options argv (+ index 1) end memory features state)))
          (true false))))))

(base:function build-command ((argc i32) (argv (pointer (pointer u8))))
  exit-code
  (let
    ((memory arena:arena (arena:create (system:create) 4096))
     (features (pointer void) (m:empty-env))
     (state build-state (build-state "" "" 0 false))
     (valid bool (build-options argv 2 argc (& memory) (& features) (& state)))
     (result
       exit-code
       (match valid
         (false (usage))
         (true
           (let
             ((request
                build:request
                (build:read
                  (& memory)
                  (field state target)
                  (field state output)
                  features))
              (configuration
                config:configuration
                (backend-target:resolve
                  (& memory)
                  (field request triple)
                  "generic"
                  ""
                  (optimization-level (field request level))
                  (field request features)))
              (items m:tape (m:empty (arena:allocator (& memory))))
              (errors u64 0)
              (c
                m:context
                (m:context
                  "verona.build"
                  (data:view "" 0)
                  (& items)
                  (& memory)
                  (& errors)
                  (m:empty-env)
                  0)))
             (do
               (link-policy
                 (field request links)
                 (field configuration platform))
               (build:directories
                 c
                 (field request output)
                 1
                 (-
                   (modules:directory-end
                     (field request output)
                     0
                     (cstring:strlen (field request output)))
                   1))
               (let
                 ((code
                    exit-code
                    (execute
                      "compile"
                      (field request root)
                      (field request output)
                      (field request level)
                      (field request paths)
                      (field request links)
                      (field request kind)
                      (field request triple)
                      "generic"
                      ""
                      (field request features)
                      (cast (pointer void) (& configuration)))))
                 (do
                   (match code
                     (0
                       (do
                         (m:text c:STDOUT-FILENO (field request output))
                         (m:text c:STDOUT-FILENO "\n")))
                     (_ unit))
                   code))))))))
    (do (arena:destroy (& memory)) result)))

(base:function is-version-command ((argc i32) (argv (pointer (pointer u8))))
  bool
  (base:and-then
    (== argc 2)
    (let ((command (pointer u8) (deref (pointer-offset argv 1))))
      (base:or (equal command "--version") (equal command "-V")))))

(base:function is-help-command ((argc i32) (argv (pointer (pointer u8)))) bool
  (base:and-then
    (== argc 2)
    (let ((command (pointer u8) (deref (pointer-offset argv 1))))
      (base:or-else
        (base:or (equal command "--help") (equal command "-h"))
        (equal command "help")))))

(base:function is-command-help ((argc i32) (argv (pointer (pointer u8)))) bool
  (base:and-then
    (== argc 3)
    (let ((option (pointer u8) (deref (pointer-offset argv 2))))
      (base:or-else
        (base:or (equal option "--help") (equal option "-h"))
        (equal option "help")))))

(base:function main ((argc i32) (argv (pointer (pointer u8)))) exit-code
  ; ARGV[1] is unavailable for an invocation with no command.  Reject it
  ; before decoding the command so malformed CLI input cannot dereference it.
  (match (< argc 2)
    (true (usage))
    (false
      (match (is-help-command argc argv)
        (true (help))
        (false
          (match (is-version-command argc argv)
            (true
              (do
                (m:text c:STDOUT-FILENO constants:compiler-version)
                (m:text c:STDOUT-FILENO "\n")
                0))
            (false
              (let ((command (pointer u8) (deref (pointer-offset argv 1))))
                (base:cond
                  ((base:or-else
                     (equal command "read")
                     (equal command "check")
                     (equal command "eval")
                     (equal command "emit-llvm")
                     (equal command "optimization-report"))
                   (match (is-command-help argc argv)
                     (true (source-help command))
                     (false (source-command argc argv))))
                  ((base:or-else
                     (equal command "compile")
                     (equal command "compile-report"))
                   (match (is-command-help argc argv)
                     (true (source-help command))
                     (false (source-command argc argv))))
                  ((equal command "build")
                   (match (is-command-help argc argv)
                     (true (build-help))
                     (false
                       (match (< argc 4)
                         (true (usage))
                         (false (build-command argc argv))))))
                  ; Unknown commands and version flags with trailing arguments are
                  ; usage errors, not an unexplained status-one exit.
                  (true (usage)))))))))))
