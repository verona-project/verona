(import base)
(import arena)
(import data)
(import array)
(import error)
(import allocator)
(import core.model :as m)
(import core.reader :as reader)
(import core.check :as check)
(import core.modules :as modules)
(import core.source :as source)
(import core.configuration :as config)
(import core.sexpr :as syntax)
(import core.link :as link)
(import libc.string :as cstring)
(import libc.stdio :as stdio)
(import libc.filesystem :as fs)
(import libc.errno :as errno)
(import libc.types :as types)

(base:external-function getcwd "getcwd" ((pointer u8) u64) (pointer u8))

; Parsed configuration data only. IDs retain manifest source locations; arrays
; and decoded strings are arena-owned. No declaration expansion or evaluation.
(base:type target
  (product
    (name u64)
    (kind (pointer u8))
    (root u64)
    (triple u64)
    (optimization u64)
    (version u64)
    (features u64)
    (paths modules:paths-array)
    (links link:options)))

(base:type request
  (product
    (root (pointer u8))
    (output (pointer u8))
    (kind (pointer u8))
    (level (pointer u8))
    (triple (pointer u8))
    (version (pointer u8))
    (paths modules:paths-array)
    (links link:options)
    (features (pointer void))))

(base:function copy ((c m:context) (value data:view)) (pointer u8)
  (config:copy (field c memory) value))

(base:function text ((c m:context) (id u64)) (pointer u8)
  (do
    (m:require
      c
      id
      (== (field (m:at c id) kind) 25)
      "build option requires a data string")
    (let
      ((out data:data (data:empty (arena:allocator (field c memory))))
       (v m:node (m:at c id))
       (cursor u64 0)
       (escaped bool false))
      (do
        (m:storage (data:resize (& out) (field v length)))
        (check:decode-data
          c
          (data:bytes out)
          (& cursor)
          (& escaped)
          (+ (field v start) 1)
          (- (field v length) 2))
        (store (deref (pointer-offset (data:bytes out) cursor)) 0)
        (data:bytes out)))))

(base:function name ((c m:context) (id u64)) unit
  (do
    (m:require c id (check:atom c id) "build name must be a name")
    (m:require
      c
      id
      (base:and-then
        (base:not (check:integer-start c (field (m:at c id) start)))
        (base:not (m:is c id "true"))
        (base:not (m:is c id "false"))
        (base:not (m:is c id "unit"))
        (==
          (check:name-colon c id)
          (+ (field (m:at c id) start) (field (m:at c id) length))))
      "build name must be an unqualified name")))

(base:function join ((c m:context) (directory (pointer u8)) (path (pointer u8)))
  (pointer u8)
  (match (deref path)
    (47 path)
    (_
      (let
        ((out data:data (data:empty (arena:allocator (field c memory))))
         (length u64 (cstring:strlen directory)))
        (do
          (modules:append-bytes (& out) (data:view directory length))
          (match
            (base:and-then
              (> length 0)
              (== (deref (pointer-offset directory (- length 1))) (cast u8 47)))
            (true unit)
            (false (m:storage (data:append (& out) 47))))
          (modules:append-bytes (& out) (data:view path (cstring:strlen path)))
          (m:storage (data:append (& out) 0))
          (data:bytes out))))))

(base:function cwd-buffer
  ((c m:context) (out (pointer data:data)) (capacity u64)) (pointer u8)
  (do
    (m:storage (data:resize out capacity))
    (let ((raw (pointer u8) (getcwd (data:bytes (deref out)) capacity)))
      (match (base:is-null (cast (pointer void) raw))
        (false raw)
        (true
          (match (== (deref (errno:errno-pointer)) (cast i32 34))
            (false (do (m:fatal "cannot resolve current directory") ""))
            (true
              (let ((next u64 (* capacity 2)))
                (do
                  (match (> next capacity)
                    (true unit)
                    (false (m:fatal "current directory path is too large")))
                  (cwd-buffer c out next))))))))))

(base:function cwd ((c m:context)) (pointer u8)
  (let ((out data:data (data:empty (arena:allocator (field c memory)))))
    (cwd-buffer c (& out) 256)))

(base:function empty-target ((c m:context) (name u64) (kind (pointer u8)))
  target
  (target
    name
    kind
    0
    0
    0
    0
    0
    (modules:paths-new (arena:allocator (field c memory)))
    (link:options-new (arena:allocator (field c memory)))))

; Reconstruct records rather than taking field addresses, so this module is
; also accepted by the reference bootstrap compiler's value-only projections.
(base:function set-value ((out (pointer target)) (slot u64) (id u64)) unit
  (let ((v target (deref out)))
    (do
      (store
        (deref out)
        (target
          (field v name)
          (field v kind)
          (match slot (0 id) (_ (field v root)))
          (match slot (1 id) (_ (field v triple)))
          (match slot (2 id) (_ (field v optimization)))
          (match slot (3 id) (_ (field v version)))
          (match slot (4 id) (_ (field v features)))
          (field v paths)
          (field v links)))
      unit)))

(base:function add-path ((out (pointer target)) (path (pointer u8))) unit
  (let ((v target (deref out)) (paths modules:paths-array (field v paths)))
    (do
      (m:storage (modules:paths-append (& paths) path))
      (store
        (deref out)
        (target
          (field v name)
          (field v kind)
          (field v root)
          (field v triple)
          (field v optimization)
          (field v version)
          (field v features)
          paths
          (field v links)))
      unit)))

(base:function add-link
  ((out (pointer target)) (kind link:option-kind) (text (pointer u8))) unit
  (let ((v target (deref out)) (links link:options (field v links)))
    (do
      (m:storage (link:add-option (& links) kind text))
      (store
        (deref out)
        (target
          (field v name)
          (field v kind)
          (field v root)
          (field v triple)
          (field v optimization)
          (field v version)
          (field v features)
          (field v paths)
          links))
      unit)))

(base:function one ((c m:context) (option u64)) u64
  (do
    (m:require
      c
      option
      (check:arity c (m:child c option) 2)
      "build option requires exactly one argument")
    (m:next c (m:child c option))))

(base:function unique ((c m:context) (option u64) (old u64)) unit
  (m:require c option (== old 0) "duplicate build option"))

(base:function single-line ((value (pointer u8))) bool
  (base:and-then
    (> (cstring:strlen value) 0)
    (base:is-null (cast (pointer void) (cstring:strchr value 10)))
    (base:is-null (cast (pointer void) (cstring:strchr value 13)))))

(base:function feature-names ((c m:context) (id u64)) unit
  (match id (0 unit) (_ (do (name c id) (feature-names c (m:next c id))))))

(base:function optimization-digits
  ((c m:context) (id u64) (index u64) (value u64)) u64
  (match (== index (field (m:spelling c id) length))
    (true value)
    (false
      (let
        ((b
           u64
           (base:convert
             (deref (pointer-offset (field (m:spelling c id) bytes) index))))
         (next u64 (+ (* value 10) (- b 48))))
        (do
          (m:require
            c
            id
            (<= next 3)
            "optimize must be an integer from 0 through 3")
          (optimization-digits c id (+ index 1) next))))))

(base:function optimization ((c m:context) (id u64)) u64
  (do
    (m:require
      c
      id
      (check:integer-node c id)
      "optimize must be an integer from 0 through 3")
    (let
      ((first u8 (deref (field (m:spelling c id) bytes)))
       (value
         u64
         (optimization-digits c id (match first (43 1) (45 1) (_ 0)) 0)))
      (do
        (m:require
          c
          id
          (match first (45 (== value 0)) (_ true))
          "optimize must be an integer from 0 through 3")
        value))))

(base:function options
  ((c m:context) (id u64) (directory (pointer u8)) (out (pointer target))) unit
  (match id
    (0 unit)
    (_
      (let ((head u64 (m:child c id)))
        (do
          (m:require
            c
            id
            (== (field (m:at c id) kind) 1)
            "build option must be an S-expression")
          (m:require c id (> head 0) "build option must not be empty")
          (name c head)
          (base:cond
            ((m:is c head "root")
             (let ((value u64 (one c id)))
               (do
                 (unique c id (field (deref out) root))
                 (name c value)
                 (m:require
                   c
                   value
                   (modules:valid-module-name (m:spelling c value))
                   "root must be a dotted module name")
                 (set-value out 0 value)
                 unit)))
            ((m:is c head "target")
             (let ((value u64 (one c id)))
               (do
                 (unique c id (field (deref out) triple))
                 (m:require
                   c
                   value
                   (base:or
                     (m:is c value "native")
                     (== (field (m:at c value) kind) 25))
                   "target requires native or a target-triple string")
                 (set-value out 1 value)
                 unit)))
            ((m:is c head "optimize")
             (let ((value u64 (one c id)))
               (do
                 (unique c id (field (deref out) optimization))
                 (optimization c value)
                 (set-value out 2 value)
                 unit)))
            ((m:is c head "version")
             (let ((value u64 (one c id)))
               (do
                 (unique c id (field (deref out) version))
                 (m:require
                   c
                   value
                   (single-line (text c value))
                   "version requires a non-empty single-line string")
                 (set-value out 3 value)
                 unit)))
            ((m:is c head "features")
             (do
               (unique c id (field (deref out) features))
               (m:require
                 c
                 id
                 (> (m:next c head) 0)
                 "features requires at least one feature name")
               (feature-names c (m:next c head))
               (set-value out 4 id)
               unit))
            ((m:is c head "module-path")
             (add-path out (join c directory (text c (one c id)))))
            ((m:is c head "library-path")
             (add-link out (search-path) (join c directory (text c (one c id)))))
            ((m:is c head "library")
             (add-link out (library) (text c (one c id))))
            ((m:is c head "framework")
             (add-link out (framework) (text c (one c id))))
            (true (m:error c id "unknown build option")))
          (options c (m:next c id) directory out))))))

(base:function parse-target ((c m:context) (id u64) (directory (pointer u8)))
  target
  (let ((head u64 (m:child c id)) (name-id u64 (m:next c head)))
    (do
      (m:require
        c
        id
        (== (field (m:at c id) kind) 1)
        "artifact declaration must be an S-expression")
      (m:require c id (> head 0) "artifact declaration must not be empty")
      (let
        ((kind
           (pointer u8)
           (base:cond
             ((m:is c head "executable") "executable")
             ((m:is c head "static-library") "static-library")
             ((m:is c head "shared-library") "shared-library")
             (true (do (m:error c id "unknown top-level build form") ""))))
         (out target (empty-target c name-id kind)))
        (do
          (m:require
            c
            id
            (> name-id 0)
            "artifact declaration requires a target name")
          (name c name-id)
          (options c (m:next c name-id) directory (& out))
          (m:require
            c
            id
            (> (field out root) 0)
            "build target requires exactly one root option")
          (match (modules:paths-length (field out paths))
            (0 (add-path (& out) directory))
            (_ unit))
          out)))))

(base:function duplicate ((c m:context) (current u64) (id u64)) unit
  (match (== current id)
    (true unit)
    (false
      (do
        (m:require
          c
          current
          (base:not
            (m:same c (m:next c (m:child c current)) (m:next c (m:child c id))))
          "duplicate build target")
        (duplicate c current (m:next c id))))))

(base:function select
  ((c m:context)
   (id u64)
   (all u64)
   (directory (pointer u8))
   (wanted (pointer u8))
   (out (pointer target))) unit
  (match id
    (0 unit)
    (_
      (let ((value target (parse-target c id directory)))
        (do
          (duplicate c id all)
          (match (m:is c (field value name) wanted)
            (true (do (store (deref out) value) unit))
            (_ unit))
          (select c (m:next c id) all directory wanted out))))))

(base:function root-path
  ((c m:context) (paths modules:paths-array) (module (pointer u8)) (index u64))
  (pointer u8)
  (do
    (m:require
      c
      0
      (< index (modules:paths-length paths))
      "cannot find root module")
    (let ((name data:data (data:empty (arena:allocator (field c memory)))))
      (do
        (modules:append-bytes
          (& name)
          (data:view module (cstring:strlen module)))
        (modules:append-bytes (& name) (data:view ".vrn" 4))
        (m:storage (data:append (& name) 0))
        (let
          ((path
             (pointer u8)
             (join
               c
               (deref (pointer-offset (tuple-get paths 0) index))
               (data:bytes name))))
          (match (modules:access path 0)
            (0 path)
            (_ (root-path c paths module (+ index 1)))))))))

(base:function feature-copy
  ((c m:context) (head (pointer void)) (out (pointer (pointer void)))) unit
  (match (base:is-null head)
    (true unit)
    (false
      (let ((v syntax:feature (deref (cast (pointer syntax:feature) head))))
        (do
          (config:add-feature (field c memory) out (field v name))
          (feature-copy c (field v next) out))))))

(base:function package-features
  ((c m:context) (id u64) (out (pointer (pointer void)))) unit
  (match id
    (0 unit)
    (_
      (let ((value data:view (m:spelling c id)))
        (do
          (config:add-feature (field c memory) out (copy c value))
          (package-features c (m:next c id) out))))))

(base:function suffix ((kind (pointer u8)) (os (pointer u8))) (pointer u8)
  (base:cond
    ((config:equal kind "executable") "")
    ((config:equal kind "static-library") ".a")
    ((config:equal os "darwin") ".dylib")
    (true ".so")))

; Mkdir each prefix, accepting existing directories but never existing files.
(base:function directories
  ((c m:context) (path (pointer u8)) (index u64) (end u64)) unit
  (match (> index end)
    (true unit)
    (false
      (do
        (match
          (base:or
            (== index end)
            (== (deref (pointer-offset path index)) (cast u8 47)))
          (true
            (let ((prefix (pointer u8) (copy c (data:view path index))))
              (match (fs:mkdir prefix 511)
                (0 unit)
                (_
                  (let
                    ((dir (pointer types:directory-stream) (fs:opendir prefix)))
                    (do
                      (match (base:is-null (cast (pointer void) dir))
                        (true (m:fatal "cannot create output directory"))
                        (_ unit))
                      (fs:closedir dir)
                      unit))))))
          (false unit))
        (directories c path (+ index 1) end)))))

(base:function read
  ((memory (pointer arena:arena))
   (wanted (pointer u8))
   (destination (pointer u8))
   (cli-features (pointer void))) request
  (let
    ((input data:data (data:empty (arena:allocator memory)))
     (items m:tape (m:empty (arena:allocator memory)))
     (errors u64 0)
     (c
       m:context
       (m:context
         "verona.build"
         (data:view "" 0)
         (& items)
         memory
         (& errors)
         (m:empty-env)
         0))
     (directory (pointer u8) (cwd c))
     (manifest (pointer u8) (join c directory "verona.build"))
     (stream (pointer types:file-stream) (stdio:fopen manifest "rb")))
    (do
      (match (base:is-null (cast (pointer void) stream))
        (true (m:fatal "cannot find verona.build in current directory"))
        (_ unit))
      (match (source:read-open stream (& input))
        ((ok) unit)
        (_ (m:fatal "cannot read verona.build")))
      (let
        ((c
           m:context
           (m:context
             manifest
             (data:borrow input)
             (& items)
             memory
             (& errors)
             (m:empty-env)
             0))
         (forms u64 (reader:read c))
         (chosen target (empty-target c 0 ""))
         (extra (pointer void) (m:empty-env)))
        (do
          (select c forms forms directory wanted (& chosen))
          (m:require c 0 (> (field chosen name) 0) "unknown build target")
          (feature-copy c cli-features (& extra))
          (package-features
            c
            (m:next c (m:child c (field chosen features)))
            (& extra))
          (let
            ((triple
               (pointer u8)
               (match (field chosen triple)
                 (0 "native")
                 (id
                   (match (m:is c id "native")
                     (true "native")
                     (false (text c id))))))
             (normalized
               unit
               (match (field chosen triple)
                 (0 unit)
                 (id
                   (match (m:is c id "native")
                     (true unit)
                     (false
                       (do
                         (config:lower triple (cstring:strlen triple))
                         (m:require
                           c
                           id
                           (base:not (config:equal triple "native"))
                           "unsupported target triple")
                         unit))))))
             (os
               (pointer u8)
               (match (config:equal triple "native")
                 (true (syntax:native-platform))
                 (false (config:platform triple))))
             (out data:data (data:empty (arena:allocator memory)))
             (folder (pointer u8) (join c directory destination))
             (level
               (pointer u8)
               (match (field chosen optimization)
                 (0 "-O0")
                 (id
                   (match (optimization c id)
                     (0 "-O0")
                     (1 "-O1")
                     (2 "-O2")
                     (_ "-O3"))))))
            (do
              (match (config:equal (field chosen kind) "executable")
                (true unit)
                (false (modules:append-bytes (& out) (data:view "lib" 3))))
              (modules:append-bytes (& out) (m:spelling c (field chosen name)))
              (let ((ending (pointer u8) (suffix (field chosen kind) os)))
                (modules:append-bytes
                  (& out)
                  (data:view ending (cstring:strlen ending))))
              (m:storage (data:append (& out) 0))
              (request
                (root-path
                  c
                  (field chosen paths)
                  (copy c (m:spelling c (field chosen root)))
                  0)
                (join c folder (data:bytes out))
                (field chosen kind)
                level
                triple
                (match (field chosen version) (0 "") (id (text c id)))
                (field chosen paths)
                (field chosen links)
                extra))))))))

(export request read directories)
