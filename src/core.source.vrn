(import base)
(import data)
(import error)
(import libc.stdio :as io)
(import libc.types :as types)
(import core.model :as m)
(import foundation.compat.arithmetic :as n)

; Double the read window after each full read. Recursion is logarithmic in
; file size, and the buffer retains the exact bytes including embedded NULs.
(base:function read-more
  ((file (pointer types:file-stream)) (out (pointer data:data)) (start u64) (window u64))
  error:status
  (match (n:le window (n:sub (base:maxBound) start))
    (false (error:too-large))
    (true
      (match (data:resize out (n:add start window))
        ((ok)
         (let
           ((size
              u64
              (io:fread
                (cast (pointer void) (pointer-offset (data:bytes (deref out)) start))
                1
                window
                file))
            (end u64 (n:add start size)))
           (match (io:ferror file)
             (0
               (match (n:eq size window)
                 (true (read-more file out end (n:add start window)))
                 (false (data:resize out end))))
             (_ (error:invalid)))))
        (reason reason)))))

; Take ownership of an open stream. The caller retains the buffer on failure.
(base:function read-open ((file (pointer types:file-stream)) (out (pointer data:data))) error:status
  (let ((result error:status (read-more file out 0 4096)) (closed i32 (io:fclose file)))
    (match result ((ok) (match closed (0 result) (_ (error:invalid)))) (_ result))))

(base:function read ((path (pointer u8)) (out (pointer data:data))) error:status
  (let ((file (pointer types:file-stream) (io:fopen path "rb")))
    (match (m:is-empty (cast (pointer void) file))
      (true (error:invalid))
      (false (read-open file out)))))

(export read read-open)
