(import base)
(import core.constants :as constants)
(import core.diagnostic :as diag)
(import allocator)
(import array)
(import error)
(import data)
(import arena)
(import libc.descriptor :as fd)
(import libc.process :as process)
(import libc.string :as cstring)
(import libc.constants :as c)

; Stable indices into an arena-owned syntax/typed tape. Index zero is absent.
; Reader kinds: atom=0, list=1, data=25, character=26. Checked kinds: integer=2, bool=3, unit=4,
; local=5, retired=6, let=7, call=8, primitive=9, invalid declaration=10.
; Checked expressions: aggregate=13, extraction=14, sum construction=15, match=16, data=17.
; Descriptors: nominal product=20, sum=21, structural tuple=22, transparent alias=23, tuple component=24.
; Nominal opaque type=33, pointer descriptor=34. Reader float=35, checked float=36.
; Concrete implementation=18, protocol method=19, generic declaration=37.
; Protocol declaration=38, concrete protocol instance=39.
; Specialization=40, template=41, type binding=42, protocol evidence=43, active specialization=44, pointer cast=45.
; Function signature=46, function address=47, indirect call=48, array descriptor=49, array index=50.
; Constant declaration=51, constant reference=52.
; External function=53, external call=54.
; Literal/binding match=55. Match arms use target=0 for catch-all, value=binder
; or zero for wildcard. Literal arms use target=1, value=the checked bits.
; Address=57, dereference=58, pointer offset=59, store=60, tuple match=61.
; Sequence=56, with expressions after its operation head.
; Collected macro=27. Reader prefixes: quote=28, quasiquote=29, unquote=30, splice=31.
; Default numeric generic=62, with an operation code in target and virtual signatures.
; Mutable global declaration=63, global reference/place=64 with declaration ID in target.
; Session-only nodes: state entry=65, normalized qualified key=66, expansion cache=67.
; Macro registry link=70: child=installed macro ID, target=owning module, next=previous link.
; Native export=68, with resolved function TARGET and decoded symbol node in VALUE.
; Untyped list VALUE may retain its source identity when copied for specialization.
; Computed macro integer spellings use kind=69 and arena-owned generated bytes.
; Computed macro binary64 values use kind=71 with exact bits in VALUE until contextual typing.
; Computed macro booleans use kind=3 with ty=0 until contextual checking.
; Inline directive=72, noinline directive=73; TARGET is a resolved local function/template ID.
; Null pointer literal=74, pointer index/load=75.
; Types: error=0 (analysis only), unit=1, bool=2, integer types=3..10, (pointer u8)=11, f32=12, f64=13, void=14. Descriptors use ID+16.
; TARGET holds a binder/function index, opcode, checked binding initializer ID, or data literal address.
; Nine u64 metadata fields and one i64 literal: 80 bytes, alignment 8 on the supported ABI.
; Shared reader/checked-program record. Child and next are tape IDs, with zero
; denoting absence. Checking installs concrete types and resolved targets in place.
(base:type scalar-type
  (sum
    (scalar-error)
    (scalar-unit)
    (scalar-bool)
    (scalar-i64)
    (scalar-i8)
    (scalar-i16)
    (scalar-i32)
    (scalar-u8)
    (scalar-u16)
    (scalar-u32)
    (scalar-u64)
    (scalar-pointer-u8)
    (scalar-f32)
    (scalar-f64)
    (scalar-void)))

; All tags stored in the shared tape. The spelling deliberately describes the
; record role rather than its historic numeric encoding: a node may transition
; from a reader role to a checked role, but it never carries an untyped tag.
(base:type node-kind
  (sum
    (node-atom)
    (node-list)
    (node-integer)
    (node-bool)
    (node-unit)
    (node-local)
    (node-retired)
    (node-let)
    (node-call)
    (node-primitive)
    (node-invalid-declaration)
    (node-aggregate)
    (node-extraction)
    (node-sum-construction)
    (node-match)
    (node-data)
    (node-concrete-implementation)
    (node-protocol-method)
    (node-nominal-product)
    (node-nominal-sum)
    (node-structural-tuple)
    (node-transparent-alias)
    (node-tuple-component)
    (node-reader-data)
    (node-reader-character)
    (node-collected-macro)
    (node-quote)
    (node-quasiquote)
    (node-unquote)
    (node-splice)
    (node-nominal-opaque)
    (node-pointer-descriptor)
    (node-reader-float)
    (node-float)
    (node-generic-declaration)
    (node-protocol-declaration)
    (node-concrete-protocol-instance)
    (node-specialization)
    (node-template)
    (node-type-binding)
    (node-protocol-evidence)
    (node-active-specialization)
    (node-pointer-cast)
    (node-function-signature)
    (node-function-address)
    (node-indirect-call)
    (node-array-descriptor)
    (node-array-index)
    (node-constant-declaration)
    (node-constant-reference)
    (node-external-function)
    (node-external-call)
    (node-literal-match)
    (node-sequence)
    (node-address)
    (node-dereference)
    (node-pointer-offset)
    (node-store)
    (node-tuple-match)
    (node-default-numeric-generic)
    (node-mutable-global-declaration)
    (node-global-reference)
    (node-state-entry)
    (node-qualified-key)
    (node-expansion-cache)
    (node-native-export)
    (node-computed-integer)
    (node-macro-registry-link)
    (node-computed-float)
    (node-inline-directive)
    (node-noinline-directive)
    (node-null-pointer)
    (node-pointer-index)))

(base:type node
  (product
    (kind u64)
    (start u64)
    (length u64)
    (child u64)
    (next u64)
    (ty u64)
    (target u64)
    (value i64)
    (generated u64)
    ; One-based module override for macro result syntax.
    (lookup-module u64)))

(array:define nodes node)

; Structured type identities are stable tape indices offset above the scalar
; range. Keep this encoding, and all descriptor field interpretation, in the
; model: consumers work with type IDs rather than recreating tape arithmetic.
(base:constant descriptor-base u64 16)

; Arena-owned node array descriptor: pointer, length, capacity, allocation layout.
; Indices survive growth; pointers into the array do not. Index zero is absent.
(base:type tape (tuple (pointer node) u64 u64 array:layout))

; A module progresses from source loading, through declaration collection, to
; dependency order. Keeping this as a sum makes cycle detection and ordering
; independent of a numeric encoding.
(base:type module-state (sum (loading) (loaded) (ordered)))

; A session owns module names, diagnostic paths, and source ranges.
; Identity follows the reference compiler: the full module name, not the path.
; Exports is an optional declaration ID.
(base:type module-info
  (product
    (name (pointer u8))
    (path (pointer u8))
    (start u64)
    (length u64)
    (exports u64)
    (state module-state)
    (first u64)
    (last u64)))

(array:define modules module-info)

; Arena-owned module table: pointer, length, capacity, allocation layout.
; Zero-based indices identify modules; the root module has index zero.
(base:type modules-array (tuple (pointer module-info) u64 u64 array:layout))

; Resolved import edge. Owner/target are module indices; alias/site are tape IDs
; for the qualifier spelling and original import declaration respectively.
(base:type import-info
  (product (owner u64) (target u64) (alias u64) (site u64)))

(array:define imports import-info)

; Arena-owned edge table: pointer, length, capacity, allocation layout.
; Aliases are unique within each importing module.
(base:type imports-array (tuple (pointer import-info) u64 u64 array:layout))

; Borrowed pointers to module/import table descriptors. Their storage and the
; invocation source/tape must outlive every context that references this session.
; STATE is an arena-owned chain of compile-time entries, never shared across sessions.
(base:type module-session
  (product
    (files (pointer modules-array))
    (edges (pointer imports-array))
    (state u64)
    (expansions u64)
    ; Borrowed immutable per-invocation target configuration, or null for native defaults.
    (configuration (pointer void))
    ; Session-owned macro registry; avoids scanning the full typed tape at every expression.
    (macros u64)))

; Borrowed program view: source bytes, mutable tape, arena, and error counter.
; Session is a module-session pointer erased to void, or null for a single file.
; Module-aware contexts interpret offsets through combined-source file ranges.
; Specialization holds a tape chain of type bindings and protocol evidence.
(base:type context
  (product
    (path (pointer u8))
    (source data:view)
    (items (pointer tape))
    (memory (pointer arena:arena))
    (errors (pointer u64))
    (session (pointer void))
    (specialization u64)))

; Return the module owning a global source offset (root is zero).
(base:function module-at ((c context) (offset u64) (index u64)) u64
  (match (base:is-null (field c session))
    (true 0)
    (false
      (let
        ((s
           module-session
           (deref (cast (pointer module-session) (field c session)))))
        (match (>= index (modules-length (deref (field s files))))
          (true 0)
          (false
            (let
              ((v
                 module-info
                 (deref
                   (pointer-offset (tuple-get (deref (field s files)) 0) index))))
              (match (< offset (+ (field v start) (field v length)))
                (true index)
                (false (module-at c offset (+ index 1)))))))))))

(base:function owner ((c context) (id u64)) u64
  (let ((v node (at c id)))
    (match (field v lookup-module)
      (0 (module-at c (field v start) 0))
      (module (- module 1)))))

(base:function file-info ((c context) (index u64)) module-info
  (let
    ((s
       module-session
       (deref (cast (pointer module-session) (field c session)))))
    (deref (pointer-offset (tuple-get (deref (field s files)) 0) index))))

(base:function has-files ((c context)) bool
  (match (base:is-null (field c session))
    (true false)
    (false
      (let
        ((s
           module-session
           (deref (cast (pointer module-session) (field c session)))))
        (> (modules-length (deref (field s files))) 0)))))

(base:function source-start ((c context) (offset u64)) u64
  (match (has-files c)
    (false 0)
    (true (field (file-info c (module-at c offset 0)) start))))

(base:function source-path ((c context) (offset u64)) (pointer u8)
  (match (has-files c)
    (false (field c path))
    (true (field (file-info c (module-at c offset 0)) path))))

; Write a borrowed NUL-terminated string to the supplied file descriptor.
(base:function text ((out i32) (value (pointer u8))) unit
  (write out (data:view value (cstring:strlen value))))

; Write the entire byte view, handling partial writes; exit on error or no progress.
(base:function write ((out i32) (value data:view)) unit
  (match (== (field value length) 0)
    (true unit)
    (false
      (let
        ((count
           i64
           (fd:write
             out
             (cast (pointer void) (field value bytes))
             (field value length))))
        (match (> count 0)
          (false (do (process:exit 2) unit))
          (true
            (let ((size u64 (base:convert count)))
              (write
                out
                (data:view
                  (pointer-offset (field value bytes) size)
                  (- (field value length) size))))))))))

; Write an unsigned decimal integer without a sign, padding, or newline.
(base:function number ((out i32) (value u64)) unit
  (let
    ((digit u8 (base:convert (+ (cast u64 48) (- value (* (/ value 10) 10))))))
    (do
      (match (>= value 10) (true (number out (/ value 10))) (false unit))
      (write out (data:view (& digit) 1)))))

(base:function diagnostic
  ((severity (pointer u8)) (code (pointer u8)) (message (pointer u8))) unit
  (diag:simple severity code message))

(base:function abort () unit
  (do (process:exit 2) unit))

; Print a diagnostic to stderr and terminate with compiler-error status 2.
(base:function fatal ((code (pointer u8)) (message (pointer u8))) unit
  (do (diagnostic "error" code message) (abort)))

; Accept a successful Foundation operation; terminate on any storage error.
(base:function storage ((result error:status)) unit
  (match result
    ((ok) unit)
    (_
      (fatal
        "compiler-storage-allocation-failed"
        "compiler storage allocation failed"))))

; Create an empty syntax tape using the supplied allocator; no nodes exist yet.
(base:function empty ((backing allocator:backend)) tape
  (nodes-empty
    (cast (pointer node) (cast (pointer void) ""))
    (array:layout constants:node-byte-size constants:node-alignment backing)))

; Read a node by stable tape index; the caller must supply a valid index.
(base:function at ((c context) (id u64)) node
  (deref (pointer-offset (tuple-get (deref (field c items)) 0) id)))

; Replace a complete node at an existing tape index without changing the tape size.
(base:function set ((c context) (id u64) (value node)) unit
  (do
    (store
      (deref (pointer-offset (tuple-get (deref (field c items)) 0) id))
      value)
    unit))

; Append a node and return its stable index.
(base:function add ((c context) (value node)) u64
  (let ((id u64 (nodes-length (deref (field c items)))))
    (do (storage (nodes-append (field c items) value)) id)))

; The numeric tape encoding is private to this table. New model APIs accept a
; NODE-KIND, so producers cannot accidentally exchange unrelated tag numbers.
(base:function kind-code ((kind node-kind)) u64
  (match kind
    ((node-atom) 0)
    ((node-list) 1)
    ((node-integer) 2)
    ((node-bool) 3)
    ((node-unit) 4)
    ((node-local) 5)
    ((node-retired) 6)
    ((node-let) 7)
    ((node-call) 8)
    ((node-primitive) 9)
    ((node-invalid-declaration) 10)
    ((node-aggregate) 13)
    ((node-extraction) 14)
    ((node-sum-construction) 15)
    ((node-match) 16)
    ((node-data) 17)
    ((node-concrete-implementation) 18)
    ((node-protocol-method) 19)
    ((node-nominal-product) 20)
    ((node-nominal-sum) 21)
    ((node-structural-tuple) 22)
    ((node-transparent-alias) 23)
    ((node-tuple-component) 24)
    ((node-reader-data) 25)
    ((node-reader-character) 26)
    ((node-collected-macro) 27)
    ((node-quote) 28)
    ((node-quasiquote) 29)
    ((node-unquote) 30)
    ((node-splice) 31)
    ((node-nominal-opaque) 33)
    ((node-pointer-descriptor) 34)
    ((node-reader-float) 35)
    ((node-float) 36)
    ((node-generic-declaration) 37)
    ((node-protocol-declaration) 38)
    ((node-concrete-protocol-instance) 39)
    ((node-specialization) 40)
    ((node-template) 41)
    ((node-type-binding) 42)
    ((node-protocol-evidence) 43)
    ((node-active-specialization) 44)
    ((node-pointer-cast) 45)
    ((node-function-signature) 46)
    ((node-function-address) 47)
    ((node-indirect-call) 48)
    ((node-array-descriptor) 49)
    ((node-array-index) 50)
    ((node-constant-declaration) 51)
    ((node-constant-reference) 52)
    ((node-external-function) 53)
    ((node-external-call) 54)
    ((node-literal-match) 55)
    ((node-sequence) 56)
    ((node-address) 57)
    ((node-dereference) 58)
    ((node-pointer-offset) 59)
    ((node-store) 60)
    ((node-tuple-match) 61)
    ((node-default-numeric-generic) 62)
    ((node-mutable-global-declaration) 63)
    ((node-global-reference) 64)
    ((node-state-entry) 65)
    ((node-qualified-key) 66)
    ((node-expansion-cache) 67)
    ((node-native-export) 68)
    ((node-computed-integer) 69)
    ((node-macro-registry-link) 70)
    ((node-computed-float) 71)
    ((node-inline-directive) 72)
    ((node-noinline-directive) 73)
    ((node-null-pointer) 74)
    ((node-pointer-index) 75)))

; Enum-typed construction boundary. The returned record keeps the existing
; ten-word tape ABI while only this function knows its encoded tag value.
(base:function record
  ((kind node-kind)
   (start u64)
   (length u64)
   (child u64)
   (next u64)
   (ty u64)
   (target u64)
   (value i64)
   (generated u64)
   (lookup-module u64)) node
  (node
    (kind-code kind)
    start
    length
    child
    next
    ty
    target
    value
    generated
    lookup-module))

(base:function add-record
  ((c context)
   (kind node-kind)
   (start u64)
   (length u64)
   (child u64)
   (next u64)
   (ty u64)
   (target u64)
   (value i64)
   (generated u64)
   (lookup-module u64)) u64
  (add
    c
    (record
      kind
      start
      length
      child
      next
      ty
      target
      value
      generated
      lookup-module)))

; A scalar type has no descriptor record. Descriptor IDs are tape indices and
; remain valid across tape growth; borrowed node pointers must not escape.
(base:function descriptor-type ((id u64)) u64
  (+ id descriptor-base))

(base:function descriptor-present ((ty u64)) bool
  (> ty descriptor-base))

(base:function descriptor-id ((ty u64)) u64
  (match (descriptor-present ty) (true (- ty descriptor-base)) (false 0)))

(base:function descriptor-kind ((c context) (ty u64)) u64
  (match (descriptor-id ty) (0 0) (id (field (at c id) kind))))

; Products and sums retain declaration syntax; their components follow the
; declaration head and name. Structural tuples and function descriptors own
; their component chains directly.
(base:function descriptor-components ((c context) (ty u64)) u64
  (let ((id u64 (descriptor-id ty)))
    (match id
      (0 0)
      (_
        (match (descriptor-kind c ty)
          (22 (child c id))
          (46 (child c id))
          (20 (next c (child c (next c (next c (child c id))))))
          (21 (next c (child c (next c (next c (child c id))))))
          (_ 0))))))

; Target and value are descriptor payloads (pointee/result or element/length).
(base:function descriptor-target ((c context) (ty u64)) u64
  (match (descriptor-id ty) (0 0) (id (field (at c id) target))))

(base:function descriptor-value ((c context) (ty u64)) i64
  (match (descriptor-id ty) (0 0) (id (field (at c id) value))))

(base:function pointer-value-type ((c context) (ty u64)) bool
  (match ty (11 true) (_ (== (descriptor-kind c ty) 34))))

; The built-in byte pointer has the same public view as a pointer descriptor.
(base:function pointer-pointee ((c context) (ty u64)) u64
  (match ty (11 7) (_ (descriptor-target c ty))))

(base:function array-element ((c context) (ty u64)) u64
  (descriptor-target c ty))

(base:function array-length ((c context) (ty u64)) u64
  (base:convert (descriptor-value c ty)))

; A callback is a pointer whose pointee is a function descriptor. Return its
; stable descriptor ID so callers never subtract the descriptor offset.
(base:function callback-signature ((c context) (ty u64)) u64
  (match (pointer-value-type c ty)
    (false 0)
    (true
      (let ((pointee u64 (pointer-pointee c ty)))
        (match (== (descriptor-kind c pointee) 46)
          (true (descriptor-id pointee))
          (false 0))))))

; Focused descriptor constructors centralize the tape layout for structural
; types. The supplied component links and source IDs are stable tape indices.
(base:function pointer-descriptor ((c context) (pointee u64)) u64
  (descriptor-type
    (add-record c (node-pointer-descriptor) 0 0 0 0 0 pointee 0 0 0)))

(base:function array-descriptor ((c context) (element u64) (length u64)) u64
  (descriptor-type
    (add-record
      c
      (node-array-descriptor)
      0
      0
      0
      0
      0
      element
      (base:convert length)
      0
      0)))

(base:function tuple-component
  ((c context) (source u64) (next-component u64) (ty u64)) u64
  (let ((v node (at c source)))
    (add-record
      c
      (node-tuple-component)
      (field v start)
      0
      0
      next-component
      ty
      0
      0
      0
      0)))

(base:function tuple-descriptor ((c context) (components u64)) u64
  (descriptor-type
    (add-record c (node-structural-tuple) 0 0 components 0 0 0 0 0 0)))

(base:function callback-descriptor
  ((c context) (source u64) (parameters u64) (result u64)) u64
  (let ((v node (at c source)))
    (descriptor-type
      (add-record
        c
        (node-function-signature)
        (field v start)
        0
        parameters
        0
        0
        result
        0
        0
        0))))

; Give the checker an independent copy of a source syntax chain.
(base:function copy-tree ((c context) (id u64)) u64
  (match id
    (0 0)
    (_
      (let
        ((v node (at c id))
         (child u64 (copy-tree c (field v child)))
         (next u64 (copy-tree c (field v next))))
        (add
          c
          (node
            (field v kind)
            (field v start)
            (field v length)
            child
            next
            0
            0
            ; Untyped lists retain their original identity through specialization.
            (match (field v kind)
              (3 (field v value))
              (1
                (match (field v ty)
                  (0
                    (match (field v value)
                      (0 (base:convert id))
                      (_ (field v value))))
                  (_ 0)))
              (_ 0))
            (field v generated)
            (field v lookup-module)))))))

; Return the next sibling index, or zero when the sibling chain ends.
(base:function next ((c context) (id u64)) u64
  (field (at c id) next))

; Return the first child index of a list, or zero when it has no children.
(base:function child ((c context) (id u64)) u64
  (field (at c id) child))

; Set a node's next sibling while preserving its span, children, and checked data.
(base:function link ((c context) (id u64) (sibling u64)) unit
  (let ((v node (at c id)))
    (set
      c
      id
      (node
        (field v kind)
        (field v start)
        (field v length)
        (field v child)
        sibling
        (field v ty)
        (field v target)
        (field v value)
        (field v generated)
        (field v lookup-module)))))

; Attach a checked kind, type, resolved target, and literal value; return the type ID.
(base:function typed
  ((c context) (id u64) (kind u64) (ty u64) (target u64) (value i64)) u64
  (let ((v node (at c id)))
    (do
      (set
        c
        id
        (node
          kind
          (field v start)
          (field v length)
          (field v child)
          (field v next)
          ty
          target
          value
          (field v generated)
          (field v lookup-module)))
      ty)))

; Checked retagging follows the same enum boundary as construction.
(base:function typed-kind
  ((c context) (id u64) (kind node-kind) (ty u64) (target u64) (value i64)) u64
  (typed c id (kind-code kind) ty target value))

; Read a source byte as u64; return the zero sentinel at or beyond the source end.
(base:function byte ((c context) (i u64)) u64
  (match (< i (field (field c source) length))
    (true
      (base:convert (deref (pointer-offset (field (field c source) bytes) i))))
    (false 0)))

(base:function bytes-at ((bits u64)) (pointer u8)
  (deref (cast (pointer (pointer u8)) (cast (pointer void) (& bits)))))

; Generated symbols retain their creation site and borrow separate arena bytes.
(base:function spelling ((c context) (id u64)) data:view
  (let ((v node (at c id)))
    (data:view
      (match (field v generated)
        (0 (pointer-offset (field (field c source) bytes) (field v start)))
        (bits (bytes-at bits)))
      (field v length))))

; Read a byte of original or arena-owned literal text without losing provenance.
(base:function spelling-byte ((c context) (id u64) (index u64)) u64
  (base:convert (deref (pointer-offset (field (spelling c id) bytes) index))))

; Compare a node's complete source spelling with a borrowed C string.
(base:function is ((c context) (id u64) (name (pointer u8))) bool
  (data:equal (spelling c id) (data:view name (cstring:strlen name))))

; Compare the original spellings of two nodes, independently of their resolved IDs.
(base:function same ((c context) (left u64) (right u64)) bool
  (data:equal (spelling c left) (spelling c right)))

; Bounded-depth source location scan, including CRLF as a single newline.
; Mutable source cursor with one-based lines and byte columns. CR remembers
; a preceding carriage return so a CRLF pair counts as one newline.
(base:type position (product (line u64) (column u64) (cr bool)))

; Advance a mutable source position over a byte range with bounded recursion depth.
; Treat CRLF as one newline and keep line/column positions one-based.
(base:function locate
  ((c context) (start u64) (count u64) (pos (pointer position))) unit
  (match count
    (0 unit)
    (1
      (let ((b u64 (byte c start)) (v position (deref pos)))
        (do
          (store
            (deref pos)
            (match b
              (13 (position (+ (field v line) 1) 1 true))
              (10
                (position
                  (match (field v cr)
                    (true (field v line))
                    (false (+ (field v line) 1)))
                  1
                  false))
              (_ (position (field v line) (+ (field v column) 1) false))))
          unit)))
    (_
      (let ((half u64 (/ count 2)))
        (do
          (locate c start half pos)
          (locate c (+ start half) (- count half) pos))))))

(base:function location-in-file
  ((c context)
   (path (pointer u8))
   (first u64)
   (size u64)
   (offset u64)
   (length u64)) diag:location
  (let ((relative u64 (- offset first)) (pos position (position 1 1 false)))
    (match (base:and (>= offset first) (<= relative size))
      (false (diag:no-location))
      (true
        (do
          (locate c first relative (& pos))
          (diag:location
            path
            (field pos line)
            (field pos column)
            relative
            (match (<= length (- size relative))
              (true (+ relative length))
              (false relative))
            (data:view
              (pointer-offset (field (field c source) bytes) first)
              size)))))))

(base:function source-location ((c context) (offset u64) (length u64))
  diag:location
  (match (has-files c)
    (false
      (location-in-file
        c
        (field c path)
        0
        (field (field c source) length)
        offset
        length))
    (true
      (let ((v module-info (file-info c (module-at c offset 0))))
        ; The combined source has a synthetic separator after each file.
        (location-in-file
          c
          (field v path)
          (field v start)
          (- (field v length) 1)
          offset
          length)))))

; Generated spellings can have a different length from their source site.
(base:function site ((c context) (id u64)) diag:location
  (match id
    (0 (diag:no-location))
    (_
      (let ((v node (at c id)))
        (source-location
          c
          (field v start)
          (match (field v generated) (0 (field v length)) (_ 0)))))))

(base:function diagnostic-at
  ((c context)
   (id u64)
   (severity (pointer u8))
   (code (pointer u8))
   (message (pointer u8))) unit
  (diag:emit
    (diag:entry
      severity
      code
      (diag:string-view message)
      (match id
        ; Required syntax can be missing from an empty file. Keep its start location.
        (0 (source-location c 0 0))
        (_ (site c id))))
    nil
    (data:view nil 0)))

(base:function error-range
  ((c context)
   (offset u64)
   (length u64)
   (code (pointer u8))
   (message (pointer u8))) unit
  (do
    (diag:emit
      (diag:entry
        "error"
        code
        (diag:string-view message)
        (source-location c offset length))
      nil
      (data:view nil 0))
    (abort)))

; Report a fatal diagnostic at a source byte offset, then exit with status 2.
(base:function error-at
  ((c context) (offset u64) (code (pointer u8)) (message (pointer u8))) unit
  (error-range c offset 0 code message))

; Report a fatal diagnostic at the specified syntax node.
(base:function error
  ((c context) (id u64) (code (pointer u8)) (message (pointer u8))) unit
  (do (diagnostic-at c id "error" code message) (abort)))

(base:function count-error ((c context)) unit
  (do (store (deref (field c errors)) (+ (deref (field c errors)) 1)) unit))

; Record a semantic diagnostic without terminating analysis.
(base:function report
  ((c context) (id u64) (code (pointer u8)) (message (pointer u8))) unit
  (do (diagnostic-at c id "error" code message) (count-error c)))

; Enforce an analysis invariant or report the supplied diagnostic at the node.
(base:function require
  ((c context)
   (id u64)
   (condition bool)
   (code (pointer u8))
   (message (pointer u8))) unit
  (match condition (true unit) (false (error c id code message))))

; A linked environment on the host stack; no pointer escapes its recursive scope.
; NAME is a syntax index, BINDER a stable identity, VALUE an evaluated i64.
; Name resolution uses only NAME/BINDER; it leaves VALUE zero.
; Borrowed lexical environment link. Parent is another binding pointer erased
; to void, or null at the end. Stack-allocated links cannot escape their scope.
(base:type binding
  (product (name u64) (binder u64) (value i64) (parent (pointer void))))

; Inspect pointer bits on the supported 64-bit ABI; this does not dereference the pointee.
(base:function address ((p (pointer void))) u64
  (deref (cast (pointer u64) (cast (pointer void) (& p)))))

; Recover the arena-owned bytes from a checked data literal.
(base:function literal-bytes ((c context) (id u64)) (pointer u8)
  (bytes-at (field (at c id) target)))

; Construct the null pointer that marks the end of a borrowed environment chain.
(base:function empty-env () (pointer void)
  nil)

; Search lexical bindings from inner to outer scope; return a binder ID or zero if absent.
(base:function lookup ((c context) (name u64) (env (pointer void))) u64
  (match (base:is-null env)
    (true 0)
    (false
      (let ((b binding (deref (cast (pointer binding) env))))
        (match (same c name (field b name))
          (true (field b binder))
          (false (lookup c name (field b parent))))))))

; Find a resolved binder's signed runtime value; a missing binder is a fatal internal error.
(base:function value ((binder u64) (env (pointer void))) i64
  (match (base:is-null env)
    (true
      (do
        (fatal
          "internal-error-missing-resolved-binding"
          "internal error: missing resolved binding")
        (let ((zero i64 0)) zero)))
    (false
      (let ((b binding (deref (cast (pointer binding) env))))
        (match (== binder (field b binder))
          (true (field b value))
          (false (value binder (field b parent))))))))

