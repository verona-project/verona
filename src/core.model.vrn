(import base)
(import core.constants :as constants)
(import allocator)
(import array)
(import error)
(import data)
(import arena)
(import libc.descriptor :as fd)
(import libc.process :as process)
(import libc.string :as cstring)

; Stable indices into an arena-owned syntax/typed tape. Index zero is absent.
; Reader kinds: atom=0, list=1, data=25, character=26. Checked kinds: integer=2, bool=3, unit=4,
; local=5, if=6, let=7, call=8, primitive=9, invalid declaration=10.
; Checked expressions: aggregate=13, extraction=14, sum construction=15, match=16, data=17.
; Descriptors: nominal product=20, sum=21, structural tuple=22, transparent alias=23, tuple component=24.
; Nominal opaque type=33, pointer descriptor=34. Reader float=35, checked float=36.
; Concrete implementation=18, protocol method=19, generic declaration=37.
; Protocol declaration=38, concrete protocol instance=39.
; Specialization=40, template=41, type binding=42, protocol evidence=43, active specialization=44, pointer cast=45.
; Function signature=46, function address=47, indirect call=48, array descriptor=49, array index=50.
; Constant declaration=51, constant reference=52.
; External function=53, external call=54.
; Literal/binding match=55. Match arms use target=0 for catch-all, value=binder
; or zero for wildcard. Literal arms use target=1, value=the checked bits.
; Address=57, dereference=58, pointer offset=59, store=60, tuple match=61.
; Sequence=56, with expressions after its operation head.
; Collected macro=27. Reader prefixes: quote=28, quasiquote=29, unquote=30, splice=31.
; Default numeric generic=62, with an operation code in target and virtual signatures.
; Mutable global declaration=63, global reference/place=64 with declaration ID in target.
; Session-only nodes: state entry=65, normalized qualified key=66, expansion cache=67.
; Macro registry link=70: child=installed macro ID, target=owning module, next=previous link.
; Native export=68, with resolved function TARGET and decoded symbol node in VALUE.
; Untyped list VALUE may retain its source identity when copied for specialization.
; Computed macro integer spellings use kind=69 and arena-owned generated bytes.
; Computed macro binary64 values use kind=71 with exact bits in VALUE until contextual typing.
; Computed macro booleans use kind=3 with ty=0 until contextual checking.
; Types: error=0 (analysis only), unit=1, bool=2, integer types=3..10, (pointer u8)=11, f32=12, f64=13, void=14. Descriptors use ID+16.
; TARGET holds a binder/function index, opcode, checked binding initializer ID, or data literal address.
; Nine u64 metadata fields and one i64 literal: 80 bytes, alignment 8 on the supported ABI.
; Shared reader/checked-program record. Child and next are tape IDs, with zero
; denoting absence. Checking installs concrete types and resolved targets in place.
(base:type node
  (product
    (kind u64)
    (start u64)
    (length u64)
    (child u64)
    (next u64)
    (ty u64)
    (target u64)
    (value i64)
    (generated u64)
    ; One-based module override for macro result syntax.
    (lookup-module u64)))

(array:define nodes node)

; Arena-owned node array descriptor: pointer, length, capacity, allocation layout.
; Indices survive growth; pointers into the array do not. Index zero is absent.
(base:type tape (tuple (pointer node) u64 u64 array:layout))

; A module progresses from source loading, through declaration collection, to
; dependency order. Keeping this as a sum makes cycle detection and ordering
; independent of a numeric encoding.
(base:type module-state (sum (loading) (loaded) (ordered)))

; A session owns module names, diagnostic paths, and source ranges.
; Identity follows the reference compiler: the full module name, not the path.
; Exports is an optional declaration ID.
(base:type module-info
  (product
    (name (pointer u8))
    (path (pointer u8))
    (start u64)
    (length u64)
    (exports u64)
    (state module-state)
    (first u64)
    (last u64)))

(array:define modules module-info)

; Arena-owned module table: pointer, length, capacity, allocation layout.
; Zero-based indices identify modules; the root module has index zero.
(base:type modules-array (tuple (pointer module-info) u64 u64 array:layout))

; Resolved import edge. Owner/target are module indices; alias/site are tape IDs
; for the qualifier spelling and original import declaration respectively.
(base:type import-info (product (owner u64) (target u64) (alias u64) (site u64)))

(array:define imports import-info)

; Arena-owned edge table: pointer, length, capacity, allocation layout.
; Aliases are unique within each importing module.
(base:type imports-array (tuple (pointer import-info) u64 u64 array:layout))

; Borrowed pointers to module/import table descriptors. Their storage and the
; invocation source/tape must outlive every context that references this session.
; STATE is an arena-owned chain of compile-time entries, never shared across sessions.
(base:type module-session
  (product
    (files (pointer modules-array))
    (edges (pointer imports-array))
    (state u64)
    (expansions u64)
    ; Borrowed immutable per-invocation target configuration, or null for native defaults.
    (configuration (pointer void))
    ; Session-owned macro registry; avoids scanning the full typed tape at every expression.
    (macros u64)))

; Borrowed program view: source bytes, mutable tape, arena, and error counter.
; Session is a module-session pointer erased to void, or null for a single file.
; Module-aware contexts interpret offsets through combined-source file ranges.
; Specialization holds a tape chain of type bindings and protocol evidence.
(base:type context
  (product
    (path (pointer u8))
    (source data:view)
    (items (pointer tape))
    (memory (pointer arena:arena))
    (errors (pointer u64))
    (session (pointer void))
    (specialization u64)))

; Return the module owning a global source offset (root is zero).
(base:function module-at ((c context) (offset u64) (index u64)) u64
  (match (is-empty (field c session))
    (true 0)
    (false
      (let ((s module-session (deref (cast (pointer module-session) (field c session)))))
        (match (>= index (modules-length (deref (field s files))))
          (true 0)
          (false
            (let
              ((v module-info (deref (pointer-offset (tuple-get (deref (field s files)) 0) index))))
              (match (< offset (+ (field v start) (field v length)))
                (true index)
                (false (module-at c offset (+ index 1)))))))))))

(base:function owner ((c context) (id u64)) u64
  (let ((v node (at c id)))
    (match (field v lookup-module) (0 (module-at c (field v start) 0)) (module (- module 1)))))

(base:function file-info ((c context) (index u64)) module-info
  (let ((s module-session (deref (cast (pointer module-session) (field c session)))))
    (deref (pointer-offset (tuple-get (deref (field s files)) 0) index))))

(base:function has-files ((c context)) bool
  (match (is-empty (field c session))
    (true false)
    (false
      (let ((s module-session (deref (cast (pointer module-session) (field c session)))))
        (> (modules-length (deref (field s files))) 0)))))

(base:function source-start ((c context) (offset u64)) u64
  (match (has-files c) (false 0) (true (field (file-info c (module-at c offset 0)) start))))

(base:function source-path ((c context) (offset u64)) (pointer u8)
  (match (has-files c)
    (false (field c path))
    (true (field (file-info c (module-at c offset 0)) path))))

; Write a borrowed NUL-terminated string to the supplied file descriptor.
(base:function text ((out i32) (value (pointer u8))) unit
  (write out (data:view value (cstring:strlen value))))

; Write the entire byte view, handling partial writes; exit on error or no progress.
(base:function write ((out i32) (value data:view)) unit
  (match (== (field value length) 0)
    (true unit)
    (false
      (let
        ((count i64 (fd:write out (cast (pointer void) (field value bytes)) (field value length))))
        (match (> count 0)
          (false (do (process:exit 2) unit))
          (true
            (let ((size u64 (base:convert count)))
              (write
                out
                (data:view
                  (pointer-offset (field value bytes) size)
                  (- (field value length) size))))))))))

; Write an unsigned decimal integer without a sign, padding, or newline.
(base:function number ((out i32) (value u64)) unit
  (let ((digit u8 (base:convert (+ (cast u64 48) (- value (* (/ value 10) 10))))))
    (do
      (match (>= value 10) (true (number out (/ value 10))) (false unit))
      (write out (data:view (& digit) 1)))))

; Print a diagnostic to stderr and terminate with compiler-error status 2.
(base:function fatal ((message (pointer u8))) unit
  (do (text 2 message) (text 2 "\n") (process:exit 2) unit))

; Accept a successful Foundation operation; terminate on any storage error.
(base:function storage ((result error:status)) unit
  (match result ((ok) unit) (_ (fatal "compiler storage allocation failed"))))

; Create an empty syntax tape using the supplied allocator; no nodes exist yet.
(base:function empty ((backing allocator:backend)) tape
  (nodes-empty
    (cast (pointer node) (cast (pointer void) ""))
    (array:layout constants:node-byte-size constants:node-alignment backing)))

; Read a node by stable tape index; the caller must supply a valid index.
(base:function at ((c context) (id u64)) node
  (deref (pointer-offset (tuple-get (deref (field c items)) 0) id)))

; Replace a complete node at an existing tape index without changing the tape size.
(base:function set ((c context) (id u64) (value node)) unit
  (do (store (deref (pointer-offset (tuple-get (deref (field c items)) 0) id)) value) unit))

; Append a node and return its stable index.
(base:function add ((c context) (value node)) u64
  (let ((id u64 (nodes-length (deref (field c items)))))
    (do (storage (nodes-append (field c items) value)) id)))

; Give the checker an independent copy of a source syntax chain.
(base:function copy-tree ((c context) (id u64)) u64
  (match id
    (0 0)
    (_
      (let
        ((v node (at c id))
         (child u64 (copy-tree c (field v child)))
         (next u64 (copy-tree c (field v next))))
        (add
          c
          (node
            (field v kind)
            (field v start)
            (field v length)
            child
            next
            0
            0
            ; Untyped lists retain their original identity through specialization.
            (match (field v kind)
              (3 (field v value))
              (1
                (match (field v ty)
                  (0 (match (field v value) (0 (base:convert id)) (_ (field v value))))
                  (_ 0)))
              (_ 0))
            (field v generated)
            (field v lookup-module)))))))

; Return the next sibling index, or zero when the sibling chain ends.
(base:function next ((c context) (id u64)) u64
  (field (at c id) next))

; Return the first child index of a list, or zero when it has no children.
(base:function child ((c context) (id u64)) u64
  (field (at c id) child))

; Set a node's next sibling while preserving its span, children, and checked data.
(base:function link ((c context) (id u64) (sibling u64)) unit
  (let ((v node (at c id)))
    (set
      c
      id
      (node
        (field v kind)
        (field v start)
        (field v length)
        (field v child)
        sibling
        (field v ty)
        (field v target)
        (field v value)
        (field v generated)
        (field v lookup-module)))))

; Attach a checked kind, type, resolved target, and literal value; return the type ID.
(base:function typed ((c context) (id u64) (kind u64) (ty u64) (target u64) (value i64)) u64
  (let ((v node (at c id)))
    (do
      (set
        c
        id
        (node
          kind
          (field v start)
          (field v length)
          (field v child)
          (field v next)
          ty
          target
          value
          (field v generated)
          (field v lookup-module)))
      ty)))

; Read a source byte as u64; return the zero sentinel at or beyond the source end.
(base:function byte ((c context) (i u64)) u64
  (match (< i (field (field c source) length))
    (true (base:convert (deref (pointer-offset (field (field c source) bytes) i))))
    (false 0)))

(base:function bytes-at ((bits u64)) (pointer u8)
  (deref (cast (pointer (pointer u8)) (cast (pointer void) (& bits)))))

; Generated symbols retain their creation site and borrow separate arena bytes.
(base:function spelling ((c context) (id u64)) data:view
  (let ((v node (at c id)))
    (data:view
      (match (field v generated)
        (0 (pointer-offset (field (field c source) bytes) (field v start)))
        (bits (bytes-at bits)))
      (field v length))))

; Read a byte of original or arena-owned literal text without losing provenance.
(base:function spelling-byte ((c context) (id u64) (index u64)) u64
  (base:convert (deref (pointer-offset (field (spelling c id) bytes) index))))

; Compare a node's complete source spelling with a borrowed C string.
(base:function is ((c context) (id u64) (name (pointer u8))) bool
  (data:equal (spelling c id) (data:view name (cstring:strlen name))))

; Compare the original spellings of two nodes, independently of their resolved IDs.
(base:function same ((c context) (left u64) (right u64)) bool
  (data:equal (spelling c left) (spelling c right)))

; Bounded-depth source location scan, including CRLF as a single newline.
; Mutable source cursor with one-based lines and byte columns. CR remembers
; a preceding carriage return so a CRLF pair counts as one newline.
(base:type position (product (line u64) (column u64) (cr bool)))

; Advance a mutable source position over a byte range with bounded recursion depth.
; Treat CRLF as one newline and keep line/column positions one-based.
(base:function locate ((c context) (start u64) (count u64) (pos (pointer position))) unit
  (match count
    (0 unit)
    (1
      (let ((b u64 (byte c start)) (v position (deref pos)))
        (do
          (store
            (deref pos)
            (match b
              (13 (position (+ (field v line) 1) 1 true))
              (10
                (position
                  (match (field v cr) (true (field v line)) (false (+ (field v line) 1)))
                  1
                  false))
              (_ (position (field v line) (+ (field v column) 1) false))))
          unit)))
    (_
      (let ((half u64 (/ count 2)))
        (do (locate c start half pos) (locate c (+ start half) (- count half) pos))))))

; Print FILE:LINE:COLUMN followed by a colon and space to stderr for a byte offset.
(base:function location ((c context) (offset u64)) unit
  (let ((pos position (position 1 1 false)))
    (do
      (locate c (source-start c offset) (- offset (source-start c offset)) (& pos))
      (text 2 (source-path c offset))
      (text 2 ":")
      (number 2 (field pos line))
      (text 2 ":")
      (number 2 (field pos column))
      (text 2 ": ")
      unit)))

; Report a fatal diagnostic at a source byte offset, then exit with status 2.
(base:function error-at ((c context) (offset u64) (message (pointer u8))) unit
  (do (location c offset) (fatal message)))

; Report a fatal diagnostic at the start of the specified syntax node.
(base:function error ((c context) (id u64) (message (pointer u8))) unit
  (error-at c (field (at c id) start) message))

; Record a semantic diagnostic without terminating analysis.
(base:function report ((c context) (id u64) (message (pointer u8))) unit
  (do
    (location c (field (at c id) start))
    (text 2 message)
    (text 2 "\n")
    (store (deref (field c errors)) (+ (deref (field c errors)) 1))
    unit))

; Enforce an analysis invariant or report the supplied diagnostic at the node.
(base:function require ((c context) (id u64) (condition bool) (message (pointer u8))) unit
  (match condition (true unit) (false (error c id message))))

; A linked environment on the host stack; no pointer escapes its recursive scope.
; NAME is a syntax index, BINDER a stable identity, VALUE an evaluated i64.
; Name resolution uses only NAME/BINDER; it leaves VALUE zero.
; Borrowed lexical environment link. Parent is another binding pointer erased
; to void, or null at the end. Stack-allocated links cannot escape their scope.
(base:type binding (product (name u64) (binder u64) (value i64) (parent (pointer void))))

; Inspect pointer bits on the supported 64-bit ABI; this does not dereference the pointee.
(base:function address ((p (pointer void))) u64
  (deref (cast (pointer u64) (cast (pointer void) (& p)))))

; Recover the arena-owned bytes from a checked data literal.
(base:function literal-bytes ((c context) (id u64)) (pointer u8)
  (bytes-at (field (at c id) target)))

; Construct the null pointer that marks the end of a borrowed environment chain.
(base:function empty-env () (pointer void)
  (let ((zero u64 0)) (deref (cast (pointer (pointer void)) (cast (pointer void) (& zero))))))

; Test whether an environment pointer is the null chain terminator.
(base:function is-empty ((p (pointer void))) bool
  (base:is-null p))

; Search lexical bindings from inner to outer scope; return a binder ID or zero if absent.
(base:function lookup ((c context) (name u64) (env (pointer void))) u64
  (match (is-empty env)
    (true 0)
    (false
      (let ((b binding (deref (cast (pointer binding) env))))
        (match (same c name (field b name))
          (true (field b binder))
          (false (lookup c name (field b parent))))))))

; Find a resolved binder's signed runtime value; a missing binder is a fatal internal error.
(base:function value ((binder u64) (env (pointer void))) i64
  (match (is-empty env)
    (true (do (fatal "internal error: missing resolved binding") (let ((zero i64 0)) zero)))
    (false
      (let ((b binding (deref (cast (pointer binding) env))))
        (match (== binder (field b binder))
          (true (field b value))
          (false (value binder (field b parent))))))))

(export
  module-info
  module-state
  modules-array
  modules-empty
  modules-append
  modules-length
  import-info
  imports-array
  imports-empty
  imports-append
  imports-length
  module-session
  owner
  file-info
  source-start
  source-path
  nodes-length
  node
  tape
  context
  empty
  at
  set
  add
  next
  child
  link
  typed
  byte
  spelling
  spelling-byte
  copy-tree
  is
  same
  text
  write
  number
  fatal
  storage
  position
  locate
  location
  error-at
  error
  require
  report
  binding
  empty-env
  is-empty
  address
  literal-bytes
  lookup
  value)
