    (m:location c (field (m:at c name) start))
    (m:text lconstants:STDERR-FILENO "unknown function: ")
    (m:write 2 (m:spelling c name))
    (m:text lconstants:STDERR-FILENO "\n")
    (store (deref (field c errors)) (+ (deref (field c errors)) 1))
    unit))

; Resolve the nearest namespace first; invalid declarations never supply a signature.
(base:function direct-call
  ((c m:context) (id u64) (head u64) (args u64) (env (pointer void)) (all u64) (expected u64)) u64
