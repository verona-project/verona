           (append-byte out (& cursor) 0)
           (m:typed c id 17 11 (m:address (cast (pointer void) out)) 0))))
      (_ (do (m:report c id "data literal storage allocation failed") 0)))))

; Resolve and type-check one expression, recording literal values and binder identities.
