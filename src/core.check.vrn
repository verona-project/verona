                 (arguments c args (m:child c (signature c fn)) env all)
                 (m:typed c id 54 (match (field (m:at c fn) ty) (14 1) (ty ty)) fn 0)))
              ((== (field (m:at c fn) ty) 0) 0)
              (true
                (do
                  (arguments c args (m:child c (signature c fn)) env all)
                  (m:typed c id 8 (field (m:at c fn) ty) fn 0))))))))))

; Binder value bits encode addressable=1, writable=2, materialized storage=4.
(base:function place-flags ((c m:context) (id u64)) u64
  (let ((v m:node (m:at c id)))
    (match (field v kind)
      (64 3)
      (5 (num:remainder (base:convert (field (m:at c (field v target)) value)) 4))
      (58 3)
      (14 (base:convert (field v value)))
      (50 (base:convert (field v value)))
      (_ 0))))

(base:function stored-binder ((c m:context) (id u64)) bool
  (let ((value u64 (base:convert (field (m:at c id) value))))
    (>= value (cast u64 4))))

(base:function materialize-place ((c m:context) (id u64)) unit
  (let ((v m:node (m:at c id)))
    (match (field v kind)
      (5
        (let ((binder u64 (field v target)) (name m:node (m:at c binder)))
          (match (stored-binder c binder)
            (true unit)
            (false
