(import base)
(import arena)
(import core.sexpr :as syntax)
(import core.numeric :as num)
(import core.float :as float)
(import core.constants :as constants)
(import core.model :as m)
(import core.syntax-support :as raw)
(import core.expand :as expand)
(import data)
(import libc.string :as cstring)
(import libc.constants :as lconstants)

(base:function require ((c m:context) (id u64) (condition bool) (message (pointer u8))) unit
  (match condition (true unit) (false (m:report c id message))))

; Test whether a sibling chain contains exactly count nodes.
(base:function arity ((c m:context) (id u64) (count u64)) bool
  (raw:arity c id count))

; Test whether a nonzero syntax index refers to an unchecked reader atom.
(base:function atom ((c m:context) (id u64)) bool
  (raw:atom c id))

; Test whether a nonzero syntax index refers to a reader list.
(base:function list ((c m:context) (id u64)) bool
  (match id (0 false) (_ (== (field (m:at c id) kind) 1))))

; Resolve concrete type syntax after nominal declarations have been registered.
(base:function type-name ((c m:context) (id u64)) u64
  (let ((ty u64 (type-reference c id)))
    (base:cond
      ((== ty 14) (m:report c id "void type requires a pointer") 0)
      ((== (type-kind c ty) 33) (m:report c id "opaque type requires a pointer") 0)
      ((== (type-kind c ty) 46) (m:report c id "function type requires a pointer") 0)
      (true (do (resolve-value-layout c ty) ty)))))

(base:function resolve-value-layout ((c m:context) (ty u64)) unit
  (match (type-kind c ty)
    (20 (resolve-layout c (- ty num:descriptor-base)))
    (21 (resolve-layout c (- ty num:descriptor-base)))
    (22 (resolve-component-layouts c (type-components c ty)))
    (49 (resolve-value-layout c (array-element c ty)))
    (_ unit)))

(base:function resolve-component-layouts ((c m:context) (id u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (resolve-value-layout c (field (m:at c id) ty))
        (resolve-component-layouts c (m:next c id))))))

(base:function type-reference ((c m:context) (id u64)) u64
  (let ((slot u64 (substitution-slot c (field c specialization) id)))
    (match slot (0 (concrete-type-reference c id)) (_ (field (m:at c slot) ty)))))

(base:function concrete-type-reference ((c m:context) (id u64)) u64
  (base:cond
    ((m:is c id "unit") (+ 0 1))
    ((m:is c id "bool") (+ 0 2))
    ((m:is c id "void") 14)
    ((> (num:type-name c id) 0) (num:type-name c id))
    ((list c id)
     (base:cond
       ((m:is c (m:child c id) "pointer")
        (let ((pointee u64 (m:next c (m:child c id))))
          (match (arity c pointee 1)
            (true (pointer-type c (type-reference c pointee)))
            (false (do (m:report c id "pointer requires one pointee type") 0)))))
       ((m:is c (m:child c id) "function") (callback-type c id))
       ((m:is c (m:child c id) "array") (array-type-reference c id))
       ((m:is c (m:child c id) "tuple")
        (do
          (tuple-reference-types c (m:next c (m:child c id)))
          (tuple-type c (m:next c (m:child c id)))))
       (true (do (m:report c id "expected concrete type") 0))))
    (true
      (let ((found u64 (type-resolve c id)))
        (match found (0 (do (unknown-type c id) 0)) (_ (resolve-declared-type c found)))))))

; Map an expanded typed i64 primitive name to its opcode; return zero for other names.
(base:function letter ((b u64)) bool
  (base:or (== b 95) (base:and (>= b 65) (<= b 90)) (base:and (>= b 97) (<= b 122))))

; Recognize an ASCII decimal digit without interpreting its numeric value.
(base:function digit ((b u64)) bool
  (raw:digit b))

; Validate identifier bytes in [i,end), allowing letters, digits, underscore, and hyphen.
; Split long ranges to avoid stack growth proportional to identifier length.
(base:function name-tail ((bytes (pointer u8)) (i u64) (end u64)) bool
  (match (- end i)
    (0 true)
    (1
      (let ((b u64 (base:convert (deref (pointer-offset bytes i)))))
        (base:cond ((letter b) true) ((digit b) true) (true (== b 45)))))
    (_
      (let ((middle u64 (+ i (/ (- end i) 2))))
        (match (name-tail bytes i middle) (false false) (true (name-tail bytes middle end)))))))

; Require a valid, non-reserved identifier and report errors at its source location.
(base:function identifier ((c m:context) (id u64)) unit
  (let ((name data:view (m:spelling c id)))
    (do
      (require c id (atom c id) "expected identifier")
      (require
        c
        id
        (match (field name length) (0 false) (_ (letter (base:convert (deref (field name bytes))))))
        "invalid identifier")
      (require c id (name-tail (field name bytes) 0 (field name length)) "invalid identifier")
      (require c id (match (m:is c id "if") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "let") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "function") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "true") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "false") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "unit") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "void") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "bool") (true false) (false true)) "reserved identifier")
      (require c id (== (num:type-name c id) 0) "reserved identifier")
      (require c id (match (m:is c id "cast") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "tuple") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "tuple-get") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "field") (true false) (false true)) "reserved identifier")
      (require c id (match (m:is c id "match") (true false) (false true)) "reserved identifier")
      unit)))

; Locate the parameter-list node in a structurally valid function declaration.
(base:function signature ((c m:context) (fn u64)) u64
  (match (field (m:at c fn) kind)
    (53 (field (m:at c fn) target))
    (_ (m:next c (m:next c (m:child c fn))))))

; Locate the single body expression in a structurally valid function declaration.
(base:function body ((c m:context) (fn u64)) u64
  (m:next c (m:next c (signature c fn))))

; Find a named function in the top-level chain by source spelling, or return zero.
(base:function declaration-shape ((c m:context) (fn u64)) bool
  (match (list c fn)
    (false false)
    (true
      (match (arity c (m:child c fn) 5) (false false) (true (m:is c (m:child c fn) "%function"))))))

(base:function constant-declaration ((c m:context) (id u64)) bool
  (m:is c (m:child c id) "%constant"))

(base:function variable-declaration ((c m:context) (id u64)) bool
  (m:is c (m:child c id) "%variable"))

; Keep C object validation separate from the private core value representation.
(base:function c-seen ((ty u64) (seen (pointer void))) bool
  (match (m:is-empty seen)
    (true false)
    (false
      (let ((v m:binding (deref (cast (pointer m:binding) seen))))
        (match (== ty (field v binder)) (true true) (false (c-seen ty (field v parent))))))))

(base:function c-components ((c m:context) (id u64) (seen (pointer void))) bool
  (match id
    (0 true)
    (_
      (match (c-value-type c (field (m:at c id) ty) seen)
        (false false)
        (true (c-components c (m:next c id) seen))))))

(base:function c-cases ((c m:context) (id u64) (seen (pointer void))) bool
  (match id
    (0 true)
    (_
      (match (c-components c (m:next c (m:child c id)) seen)
        (false false)
        (true (c-cases c (m:next c id) seen))))))

(base:function c-value-type ((c m:context) (ty u64) (seen (pointer void))) bool
  (base:cond
    ((== ty 2) true)
    ((num:integer-type ty) true)
    ((num:float-type ty) true)
    ((== ty 11) true)
    ((c-seen ty seen) true)
    (true
      (let
        ((binding m:binding (m:binding 0 ty 0 seen))
         (rest (pointer void) (cast (pointer void) (& binding))))
        (match (type-kind c ty)
          (34
            (let ((pointee u64 (pointer-pointee c ty)))
              (base:cond
                ((== pointee 14) true)
                ((== (type-kind c pointee) 33) true)
                ((== (type-kind c pointee) 46)
                 (let ((v m:node (m:at c (- pointee num:descriptor-base))))
                   (match (c-components c (field v child) rest)
                     (false false)
                     (true (match (field v target) (14 true) (result (c-value-type c result rest)))))))
                (true (c-value-type c pointee rest)))))
          (20 (c-components c (type-components c ty) rest))
          (21 (c-cases c (type-components c ty) rest))
          (49 (c-value-type c (array-element c ty) rest))
          (_ false))))))

(base:function parameter-type ((c m:context) (id u64)) u64
  (let ((v m:node (m:at c id)))
    (match (field v ty) (0 (field (m:at c (field v child)) ty)) (ty ty))))

(base:function external-name ((c m:context) (id u64)) (pointer u8)
  (m:literal-bytes c (base:convert (field (m:at c id) value))))

(base:function external-parameters ((c m:context) (id u64)) u64
  (match id
    (0 0)
    (_
      (let
        ((v m:node (m:at c id))
         (ty u64 (type-name c id))
         (next u64 (external-parameters c (m:next c id)))
         (name u64 (m:add c (m:node 0 (field v start) 0 0 id ty 0 0 0 (field v lookup-module)))))
        (do
          (require
            c
            id
            (c-value-type c ty (m:empty-env))
            "external parameters require C-compatible value types")
          (m:add c (m:node 1 (field v start) 0 name next ty 0 0 0 (field v lookup-module))))))))

(base:function external-signature ((c m:context) (id u64) (all u64)) unit
  (let
    ((head u64 (m:child c id))
     (name u64 (m:next c head))
     (symbol u64 (m:next c name))
     (params u64 (m:next c symbol))
     (result u64 (m:next c params)))
    (match
      (match (arity c head 5)
        (true (match (== (field (m:at c symbol) kind) 25) (true (list c params)) (false false)))
        (false false))
      (false
        (m:report
          c
          id
          "%external-function requires a name, external data name, parameter type list, and result type"))
      (true
        (let ((ty u64 (type-reference c result)))
          (do
            (generic-name c name)
            (require
              c
              name
              (== (find c all name) id)
              "duplicate external function or declaration")
            (require
              c
              name
              (== (type-resolve c name) 0)
              "external function conflicts with type constructor")
            (require
              c
              name
              (== (cases-find c name (m:spelling c name) 1 0) 0)
              "external function conflicts with sum constructor")
            (require
              c
              params
              (<= (chain-length c (m:child c params)) constants:parameter-limit)
              "parameter limit (64) exceeded")
            (resolve-value-layout c ty)
            (require
              c
              result
              (match ty (14 true) (_ (c-value-type c ty (m:empty-env))))
              "external result requires a C-compatible value type or void")
            (data-literal c symbol (m:at c symbol))
            (match (field (m:at c symbol) kind)
              (17
                (let
                  ((bytes (pointer u8) (m:literal-bytes c symbol))
                   (checked u64 (external-parameters c (m:child c params))))
                  (do
                    (require
                      c
                      symbol
                      (> (cstring:strlen bytes) 0)
                      "external symbol cannot be empty")
                    (require
                      c
                      symbol
                      (match (cstring:strcmp bytes "main") (0 false) (_ true))
                      "external symbol main is reserved for the entry point")
                    (m:typed
                      c
                      id
                      53
                      ty
                      (m:add c (m:node 1 (field (m:at c params) start) 0 checked 0 0 0 0 0 0))
                      (base:convert symbol))
                    unit)))
              (_ unit))))))))

(base:function external-parameters-equal ((c m:context) (a u64) (b u64)) bool
  (match a
    (0 (== b 0))
    (_
      (match b
        (0 false)
        (_
          (match (== (parameter-type c a) (parameter-type c b))
            (true (external-parameters-equal c (m:next c a) (m:next c b)))
            (false false)))))))

(base:function external-symbols ((c m:context) (id u64) (other u64)) unit
  (match other
    (0 unit)
    (_
      (do
        (match (== (field (m:at c other) kind) 53)
          (true
            (match (cstring:strcmp (external-name c id) (external-name c other))
              (0
                (require
                  c
                  other
                  (match (== (field (m:at c id) ty) (field (m:at c other) ty))
                    (true
                      (external-parameters-equal
                        c
                        (m:child c (signature c id))
                        (m:child c (signature c other))))
                    (false false))
                  "conflicting declarations for external symbol"))
              (_ unit)))
          (false unit))
        (external-symbols c id (m:next c other))))))

(base:function check-external-symbols ((c m:context) (id u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (match (field (m:at c id) kind) (53 (external-symbols c id (m:next c id))) (_ unit))
        (check-external-symbols c (m:next c id))))))

(base:function constant-initializer ((c m:context) (id u64)) u64
  (m:next c (m:next c (m:next c (m:child c id)))))

(base:function constant-signature ((c m:context) (id u64) (all u64)) unit
  (match (arity c (m:child c id) 4)
    (false (m:report c id "%constant requires a name, type, and value"))
    (true
      (let ((name u64 (m:next c (m:child c id))) (ty u64 (type-name c (m:next c name))))
        (do
          (generic-name c name)
          (require c name (== (find c all name) id) "duplicate constant or declaration")
          (require c name (== (type-resolve c name) 0) "constant conflicts with type constructor")
          (require
            c
            name
            (== (cases-find c name (m:spelling c name) 1 0) 0)
            "constant conflicts with sum constructor")
          (require
            c
            name
            (match (type-kind c ty) (20 false) (21 false) (22 false) (49 false) (_ true))
            "top-level aggregate constants are not supported yet")
          (m:typed c id 51 ty 0 0)
          unit)))))

(base:function variable-signature ((c m:context) (id u64) (all u64)) unit
  (match (arity c (m:child c id) 4)
    (false (m:report c id "%variable requires a name, type, and initializer"))
    (true
      (let ((name u64 (m:next c (m:child c id))) (ty u64 (type-name c (m:next c name))))
        (do
          (generic-name c name)
          (require c name (== (find c all name) id) "duplicate variable or declaration")
          (require c name (== (type-resolve c name) 0) "variable conflicts with type constructor")
          (require
            c
            name
            (== (cases-find c name (m:spelling c name) 1 0) 0)
            "variable conflicts with sum constructor")
          (require
            c
            name
            (match (type-kind c ty) (20 false) (21 false) (22 false) (49 false) (_ true))
            "top-level aggregate variables are not supported yet")
          (m:typed c id 63 ty 0 0)
          unit)))))

(base:function template-shape ((c m:context) (id u64)) bool
  (let ((head u64 (m:child c id)))
    (match (m:is c head "%function")
      (true
        (match (arity c head 6) (true (m:is c (m:child c (signature c id)) "for")) (false false)))
      (false false))))

(base:function implementation-shape ((c m:context) (fn u64)) bool
  (let ((head u64 (m:child c fn)))
    (match (m:is c head "%implementation")
      (true (match (atom c (m:next c head)) (true (arity c head 5)) (false false)))
      (false false))))

(base:function callable-shape ((c m:context) (fn u64)) bool
  (base:cond
    ((== (field (m:at c fn) kind) 53) true)
    ((declaration-shape c fn) true)
    ((== (field (m:at c fn) kind) 19) true)
    ((== (field (m:at c fn) kind) 40) true)
    (true (implementation-shape c fn))))

(base:function generic-declaration ((c m:context) (id u64)) bool
  (m:is c (m:child c id) "%generic"))

(base:function protocol-declaration ((c m:context) (id u64)) bool
  (m:is c (m:child c id) "%protocol"))

(base:function find ((c m:context) (functions u64) (name u64)) u64
  (named-in c functions (m:owner c name) (m:spelling c name)))

; Qualified lookup selects an explicit import, then an explicitly exported local declaration.
(base:function colon ((c m:context) (i u64) (end u64)) u64
  (raw:colon c i end))

; Constructed symbols are plain names, even if their spelling contains a colon.
(base:function name-colon ((c m:context) (id u64)) u64
  (raw:name-colon c id))

(base:function import-target ((c m:context) (owner u64) (alias data:view) (i u64)) u64
  (raw:import-target c owner alias i))

(base:function named-in ((c m:context) (all u64) (owner u64) (name data:view)) u64
  (match all
    (0 0)
    (_
      (match
        (match (== (m:owner c all) owner)
          (true
            (match
              (base:cond
                ((generic-declaration c all) true)
                ((protocol-declaration c all) true)
                ((template-shape c all) true)
                ((constant-declaration c all) true)
                ((variable-declaration c all) true)
                ((m:is c (m:child c all) "%external-function") true)
                ((specialization-kind (field (m:at c all) kind)) false)
                ((m:is c (m:child c all) "%function") (arity c (m:child c all) 5))
                (true false))
              (true (data:equal name (m:spelling c (m:next c (m:child c all)))))
              (false false)))
          (false false))
        (true all)
        (false (named-in c (m:next c all) owner name))))))

(base:function exported ((c m:context) (names u64) (name data:view)) bool
  (raw:exported c names name))

; Match resolve-qualified-name's distinction between an unknown qualifier and
; a loaded module that the current module has not imported.
(base:function known-module ((c m:context) (name data:view) (i u64)) bool
  (match (m:is-empty (field c session))
    (true false)
    (false
      (let ((session m:module-session (deref (cast (pointer m:module-session) (field c session)))))
        (match (>= i (m:modules-length (deref (field session files))))
          (true false)
          (false
            (let ((text (pointer u8) (field (m:file-info c i) name)))
              (match (data:equal name (data:view text (cstring:strlen text)))
                (true true)
                (false (known-module c name (+ i 1)))))))))))

(base:function missing-qualifier ((c m:context) (site u64) (name data:view)) unit
  (m:report
    c
    site
    (match (known-module c name 0)
      (true "module not imported (missing import)")
      (false "unknown module qualifier (missing import)"))))

; Default generics live outside the source declaration chain. Their numeric
; signatures are virtual, avoiding synthetic wrapper functions in either backend.
; Their identities are shared across the module graph, like the reference
; bootstrap scope. Explicit declarations replace the binding only in their module.
(base:constant default-implementation u64 18446744073709551614)

(base:function default-range ((c m:context) (code u64) (start u64) (count u64)) u64
  (match count
    (0 0)
    (1
      (let ((v m:node (m:at c start)))
        (match (== (field v kind) 62)
          (true (match (== (field v target) code) (true start) (false 0)))
          (false 0))))
    (_
      (let ((half u64 (/ count 2)) (found u64 (default-range c code start half)))
        (match found (0 (default-range c code (+ start half) (- count half))) (_ found))))))

(base:function default-generic ((c m:context) (name u64)) u64
  (let ((code u64 (num:default-code c name)))
    (match code
      (0 0)
      (_
        (let
          ((found u64 (default-range c code 1 (- (m:nodes-length (deref (field c items))) 1))))
          (match found (0 (make-default-generic c name code 0)) (_ found)))))))

(base:function default-name
  ((c m:context) (site m:node) (text (pointer u8)) (length u64) (next u64) (owner u64)) u64
  (m:add
    c
    (m:node
      0
      (field site start)
      length
      0
      next
      0
      0
      0
      (m:address (cast (pointer void) text))
      (+ owner 1))))

(base:function make-default-generic ((c m:context) (name u64) (code u64) (owner u64)) u64
  (let
    ((v m:node (m:at c name))
     (right u64 (default-name c v "right" 5 0 owner))
     (left u64 (default-name c v "left" 4 right owner))
     (params u64 (m:add c (m:node 1 (field v start) 0 left 0 0 0 0 0 (+ owner 1))))
     (label
       u64
       (m:add
         c
         (m:node
           0
           (field v start)
           (field v length)
           0
           params
           0
           0
           0
           (field v generated)
           (+ owner 1))))
     (head u64 (default-name c v "%generic" 8 label owner)))
    (m:add c (m:node 62 (field v start) (field v length) head 0 0 code 0 0 (+ owner 1)))))

(base:function default-prefix ((c m:context) (args u64) (stop u64) (ty u64)) bool
  (match (== args stop)
    (true true)
    (false
      (match (== (field (m:at c args) ty) ty)
        (true (default-prefix c (m:next c args) stop ty))
        (false false)))))

(base:function default-arguments-match ((c m:context) (args u64) (ty u64)) bool
  (match args
    (0 true)
    (_
      (match (field (m:at c args) ty)
        (0 (default-arguments-match c (m:next c args) ty))
        (actual
          (match (== actual ty)
            (true (default-arguments-match c (m:next c args) ty))
            (false false)))))))

(base:function default-eligible ((c m:context) (generic u64) (args u64) (result u64) (ty u64)) bool
  (match (== (field (m:at c generic) kind) 62)
    (false false)
    (true
      (match (num:numeric-type ty)
        (false false)
        (true
          (match
            (match result
              (0 true)
              (_ (== result (num:default-result (field (m:at c generic) target) ty))))
            (false false)
            (true (default-arguments-match c args ty))))))))

(base:function default-literal-parameter
  ((c m:context) (generic u64) (args u64) (stop u64) (result u64) (ty u64) (found u64)) u64
  (base:cond
    ((>= ty 14) found)
    ((== found (cast u64 18446744073709551615)) found)
    ((default-eligible c generic args result ty)
     (match found
       (0 (default-literal-parameter c generic args stop result (+ ty 1) ty))
       (_
         (match (== found ty)
           (true (default-literal-parameter c generic args stop result (+ ty 1) found))
           (false (cast u64 18446744073709551615))))))
    (true (default-literal-parameter c generic args stop result (+ ty 1) found))))

(base:function default-selection ((c m:context) (generic u64) (args u64) (result u64) (found u64))
  u64
  (match (default-eligible c generic args result (field (m:at c args) ty))
    (false found)
    (true (match found (0 default-implementation) (_ (cast u64 18446744073709551615))))))

(base:function duplicate-default ((c m:context) (generic u64) (params u64) (result u64)) bool
  (let
    ((ty u64 (field (m:at c (m:child c params)) ty))
     (other u64 (field (m:at c (m:child c (m:next c params))) ty)))
    (match (== (field (m:at c generic) kind) 62)
      (false false)
      (true
        (base:and
          (num:numeric-type ty)
          (== ty other)
          (== result (num:default-result (field (m:at c generic) target) ty)))))))

(base:function resolve ((c m:context) (all u64) (name u64)) u64
  (let
    ((v m:node (m:at c name))
     (end u64 (+ (field v start) (field v length)))
     (split u64 (name-colon c name)))
    (match (== split end)
      (true (match (find c all name) (0 (default-generic c name)) (found found)))
      (false
        (match (m:is-empty (field c session))
          (true (do (m:report c name "unknown module alias (missing import)") 0))
          (false
            (let
              ((target
                 u64
                 (import-target
                   c
                   (m:owner c name)
                   (data:view (field (m:spelling c name) bytes) (- split (field v start)))
                   0)))
              (match target
                (0
                  (do
                    (missing-qualifier
                      c
                      name
                      (data:view (field (m:spelling c name) bytes) (- split (field v start))))
                    0))
                (_
                  (let
                    ((member
                       data:view
                       (data:view
                         (pointer-offset (field (field c source) bytes) (+ split 1))
                         (- end (+ split 1))))
                     (module m:module-info (m:file-info c (- target 1))))
                    (match (exported c (m:next c (m:child c (field module exports))) member)
                      (false
                        (do
                          (m:report
                            c
                            name
                            (match
                              (match (> (named-in c all (- target 1) member) 0)
                                (true true)
                                (false (> (type-in c (- target 1) member 1) 0)))
                              (true
                                "private declaration access (module name is private or not exported)")
                              (false "unknown module member")))
                          0))
                      (true (named-in c all (- target 1) member)))))))))))))

; Installed definitions are tagged in the tape. Only collection of a preceding
; form installs a definition, so lookup cannot see a later declaration.
(base:function macro-range ((c m:context) (owner u64) (name data:view) (start u64) (count u64)) u64
  (raw:macro-range c owner name start count))

(base:function macro-in ((c m:context) (owner u64) (name data:view)) u64
  (raw:macro-in c owner name))

(base:function export-names ((c m:context) (all u64) (owner u64) (names u64)) unit
  (match names
    (0 unit)
    (_
      (let ((name data:view (m:spelling c names)) (decl u64 (named-in c all owner name)))
        (do
          (match (macro-in c owner name)
            (0
              (do
                (generic-name c names)
                (require
                  c
                  names
                  (match decl (0 (> (type-in c owner name 1) 0)) (_ true))
                  "export names an unknown function, constant, variable, or type")))
            (_ unit))
          (export-names c all owner (m:next c names)))))))

(base:function exports ((c m:context) (all u64) (i u64)) unit
  (match (m:is-empty (field c session))
    (true unit)
    (false
      (let ((session m:module-session (deref (cast (pointer m:module-session) (field c session)))))
        (match (>= i (m:modules-length (deref (field session files))))
          (true unit)
          (false
            (do
              (export-names c all i (m:next c (m:child c (field (m:file-info c i) exports))))
              (exports c all (+ i 1)))))))))

; Validate parameter shapes, names, types, uniqueness, and the parameter-count limit.
; Record types on parameter-name nodes while borrowing stack bindings for duplicate detection.
(base:function parameters-inner ((c m:context) (param u64) (env (pointer void)) (count u64)) unit
  (match param
    (0 unit)
    (_
      (do
        (require c param (< count constants:parameter-limit) "parameter limit (64) exceeded")
        (require c param (list c param) "expected parameter list")
        (require c param (arity c (m:child c param) 2) "parameter requires name and type")
        (let ((name u64 (m:child c param)) (ty u64 (type-name c (m:next c name))))
          (do
            (require c name (plain-name c name) "expected identifier for local binding")
            (require c name (== (m:lookup c name env) 0) "duplicate parameter")
            (m:typed c name 0 ty 0 3)
            (let ((binding m:binding (m:binding name name 0 env)))
              (parameters c (m:next c param) (cast (pointer void) (& binding)) (+ count 1)))))))))

(base:function parameters-shape ((c m:context) (param u64) (env (pointer void)) (count u64)) unit
  (match param
    (0 unit)
    (_
      (match (match (list c param) (false false) (true (arity c (m:child c param) 2)))
        (true (parameters-inner c param env count))
        (false
          (do
            (m:report c param "parameter requires name and type")
            (parameters c (m:next c param) env count)))))))

(base:function parameters ((c m:context) (param u64) (env (pointer void)) (count u64)) unit
  (match (>= count constants:parameter-limit)
    (true (require c param (== param 0) "parameter limit (64) exceeded"))
    (false (parameters-shape c param env count))))

; Validate every expanded %function declaration and collect its checked signature.
; Finish before checking bodies so forward calls and mutual recursion can resolve.
(base:function signatures-inner ((c m:context) (fn u64) (all u64)) unit
  (match fn
    (0 unit)
    (_
      (do
        (require c fn (list c fn) "expected function declaration")
        (require
          c
          fn
          (arity c (m:child c fn) 5)
          "%function requires name, parameters, return type, and one body")
        (require
          c
          fn
          (m:is c (m:child c fn) "%function")
          "only %function declarations are supported")
        (let
          ((name u64 (m:next c (m:child c fn)))
           (params u64 (signature c fn))
           (ty u64 (type-name c (m:next c params))))
          (do
            (generic-name c name)
            (require c name (== (find c all name) fn) "duplicate function")
            (require
              c
              name
              (== (type-resolve c name) 0)
              "function conflicts with type constructor")
            (require
              c
              name
              (== (cases-find c name (m:spelling c name) 1 0) 0)
              "function conflicts with sum constructor")
            (require c params (list c params) "expected parameter list")
            (parameters c (m:child c params) (m:empty-env) 0)
            (m:typed c fn 1 ty 0 0)
            unit))))))

(base:function generic-name ((c m:context) (id u64)) unit
  (base:cond
    ((m:is c id "+") unit)
    ((m:is c id "-") unit)
    ((m:is c id "*") unit)
    ((m:is c id "/") unit)
    ((m:is c id "==") unit)
    ((m:is c id "/=") unit)
    ((m:is c id "==") unit)
    ((m:is c id "!=") unit)
    ((m:is c id "<") unit)
    ((m:is c id "<=") unit)
    ((m:is c id ">") unit)
    ((m:is c id ">=") unit)
    (true (identifier c id))))

(base:function generic-parameters ((c m:context) (param u64) (seen (pointer void)) (count u64)) unit
  (match param
    (0 unit)
    (_
      (do
        (require c param (< count constants:parameter-limit) "parameter limit (64) exceeded")
        (identifier c param)
        (require c param (== (m:lookup c param seen) 0) "duplicate generic parameter")
        (let ((binding m:binding (m:binding param param 0 seen)))
          (generic-parameters c (m:next c param) (cast (pointer void) (& binding)) (+ count 1)))))))

(base:function register-generics ((c m:context) (id u64) (all u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (match (generic-declaration c id)
          (true
            (let
              ((head u64 (m:child c id))
               (name u64 (m:next c head))
               (params u64 (m:next c name))
               (before u64 (deref (field c errors))))
              (do
                (require c id (arity c head 3) "%generic requires a name and parameter list")
                (generic-name c name)
                (require c params (list c params) "expected generic parameter list")
                (require c name (== (find c all name) id) "duplicate generic or function")
                (require c name (== (type-resolve c name) 0) "generic conflicts with type")
                (require
                  c
                  name
                  (== (cases-find c name (m:spelling c name) 1 0) 0)
                  "generic conflicts with sum constructor")
                (generic-parameters c (m:child c params) (m:empty-env) 0)
                (m:typed
                  c
                  id
                  (match (== before (deref (field c errors))) (true 37) (false 10))
                  0
                  0
                  0)
                unit)))
          (false unit))
        (register-generics c (m:next c id) all)))))

(base:function parameter-types-equal ((c m:context) (left u64) (right u64)) bool
  (match left
    (0 (== right 0))
    (_
      (match right
        (0 false)
        (_
          (match (== (field (m:at c (m:child c left)) ty) (field (m:at c (m:child c right)) ty))
            (true (parameter-types-equal c (m:next c left) (m:next c right)))
            (false false)))))))

(base:function duplicate-implementation
  ((c m:context) (id u64) (generic u64) (ty u64) (params u64) (all u64)) bool
  (base:cond
    ((== all 0) false)
    ((== all id) false)
    ((implementation-for c all generic)
     (match (== (field (m:at c all) ty) ty)
       (true
         (match (parameter-types-equal c params (m:child c (signature c all)))
           (true true)
           (false (duplicate-implementation c id generic ty params (m:next c all)))))
       (false (duplicate-implementation c id generic ty params (m:next c all)))))
    (true (duplicate-implementation c id generic ty params (m:next c all)))))

(base:function implementation-for ((c m:context) (id u64) (generic u64)) bool
  (let ((v m:node (m:at c id)))
    (match (field v kind) (18 (== (field v target) generic)) (_ false))))

(base:function implementation-signature ((c m:context) (id u64) (all u64)) unit
  (let
    ((name u64 (m:next c (m:child c id)))
     (params u64 (signature c id))
     (generic u64 (resolve c all name))
     (ty u64 (type-name c (m:next c params))))
    (do
      (require
        c
        name
        (match (field (m:at c generic) kind) (37 true) (62 true) (_ false))
        "implementation requires a generic")
      (require c params (list c params) "expected implementation parameter list")
      (require
        c
        params
        (arity c (m:child c params) (chain-length c (m:child c (signature c generic))))
        "implementation arity does not match generic")
      (parameters c (m:child c params) (m:empty-env) 0)
      (require
        c
        name
        (match
          (base:or
            (duplicate-default c generic (m:child c params) ty)
            (duplicate-implementation c id generic ty (m:child c params) all))
          (true false)
          (false true))
        "duplicate generic implementation")
      (m:typed c id 18 ty generic 0)
      unit)))

(base:function operation-named ((c m:context) (name u64) (id u64) (method bool)) u64
  (match id
    (0 0)
    (_
      (let
        ((head u64 (m:child c id))
         (candidate u64 (match method (true (m:next c head)) (false head))))
        (match (m:same c name candidate)
          (true id)
          (false (operation-named c name (m:next c id) method)))))))

(base:function protocol-operations ((c m:context) (id u64)) u64
  (m:next c (signature c id)))

(base:function validate-protocol-operations ((c m:context) (op u64) (types u64)) unit
  (match op
    (0 unit)
    (_
      (let ((name u64 (m:child c op)) (params u64 (m:next c name)))
        (do
          (require
            c
            op
            (arity c name 3)
            "protocol operation requires name, parameters and result type")
          (generic-name c name)
          (require
            c
            op
            (== (operation-named c name (m:next c op) false) 0)
            "duplicate protocol operation")
          (require c params (list c params) "expected protocol operation parameters")
          (validate-protocol-parameters c (m:child c params) types (m:empty-env))
          (validate-protocol-type c (m:next c params) types)
          (validate-protocol-operations c (m:next c op) types))))))

(base:function type-parameter-index ((c m:context) (id u64) (params u64) (index u64)) u64
  (match params
    (0 0)
    (_
      (match (m:same c id params)
        (true index)
        (false (type-parameter-index c id (m:next c params) (+ index 1)))))))

(base:function validate-protocol-type ((c m:context) (id u64) (types u64)) unit
  (base:cond
    ((> (type-parameter-index c id types 1) 0) unit)
    ((m:is c (m:child c id) "array")
     (let ((head u64 (m:child c id)) (element u64 (m:next c head)))
       (do
         (require c id (arity c head 3) "array requires an element type and length")
         (validate-protocol-type c element types)
         (array-length-literal c (m:next c element))
         unit)))
    ((m:is c (m:child c id) "tuple") (validate-protocol-types c (m:next c (m:child c id)) types))
    ((m:is c (m:child c id) "pointer")
     (let ((pointee u64 (m:next c (m:child c id))))
       (do
         (require c id (arity c pointee 1) "pointer requires one pointee type")
         (match (type-parameter-index c pointee types 1)
           (0 (do (pointer-type c (type-reference c pointee)) unit))
           (_ unit)))))
    (true (do (type-name c id) unit))))

(base:function validate-protocol-types ((c m:context) (id u64) (types u64)) unit
  (match id
    (0 unit)
    (_ (do (validate-protocol-type c id types) (validate-protocol-types c (m:next c id) types)))))

(base:function validate-protocol-parameters
  ((c m:context) (id u64) (types u64) (seen (pointer void))) unit
  (match id
    (0 unit)
    (_
      (let ((name u64 (m:child c id)))
        (do
          (require c id (arity c name 2) "protocol parameter requires a name and a type")
          (identifier c name)
          (require c name (== (m:lookup c name seen) 0) "duplicate protocol parameter")
          (validate-protocol-type c (m:next c name) types)
          (let ((binding m:binding (m:binding name name 0 seen)))
            (validate-protocol-parameters c (m:next c id) types (cast (pointer void) (& binding)))))))))

(base:function register-protocols ((c m:context) (id u64) (all u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (match (protocol-declaration c id)
          (true
            (let
              ((head u64 (m:child c id)) (name u64 (m:next c head)) (params u64 (signature c id)))
              (do
                (identifier c name)
                (require c name (== (find c all name) id) "duplicate protocol declaration")
                (require c name (== (type-resolve c name) 0) "protocol conflicts with type")
                (require c params (list c params) "expected protocol type parameter list")
                (generic-parameters c (m:child c params) (m:empty-env) 0)
                (validate-protocol-operations c (protocol-operations c id) (m:child c params))
                (m:typed c id 38 0 0 0)
                unit)))
          (false unit))
        (register-protocols c (m:next c id) all)))))

(base:function protocol-instance ((c m:context) (id u64)) bool
  (let ((head u64 (m:child c id)))
    (match (m:is c head "%implementation") (true (list c (m:next c head))) (false false))))

(base:function protocol-arguments ((c m:context) (id u64)) u64
  (m:next c (m:child c (m:next c (m:child c id)))))

(base:function duplicate-protocol-instance
  ((c m:context) (id u64) (protocol u64) (args u64) (all u64)) bool
  (let ((v m:node (m:at c all)))
    (base:cond
      ((== all 0) false)
      ((== all id) false)
      ((== (field v kind) 39)
       (match (== (field v target) protocol)
         (true
           (match (component-equal c args (protocol-arguments c all))
             (true true)
             (false (duplicate-protocol-instance c id protocol args (m:next c all)))))
         (false (duplicate-protocol-instance c id protocol args (m:next c all)))))
      (true (duplicate-protocol-instance c id protocol args (m:next c all))))))

(base:function protocol-type-matches
  ((c m:context) (template u64) (params u64) (args u64) (actual u64)) bool
  (let ((index u64 (type-parameter-index c template params 1)) (head u64 (m:child c template)))
    (base:cond
      ((> index 0) (== actual (field (m:at c (component-at c args (- index 1))) ty)))
      ((m:is c head "array")
       (match (array-template-shape c head actual)
         (true (protocol-type-matches c (m:next c head) params args (array-element c actual)))
         (false false)))
      ((m:is c head "tuple")
       (match (== (type-kind c actual) 22)
         (true (protocol-types-match c (m:next c head) params args (type-components c actual)))
         (false false)))
      ((m:is c head "pointer")
       (base:cond
         ((== actual 11) (protocol-type-matches c (m:next c head) params args 7))
         ((== (type-kind c actual) 34)
          (protocol-type-matches
            c
            (m:next c head)
            params
            args
            (field (m:at c (- actual num:descriptor-base)) target)))
         (true false)))
      (true (== actual (type-reference c template))))))

(base:function protocol-types-match
  ((c m:context) (template u64) (params u64) (args u64) (actual u64)) bool
  (match template
    (0 (== actual 0))
    (_
      (match actual
        (0 false)
        (_
          (match (protocol-type-matches c template params args (field (m:at c actual) ty))
            (true (protocol-types-match c (m:next c template) params args (m:next c actual)))
            (false false)))))))

(base:function protocol-parameters-match
  ((c m:context) (template u64) (params u64) (args u64) (actual u64)) bool
  (match template
    (0 (== actual 0))
    (_
      (match actual
        (0 false)
        (_
          (match
            (protocol-type-matches
              c
              (m:next c (m:child c template))
              params
              args
              (field (m:at c (m:child c actual)) ty))
            (true (protocol-parameters-match c (m:next c template) params args (m:next c actual)))
            (false false)))))))

(base:function protocol-coverage ((c m:context) (site u64) (op u64) (methods u64)) unit
  (match op
    (0 unit)
    (_
      (do
        (require
          c
          site
          (> (operation-named c (m:child c op) methods true) 0)
          "missing protocol operation")
        (protocol-coverage c site (m:next c op) methods)))))

(base:function protocol-methods ((c m:context) (id u64) (protocol u64) (args u64)) u64
  (let
    ((head u64 (m:child c id))
     (name u64 (m:next c head))
     (params u64 (signature c id))
     (next u64 (m:next c id))
     (operation u64 (operation-named c name (protocol-operations c protocol) false))
     (types u64 (m:child c (signature c protocol)))
     (expected u64 (m:next c (m:child c operation))))
    (do
      (require
        c
        id
        (match (m:is c head "function") (true (arity c head 5)) (false false))
        "protocol implementation requires function methods")
      (require c id (> operation 0) "unknown protocol operation")
      (require c id (== (operation-named c name next true) 0) "duplicate protocol operation")
      (require c params (list c params) "expected implementation parameter list")
      (parameters c (m:child c params) (m:empty-env) 0)
      (let ((ty u64 (type-name c (m:next c params))))
        (do
          (require
            c
            id
            (protocol-parameters-match c (m:child c expected) types args (m:child c params))
            "protocol operation parameter type mismatch")
          (require
            c
            id
            (protocol-type-matches c (m:next c expected) types args ty)
            "protocol operation result type mismatch")
          (m:typed c id 19 ty protocol 0)
          (match next (0 id) (_ (protocol-methods c next protocol args))))))))

(base:function protocol-argument-types ((c m:context) (id u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (m:typed c id (field (m:at c id) kind) (type-reference c id) 0 0)
        (protocol-argument-types c (m:next c id))))))

(base:function register-protocol-instances ((c m:context) (id u64) (all u64)) unit
  (match id
    (0 unit)
    (_
      (let ((next u64 (m:next c id)))
        (do
          (match (protocol-instance c id)
            (true
              (let
                ((application u64 (m:next c (m:child c id)))
                 (name u64 (m:child c application))
                 (args u64 (m:next c name))
                 (methods u64 (m:next c application))
                 (protocol u64 (resolve c all name))
                 (before u64 (deref (field c errors))))
                (do
                  (require c name (== (field (m:at c protocol) kind) 38) "unknown protocol")
                  (require
                    c
                    id
                    (arity c args (chain-length c (m:child c (signature c protocol))))
                    "protocol argument count mismatch")
                  (protocol-argument-types c args)
                  (require
                    c
                    id
                    (match (duplicate-protocol-instance c id protocol args all)
                      (true false)
                      (false true))
                    "duplicate protocol implementation")
                  (protocol-coverage c id (protocol-operations c protocol) methods)
                  (m:typed c id 39 0 protocol 0)
                  (match (== before (deref (field c errors)))
                    (false unit)
                    (true
                      (match methods
                        (0 unit)
                        (_
                          (let ((last u64 (protocol-methods c methods protocol args)))
                            (do (m:link c id methods) (m:link c last next))))))))))
            (false unit))
          (register-protocol-instances c next all))))))

; Invalid declarations have kind 10 and no usable signature.
(base:function signatures ((c m:context) (fn u64) (all u64)) unit
  (match fn
    (0 unit)
    (_
      (let ((before u64 (deref (field c errors))))
        (do
          (base:cond
            ((m:is c (m:child c fn) "%external-function") (external-signature c fn all))
            ((constant-declaration c fn) (constant-signature c fn all))
            ((variable-declaration c fn) (variable-signature c fn all))
            ((m:is c (m:child c fn) "native-export") (do (m:typed c fn 68 0 0 0) unit))
            ((generic-declaration c fn) unit)
            ((== (field (m:at c fn) kind) 19) unit)
            ((>= (field (m:at c fn) kind) 20) unit)
            ((template-shape c fn) (register-template c fn all))
            ((declaration-shape c fn) (signatures-inner c fn all))
            ((implementation-shape c fn) (implementation-signature c fn all))
            (true
              (m:report
                c
                fn
                "only %function declarations are supported; %function requires name, parameters, return type, and one body")))
          (match (== before (deref (field c errors)))
            (true unit)
            (false (do (m:typed c fn 10 0 0 0) unit)))
          (signatures c (m:next c fn) all))))))

; Accumulate decimal digits into an unsigned magnitude without exceeding limit.
; Check before multiplication/addition and split traversal to handle long zero-prefixed literals.
(base:function integer-span
  ((c m:context) (id u64) (i u64) (count u64) (value (pointer u64)) (limit u64)) unit
  (match count
    (0 unit)
    (1
      (let ((b u64 (m:spelling-byte c id (- i (field (m:at c id) start)))))
        (do
          (require c id (digit b) "invalid decimal i64 literal")
          (let ((d u64 (- b 48)))
            (do
              (require
                c
                id
                (<= (deref value) (/ (- limit d) 10))
                "integer literal out of range")
              (store (deref value) (+ (* (deref value) 10) d))
              unit)))))
    (_
      (let ((half u64 (/ count 2)) (before u64 (deref (field c errors))))
        (do
          (integer-span c id i half value limit)
          (match (== before (deref (field c errors)))
            (true (integer-span c id (+ i half) (- count half) value limit))
            (false unit)))))))

; Parse magnitude against the contextual integer type, including u64 max.
(base:function integer ((c m:context) (id u64) (ty u64)) u64
  (let
    ((v m:node (m:at c id))
     (start u64 (field v start))
     (negative bool (== (m:spelling-byte c id 0) 45))
     (first
       u64
       (match (m:spelling-byte c id 0) (45 (+ start 1)) (43 (+ start 1)) (_ start)))
     (end u64 (+ start (field v length)))
     (limit
       u64
       (match (num:signed-type ty)
         (true (match negative (true (num:sign-bit ty)) (false (- (num:sign-bit ty) 1))))
         (false (- (num:modulus ty) 1))))
     (magnitude u64 0))
    (do
      (require c id (< first end) "expected integer digits")
      (require
        c
        id
        (match negative (false true) (true (num:signed-type ty)))
        "unsigned integer literal cannot be negative")
      (integer-span c id first (- end first) (& magnitude) limit)
      (m:typed
        c
        id
        2
        ty
        0
        (num:normalize ty (match negative (true (- 0 magnitude)) (false magnitude)))))))

; Require identical actual/expected type IDs and diagnose a mismatch at the expression.
(base:function expect ((c m:context) (id u64) (actual u64) (expected u64)) unit
  (base:cond
    ((== actual 0) unit)
    ((== expected 0) unit)
    ((== actual expected) unit)
    (true
      (m:location c (field (m:at c id) start))
