            (14 false)
            (_ (match (type-kind c pointee) (33 false) (46 false) (_ true))))
          (false (do (m:report c id "pointer requires a complete object type") 0))
          (true (do (resolve-value-layout c pointee) pointee)))))))

(base:function dereference-expression
  ((c m:context) (id u64) (args u64) (env (pointer void)) (all u64)) u64
  (match (arity c args 1)
    (false (do (m:report c id "deref requires exactly one operand") 0))
    (true
      (let ((ty u64 (expression c args env all)) (pointee u64 (complete-pointee c args ty)))
        (m:typed c id 58 pointee 0 3)))))

(base:function offset-expression ((c m:context) (id u64) (args u64) (env (pointer void)) (all u64))
  u64
