                  (require c head (== (m:lookup c head env) 0) "local value is not callable")
                  (components-check c args (m:next c (m:child c case)) env all)
                  (m:typed c id 15 (field (m:at c case) ty) case 0))))))))))

(base:function checked-cast ((c m:context) (id u64) (args u64) (env (pointer void)) (all u64)) u64
