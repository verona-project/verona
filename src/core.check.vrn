; Existing evaluator/support callers still require an executable entry.
(base:function check ((c m:context) (functions u64)) u64
  (check-with-entry c functions true))

; Native export records retain their source syntax, resolved local function in
; TARGET, and a decoded data-literal node ID in VALUE (as external imports do).
(base:function native-export-name ((c m:context) (id u64)) (pointer u8)
  (external-name c id))

(base:function native-export-duplicates ((c m:context) (id u64) (other u64)) unit
