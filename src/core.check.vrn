    (false (indirect-call c id head args env all))
    (true
      (let
        ((before u64 (deref (field c errors)))
         (binding u64 (resolve c all head))
         (method u64 (constrained-method c head binding))
         (fn u64 (match method (0 binding) (_ method))))
