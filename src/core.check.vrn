; Resolve and check an if, let, primitive operation, or direct function call.
; Annotate the list with its checked kind, result type, and resolved target.
(base:function application-inner
  ((c m:context) (id u64) (env (pointer void)) (all u64) (expected u64)) u64
  (let
    ((head u64 (m:child c id))
     (args u64 (m:next c head))
     (primitive num:operation (num:primitive c head))
     (op u64 (field primitive code)))
    (do
      (require c id (atom c head) "expected operation or function name")
      (base:cond
        ((m:is c head "if")
         (require c id (arity c args 3) "if requires condition and two branches")
         (expect c args (expression-as c args env all 2) 2)
         (let
           ((yes u64 (m:next c args))
            (no u64 (m:next c yes))
            (ty u64 (expression-as c yes env all expected)))
