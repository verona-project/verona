                   (require c name (plain-name c name) "expected product field name")
                   (field-index c fields name 0)))
               (true
                 (do
                   (require c name (integer-node c name) "tuple index must be an integer literal")
                   (integer c name 3)
                   (index-value (field (m:at c name) value))))))
           (component u64 (component-at c fields index)))
          (do
            (require c name (> component 0) "tuple index out of range")
            (m:typed
              c
              id
              14
              (field (m:at c component) ty)
              index
              (base:convert (place-flags c args)))))))))

; Expected types guide sum constructor selection without changing nominal identity.
(base:function expression-as ((c m:context) (id u64) (env (pointer void)) (all u64) (expected u64))
  u64
  (do (expand:expression c id) (expression-as-inner c id env all expected)))

(base:function expression-as-inner
  ((c m:context) (id u64) (env (pointer void)) (all u64) (expected u64)) u64
  (base:cond
    ((function-designator c id expected env) (function-address c id expected all))
    ((match (num:float-type expected) (true (raw:floating-node c id)) (false false))
     (float:parse c id expected))
    (true
      (match (list c id)
        (false
          (match (match (> expected 0) (false false) (true (integer-node c id)))
            (false (expression c id env all))
            (true
              (let
                ((before u64 (deref (field c errors)))
                 (ty
                   u64
                   (integer c id (match (num:integer-type expected) (true expected) (false 3)))))
                (match (== before (deref (field c errors)))
                  (true ty)
                  (false (m:typed c id 2 0 0 0)))))))
        (true
          (let ((before u64 (deref (field c errors))) (ty u64 (application c id env all expected)))
            (match (== before (deref (field c errors)))
              (true ty)
              (false (m:typed c id (field (m:at c id) kind) 0 0 0)))))))))

(base:function layout-cases ((c m:context) (id u64) (ty u64) (index u64) (seen (pointer void))) unit
  (match id
    (0 unit)
    (_
      (let ((name u64 (m:child c id)))
        (do
          (require c id (match (list c id) (true (> name 0)) (false false)) "expected sum case")
          (identifier c name)
          (require c name (== (m:lookup c name seen) 0) "duplicate sum case")
          (tuple-types c (m:next c name))
          (m:typed c id 1 ty index 0)
          (let ((binding m:binding (m:binding name name 0 seen)))
            (layout-cases c (m:next c id) ty (+ index 1) (cast (pointer void) (& binding)))))))))

(base:function case-in ((c m:context) (id u64) (name data:view)) u64
  (match id
    (0 0)
    (_
      (match (data:equal (m:spelling c (m:child c id)) name)
        (true id)
        (false (case-in c (m:next c id) name))))))

(base:function visible-type ((c m:context) (site u64) (id u64)) bool
  (match (== (m:owner c site) (m:owner c id)) (true true) (false false)))

(base:function cases-find ((c m:context) (site u64) (name data:view) (i u64) (found u64)) u64
  (case-range c site name i (- (m:nodes-length (deref (field c items))) i) found))

(base:function case-range
  ((c m:context) (site u64) (name data:view) (start u64) (count u64) (found u64)) u64
  (match count
    (0 found)
    (1
      (let
        ((candidate
           u64
           (match (field (m:at c start) kind)
             (21
               (match (visible-type c site start)
                 (true (case-in c (type-components c (+ start num:descriptor-base)) name))
                 (false 0)))
             (_ 0))))
        (match candidate
          (0 found)
          (_
            (do
              (match found
                (0 unit)
                (_ (m:report c site "ambiguous sum constructor; qualify with Type:case")))
              candidate)))))
    (_
      (let ((half u64 (/ count 2)) (left u64 (case-range c site name start half found)))
        (case-range c site name (+ start half) (- count half) left)))))

; Explicit qualification is Type:case or module:Type:case. A qualified type
; must pass ordinary module export checks; exporting a sum exposes its cases.
(base:function last-colon ((c m:context) (start u64) (end u64)) u64
  (match (== start end)
    (true end)
    (false
      (match (m:byte c (- end 1)) (58 (- end 1)) (_ (last-colon c start (- end 1)))))))

(base:function case-resolve ((c m:context) (name u64) (expected u64)) u64
  (let
    ((v m:node (m:at c name))
     (end u64 (+ (field v start) (field v length)))
     (split
       u64
       (match (field v generated) (0 (last-colon c (field v start) end)) (_ (field v start)))))
    (match (== split (field v start))
      (true
        (match (== (type-kind c expected) 21)
          (true (case-in c (type-components c expected) (m:spelling c name)))
          (false (cases-find c name (m:spelling c name) 1 0))))
      (false
        (let
          ((prefix
             u64
             (m:add c (m:node 0 (field v start) (- split (field v start)) 0 0 0 0 0 0 0)))
           (decl u64 (type-resolve c prefix)))
          (match (== (field (m:at c decl) kind) 21)
            (false 0)
            (true
              (case-in
                c
                (type-components c (+ decl num:descriptor-base))
                (data:view
                  (pointer-offset (field (field c source) bytes) (+ split 1))
                  (- end (+ split 1)))))))))))

(base:function chain-length ((c m:context) (id u64)) u64
  (match id (0 0) (_ (+ 1 (chain-length c (m:next c id))))))

; Catch-all names bind the complete scrutinee only within their arm.
(base:function catch-all-body
  ((c m:context) (arm u64) (ty u64) (env (pointer void)) (all u64) (expected u64)) u64
  (let ((pattern u64 (m:child c arm)) (body u64 (m:next c pattern)))
    (match (m:is c pattern "_")
      (true (expression-as c body env all expected))
      (false
        (do
          (m:typed c pattern 0 ty 0 0)
          (let ((binding m:binding (m:binding pattern pattern 0 env)))
            (expression-as c body (cast (pointer void) (& binding)) all expected)))))))

(base:function catch-all-id ((c m:context) (pattern u64)) i64
  (match (m:is c pattern "_") (true 0) (false (base:convert pattern))))

(base:function literal-pattern ((c m:context) (id u64) (ty u64)) unit
  (match (field (m:at c id) kind)
    (3
      (do
        (require c id (== ty 2) "boolean pattern requires a boolean scrutinee")
        (m:typed c id 3 2 0 (field (m:at c id) value))
        unit))
    (_ (literal-pattern-inner c id ty))))

(base:function literal-pattern-inner ((c m:context) (id u64) (ty u64)) unit
  (let ((v m:node (m:at c id)))
    (base:cond
      ((== (field v kind) 26)
       (do
         (require c id (num:integer-type ty) "character pattern requires an integer scrutinee")
         (m:typed
           c
           id
           2
           ty
           0
           (base:convert
             (syntax:character-byte
               (pointer-offset (field (field c source) bytes) (+ (field v start) 2))
               (- (field v length) 2))))
         unit))
      ((integer-node c id)
       (do
         (require c id (num:integer-type ty) "integer pattern requires an integer scrutinee")
         (match (num:integer-type ty) (true (do (integer c id ty) unit)) (false unit))))
      ((match (field v generated)
         (0 (match (m:is c id "true") (true true) (false (m:is c id "false"))))
         (_ false))
       (do
         (require c id (== ty 2) "boolean pattern requires a boolean scrutinee")
         (m:typed c id 3 2 0 (match (m:is c id "true") (true 1) (false 0)))
         unit))
      (true (m:report c id "expected boolean, integer, character, binding, or wildcard pattern")))))

(base:function literal-covered ((value i64) (seen (pointer void))) bool
  (match (m:is-empty seen)
    (true false)
    (false
      (let ((v m:binding (deref (cast (pointer m:binding) seen))))
        (match (== value (field v value))
          (true true)
          (false (literal-covered value (field v parent))))))))

(base:function scalar-arms
  ((c m:context)
   (site u64)
   (arm u64)
   (ty u64)
   (env (pointer void))
   (all u64)
   (expected u64)
   (seen (pointer void))
   (covered u64)
   (wild bool)) u64
  (match arm
    (0
      (do
        (require
          c
          site
          (match wild (true true) (false (match ty (2 (== covered 2)) (_ false))))
          "non-exhaustive match")
        expected))
    (_
      (let ((pattern u64 (m:child c arm)) (body u64 (m:next c pattern)))
        (do
          (require
            c
            arm
            (match (list c arm) (true (arity c pattern 2)) (false false))
            "match arm requires pattern and body")
          (require c arm (match wild (true false) (false true)) "unreachable match arm")
          (match (plain-name c pattern)
            (true
              (let ((result u64 (catch-all-body c arm ty env all expected)))
                (do
                  (expect c body result expected)
                  (m:typed c arm 1 result 0 (catch-all-id c pattern))
                  (scalar-arms c site (m:next c arm) ty env all result seen covered true))))
            (false
              (do
                (literal-pattern c pattern ty)
                (let
                  ((value i64 (field (m:at c pattern) value))
                   (result u64 (expression-as c body env all expected))
                   (binding m:binding (m:binding pattern 0 value seen)))
                  (do
                    (require
                      c
                      pattern
                      (match (literal-covered value seen) (true false) (false true))
                      "duplicate match pattern")
                    (expect c body result expected)
                    (m:typed c arm 1 result 1 value)
                    (scalar-arms
                      c
                      site
                      (m:next c arm)
                      ty
                      env
                      all
                      result
                      (cast (pointer void) (& binding))
