                      wild)))))))))))

; Component patterns are shallow, matching the reference compiler. Only names
; introduce slots; wildcards and literals never become local bindings.
(base:function complete-pattern-components ((c m:context) (id u64)) bool
  (match id
    (0 true)
    (_ (match (plain-name c id) (false false) (true (complete-pattern-components c (m:next c id)))))))

(base:function pattern-bindings
  ((c m:context)
   (names u64)
   (types u64)
   (body u64)
   (env (pointer void))
   (seen (pointer void))
   (all u64)
   (expected u64)) u64
  (match names
    (0
      (do
        (require c body (== types 0) "too few pattern components")
        (expression-as c body env all expected)))
    (_
      (do
        (require c names (> types 0) "too many pattern components")
        (match (plain-name c names)
          (true
            (match (m:is c names "_")
              (true
                (pattern-bindings c (m:next c names) (m:next c types) body env seen all expected))
              (false
                (do
                  (require c names (== (m:lookup c names seen) 0) "duplicate payload binding")
                  (m:typed c names 0 (field (m:at c types) ty) 0 0)
                  (let
                    ((binding m:binding (m:binding names names 0 env))
                     (local m:binding (m:binding names names 0 seen)))
                    (pattern-bindings
                      c
                      (m:next c names)
                      (m:next c types)
                      body
                      (cast (pointer void) (& binding))
                      (cast (pointer void) (& local))
                      all
                      expected))))))
          (false
            (do
              (match (list c names)
                (true (m:report c names "nested structured patterns are not supported"))
                (false (literal-pattern c names (field (m:at c types) ty))))
              (pattern-bindings c (m:next c names) (m:next c types) body env seen all expected))))))))

(base:function tuple-arms
  ((c m:context)
   (site u64)
   (arm u64)
   (ty u64)
   (env (pointer void))
   (all u64)
   (expected u64)
   (complete bool)
   (wild bool)) u64
  (match arm
    (0
      (do
        (require c site (match complete (true true) (false wild)) "non-exhaustive match")
        expected))
    (_
      (let ((pattern u64 (m:child c arm)) (body u64 (m:next c pattern)))
        (do
          (require
            c
            arm
            (match (list c arm) (true (arity c pattern 2)) (false false))
            "match arm requires pattern and body")
          (require c arm (match wild (true false) (false true)) "unreachable match arm")
          (match (plain-name c pattern)
            (true
              (let ((result u64 (catch-all-body c arm ty env all expected)))
                (do
                  (expect c body result expected)
                  (m:typed c arm 1 result 0 (catch-all-id c pattern))
                  (tuple-arms c site (m:next c arm) ty env all result complete true))))
            (false
              (let ((head u64 (m:child c pattern)) (names u64 (m:next c head)))
