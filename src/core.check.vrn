            (syntax:character-byte
              (pointer-offset (field (field c source) bytes) (+ (field v start) 2))
              (- (field v length) 2)))))
      (_
        (base:cond
          ((match (field v generated) (0 (m:is c id "true")) (_ false)) (m:typed c id 3 2 0 1))
          ((match (field v generated) (0 (m:is c id "false")) (_ false)) (m:typed c id 3 2 0 0))
          ((match (field v generated) (0 (m:is c id "unit")) (_ false)) (m:typed c id 4 1 0 0))
