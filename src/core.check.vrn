                      (expect c body ty expected)
                      (m:typed c arm 1 ty (+ (field (m:at c case) target) 1) 0)
                      (match-arms
                        c
                        (m:next c arm)
                        sum
                        env
                        (match complete (true (cast (pointer void) (& binding))) (false seen))
                        all
                        ty
                        (match complete (true (+ covered 1)) (false covered))
                        wild))))))))))))

(base:function match-expression
  ((c m:context) (id u64) (args u64) (env (pointer void)) (all u64) (expected u64)) u64
  (let ((ty u64 (expression c args env all)))
    (do
      (require c id (> (m:next c args) 0) "match requires arms")
      (match ty
        (0 0)
        (_
          (match (type-kind c ty)
            (22
              (let ((result u64 (tuple-arms c id (m:next c args) ty env all expected false false)))
                (m:typed c id 61 result 0 0)))
            (_
              (match (== (type-kind c ty) 21)
                (false
                  (let
                    ((result
                       u64
                       (scalar-arms c id (m:next c args) ty env all expected (m:empty-env) 0 false)))
                    (m:typed c id 55 result 0 0)))
                (true
                  (let
                    ((result
                       u64
                       (match-arms c (m:next c args) ty env (m:empty-env) all expected 0 false)))
                    (m:typed c id 16 result 0 0)))))))))))

(base:function write-type-components ((c m:context) (id u64)) unit
  (match id
    (0 unit)
    (_
      (do
        (m:text lconstants:STDERR-FILENO " ")
        (write-type c (field (m:at c id) ty))
        (write-type-components c (m:next c id))))))

(base:function write-type ((c m:context) (ty u64)) unit
  (match ty
    (0 (m:text lconstants:STDERR-FILENO "<invalid>"))
    (1 (m:text lconstants:STDERR-FILENO "unit"))
    (2 (m:text lconstants:STDERR-FILENO "bool"))
    (3 (m:text lconstants:STDERR-FILENO "i64"))
    (11 (m:text lconstants:STDERR-FILENO "(pointer u8)"))
    (14 (m:text lconstants:STDERR-FILENO "void"))
    (_
      (match (match (num:integer-type ty) (true true) (false (num:float-type ty)))
        (true (m:text lconstants:STDERR-FILENO (num:name ty)))
        (false
          (match (type-kind c ty)
            (34
              (do
                (m:text lconstants:STDERR-FILENO "(pointer ")
                (write-type c (field (m:at c (- ty num:descriptor-base)) target))
                (m:text lconstants:STDERR-FILENO ")")))
            (49
              (do
                (m:text lconstants:STDERR-FILENO "(array ")
                (write-type c (array-element c ty))
                (m:text lconstants:STDERR-FILENO " ")
                (m:number 2 (array-length c ty))
                (m:text lconstants:STDERR-FILENO ")")))
            (46
              (let ((v m:node (m:at c (- ty num:descriptor-base))))
                (do
                  (m:text lconstants:STDERR-FILENO "(function (")
                  (write-type-components c (field v child))
                  (m:text lconstants:STDERR-FILENO ") ")
                  (write-type c (field v target))
                  (m:text lconstants:STDERR-FILENO ")"))))
            (22
              (do
                (m:text lconstants:STDERR-FILENO "(tuple")
                (write-type-components c (type-components c ty))
                (m:text lconstants:STDERR-FILENO ")")))
            (_
              (let ((id u64 (- ty num:descriptor-base)))
                (do
                  (m:number 2 (m:owner c id))
                  (m:text lconstants:STDERR-FILENO ":")
                  (m:write 2 (m:spelling c (m:next c (m:child c id)))))))))))))

