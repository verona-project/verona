                  (require
                    c
                    pattern
                    (match complete (true false) (false true))
                    "unreachable tuple pattern")
                  (require
                    c
                    pattern
                    (match (list c pattern) (true (m:is c head "tuple")) (false false))
                    "expected tuple pattern or catch-all")
                  (let
                    ((result
                       u64
                       (pattern-bindings
                         c
                         names
                         (type-components c ty)
                         body
                         env
                         (m:empty-env)
                         all
                         expected)))
                    (do
                      (expect c body result expected)
                      (m:typed c arm 1 result 1 0)
                      (tuple-arms
                        c
                        site
                        (m:next c arm)
                        ty
                        env
                        all
                        result
                        (complete-pattern-components c names)
                        wild))))))))))))

(base:function match-arms
  ((c m:context)
   (arm u64)
   (sum u64)
   (env (pointer void))
   (seen (pointer void))
   (all u64)
   (expected u64)
   (covered u64)
   (wild bool)) u64
  (match arm
    (0
      (do
        (require
          c
          (- sum num:descriptor-base)
          (match wild (true true) (false (== covered (chain-length c (type-components c sum)))))
          "non-exhaustive match")
        expected))
    (_
      (let ((pattern u64 (m:child c arm)) (body u64 (m:next c pattern)))
        (do
          (require
            c
            arm
            (match (list c arm) (true (arity c pattern 2)) (false false))
            "match arm requires pattern and body")
          (require c arm (match wild (true false) (false true)) "unreachable match arm")
          (match (plain-name c pattern)
            (true
              (let ((ty u64 (catch-all-body c arm sum env all expected)))
                (do
                  (require
                    c
                    arm
                    (< covered (chain-length c (type-components c sum)))
                    "unreachable wildcard")
                  (expect c body ty expected)
                  (m:typed c arm 1 ty 0 (catch-all-id c pattern))
                  (match-arms c (m:next c arm) sum env seen all ty covered true))))
            (false
              (let ((head u64 (m:child c pattern)) (case u64 (case-resolve c head sum)))
                (do
                  (require c pattern (list c pattern) "expected sum-case pattern or wildcard")
                  (require c pattern (> case 0) "unknown sum case in pattern")
                  (require
                    c
                    pattern
                    (== (field (m:at c case) ty) sum)
                    "pattern belongs to another sum")
                  (require
                    c
                    pattern
                    (== (m:lookup c (m:child c case) seen) 0)
                    "duplicate match case")
                  (let
                    ((ty
                       u64
                       (pattern-bindings
                         c
                         (m:next c head)
                         (m:next c (m:child c case))
                         body
                         env
                         (m:empty-env)
                         all
                         expected))
                     (complete bool (complete-pattern-components c (m:next c head)))
                     (binding m:binding (m:binding (m:child c case) case 0 seen)))
