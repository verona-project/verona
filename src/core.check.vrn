                (m:typed
                  c
                  binder
                  0
                  (field name ty)
                  0
                  (+ (field name value) (cast i64 4)))
                unit)))))
      (14 (materialize-place c (m:next c (field v child))))
      (50 (materialize-place c (m:next c (field v child))))
      (_ unit))))

(base:function address-expression ((c m:context) (id u64) (args u64) (env (pointer void)) (all u64))
  u64
  (match (arity c args 1)
    (false (do (m:report c id "& requires exactly one operand") 0))
    (true
      (let ((ty u64 (expression c args env all)))
        (do
          (require c args (> (place-flags c args) 0) "expression is not addressable")
          (materialize-place c args)
          (m:typed c id 57 (pointer-type c ty) 0 0))))))

(base:function complete-pointee ((c m:context) (id u64) (ty u64)) u64
