           (m:report c id "ambiguous numeric literal; supply a type with cast")
           0)
          (true
            (let ((binder u64 (m:lookup c id env)))
              (do
                (match binder
                  (0
                    (let ((before u64 (deref (field c errors))) (decl u64 (resolve c all id)))
                      (base:cond
                        ((constant-declaration c decl)
                         (m:typed c id 52 (field (m:at c decl) ty) decl 0))
                        ((variable-declaration c decl)
                         (m:typed c id 64 (field (m:at c decl) ty) decl 0))
