            (false 0)))))))

; Recognize a decimal literal's initial digit, including a signed first digit.
(base:function integer-start ((c m:context) (offset u64)) bool
  (raw:integer-start c offset))

(base:function integer-node ((c m:context) (id u64)) bool
  (raw:integer-node c id))

; Decode the reader-validated spelling in bounded stack space.
(base:function decode-data
  ((c m:context)
   (out (pointer u8))
   (cursor (pointer u64))
   (escaped (pointer bool))
   (start u64)
   (count u64)) unit
  (raw:decode-data c out cursor escaped start count))

(base:function append-byte ((out (pointer u8)) (cursor (pointer u64)) (b u64)) unit
  (raw:append-byte out cursor b))

(base:function data-literal ((c m:context) (id u64) (v m:node)) u64
