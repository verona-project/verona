                   c
                   args
                   (pointer-value-type c (field (m:at c args) ty))
                   "pointer null check requires a pointer"))
               (_ unit))
             (match (field primitive arity)
               (1 unit)
               (_ (expect c (m:next c args) (expression-as c (m:next c args) env all input) input)))
