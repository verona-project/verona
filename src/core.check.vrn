             (require c head (== (field (m:at c decl) kind) 20) "expected product constructor")
             (components-check c args (type-components c (+ decl num:descriptor-base)) env all)
             (m:typed c id 13 (+ decl num:descriptor-base) 0 0))))
        ((m:is c head "match") (match-expression c id args env all expected))
        (true
