               (false true))
             0)
            ((match (substitution-complete c bindings) (true false) (false true))
             (m:report c id "cannot infer type parameter")
             0)
            (true
              (let ((target u64 (specialize scope fn all)))
                (match target (0 0) (_ (m:typed c id 8 (field (m:at c target) ty) target 0)))))))))))

; Report an unresolved call with its source spelling, including any module qualifier.
(base:function unknown-function ((c m:context) (name u64)) unit
