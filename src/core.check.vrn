                  (_ (m:typed c id 5 (field (m:at c binder) ty) binder 0)))))))))))

; Type zero is an internal error marker and never reaches either execution path.
(base:function expression ((c m:context) (id u64) (env (pointer void)) (all u64)) u64
  (let
    ((expanded unit (expand:expression c id))
     (before u64 (deref (field c errors)))
     (ty u64 (expression-inner c id env all)))
    (match (== before (deref (field c errors)))
      (true ty)
      (false (m:typed c id (field (m:at c id) kind) 0 0 0)))))

; Introduce the function's typed parameters, then require its body to match its return type.
(base:function function-body ((c m:context) (fn u64) (param u64) (env (pointer void)) (all u64))
  unit
  (match param
    (0
      (expect-origin
        c
        (body c fn)
        (expression-as c (body c fn) env all (field (m:at c fn) ty))
        (field (m:at c fn) ty)
        (m:next c (signature c fn))))
    (_
      (let ((name u64 (m:child c param)) (binding m:binding (m:binding name name 0 env)))
        (function-body c fn (m:next c param) (cast (pointer void) (& binding)) all)))))

; Check every function body, including functions that execution will never reach.
(base:function bodies ((c m:context) (fn u64) (all u64)) unit
  (match fn
    (0 unit)
    (_
      (do
        (match (field (m:at c fn) kind)
          (51 (constant-body c fn all))
          (63 (variable-body c fn all))
          (_
            (match
              (match (== (field (m:at c fn) kind) 10)
                (true true)
                (false (>= (field (m:at c fn) kind) 20)))
              (true unit)
              (false (function-body c fn (m:child c (signature c fn)) (m:empty-env) all)))))
        (bodies c (m:next c fn) all)))))

(base:function variable-body ((c m:context) (id u64) (all u64)) unit
  (let ((init u64 (constant-initializer c id)) (ty u64 (field (m:at c id) ty)))
    (do
      (expect c init (expression-as c init (m:empty-env) all ty) ty)
      (require
        c
        init
        (match (field (m:at c init) kind) (2 true) (3 true) (4 true) (17 true) (36 true) (_ false))
        "variable initializer must be a scalar or data literal"))))

(base:function constant-body ((c m:context) (id u64) (all u64)) unit
  (let ((init u64 (constant-initializer c id)) (ty u64 (field (m:at c id) ty)))
    (do
      (expect c init (expression-as c init (m:empty-env) all ty) ty)
      (require
        c
        init
        (match (field (m:at c init) kind) (2 true) (3 true) (4 true) (17 true) (36 true) (_ false))
        "constant initializer must be a scalar or data literal"))))

; Find the root function named main, or return zero for library roots.
(base:function main-function ((c m:context) (fn u64)) u64
  (match fn
    (0 0)
    (_
      (match
        (match (== (m:owner c fn) 0)
          (true
            (match (declaration-shape c fn)
              (true (m:is c (m:next c (m:child c fn)) "main"))
              (false false)))
          (false false))
        (true fn)
        (false (main-function c (m:next c fn)))))))

; The command-line entry receives C int argc and a pointer to data pointers.
(base:function command-line-main ((c m:context) (fn u64)) bool
  (let ((params u64 (m:child c (signature c fn))))
    (match (arity c params 2)
      (false false)
      (true
        (let ((argc u64 (parameter-type c params)) (argv u64 (parameter-type c (m:next c params))))
          (match (== argc 6)
            (false false)
            (true
              (match (pointer-value-type c argv)
                (false false)
                (true (== (pointer-pointee c argv) 11))))))))))

; Collect signatures, validate the entry point, and check all function bodies.
; Return the checked main declaration index for either execution path.
(base:function check-with-entry ((c m:context) (functions u64) (entry bool)) u64
  (do
    (register-types c functions)
    (check-types c functions)
    (register-generics c functions functions)
    (register-protocols c functions functions)
    (register-protocol-instances c functions functions)
    (signatures c functions functions)
    (check-external-symbols c functions)
    (native-exports c functions functions)
    (exports c functions 0)
    (let ((main u64 (match entry (true (main-function c functions)) (false 0))))
      (do
        (require c 0 (base:or-else (base:not entry) (> main 0)) "missing main function")
        (match (== (field (m:at c main) ty) 0)
          (true unit)
          (false
            (do
              (match (arity c (m:child c (signature c main)) 0)
                (true unit)
                (false
