(in-package #:verona.ide)

(defun definition-slot (object name)
  (let ((slot (find-symbol (string name) :verona)))
    (when (and object slot (slot-exists-p object slot) (slot-boundp object slot))
      (slot-value object slot))))

(defun definition-records (s)
  ;; Identifiers include the evaluation generation, even for unchanged sources.
  (loop for record in (query-module-records s) for state = (fourth record)
        append (loop for d in (remove-duplicates
                               (append (getf (query-product state :declarations) :value)
                                       (getf (getf (query-product state :macros) :value) :definitions)) :test #'eq)
                     when (typep d 'verona::declaration)
                     collect (list (list (first record) (module-evaluation-generation state)
                                         (cdr (assoc d (module-evaluation-definition-identities state) :test #'eq))) record d))))

(defun definition-kind (d)
  (typecase d
    ((or verona::type-declaration verona::type-alias-declaration) :type)
    ((or verona::function-declaration verona::external-function-declaration) :function)
    (verona::constant-declaration :constant) (verona::variable-declaration :variable)
    (verona::macro-declaration :macro) (verona::generic-declaration :generic)
    (verona::protocol-declaration :protocol) (verona::implementation-declaration :implementation)))

(defun definition-structure (value records &optional seen)
  "Copy descriptive compiler data, excluding bodies, values and environments."
  (typecase value
    (null nil)
    (verona::syntax (definition-structure (verona::syntax-datum value) records seen))
    (verona::verona-list (mapcar (lambda (x) (definition-structure x records seen)) (verona::verona-list-elements value)))
    (verona::declaration (list :definition (first (find value records :key #'third :test #'eq))
                               :name (query-data (verona::declaration-name value))))
    (verona::verona-name (query-data value))
    (verona::module-name (query-data value))
    (verona::qualified-name (list :qualifier (query-data (verona::qualified-name-qualifier value))
                                  :name (query-data (verona::qualified-name-name value))))
    (verona::unit-literal (list :kind :unit))
    (verona::verona-boolean-literal (list :kind :boolean :value (verona::verona-boolean-literal-value value)))
    (cons (cons (definition-structure (car value) records seen) (definition-structure (cdr value) records seen)))
    (standard-object
     (if (member value seen :test #'eq) (list :kind (class-name (class-of value)) :recursive-p t)
         (append (list :kind (class-name (class-of value)))
                 (loop for name in '(name declaration signed width target element-type length element-types
                                     parameters parameter-types result result-type return-type type target-type
                                     type-parameters constraints arguments protocol generic operations fields
                                     alternatives payload-types index arity value)
                       for slot = (find-symbol (string name) :verona)
                       when (and slot (slot-exists-p value slot) (slot-boundp value slot))
                         append (list (intern (string name) :keyword)
                                      (definition-structure (slot-value value slot) records (cons value seen)))))))
    (t (query-data value))))

(defun definition-summary (entry)
  (destructuring-bind (identifier record d) entry
    (let ((state (fourth record)))
      (list :id identifier :module (first record) :name (query-data (verona::declaration-name d))
            :kind (definition-kind d)
            :visibility (if (find d (getf (query-product state :exports) :value) :key #'cdr :test #'eq) :public :private)
            :location (query-data (verona::declaration-source d))
            :availability (getf (query-product state :declarations) :availability)
            :status (module-evaluation-status state)
            :completed-phases (module-evaluation-completed-phases state)
            :failed-phase (module-evaluation-failed-phase state)
            :evaluation-source-revision (module-evaluation-source-revision state)
            :evaluation-configuration-revision (module-evaluation-configuration-revision state)))))

(defun definition-query-metadata (s module)
  (let ((records (if module (list (require-query-module s module)) (query-module-records s))))
    (list :modules (mapcar (lambda (r) (query-summary s r)) records)
          :availability (cond ((every (lambda (r) (eq :complete (getf (query-product (fourth r) :declarations) :availability))) records) :complete)
                              ((some #'fourth records) :partial) (t :unavailable)))))

(defun list-definitions (store id &key module name kind visibility (offset 0) (limit 100))
  (serialized (store)
    (let* ((s (require-session store id)) (metadata (definition-query-metadata s module))
           (items (loop for entry in (definition-records s) for summary = (definition-summary entry)
                        when (and (or (null module) (equal module (getf summary :module)))
                                  (query-matches name (getf summary :name))
                                  (or (null kind) (eq kind (getf summary :kind)))
                                  (or (null visibility) (eq visibility (getf summary :visibility)))) collect summary)))
      (query-data (append metadata (query-page (sort items #'string< :key #'query-order-key) offset limit))))))

(defun find-definitions (store id name &key module (offset 0) (limit 100))
  "Exact lookup by ID or name; qualification uses qualifier:member."
  (serialized (store)
    (let* ((s (require-session store id)) (context (and module (require-query-module s module)))
           (separator (and (stringp name) (position #\: name)))
           (qualifier (and separator (subseq name 0 separator)))
           (member-name (if separator (subseq name (1+ separator)) name))
           (targets (when (and qualifier context)
                      (loop for import in (getf (query-product (fourth context) :imports) :value)
                            when (equal qualifier (query-data (verona::import-qualifier-name import)))
                              collect (verona::import-module import))))
           (items (loop for entry in (definition-records s) for summary = (definition-summary entry)
                        when (if (listp name) (equal name (first entry))
                                 (and (equal member-name (getf summary :name))
                                      (cond (qualifier (and (eq :public (getf summary :visibility))
                                                            (if context (member (verona::declaration-module (third entry)) targets :test #'eq)
                                                                (equal qualifier (first (getf summary :module))))))
                                            (module (equal module (getf summary :module))) (t t)))) collect summary)))
      (query-data (append (list :status (cond ((null items) :unresolved) ((cdr items) :ambiguous) (t :found)))
                          (definition-query-metadata s module)
                          (query-page (sort items #'string< :key #'query-order-key) offset limit))))))

(defun inspect-definition (store id identifier)
  (serialized (store)
    (let* ((s (require-session store id)) (records (definition-records s))
           (entry (find identifier records :key #'first :test #'equal)))
      (unless entry (return-from inspect-definition (list :status :unresolved :id (query-data identifier))))
      (let* ((d (third entry)) (state (fourth (second entry)))
             (semantic (cdr (assoc d (getf (query-product state :resolved-definitions) :value) :test #'eq)))
             (origin (verona::syntax-expansion-origin (verona::declaration-expanded-syntax d))))
        (query-data
         (append (list :status :found) (definition-summary entry)
                 (list :documentation (list :availability :complete :value (verona::declaration-documentation d))
                       :declared (loop for name in '(parameters parameter-types return-type result-type arity type type-declaration for-clause target kind body generic-name protocol-application operations)
                                       unless (and (eq name 'body) (not (typep d 'verona::type-declaration)))
                                         append (let ((slot (find-symbol (string name) :verona)))
                                                  (when (and slot (slot-exists-p d slot) (slot-boundp d slot))
                                                    (list (intern (string name) :keyword) (definition-structure (slot-value d slot) records)))))
                       :resolved (list :availability (if semantic (getf (query-product state :resolved-definitions) :availability) :unavailable)
                                       :value (definition-structure semantic records))
                       :generated-p (not (null origin))
                       :compile-time (list :availability (getf (query-product state :bindings) :availability)
                                           :originating-definition identifier
                                           :binding-kind (let* ((environment (getf (getf (query-product state :bindings) :value) :definitions))
                                                                (binding (and (typep environment 'verona::environment)
                                                                              (cdr (assoc (verona::declaration-name d)
                                                                                          (verona::environment-bindings environment)
                                                                                          :test #'verona::verona-name=)))))
                                                           (and binding (class-name (class-of binding)))))
                       :expansion-origins (loop for current = origin then (verona::expansion-origin-parent-origin current)
                                                while current collect
                                                  (list :invocation (query-data (verona::expansion-origin-invocation current))
                                                        :macro (query-data (verona::expansion-origin-macro current)))))))))))

(defun definition-type-structure (store id identifier)
  "Inspect declared layout and resolved type structure with related IDs."
  (inspect-definition store id identifier))

(defun definition-relationships (store id identifier &key (offset 0) (limit 100))
  (serialized (store)
    (let* ((s (require-session store id)) (records (definition-records s))
           (entry (find identifier records :key #'first :test #'equal)))
      (unless entry (return-from definition-relationships (list :status :unresolved)))
      (labels ((resolved (r) (cdr (assoc (third r) (getf (query-product (fourth (second r)) :resolved-definitions) :value) :test #'eq)))
               (contains (x root seen)
                 (cond ((eq x root) t) ((member x seen :test #'eq) nil)
                       ((consp x) (or (contains (car x) root (cons x seen)) (contains (cdr x) root (cons x seen))))
                       ((typep x 'standard-object)
                        (some (lambda (slot) (contains (definition-slot x slot) root (cons x seen)))
                              '(implementation protocol generic arguments parameter-types result-type))) (t nil))))
        (let* ((semantic (resolved entry))
               (root (or (definition-slot semantic 'protocol) (definition-slot semantic 'generic)
                         (definition-slot semantic 'type) (definition-slot semantic 'target-type)))
               (items (loop for other in records
                            when (and root (eq :implementation (definition-kind (third other)))
                                      (contains (resolved other) root nil)) collect (definition-summary other))))
          (query-data (append (list :status :found :id identifier
                                   :modules (mapcar (lambda (r) (query-summary s r)) (query-module-records s))
                                   :availability (if (every (lambda (r) (eq :complete (getf (query-product (fourth r) :resolved-definitions) :availability))) (query-module-records s)) :complete :partial)
                                   :requirements (definition-structure (definition-slot root 'operations) records))
                              (query-page (sort items #'string< :key #'query-order-key) offset limit))))))))
