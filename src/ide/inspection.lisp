(in-package #:verona.ide)

(defun inspection-metadata (s record)
  (append (nav-metadata s record)
          (list :evaluation-configuration-revision
                (and (fourth record) (module-evaluation-configuration-revision (fourth record)))
                :completed-phases (and (fourth record) (module-evaluation-completed-phases (fourth record)))
                :failed-phase (and (fourth record) (module-evaluation-failed-phase (fourth record)))
                :incomplete-phases (loop for phase in +module-phases+
                                         unless (and (fourth record)
                                                     (member phase (module-evaluation-completed-phases (fourth record))))
                                           collect phase))))

(defun diagnostic-location (s record location)
  ;; A prerequisite diagnostic may refer to a different source than its owner.
  (let* ((data (query-data location))
         (source (if (getf data :start) (getf (getf data :start) :source) (getf data :source)))
         (owner (or (find source (query-module-records s) :test #'equal
                          :key (lambda (r) (let ((id (second (first r))))
                                             (if (stringp id) id (format nil "<buffer ~A>" (second id))))))
                    record)))
    (list :evaluated-location data :location (and (nav-exact-p s owner) data)
          :exact-p (nav-exact-p s owner))))

(defun diagnostic-items (s record &key severity phase definition)
  (let* ((state (fourth record))
         (entry (and definition (find definition (definition-records s) :key #'first :test #'equal)))
         (syntax (and entry (verona::declaration-expanded-syntax (third entry)))))
    (loop for diagnostic in (and state (module-evaluation-diagnostics state))
          for index from 0 for current-phase = (nth index (module-evaluation-diagnostic-phases state))
          for data = (query-data diagnostic)
          for location = (getf data :location)
          for start = (getf location :start)
          when (and (or (null severity) (eq severity (getf data :severity)))
                    (or (null phase) (eq phase current-phase))
                    (or (null definition)
                        (and syntax (equal (first (second entry)) (first record)) start
                             (nav-contains syntax (getf start :offset)))))
            collect
              (let* ((where (diagnostic-location s record location))
                     (related (mapcar (lambda (x) (diagnostic-location s record x))
                                      (verona::diagnostic-secondary-locations diagnostic))))
                (setf (getf data :location) (getf where :location)
                      (getf data :evaluated-location) (getf where :evaluated-location)
                      (getf data :exact-p) (getf where :exact-p)
                      (getf data :secondary-locations) (mapcar (lambda (x) (getf x :location)) related)
                      (getf data :related-locations) related)
                (append (list :module (first record) :phase current-phase :diagnostic data)
                        (inspection-metadata s record))))))

(defun module-diagnostics (store id module &key severity phase definition (offset 0) (limit 100))
  (serialized (store)
    (let* ((s (require-session store id)) (record (require-query-module s module)))
      (query-data (append (inspection-metadata s record)
                          (query-page (diagnostic-items s record :severity severity :phase phase :definition definition)
                                      offset limit))))))

(defun project-diagnostics (store id &key module definition severity phase (offset 0) (limit 100))
  "List the same current diagnostics as MODULE-DIAGNOSTICS, across known modules."
  (serialized (store)
    (let* ((s (require-session store id))
           (records (if module (list (require-query-module s module))
                        (sort (query-module-records s) #'string< :key (lambda (r) (query-order-key (first r)))))))
      (query-data (append (list :coverage (mapcar (lambda (r) (inspection-metadata s r)) records))
                          (query-page (loop for r in records append
                                            (diagnostic-items s r :severity severity :phase phase :definition definition))
                                      offset limit))))))

(defun inspection-atom-data (data budget)
  (cond ((stringp data)
         (let ((end (min (length data) (max 0 (car budget)))))
           (when (< end (length data)) (setf (cdr budget) t))
           (decf (car budget) end)
           (subseq data 0 end)))
        ((consp data)
         (if (plusp (car budget))
             (progn (decf (car budget))
                    (cons (inspection-atom-data (car data) budget)
                          (inspection-atom-data (cdr data) budget)))
             (progn (setf (cdr budget) t) nil)))
        (t data)))

(defun inspection-form-data (syntax budget &optional replacements)
  ;; Share the output budget across syntax, structured atoms and expansion steps.
  (let ((replacement (assoc syntax replacements :test #'eq)))
    (when replacement
      (return-from inspection-form-data
        (inspection-form-data (second replacement) budget (remove replacement replacements :test #'eq)))))
  (if (<= (car budget) 0) (progn (setf (cdr budget) t) :truncated)
      (progn (decf (car budget))
             (let ((datum (verona::syntax-datum syntax)))
               (if (verona::verona-list-p datum)
                   (loop for remaining on (verona::verona-list-elements datum)
                         while (plusp (car budget)) collect (inspection-form-data (car remaining) budget replacements)
                         finally (when remaining (setf (cdr budget) t)))
                   (inspection-atom-data (definition-structure datum nil) budget))))))

(defun inspection-same-form-p (left right)
  (let ((a (verona::syntax-datum left)) (b (verona::syntax-datum right)))
    (if (verona::verona-list-p a)
        (and (verona::verona-list-p b)
             (= (length (nav-elements left)) (length (nav-elements right)))
             (every #'inspection-same-form-p (nav-elements left) (nav-elements right)))
        (and (eq (type-of a) (type-of b))
             (if (or (stringp a) (verona::verona-name-p a) (verona::qualified-name-p a))
                 (equal (definition-structure a nil) (definition-structure b nil))
                 (equalp a b))))))

(defun inspection-subform-p (syntax form)
  (or (eq syntax form) (some (lambda (child) (inspection-subform-p syntax child)) (nav-elements form))))

(defun inspection-selected-steps (selected steps)
  ;; Follow only transformations of the selected subtree, excluding siblings.
  (let ((forms (list (first selected))) (result nil))
    (dolist (step (member selected steps :test #'eq) (nreverse result))
      (when (some (lambda (form) (inspection-subform-p (first step) form)) forms)
        (push step result)
        (push (second step) forms)))))

(defun inspect-expansion (store id module &key offset definition (limit 4096))
  "Inspect a cached source form or current definition. LIMIT is a shared node/character budget."
  (unless (and (integerp limit) (<= 1 limit 100000)) (reject-request "Invalid expansion LIMIT"))
  (unless (or definition (and (integerp offset) (>= offset 0))) (reject-request "Supply OFFSET or DEFINITION"))
  (serialized (store)
    (let* ((s (require-session store id)) (record (require-query-module s module)) (state (fourth record))
           (entry (and definition (find definition (definition-records s) :key #'first :test #'equal)))
           (valid (or (null definition) (and entry (equal module (first (second entry))))))
           (position (if entry (nav-start (verona::declaration-source (third entry))) offset))
           (path (and valid position (nav-path (getf (query-product state :syntax) :value) position)))
           (before (and valid (if definition (first path)
                                  (or (find-if #'nav-elements (reverse path)) (car (last path))))))
           (all-steps (and state (reverse (module-evaluation-expansion-steps state))))
           ;; Compiler macros can rehydrate child syntax at their parent's range.
           ;; Match the selected reader form by datum within its top-level form.
           (selected-step (and before
                               (find-if (lambda (step)
                                          (and (nav-contains (first path) (nav-start (first step)))
                                               (inspection-same-form-p before (first step))))
                                        all-steps)))
           (steps (and selected-step
                       (inspection-selected-steps selected-step all-steps)))
           (after (or (and selected-step (first selected-step)) before))
           (availability (getf (query-product state :expanded-forms) :availability))
           (budget (cons limit nil)))
      (when (and steps (eq availability :unavailable)) (setf availability :partial))
      (query-data
       (append (inspection-metadata s record)
               (list :status (if before :found :unavailable) :expansion-availability availability
                     :expanded-p (if steps t
                                     (if (and (eq availability :complete)
                                              (or (null (nav-elements before))
                                                  (eq (getf (query-product state :types) :availability) :complete)))
                                         nil :unknown))
                     :steps-availability (if (eq (getf (query-product state :types) :availability) :complete)
                                             :complete (if (eq availability :unavailable) :unavailable :partial))
                     :before (and before (inspection-form-data before budget))
                     :after (and after (not (eq availability :unavailable)) (inspection-form-data after budget steps))
                     :steps (loop for (input output) in steps while (plusp (car budget))
                                  collect (list :before (inspection-form-data input budget)
                                                :after (inspection-form-data output budget)
                                                :origin (nav-location s record input)))
                     :truncated-p (or (cdr budget) (and steps (<= (car budget) 0))) :limit limit)
               (when before (nav-location s record before)))))))

(defun type-at-position (store id module offset)
  (serialized (store)
    (let ((s (require-session store id)))
      (multiple-value-bind (record path bindings token entry) (nav-context s module offset)
        (declare (ignore path bindings token))
        (let* ((state (fourth record)) (records (definition-records s))
               (candidates (and state (remove-if-not (lambda (x) (nav-contains (first x) offset))
                                                          (module-evaluation-expression-types state))))
               (expression (first (stable-sort (copy-list candidates) #'<
                                               :key (lambda (x) (- (nav-end (first x)) (nav-start (first x)))))))
               (semantic (and entry (nav-semantic entry)))
               (inferred (or (and expression (verona::expression-type (second expression)))
                             (definition-slot semantic 'type) (definition-slot semantic 'return-type)))
               (declared (and entry (or (definition-slot (third entry) 'type)
                                       (definition-slot (third entry) 'return-type))))
               (structure (definition-structure inferred records)))
          (query-data (append (inspection-metadata s record)
                              (list :status (if (or inferred declared) :found :unavailable)
                                    :definition (first entry) :declared-type (definition-structure declared records)
                                    :inferred-type structure
                                    :description (if inferred (verona::verona-type-name inferred)
                                                     (and declared
                                                          (let ((data (definition-structure declared records)))
                                                            (if (stringp data) data
                                                                (with-standard-io-syntax (prin1-to-string data)))))))
                              (when expression (nav-location s record (first expression))))))))))
