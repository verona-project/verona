(in-package #:verona.ide)

;; All positions are zero-based character offsets in the evaluated source.
(defun nav-elements (syntax)
  (when (and syntax (verona::verona-list-p (verona::syntax-datum syntax)))
    (verona::verona-list-elements (verona::syntax-datum syntax))))

(defun nav-start (syntax) (verona::source-location-offset (verona::syntax-start syntax)))
(defun nav-end (syntax) (verona::source-location-offset (verona::syntax-end syntax)))
(defun nav-contains (syntax offset)
  (and (<= (nav-start syntax) offset) (<= offset (nav-end syntax))))

(defun nav-path (forms offset)
  (loop for form in forms when (nav-contains form offset)
        return (cons form (nav-path (nav-elements form) offset))))

(defun nav-exact-p (s record)
  (let ((state (fourth record)) (source (third record)))
    (and state source
         (= (source-revision source) (module-evaluation-source-revision state))
         (= (session-configuration-revision s) (module-evaluation-configuration-revision state)))))

(defun nav-metadata (s record)
  (list :module (first record) :evaluation-source-revision
        (and (fourth record) (module-evaluation-source-revision (fourth record)))
        :current-source-revision (and (third record) (source-revision (third record)))
        :exact-p (nav-exact-p s record)
        :processing-status (if (fourth record) (module-evaluation-status (fourth record)) :unevaluated)
        :availability (if (and (fourth record) (eq :complete (module-evaluation-status (fourth record))))
                          :complete
                          (if (fourth record) :partial :unavailable))
        :resolution-availability (getf (query-product (fourth record) :resolved-definitions) :availability)
        :type-availability (getf (query-product (fourth record) :types) :availability)))

(defun nav-location (s record syntax)
  (list :evaluated-location (query-data syntax) :exact-p (nav-exact-p s record)
        :location (and (nav-exact-p s record) (query-data syntax))))

(defun nav-context (s module offset)
  (unless (and (integerp offset) (>= offset 0)) (reject-request "OFFSET must be nonnegative"))
  (let* ((record (require-query-module s module)) (state (fourth record))
         (path (nav-path (getf (query-product state :syntax) :value) offset))
         (contexts (and state (module-evaluation-navigation-contexts state)))
         (scope (first (sort (remove-if-not (lambda (x) (nav-contains (first x) offset))
                                           (copy-list contexts))
                             #'< :key (lambda (x) (- (nav-end (first x)) (nav-start (first x)))))))
         (token (car (last path)))
         (definition (find-if (lambda (e)
                               (and (equal module (first (second e)))
                                    (nav-contains (verona::declaration-expanded-syntax (third e)) offset)))
                             (definition-records s))))
    (values record path (append (second scope)
                                (mapcar (lambda (operation)
                                          (cons (verona::protocol-operation-name operation) operation))
                                        (third scope))) token definition)))

(defun nav-name (syntax)
  (when syntax
    (let ((datum (verona::syntax-datum syntax)))
      (typecase datum
        (verona::verona-name (query-data datum))
        (verona::qualified-name
         (format nil "~A:~A" (query-data (verona::qualified-name-qualifier datum))
                 (query-data (verona::qualified-name-name datum))))))))

(defun nav-local (s record binding)
  (let ((syntax (or (definition-slot binding 'syntax) (definition-slot binding 'source))))
    (append (list :id (list (first record) (module-evaluation-generation (fourth record))
                           :local (and syntax (nav-start syntax))
                           (query-data (verona::semantic-binding-name binding)))
                  :name (query-data (verona::semantic-binding-name binding)) :kind :local
                  :type (definition-structure (definition-slot binding 'type) (definition-records s)))
            (when syntax (nav-location s record syntax)))))

(defun nav-local-binding-p (binding)
  (typep binding '(or verona::parameter-binding verona::let-binding
                     verona::pattern-binding verona::type-parameter)))

(defun nav-definition (s entry records)
  (let ((summary (definition-summary entry)))
    (remf summary :location)
    (append (nav-location s (second entry) (verona::declaration-source (third entry)))
            summary
            (list :signature (loop for slot in '(parameters return-type result-type for-clause type)
                                   for value = (definition-slot (third entry) slot)
                                   when value append (list (intern (string slot) :keyword)
                                                           (definition-structure value records)))))))

(defun nav-visible (s record bindings)
  (let ((records (definition-records s)) (items nil))
    (dolist (binding bindings)
      (when (typep (cdr binding) 'verona::protocol-operation)
        (let* ((operation (cdr binding))
               (declaration (verona::protocol-declaration (verona::protocol-operation-protocol operation)))
               (entry (find declaration records :key #'third :test #'eq)))
          (when entry
            (push (append (list :name (query-data (car binding)) :kind :protocol-member :member-p t
                                :signature (definition-structure operation records))
                          (nav-location s (second entry) (verona::protocol-operation-source operation))
                          (nav-definition s entry records)) items)))))
    (dolist (entry records)
      (when (equal (first record) (first (second entry)))
        (push (nav-definition s entry records) items)))
    (dolist (import (getf (query-product (fourth record) :imports) :value))
      (let ((qualifier (query-data (verona::import-qualifier-name import))))
        (push (list :name (concatenate 'string qualifier ":") :kind :module) items)
        (dolist (entry records)
          (when (and (eq (verona::import-module import) (verona::declaration-module (third entry)))
                     (eq :public (getf (definition-summary entry) :visibility)))
            (let ((summary (nav-definition s entry records)))
              (setf (getf summary :name) (format nil "~A:~A" qualifier (getf summary :name)))
              (push summary items))))))
    ;; Semantic bindings are ordered from innermost to outermost.
    (let ((locals (loop for binding in bindings
                        when (nav-local-binding-p (cdr binding))
                          collect (nav-local s record (cdr binding)))))
      (remove-duplicates (append locals (nreverse items)) :key (lambda (x) (getf x :name))
                         :test #'equal :from-end t))))

(defun position-context (store id module offset)
  (serialized (store)
    (let ((s (require-session store id)))
      (multiple-value-bind (record path bindings token definition) (nav-context s module offset)
        (declare (ignore path))
        (query-data (append (nav-metadata s record)
                            (list :symbol (nav-name token) :enclosing-definition (first definition)
                                  :scope-availability (if bindings :available :unavailable)
                                  :scope (nav-visible s record bindings))
                            (when token (nav-location s record token))))))))

(defparameter +completion-forms+
  '("do" "let" "match" "return" "assign" "store" "array-of" "tuple" "tuple-get"
    "index" "field" "&" "address-of" "deref" "dereference" "cast" "pointer-offset"))

(defparameter +declaration-completion-forms+
  '("function" "type" "constant" "variable" "generic" "protocol"
    "implementation" "macro" "import" "export"))

(defun complete-names (store id module offset &key prefix expected-type (limit 100))
  (serialized (store)
    (let ((s (require-session store id)))
      (multiple-value-bind (record path bindings token definition) (nav-context s module offset)
        (declare (ignore definition))
        (let* ((name (nav-name token))
               (prefix (or prefix (and name (subseq name 0 (min (length name) (- offset (nav-start token))))) ""))
               (head-p (or (null path) (let ((parent (car (last path 2))))
                                                       (eq token (first (nav-elements parent))))))
               (items (nav-visible s record bindings))
               (range (and (nav-exact-p s record)
                           (list :start (if name (nav-start token) offset)
                                 :end (if name (nav-end token) offset)))))
          (when head-p
            (setf items (append items (mapcar (lambda (name) (list :name name :kind :language-form))
                                              (if (<= (length path) 2) +declaration-completion-forms+ +completion-forms+)))))
          (setf items (loop for item in items for name = (getf item :name)
                            for signature = (getf item :signature)
                            for type = (or (getf item :type) (getf signature :type) (getf signature :return-type)
                                           (getf signature :result-type))
                            when (and (<= (length prefix) (length name))
                                      (string= prefix name :end2 (length prefix))
                                      (or (null expected-type) (null type) (equal expected-type type)))
                              collect (append item (list :insertion-text name :replacement-range range
                                                         :type-match (cond ((null expected-type) :not-requested)
                                                                           ((null type) :unknown) (t :match))))))
          (query-data (append (nav-metadata s record)
                              (query-page (sort items #'string< :key (lambda (x) (getf x :name))) 0 limit))))))))

(defun nav-targets (s record bindings name)
  (let ((local (find name bindings :key (lambda (x) (query-data (car x))) :test #'equal)))
    (if (and local (nav-local-binding-p (cdr local)))
        (list (nav-local s record (cdr local)))
        (remove-if-not (lambda (x) (equal name (getf x :name))) (nav-visible s record bindings)))))

(defun go-to-definition (store id module offset)
  (serialized (store)
    (let ((s (require-session store id)))
      (multiple-value-bind (record path bindings token definition) (nav-context s module offset)
        (declare (ignore path definition))
        (let ((items (nav-targets s record bindings (nav-name token))))
          (setf items
                (mapcar (lambda (item)
                          (let ((entry (find (getf item :id) (definition-records s) :key #'first :test #'equal)))
                            (if (and entry (not (getf item :member-p)))
                                (append (list :id (first entry) :name (getf item :name))
                                        (nav-location s (second entry) (verona::declaration-source (third entry)))) item))) items))
          (query-data (append (nav-metadata s record)
                              (list :status (cond ((null items) :unresolved) ((cdr items) :ambiguous) (t :found))
                                    :items items))))))))

(defun nav-semantic (entry)
  (cdr (assoc (third entry) (getf (query-product (fourth (second entry)) :resolved-definitions) :value) :test #'eq)))

(defun nav-root (entry)
  (let ((semantic (nav-semantic entry)))
    (or (definition-slot semantic 'generic) (definition-slot semantic 'protocol))))

(defun signature-help (store id module offset)
  (serialized (store)
    (let* ((s (require-session store id)) (records (definition-records s)))
      (multiple-value-bind (record path bindings token definition) (nav-context s module offset)
        (declare (ignore token definition))
        (let* ((call (find-if #'nav-elements (reverse path))) (elements (nav-elements call))
               (argument (and elements (max 0 (1- (or (position-if (lambda (x) (nav-contains x offset)) elements)
                                                       (length elements))))))
               (targets (nav-targets s record bindings (nav-name (first elements))))
               (entries (remove nil (mapcar (lambda (x) (find (getf x :id) records :key #'first :test #'equal)) targets)))
               (roots (remove nil (mapcar #'nav-root entries)))
               (implementations (remove-if-not (lambda (e) (and (eq :implementation (definition-kind (third e)))
                                                                  (member (nav-root e) roots :test #'eq))) records))
               (signatures (append (remove-if-not (lambda (x) (getf x :member-p)) targets)
                                   (mapcar (lambda (e)
                                     (append (nav-definition s e records)
                                             (list :resolved (definition-structure (nav-semantic e) records))))
                                   (or implementations
                                       (remove-if (lambda (e) (eq :protocol (definition-kind (third e)))) entries))))))
          (query-data (append (nav-metadata s record)
                              (list :active-argument argument :signatures signatures
                                    :signature-availability (if signatures :available :unavailable)))))))))

(defun find-references (store id identifier &key (include-declaration t) (offset 0) (limit 100))
  (serialized (store)
    (let* ((s (require-session store id)) (records (definition-records s))
           (entry (find identifier records :key #'first :test #'equal))
           (local-record (and (eq :local (third identifier))
                              (find (first identifier) (query-module-records s) :key #'first :test #'equal)))
           (local-binding
             (and local-record (fourth local-record)
                  (loop for context in (module-evaluation-navigation-contexts (fourth local-record))
                        thereis (loop for binding in (second context)
                                      when (equal identifier (getf (nav-local s local-record (cdr binding)) :id))
                                        return (cdr binding)))))
           (items nil) (coverage nil))
      (dolist (record (query-module-records s))
        (push (append (nav-metadata s record)
                      (list :complete-p (and (nav-exact-p s record) (fourth record)
                                             (eq :complete (module-evaluation-status (fourth record)))))) coverage)
        (when (and local-binding (equal (first record) (first local-record)))
          (dolist (context (module-evaluation-navigation-contexts (fourth record)))
            (let* ((syntax (first context)) (name (nav-name syntax))
                   (binding (find name (second context) :key (lambda (x) (query-data (car x))) :test #'equal)))
              (when (and name (eq local-binding (cdr binding)))
                (push (append (list :kind :use :module (first record)) (nav-location s record syntax)) items)))))
        (when entry
          (dolist (edge (gethash (first record) (session-dependencies s)))
            (when (and (equal (first (second entry)) (getf edge :target))
                       (equal (query-data (verona::declaration-name (third entry))) (getf edge :to)))
              (push (append (list :kind :use :module (first record))
                            (nav-location s record (getf edge :location))) items)))))
      (when (and entry include-declaration)
        (push (append (list :kind :declaration :module (first (second entry)))
                      (nav-location s (second entry) (verona::declaration-source (third entry)))) items))
      (when (and local-binding include-declaration)
        (push (append (list :kind :declaration :module (first local-record))
                      (nav-location s local-record (or (definition-slot local-binding 'syntax)
                                                       (definition-slot local-binding 'source)))) items))
      (query-data (append (list :status (if (or entry local-binding) :found :unresolved) :coverage coverage
                               :complete-p (every (lambda (x) (getf x :complete-p)) coverage))
                          (query-page (sort (remove-duplicates items :test #'equal) #'string< :key #'query-order-key) offset limit))))))

(defun related-definitions (store id identifier &key (limit 100))
  (serialized (store)
    (let* ((s (require-session store id)) (records (definition-records s))
           (entry (find identifier records :key #'first :test #'equal)))
      (unless entry (return-from related-definitions (list :status :unresolved)))
      (let* ((root (nav-root entry))
             (items (loop for other in records
                          when (and root (not (equal identifier (first other))) (eq root (nav-root other)))
                            collect (nav-definition s other records)))
             (origin (verona::syntax-expansion-origin (verona::declaration-expanded-syntax (third entry)))))
        (query-data (append (nav-metadata s (second entry))
                            (list :status :found :expansion-origins
                                  (loop for current = origin then (verona::expansion-origin-parent-origin current)
                                        while current collect
                                          (append (nav-location s (second entry) (verona::expansion-origin-invocation current))
                                                  (list :macro (query-data (verona::expansion-origin-macro current))))))
                            (query-page (sort items #'string< :key #'query-order-key) 0 limit)))))))
