(in-package #:verona.ide)
(eval-when (:compile-toplevel :load-toplevel :execute) (require :sb-posix))
(export '(start-build build-status cancel-build start-program program-input stop-program release-build))

;; Process handles never escape this table. Access is serialized by the store.
(defvar *store-build-jobs* (make-hash-table :test 'eq :weakness :key))
(defvar *store-build-jobs-lock* (sb-thread:make-mutex :name "IDE build stores"))

(defun session-store-build-jobs (store)
  ;; Keep optional build bookkeeping outside SESSION-STORE: changing a DEFSTRUCT
  ;; layout invalidates live stores and previously compiled accessor offsets.
  (sb-thread:with-mutex (*store-build-jobs-lock*)
    (or (gethash store *store-build-jobs*)
        (setf (gethash store *store-build-jobs*) (make-hash-table :test 'equal)))))

(defstruct build-job store session token directory metadata process program
  (status :building) (run-status :not-started) artifact artifact-kind artifact-target
  diagnostics exit-status run-exit-status)

(defun job-path (job name) (merge-pathnames name (build-job-directory job)))
(defun terminate-build-process (process)
  ;; The worker creates its own process group, including linker children.
  (ignore-errors (sb-posix:kill (- (uiop:process-info-pid process)) sb-posix:sigkill))
  (when (uiop:process-alive-p process) (uiop:terminate-process process :urgent t))
  (uiop:wait-process process))
(defun write-build-data (path data)
  (with-open-file (out path :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-pretty* nil)) (write data :stream out))))
(defun read-build-data (path)
  (when (probe-file path)
    (with-open-file (in path) (let ((*read-eval* nil)) (read in)))))
(defun require-build (store id token)
  (require-session store id)
  (let ((job (gethash token (session-store-build-jobs store))))
    (unless (and job (eq store (build-job-store job)) (equal id (build-job-session job)))
      (reject-request "Unknown build ~A" token))
    job))

(defun start-build (store id &key (unsaved-buffers :reject))
  "Capture saved sources, then launch the ordinary driver in an isolated SBCL."
  (let* ((info (inspect-session store id))
         (config (getf info :configuration))
         (root (configuration-root config))
         (build-file (configuration-build-file config))
         (target-name (configuration-build-target config)))
    (unless (and build-file target-name) (reject-request "Select a project build target first"))
    (let* ((text (uiop:read-file-string build-file))
           (file (verona.compiler:parse-build-source
                  (verona:make-source (namestring build-file) text) :directory root))
           (target (verona.compiler:find-build-target file target-name))
           (directory (loop for path = (merge-pathnames
                                        (format nil "verona-ide-~36R/" (random (expt 36 20)))
                                        (uiop:temporary-directory))
                            unless (probe-file path) return path))
           (token (namestring directory))
           (job (make-build-job :store store :session id :token token :directory directory))
           (paths (configuration-search-paths config))
           (source-paths (remove-duplicates
                          (loop for path in paths append
                            (uiop:directory-files path "*.vrn")) :test #'equal))
           (inputs (build-inputs store id :paths source-paths :unsaved-buffers unsaved-buffers))
           (mapping nil) (snapshot-paths nil))
      (unless target (reject-request "Unknown project target ~A" target-name))
      (unless (= (getf info :configuration-revision) (getf inputs :configuration-revision))
        (reject-request "Configuration changed during build capture; retry"))
      (ensure-directories-exist (job-path job "request.sexp"))
      (handler-case
          (progn
            (loop for path in paths for index from 0
                  for snapshot = (merge-pathnames (format nil "sources/~D/" index) directory)
                  do (ensure-directories-exist (merge-pathnames ".directory" snapshot))
                     (push snapshot snapshot-paths)
                     (dolist (source (getf inputs :sources))
                       (when (equal (uiop:pathname-directory-pathname (getf source :path)) path)
                         (let ((destination (merge-pathnames (file-namestring (getf source :path)) snapshot)))
                           (with-open-file (out destination :direction :output :if-exists :supersede)
                             (write-string (getf source :contents) out))
                           (push (cons (namestring destination) (namestring (getf source :path))) mapping)))))
            (setf (build-job-metadata job)
                  (list :target target-name :configuration (configuration-value config)
                        :configuration-revision (getf inputs :configuration-revision)
                        :source-policy :disk :unsaved-buffers unsaved-buffers
                        :build-file (namestring build-file) :build-file-contents text
                        :input-coverage :search-path-snapshot
                        :inputs (loop for source in (getf inputs :sources)
                                      collect (loop for (key value) on source by #'cddr
                                                    unless (eq key :contents) append (list key value)))))
            (write-build-data (job-path job "request.sexp")
                              (list :text text :build-file build-file :root root :target target-name
                                    :paths (nreverse snapshot-paths) :mapping mapping
                                    :triple (getf (configuration-target config) :triple)
                                    :features (configuration-reader-features config)))
            (setf (build-job-process job)
                  (uiop:launch-program
                   (list (or (uiop:getenv "VERONA_IDE_SBCL") "sbcl") "--script"
                         (namestring (asdf:system-relative-pathname :verona "scripts/ide-build-worker.lisp"))
                         (namestring directory))
                   :output (job-path job "build.stdout") :error-output (job-path job "build.stderr")
                   :if-output-exists :supersede :if-error-output-exists :supersede))
            (serialized (store)
              (require-session store id)
              (setf (gethash token (session-store-build-jobs store)) job))
            (list :build (copy-seq token) :session (copy-value id) :status :building))
        (error (condition)
          (when (build-job-process job) (terminate-build-process (build-job-process job)))
          (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore)
          (error condition))))))

(defun refresh-build (job)
  (when (and (eq :building (build-job-status job))
             (not (uiop:process-alive-p (build-job-process job))))
    (let* ((code (uiop:wait-process (build-job-process job)))
           (result (read-build-data (job-path job "result.sexp"))))
      (setf (build-job-exit-status job) code
            (build-job-diagnostics job) (getf result :diagnostics)
            (build-job-artifact-kind job) (getf result :artifact-kind)
            (build-job-artifact-target job) (getf result :artifact-target)
            (build-job-status job) (if (and (eql code 0) (getf result :artifact)
                                               (probe-file (getf result :artifact))) :succeeded :failed)
            (build-job-artifact job) (and (eq :succeeded (build-job-status job))
                                         (getf result :artifact)))))
  (when (and (eq :running (build-job-run-status job))
             (not (uiop:process-alive-p (build-job-program job))))
    (setf (build-job-run-exit-status job) (uiop:wait-process (build-job-program job))
          (build-job-run-status job) :exited)
    (ignore-errors (close (uiop:process-info-input (build-job-program job)))))
  job)

(defun build-output (job name offset limit)
  (let ((path (job-path job name)))
    (if (probe-file path)
        (with-open-file (in path)
          (let* ((length (file-length in)) (start (min offset length))
                 (text (make-string (min limit (- length start)))))
            (file-position in start)
            (let ((count (read-sequence text in)))
              (list :text (subseq text 0 count) :next-offset (file-position in)
                    :truncated (< (file-position in) length)))))
        (list :text "" :next-offset 0 :truncated nil))))

(defun build-status (store id token &key (offset 0) (error-offset 0) (limit 16384) output)
  (unless (and (integerp offset) (>= offset 0) (integerp error-offset) (>= error-offset 0)
               (integerp limit) (<= 1 limit 65536)) (reject-request "Invalid build output bounds"))
  (unless (member output '(nil :build :program)) (reject-request "Unknown output selection"))
  (serialized (store)
    (let* ((job (refresh-build (require-build store id token)))
           (running (if output (eq output :program)
                        (not (eq :not-started (build-job-run-status job))))))
      (append (list :build (copy-value token) :status (build-job-status job)
                    :stage (read-build-data (job-path job "stage.sexp"))
                    :artifact (build-job-artifact job) :diagnostics (copy-value (build-job-diagnostics job))
                    :artifact-kind (build-job-artifact-kind job)
                    :artifact-target (copy-value (build-job-artifact-target job))
                    :exit-status (build-job-exit-status job)
                    :run-status (build-job-run-status job) :run-exit-status (build-job-run-exit-status job)
                    :stdout (build-output job (if running "run.stdout" "build.stdout") offset limit)
                    :stderr (build-output job (if running "run.stderr" "build.stderr") error-offset limit))
              (let ((metadata (copy-value (build-job-metadata job))))
                (setf (getf metadata :configuration)
                      (configuration-value (getf metadata :configuration)))
                metadata)))))

(defun cancel-build (store id token)
  (serialized (store)
    (let ((job (refresh-build (require-build store id token))))
      (when (eq :building (build-job-status job))
        (terminate-build-process (build-job-process job))
        (setf (build-job-status job) :cancelled (build-job-artifact job) nil))
      (build-job-status job))))

(defun start-program (store id token &key (arguments nil) directory environment)
  (unless (and (listp arguments) (every #'stringp arguments)
               (listp environment) (every (lambda (s) (and (stringp s) (position #\= s) (plusp (position #\= s))
                                                   (not (find #\Null s)))) environment))
    (reject-request "Arguments and environment must be string lists (environment: NAME=value)"))
  (serialized (store)
    (let* ((job (refresh-build (require-build store id token)))
           (request (read-build-data (job-path job "request.sexp"))))
      (unless (and (eq :succeeded (build-job-status job))
                   (eq (build-job-artifact-kind job) :executable)
                   (equal (build-job-artifact-target job)
                          (verona.backend.llvm:native-target-triple)))
        (reject-request "Run requires a successful executable build for this host"))
      (when (eq :running (build-job-run-status job)) (reject-request "Program is already running"))
      (write-build-data (job-path job "run-request.sexp")
                        (list :artifact (namestring (build-job-artifact job))
                              :arguments arguments :environment environment))
      (setf (build-job-program job)
            (uiop:launch-program
             (list (or (uiop:getenv "VERONA_IDE_SBCL") "sbcl") "--script"
                   (namestring (asdf:system-relative-pathname :verona "scripts/ide-build-worker.lisp"))
                   (namestring (build-job-directory job)) "run")
             :directory (or directory (getf request :root)) :input :stream
             :output (job-path job "run.stdout") :error-output (job-path job "run.stderr")
             :if-output-exists :supersede :if-error-output-exists :supersede)
            (build-job-run-status job) :running (build-job-run-exit-status job) nil)
      (list :build token :run-status :running))))

(defun program-input (store id token text &key eof)
  (serialized (store)
    (let ((job (refresh-build (require-build store id token))))
      (unless (eq :running (build-job-run-status job)) (reject-request "Program is not running"))
      (let ((stream (uiop:process-info-input (build-job-program job))))
        (write-string text stream) (finish-output stream) (when eof (close stream)))
      t)))
(defun stop-program (store id token)
  (serialized (store)
    (let ((job (refresh-build (require-build store id token))))
      (when (eq :running (build-job-run-status job))
        (setf (build-job-run-exit-status job) (terminate-build-process (build-job-program job))
              (build-job-run-status job) :stopped)
        (ignore-errors (close (uiop:process-info-input (build-job-program job)))))
      (build-job-run-status job))))
(defun release-build (store id token)
  (cancel-build store id token) (stop-program store id token)
  (serialized (store)
    (let ((job (require-build store id token)))
      (uiop:delete-directory-tree (build-job-directory job) :validate t)
      (remhash token (session-store-build-jobs store)) t)))

(defun close-session-builds (store id)
  ;; Called with the store lock held.
  (maphash
   (lambda (token job)
     (when (and (eq store (build-job-store job)) (equal id (build-job-session job)))
       (dolist (process (list (build-job-process job) (build-job-program job)))
         (when process
           (when (uiop:process-alive-p process) (terminate-build-process process))
           (uiop:wait-process process)
           (ignore-errors (close (uiop:process-info-input process)))))
       (uiop:delete-directory-tree (build-job-directory job) :validate t :if-does-not-exist :ignore)
       (remhash token (session-store-build-jobs store))))
   (session-store-build-jobs store)))
(pushnew 'close-session-builds *session-close-hooks*)
