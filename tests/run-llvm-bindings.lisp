;;; Independent acceptance tests for the Verona LLVM C API library.
(require :asdf)
(asdf:load-system :fiveam)
(defpackage #:verona/llvm-bindings-tests (:use #:cl #:fiveam))
(in-package #:verona/llvm-bindings-tests)
(def-suite :llvm-bindings)
(in-suite :llvm-bindings)
(defparameter *binary* (first (uiop:command-line-arguments)))
(unless *binary* (error "Expected the llvm-tests executable path"))

(test builds-verifies-and-emits-native-object
  (uiop:with-temporary-file (:pathname object :type "o")
    (multiple-value-bind (output diagnostics status)
        (uiop:run-program (list *binary* (namestring object)
                               (concatenate 'string (namestring object) ".missing/object.o"))
                          :output :string :error-output :string :ignore-error-status t)
      (is (= 0 status) "~A~%~A" output diagnostics)
      (is (not (null (search "object emission passed" output))))
      (is (string= "" diagnostics)))
    (uiop:with-temporary-file (:pathname executable)
      (multiple-value-bind (output diagnostics status)
          (uiop:run-program (list (or (uiop:getenv "VERONA_LINKER") "clang")
                                 (namestring object) "-o" (namestring executable))
                            :output :string :error-output :string :ignore-error-status t)
        (declare (ignore output))
        (is (= 0 status) "~A" diagnostics))
      (multiple-value-bind (output diagnostics status)
          (uiop:run-program (list (namestring executable))
                            :output :string :error-output :string :ignore-error-status t)
        (is (= 42 status)) (is (string= "" output)) (is (string= "" diagnostics))))))

(test requires-output-paths
  (multiple-value-bind (output diagnostics status)
      (uiop:run-program (list *binary*) :output :string :error-output :string :ignore-error-status t)
    (declare (ignore output diagnostics))
    (is (= 2 status))))

(unless (run! :llvm-bindings) (uiop:quit 1))
