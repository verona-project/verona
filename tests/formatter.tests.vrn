(import base)
(import testing)
(import formatter.test_layout :as layout)
(import formatter.test_syntax :as syntax)
(import formatter.test_failure :as failure)

(base:external-function puts "puts" ((pointer u8)) i32)

(base:function run ((name (pointer u8)) (test testing:test-function)) testing:result
  (let ((result testing:result (testing:execute test)))
    (do (match (field result failed) (0 unit) (_ (do (puts name) unit))) result)))

(base:function main () exit-code
  (let
    ((result
       testing:result
       (testing:checks
         (run "FAIL layout/empty" layout:empty)
         (run "FAIL layout/whitespace" layout:whitespace)
         (run "FAIL layout/simple-call" layout:simple-call)
         (run "FAIL layout/empty-list" layout:empty-list)
         (run "FAIL layout/nested-list" layout:nested-list)
         (run "FAIL layout/import-grouping" layout:import-grouping)
         (run "FAIL layout/function-body" layout:function-body)
         (run "FAIL layout/test-body" layout:test-body)
         (run "FAIL layout/quote" layout:quote)
         (run "FAIL layout/nested-quotes" layout:nested-quotes)
         (run "FAIL layout/feature-branches" layout:feature-branches)
         (run "FAIL layout/nested-features" layout:nested-features)
         (run "FAIL layout/comment-only" layout:comment-only)
         (run "FAIL layout/trailing-comment" layout:trailing-comment)
         (run "FAIL layout/standalone-comment" layout:standalone-comment)
         (run "FAIL layout/last-child-comment" layout:last-child-comment)
         (run "FAIL layout/comment-before-closing" layout:comment-before-closing)
         (run "FAIL layout/quoted-comment" layout:quoted-comment)
         (run "FAIL layout/conditional-comment" layout:conditional-comment)
         (run "FAIL layout/character-close" layout:character-close)
         (run "FAIL layout/character-open" layout:character-open)
         (run "FAIL layout/character-semicolon" layout:character-semicolon)
         (run "FAIL layout/character-quote" layout:character-quote)
         (run "FAIL layout/character-prefix" layout:character-prefix)
         (run "FAIL layout/named-characters" layout:named-characters)
         (run "FAIL layout/string-delimiters" layout:string-delimiters)
         (run "FAIL layout/string-escapes" layout:string-escapes)
         (run "FAIL layout/literal-newline" layout:literal-newline)
         (run "FAIL layout/adjacent-forms" layout:adjacent-forms)
         (run "FAIL layout/literal-spelling" layout:literal-spelling)
         (run "FAIL layout/already-formatted" layout:already-formatted)
         (run "FAIL layout/crlf-layout" layout:crlf-layout)
         (run "FAIL layout/unicode-comment" layout:unicode-comment)
         (run "FAIL layout/embedded-nul-string" layout:embedded-nul-string)
         (run "FAIL layout/width-wrap" layout:width-wrap)
         (run "FAIL layout/anonymous-list-wrap" layout:anonymous-list-wrap)
         (run "FAIL layout/header-wrap-at-exact-boundary" layout:header-wrap-at-exact-boundary)
         (run "FAIL layout/let-layout" layout:let-layout)
         (run "FAIL syntax/unexpected-close" syntax:unexpected-close)
         (run "FAIL syntax/missing-close" syntax:missing-close)
         (run "FAIL syntax/extra-close" syntax:extra-close)
         (run "FAIL syntax/missing-quote-target" syntax:missing-quote-target)
         (run "FAIL syntax/prefix-before-close" syntax:prefix-before-close)
         (run "FAIL syntax/missing-feature-target" syntax:missing-feature-target)
         (run "FAIL syntax/missing-feature-name" syntax:missing-feature-name)
         (run "FAIL syntax/unknown-dispatch" syntax:unknown-dispatch)
         (run "FAIL syntax/empty-character" syntax:empty-character)
         (run "FAIL syntax/unknown-character-name" syntax:unknown-character-name)
         (run "FAIL syntax/multicharacter" syntax:multicharacter)
         (run "FAIL syntax/unterminated-string" syntax:unterminated-string)
         (run "FAIL syntax/unterminated-escape" syntax:unterminated-escape)
         (run "FAIL syntax/unsupported-escape" syntax:unsupported-escape)
         (run "FAIL syntax/dot-literal" syntax:dot-literal)
         (run "FAIL syntax/invalid-inactive-branch" syntax:invalid-inactive-branch)
         (run "FAIL failure/width-too-small" failure:width-too-small)
         (run "FAIL failure/width-too-large" failure:width-too-large)
         (run
           "FAIL failure/syntax-does-not-replace-destination"
           failure:syntax-does-not-replace-destination)
         (run "FAIL failure/workspace-metadata-failure" failure:workspace-metadata-failure)
         (run "FAIL failure/workspace-payload-failure" failure:workspace-payload-failure)
         (run
           "FAIL failure/output-allocation-failure-preserves-owner"
           failure:output-allocation-failure-preserves-owner)
         (run
           "FAIL failure/borrowed-destination-can-be-formatted-in-place"
           failure:borrowed-destination-can-be-formatted-in-place)
         (run "FAIL failure/invalid-utf8" failure:invalid-utf8)
         (run "FAIL failure/non-ascii-string-literal" failure:non-ascii-string-literal))))
    (match (field result failed) (0 (do (puts "formatter: 63 unit tests passed") 0)) (_ 1))))
