(in-package #:verona/tests)
(in-suite :verona)

(test ide-session-contract
  (let* ((store (verona.ide:make-session-store))
         (config (verona.ide:make-configuration))
         (id (verona.ide:create-session store config))
         (other (verona.ide:create-session store
                  (verona.ide:make-configuration :target '(:pointer-width 32))))
         (source (verona.ide:open-buffer store id "editor" "first" :module "main"))
         (revision (verona.ide:source-revision source))
         (request (verona.ide:begin-request store id source)))
    (is (equal id (verona.ide:create-session store config)))
    (is (not (equal id other)))
    (is (eq :complete (verona.ide:publish-result store id request :good)))
    (verona.ide:attach-session store id "connection")
    (verona.ide:detach-session store id "connection")
    (verona.ide:attach-session store id "reconnected")
    (is (equal "first" (verona.ide:source-text source)))
    (let* ((edited (verona.ide:edit-buffer store id "editor" "broken"))
           (pending (verona.ide:begin-request store id edited)))
      (is (> (verona.ide:source-revision edited) revision))
      (is (eq :failed (verona.ide:publish-result store id pending nil :failed t)))
      (multiple-value-bind (result status)
          (verona.ide:query-result store id (verona.ide:source-id source))
        (is (eq :current status)) (is (null (verona.ide:result-value result))))
      (let ((cancelled (verona.ide:begin-request store id edited)))
        (verona.ide:cancel-request store id cancelled)
        (is (eq :cancelled (verona.ide:publish-result store id cancelled :bad))))
      (let ((old (verona.ide:begin-request store id edited)))
        (verona.ide:configure-session store id
          (verona.ide:make-configuration :reader-features '("editor")))
        (is (eq :stale (verona.ide:publish-result store id old :bad)))))
    (signals error (verona.ide:build-inputs store id))
    (is (eq :disk (getf (verona.ide:build-inputs store id :unsaved-buffers :ignore) :source-policy)))
    (verona.ide:reset-session store id)
    (is (null (verona.ide:query-result store id (verona.ide:source-id source))))
    (verona.ide:close-session store id)
    (signals error (verona.ide:inspect-session store id))
    (is (equal other (verona.ide:find-session store other)))))

(test ide-file-overlay
  (uiop:with-temporary-file (:pathname path :stream stream :keep t)
    (write-string "disk" stream) (finish-output stream)
    (unwind-protect
         (let* ((store (verona.ide:make-session-store))
                (id (verona.ide:create-session store (verona.ide:make-configuration)))
                (disk (verona.ide:read-source store id path))
                (disk-text (verona.ide:source-text disk))
                (overlay (verona.ide:open-buffer store id "file" "overlay" :path path)))
           (is (equal "disk" disk-text))
           (is (eq disk overlay))
           (is (equal "overlay" (verona.ide:source-text disk)))
           (is (eq overlay (verona.ide:read-source store id path)))
           (verona.ide:close-buffer store id "file")
           (let ((restored (verona.ide:read-source store id path)))
             (is (equal "disk" (verona.ide:source-text restored)))
             (is (> (verona.ide:source-revision restored) (verona.ide:source-revision overlay)))))
      (delete-file path))))


(test ide-edits-do-not-evaluate-imports
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (main (verona.ide:open-buffer store id "main" "main" :module "main"))
         (pending (verona.ide:begin-request store id main))
         (import (verona.ide:open-buffer store id "import" "import" :module "import")))
    (verona.ide:edit-buffer store id "import" "changed import")
    (is (eq :pending (verona.ide:request-status pending)))
    (is (eq :complete (verona.ide:publish-result store id pending :evaluated)))
    (is (eq :current (nth-value 1 (verona.ide:query-result store id (verona.ide:source-id main)))))
    (is (eq :unsubmitted (getf (verona.ide:source-state store id (verona.ide:source-id import)) :status)))
    (let ((request (verona.ide:begin-request store id main)))
      (verona.ide:record-dependencies store id request
        (list (list :kind :import :target (list "import" (verona.ide:source-id import)))))
      (verona.ide:publish-result store id request :evaluated))
    ;; Import evaluation, rather than an import edit, changes analysis state.
    (verona.ide:begin-request store id import)
    (is (eq :stale (nth-value 1 (verona.ide:query-result store id (verona.ide:source-id main)))))
    (let ((request (verona.ide:begin-request store id main)))
      (verona.ide:reset-session store id)
      (signals error (verona.ide:publish-result store id request :obsolete)))
    (let ((text (verona.ide:source-text main)))
      (setf (char text 0) #\X)
      (is (equal "main" (verona.ide:source-text main))))
    (verona.ide:attach-session store id "live")
    (is (null (verona.ide:expire-sessions store :max-idle-seconds 0)))
    (verona.ide:detach-session store id "live")
    (is (equal (list id) (verona.ide:expire-sessions store :max-idle-seconds 0)))
    (is (null (verona.ide:find-session store id)))))

(test ide-current-evaluation-revision
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "main" "valid" :module "main"))
         (key (verona.ide:source-id source))
         (initial-revision (verona.ide:source-revision source)))
    (is (eq :unsubmitted (getf (verona.ide:source-state store id key) :status)))
    (let ((request (verona.ide:begin-request store id source)))
      (is (equal id (verona.ide:request-session-id request)))
      (is (eq :pending (getf (verona.ide:source-state store id key) :status)))
      (is (null (getf (verona.ide:source-state store id key) :successful-revision)))
      (verona.ide:publish-result store id request :valid))
    (let* ((edit (verona.ide:edit-buffer store id "main" "invalid"))
           (request (verona.ide:begin-request store id edit)))
      (verona.ide:publish-result store id request nil :failed t)
      (let ((state (verona.ide:source-state store id key)))
        (is (= (verona.ide:source-revision edit) (getf state :current-revision)))
        (is (= (verona.ide:source-revision edit) (getf state :submitted-revision)))
        (is (null (getf state :successful-revision)))
        (is (eq :failed (getf state :status))))
      (multiple-value-bind (result status) (verona.ide:query-result store id key)
        (is (equal id (verona.ide:result-session-id result)))
        (is (> (verona.ide:result-source-revision result) initial-revision))
        (is (null (verona.ide:result-value result)))
        (is (eq :current status))))))

(test ide-configuration-ownership
  (uiop:with-temporary-file (:pathname project-file)
    (let* ((store (verona.ide:make-session-store))
           (root (uiop:pathname-directory-pathname project-file))
           (config (verona.ide:make-configuration :target '(:pointer-width 64)))
           (id (verona.ide:create-session store config))
           (other-project (verona.ide:create-session store
                            (verona.ide:make-configuration :root root :target '(:pointer-width 64))))
           (other-config (verona.ide:create-session store
                           (verona.ide:make-configuration :target '(:pointer-width 64)
                                                         :reader-features '("feature"))))
           (source (verona.ide:open-buffer store id "same-buffer" "one"))
           (other (verona.ide:open-buffer store other-project "same-buffer" "two")))
      (is (not (equal id other-project)))
      (is (not (equal id other-config)))
      (signals error (verona.ide:begin-request store other-project source))
      (is (equal "two" (verona.ide:source-text other)))
      (signals error (verona.ide:configure-session store id
                       (verona.ide:make-configuration :target '(:pointer-width 64)
                                                     :reader-features '("feature"))))
      (signals error (verona.ide:configure-session store id
                       (verona.ide:make-configuration :target '(:pointer-width 32))))
      (signals error (verona.ide:configure-session store id
                       (verona.ide:make-configuration :root root)))
      ;; A caller-owned configuration cannot mutate the stored identity.
      (setf (second (verona.ide:configuration-target config)) 32)
      (is (= 64 (getf (verona.ide:configuration-target
                       (getf (verona.ide:inspect-session store id) :configuration)) :pointer-width)))
      (let ((request (verona.ide:begin-request store id source)))
        (is (= 2 (verona.ide:configure-session store id
                   (verona.ide:make-configuration :target '(:pointer-width 64)
                                                 :reader-features '("updated")))))
        (is (= 2 (verona.ide:configure-session store id
                   (verona.ide:make-configuration :target '(:pointer-width 64)
                                                 :reader-features '("updated")))))
        (is (eq :stale (verona.ide:publish-result store id request :old)))
        (let ((fresh (verona.ide:begin-request store id source)))
          (is (= 2 (verona.ide:request-configuration-revision fresh)))
          (is (eq :complete (verona.ide:publish-result store id fresh :new)))))
      (is (equal other-config (verona.ide:create-session store
                                (verona.ide:make-configuration :target '(:pointer-width 64)
                                                              :reader-features '("feature"))))))))

(test ide-save-rename-and-build-revisions
  (uiop:with-temporary-file (:pathname path :stream stream :keep t)
    (write-string "saved" stream) (finish-output stream)
    (unwind-protect
         (let* ((store (verona.ide:make-session-store))
                (id (verona.ide:create-session store (verona.ide:make-configuration)))
                (source (verona.ide:open-buffer store id "unnamed" "saved" :module "main"))
                (saved (verona.ide:save-buffer store id "unnamed" :path path))
                (key (verona.ide:source-id saved)))
           (is (not (equal key (verona.ide:source-id source))))
           (is (equal "main" (verona.ide:source-module saved)))
           (is (> (verona.ide:source-revision saved) (verona.ide:source-revision source)))
           (is (eq saved (verona.ide:save-buffer store id "unnamed")))
           (let* ((inputs (verona.ide:build-inputs store id))
                  (disk (first (getf inputs :sources))))
             (is (equal id (getf inputs :session-id)))
             (is (= 1 (getf inputs :configuration-revision)))
             (is (= (verona.ide:source-revision saved) (getf disk :revision)))
             (verona.ide:edit-buffer store id "unnamed" "unsaved")
             (signals error (verona.ide:save-buffer store id "unnamed"))
             (signals error (verona.ide:build-inputs store id))
             (let* ((ignored (verona.ide:build-inputs store id :unsaved-buffers :ignore))
                    (ignored-source (first (getf ignored :sources))))
               (is (equal "saved" (getf ignored-source :contents)))
               (is (= (getf disk :revision) (getf ignored-source :revision))))
             (with-open-file (out path :direction :output :if-exists :supersede)
               (write-string "changed on disk" out))
             (let ((changed (first (getf (verona.ide:build-inputs store id :unsaved-buffers :ignore)
                                        :sources))))
               (is (> (getf changed :revision) (getf disk :revision)))
               (is (equal "saved" (getf disk :contents)))
               (is (equal "unsaved" (verona.ide:source-text
                                     (verona.ide:read-source store id path))))))
           (uiop:with-temporary-file (:pathname destination)
             (let ((renamed (verona.ide:rename-buffer store id "unnamed" destination)))
               (is (not (equal key (verona.ide:source-id renamed))))
               (is (equal "main" (verona.ide:source-module renamed)))
               (is (equal "unsaved" (verona.ide:source-text renamed)))
               (is (equal "changed on disk" (verona.ide:source-text
                                              (verona.ide:read-source store id path)))))))
      (delete-file path))))

(test ide-build-includes-explicit-unopened-inputs
  (uiop:with-temporary-file (:pathname path :stream stream)
    (write-string "input" stream) (finish-output stream)
    (let* ((store (verona.ide:make-session-store))
           (id (verona.ide:create-session store (verona.ide:make-configuration)))
           (first (verona.ide:build-inputs store id :paths (list path)))
           (again (verona.ide:build-inputs store id :paths (list path))))
      (is (= 1 (length (getf first :sources))))
      (is (= (getf (first (getf first :sources)) :revision)
             (getf (first (getf again :sources)) :revision)))
      (is (equal "input" (getf (first (getf first :sources)) :contents))))))


#+sb-thread
(test ide-serializes-concurrent-session-updates
  (let* ((store (verona.ide:make-session-store))
         (configuration (verona.ide:make-configuration))
         (id (verona.ide:create-session store configuration))
         (source (verona.ide:open-buffer store id "buffer" "initial"))
         (initial-revision (verona.ide:source-revision source))
         (threads (loop repeat 12
                        collect (sb-thread:make-thread
                                 (lambda ()
                                   (list (verona.ide:create-session store configuration)
                                         (verona.ide:edit-buffer store id "buffer" "edit"))))))
         (values (mapcar #'sb-thread:join-thread threads)))
    (is (every (lambda (value) (equal id (first value))) values))
    (is (every (lambda (value) (eq source (second value))) values))
    (is (= (+ initial-revision 12) (verona.ide:source-revision source)))
    (is (eq :unsubmitted (getf (verona.ide:source-state store id (verona.ide:source-id source))
                               :status)))))

(test ide-configuration-results-and-close-requests
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "buffer" "source"))
         (request (verona.ide:begin-request store id source)))
    (verona.ide:publish-result store id request :before)
    (verona.ide:configure-session store id (verona.ide:make-configuration :reader-features '("new")))
    (multiple-value-bind (result status)
        (verona.ide:query-result store id (verona.ide:source-id source))
      (is (eq :stale status))
      (is (= 1 (verona.ide:result-configuration-revision result)))
      (is (eq :before (verona.ide:result-value result))))
    (let ((pending (verona.ide:begin-request store id source)))
      (verona.ide:close-session store id)
      (is (eq :stale (verona.ide:request-status pending)))
      (signals error (verona.ide:publish-result store id pending :late))
      (signals error (verona.ide:begin-request store id source))
      (signals error (verona.ide:query-result store id (verona.ide:source-id source))))))


(test ide-replaces-contents-without-changing-evaluation
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "buffer" "first"))
         (key (verona.ide:source-id source))
         (request (verona.ide:begin-request store id source))
         (evaluated-revision (verona.ide:request-source-revision request)))
    (is (equal "first" (verona.ide:request-text request)))
    (is (eq source (verona.ide:edit-buffer store id "buffer" "second")))
    (is (equal "second" (verona.ide:source-text source)))
    (is (equal "first" (verona.ide:request-text request)))
    (is (eq :pending (verona.ide:request-status request)))
    (is (eq :complete (verona.ide:publish-result store id request :first)))
    (is (null (verona.ide:request-text request)))
    (multiple-value-bind (result status) (verona.ide:query-result store id key)
      (is (eq :current status))
      (is (= evaluated-revision (verona.ide:result-source-revision result))))
    (verona.ide:edit-buffer store id "buffer" "third")
    (let ((state (verona.ide:source-state store id key)))
      (is (= evaluated-revision (getf state :submitted-revision)))
      (is (null (getf state :successful-revision)))
      (is (eq :complete (getf state :status))))
    (is (eq :current (nth-value 1 (verona.ide:query-result store id key))))
    (let ((next (verona.ide:begin-request store id source)))
      (is (equal "third" (verona.ide:request-text next)))
      (is (eq :missing (nth-value 1 (verona.ide:query-result store id key))))
      (is (eq :complete (verona.ide:publish-result store id next :third))))))


(test ide-file-refresh-and-buffer-lifecycle-do-not-evaluate
  (uiop:with-temporary-file (:pathname path :stream stream :keep t)
    (write-string "original" stream) (finish-output stream)
    (unwind-protect
         (let* ((store (verona.ide:make-session-store))
                (id (verona.ide:create-session store (verona.ide:make-configuration)))
                (source (verona.ide:read-source store id path))
                (key (verona.ide:source-id source))
                (request (verona.ide:begin-request store id source))
                (revision (verona.ide:request-source-revision request)))
           (verona.ide:publish-result store id request :original)
           (with-open-file (out path :direction :output :if-exists :supersede)
             (write-string "updated" out))
           (is (eq source (verona.ide:read-source store id path)))
           (is (equal "updated" (verona.ide:source-text source)))
           (is (eq :current (nth-value 1 (verona.ide:query-result store id key))))
           (verona.ide:open-buffer store id "file" "updated" :path path)
           (verona.ide:save-buffer store id "file")
           (uiop:with-temporary-file (:pathname destination)
             (verona.ide:rename-buffer store id "file" destination)
             (verona.ide:close-buffer store id "file"))
           (is (eq :current (nth-value 1 (verona.ide:query-result store id key))))
           (is (= revision (getf (verona.ide:source-state store id key) :submitted-revision)))
           (is (null (getf (verona.ide:source-state store id key) :successful-revision))))
      (delete-file path))))


(test ide-module-products-and-replacement
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "module" "first" :module "main"))
         (key (verona.ide:source-id source))
         (request (verona.ide:begin-request store id source)))
    (is (eq :pending (getf (verona.ide:module-state store id key) :status)))
    (signals error (verona.ide:record-phase store id request :resolution))
    (signals error (verona.ide:record-phase store id request :reading :products '(:types bad)))
    (verona.ide:record-phase store id request :reading :products '(:syntax (source-aware)))
    (signals error (verona.ide:publish-result store id request :premature))
    (verona.ide:record-phase store id request :expansion
                             :products '(:expanded-forms (expanded) :macros (old-macro) :bindings (old-binding)))
    (verona.ide:record-phase store id request :declarations
                             :products '(:declarations (old-definition) :imports (base) :exports (old-definition)))
    (verona.ide:record-phase store id request :resolution :products '(:resolved-definitions (resolved)))
    (verona.ide:record-phase store id request :type-checking :products '(:types (integer)))
    (signals error (verona.ide:record-phase store id request nil))
    (verona.ide:publish-result store id request :old)
    (let* ((state (verona.ide:module-state store id key))
           (macros (getf (getf state :products) :macros)))
      (is (= 5 (length (getf state :completed-phases))))
      (is (equal (getf state :identity) (getf macros :module)))
      (is (equal '(old-macro) (getf macros :definitions))))
    (verona.ide:edit-buffer store id "module" "second")
    (is (eq :complete (getf (verona.ide:module-state store id key) :status)))
    (let ((next (verona.ide:begin-request store id source)))
      (is (null (getf (verona.ide:module-state store id key) :products)))
      (is (null (verona.ide:query-result store id key)))
      (verona.ide:record-phase store id next :reading :products '(:syntax (new)))
      (verona.ide:record-phase store id next :expansion :failed t
                               :products '(:expanded-forms (partial)) :diagnostics '((:message "bad macro")))
      (let* ((state (verona.ide:module-state store id key)) (products (getf state :products)))
        (is (eq :failed (getf state :status)))
        (is (eq :expansion (getf state :failed-phase)))
        (is (equal '(:reading) (getf state :completed-phases)))
        (is (equal '(partial) (getf products :expanded-forms)))
        (is (null (getf products :declarations)))
        (is (null (getf products :macros)))
        (is (null (getf products :types)))
        (is (= 1 (length (getf state :diagnostics)))))
      (is (null (verona.ide:request-text next)))
      (is (eq :failed (verona.ide:publish-result store id next :late))))))

(test ide-module-identity-and-supersession
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (a (verona.ide:open-buffer store id "a" "a" :path "first.vrn" :module "same"))
         (b (verona.ide:open-buffer store id "b" "b" :path "second.vrn" :module "same"))
         (ka (verona.ide:source-id a)) (kb (verona.ide:source-id b))
         (old (verona.ide:begin-request store id a)))
    (verona.ide:record-phase store id old :reading :products '(:syntax (old)))
    (let ((next (verona.ide:begin-request store id a)))
      (is (eq :stale (verona.ide:record-phase store id old :expansion)))
      (is (eq :stale (verona.ide:publish-result store id old :old)))
      (is (null (getf (verona.ide:module-state store id ka) :products)))
      (verona.ide:publish-result store id next :new))
    (verona.ide:edit-buffer store id "b" "changed")
    (is (eq :complete (getf (verona.ide:module-state store id ka) :status)))
    (verona.ide:begin-request store id b)
    (let ((sa (verona.ide:module-state store id ka)) (sb (verona.ide:module-state store id kb)))
      (is (not (equal (getf sa :identity) (getf sb :identity))))
      (is (equal (truename (uiop:getcwd)) (uiop:pathname-directory-pathname (getf sa :source-path))))
      (is (eq :complete (getf sa :status)))
      (is (eq :pending (getf sb :status))))
    (verona.ide:reset-session store id)
    (is (null (verona.ide:module-state store id ka)))))

(test ide-module-cancellation-progress-and-diagnostics
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "buffer" "text"))
         (key (verona.ide:source-id source))
         (request (verona.ide:begin-request store id source)))
    (verona.ide:record-phase store id request :reading :complete nil
                             :products '(:syntax (partial)) :diagnostics '((:warning "current")))
    (let ((state (verona.ide:module-state store id key)))
      (is (eq :processing (getf state :status)))
      (is (null (getf state :completed-phases)))
      ;; Returned list and string data cannot mutate the session.
      (setf (getf (getf state :products) :syntax) '(changed))
      (is (equal '(partial) (getf (getf (verona.ide:module-state store id key) :products) :syntax))))
    (verona.ide:cancel-request store id request)
    (is (eq :cancelled (getf (verona.ide:module-state store id key) :status)))
    (is (eq :cancelled (verona.ide:record-phase store id request :reading)))
    (let ((next (verona.ide:begin-request store id source)))
      (is (null (getf (verona.ide:module-state store id key) :diagnostics)))
      (verona.ide:publish-result store id next :partial :failed t :diagnostics '((:error "new")))
      (is (eq :partial (verona.ide:result-value (verona.ide:query-result store id key))))
      (let ((state (verona.ide:module-state store id key)))
        (is (eq :failed (getf state :status)))
        (is (= 1 (length (getf state :diagnostics))))))))

(defun ide-test-evaluate (store id source edges)
  (let ((request (verona.ide:begin-request store id source)))
    (verona.ide:record-dependencies store id request edges)
    (dolist (phase verona.ide::+module-phases+)
      (verona.ide:record-phase store id request phase))
    (verona.ide:publish-result store id request :ok)
    request))

(test ide-dependency-selection-replacement-and-failure
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (a (verona.ide:open-buffer store id "a" "a" :module "same"))
         (b (verona.ide:open-buffer store id "b" "b" :module "same"))
         (c (verona.ide:open-buffer store id "c" "c"))
         (u (verona.ide:open-buffer store id "u" "unrelated"))
         (ka (list "same" (verona.ide:source-id a)))
         (kb (list "same" (verona.ide:source-id b)))
         (kc (list (verona.ide:source-id c) (verona.ide:source-id c))))
    (ide-test-evaluate store id a nil)
    (ide-test-evaluate store id b (list (list :kind :import :target ka :alias "a" :selected '(foo))))
    (ide-test-evaluate store id c (list (list :kind :semantic :target kb :from 'caller :to 'gone :location '(:line 4))))
    (ide-test-evaluate store id u nil)
    (is (getf (verona.ide:dependency-graph store id kc :transitive t) :complete))
    (is (= 2 (length (getf (verona.ide:dependency-graph store id ka :direction :dependents :transitive t) :edges))))
    (verona.ide:edit-buffer store id "a" "edited")
    (is (eq :current (nth-value 1 (verona.ide:query-result store id (verona.ide:source-id c)))))
    (let ((request (verona.ide:begin-request store id a)))
      (verona.ide:record-phase store id request :reading)
      (verona.ide:record-phase store id request :expansion :failed t))
    (dolist (source (list b c))
      (is (eq :needs-evaluation (getf (verona.ide:module-state store id (verona.ide:source-id source)) :status)))
      (is (getf (verona.ide:module-state store id (verona.ide:source-id source)) :needs-evaluation-reasons))
      (is (eq :stale (nth-value 1 (verona.ide:query-result store id (verona.ide:source-id source))))))
    (is (eq :current (nth-value 1 (verona.ide:query-result store id (verona.ide:source-id u)))))
    (is (not (getf (verona.ide:dependency-graph store id ka) :complete)))
    ;; Incoming references to removed definitions survive replacement.
    (is (= 1 (length (getf (verona.ide:dependency-graph store id kb :definition 'gone :level :definition :direction :dependents) :edges))))
    (ide-test-evaluate store id b nil)
    (is (null (getf (verona.ide:dependency-graph store id ka :direction :dependents) :edges)))
    (is (= 1 (length (getf (verona.ide:dependency-graph store id kb :direction :dependents) :edges))))
    (ide-test-evaluate store id c nil)
    (is (null (getf (verona.ide:dependency-graph store id kb :direction :dependents) :edges)))))

(test ide-dependency-kinds-unresolved-cycles-and-supersession
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (a (verona.ide:open-buffer store id "a" "a" :module "a"))
         (b (verona.ide:open-buffer store id "b" "b" :module "b"))
         (ka (list "a" (verona.ide:source-id a)))
         (kb (list "b" (verona.ide:source-id b)))
         (request (verona.ide:begin-request store id a)))
    (signals error (verona.ide:record-dependencies store id request
                    (list (list :kind :import :target kb) (list :kind :bad :target kb))))
    (is (null (getf (verona.ide:dependency-graph store id ka) :edges)))
    (verona.ide:record-dependencies store id request
      (loop for kind in '(:macro :binding :expanded :semantic :import)
            collect (list :kind kind :target kb :from 'f :to 'g
                          :location '(:line 3) :unresolved t :lookup-context '(:scope "a"))))
    (verona.ide:publish-result store id request :partial :failed t)
    (is (= 5 (length (getf (verona.ide:dependency-graph store id ka) :edges))))
    (is (null (verona.ide:dependency-cycles store id)))
    ;; First evaluation of a formerly absent module recognizes unresolved users.
    (ide-test-evaluate store id b (list (list :kind :semantic :target ka :from 'g :to 'f)))
    (is (eq :needs-evaluation (getf (verona.ide:module-state store id (verona.ide:source-id a)) :status)))
    (let ((old (verona.ide:begin-request store id a)))
      (ide-test-evaluate store id a (list (list :kind :semantic :target kb :from 'f :to 'g)))
      (is (eq :stale (verona.ide:record-dependencies store id old (list (list :kind :import :target ka)))))
      (is (= 1 (length (getf (verona.ide:dependency-graph store id ka) :edges)))))
    (is (eq :allowed (getf (first (verona.ide:dependency-cycles store id :level :definition)) :status)))
    (is (= 2 (length (getf (verona.ide:dependency-graph store id ka :transitive t) :edges))))
    (ide-test-evaluate store id a (list (list :kind :semantic :target kb :from 'f :to 'g :cycle-policy :forbidden :location '(:line 8))))
    (let* ((cycles (verona.ide:dependency-cycles store id)) (copy (getf (first cycles) :edges)))
      (is (eq :invalid (getf (first cycles) :status)))
      (setf (getf (first copy) :target) '(changed))
      (is (not (equal '(changed) (getf (first (getf (verona.ide:dependency-graph store id ka) :edges)) :target)))))
    (verona.ide:reset-session store id)
    (is (null (getf (verona.ide:dependency-graph store id ka) :edges)))
    (is (null (verona.ide:dependency-cycles store id)))))

