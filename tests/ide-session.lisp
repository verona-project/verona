         (key (list "scope" (verona.ide:source-id source)))
         (position (search "x))" text)))
    (verona.ide:evaluate-module store id source)
    (let* ((target (first (getf (verona.ide:go-to-definition store id key position) :items)))
           (completion (verona.ide:complete-names store id key position :prefix "x"))
           (references (verona.ide:find-references store id (getf target :id))))
      (is (eq :local (getf target :kind)))
      (is (= 1 (getf completion :total)))
      (is (= 2 (getf references :total)))
      (is (eq :found (getf references :status)))
      (let ((global (first (getf (verona.ide:find-definitions store id "x") :items))))
        (is (= 1 (getf (verona.ide:find-references store id (getf global :id)) :total))))
      (is (zerop (getf (verona.ide:complete-names store id key position :prefix "X") :total)))
      (is (= 1 (getf (verona.ide:complete-names store id key position :prefix "x"
                       :expected-type (getf target :type)) :total))))
    (verona.ide:edit-buffer store id "scope" "(function broken ((arg i32)) i32 missing)")
    (verona.ide:evaluate-module store id source)
    (let* ((position (search "missing" (verona.ide:source-text source)))
           (completion (verona.ide:complete-names store id key position :prefix "arg")))
      (is (eq :failed (getf (verona.ide:inspect-module store id key) :status)))
      (is (= 1 (getf completion :total)))
      (is (not (eq :complete (getf completion :availability))))
      (is (eq :unresolved (getf (verona.ide:find-definitions store id "x") :status))))))

