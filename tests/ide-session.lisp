(test ide-navigation-related-and-signatures
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (text "(generic echo (x)) (implementation echo ((x i32)) i32 x)
                (implementation echo ((x i64)) i64 x) (function f () i32 (echo 1))
                (macro keep (x) x) (keep (constant made i32 0))")
         (source (verona.ide:open-buffer store id "related" text :module "related"))
         (key (list "related" (verona.ide:source-id source))))
    (verona.ide:evaluate-module store id source)
    (let* ((generic (first (getf (verona.ide:list-definitions store id :kind :generic) :items)))
           (related (verona.ide:related-definitions store id (getf generic :id)))
           (implementation (first (getf related :items)))
           (signature (verona.ide:signature-help store id key (+ 5 (search "echo 1" text)))))
      (is (= 2 (getf related :total)))
      (is (= 2 (length (getf signature :signatures))))
      (is (plusp (getf (verona.ide:related-definitions store id (getf implementation :id)) :total))))
    (let* ((made (first (getf (verona.ide:find-definitions store id "made") :items)))
           (origin (verona.ide:related-definitions store id (getf made :id))))
      (is (getf origin :expansion-origins)))
