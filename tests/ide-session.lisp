     (let* ((directory (first (verona::compiler-search-paths compiler)))
            (store (verona.ide:make-session-store))
            (id (verona.ide:create-session store
                  (verona.ide:make-configuration :root directory)))
            (root (merge-pathnames "root.vrn" directory))
            (library (merge-pathnames "library.vrn" directory))
            (compiled (compile-file compiler root))
            (request (verona.ide:evaluate-module store id root))
            (result (verona.ide:query-result store id (namestring (truename root)))))
       (is (eq :complete (verona.ide:request-status request)))
       (is (equal (mapcar (lambda (d) (verona-name-value (declaration-name d)))
                          (module-declarations compiled))
                  (mapcar (lambda (d) (verona-name-value (declaration-name d)))
                          (module-declarations (verona.ide:result-value result)))))
       (is (= 1 (length (getf (verona.ide:module-state store id (namestring (truename root)))
                                 :dependency-environments))))
       (let ((previous (verona.ide:query-result store id (namestring (truename library)))))
         (with-open-file (stream library :direction :output :if-exists :supersede)
           (write-string "(function value () i32 missing) (export value)" stream))
         (is (eq :failed (verona.ide:request-status (verona.ide:evaluate-module store id root))))
         (is (not (eq previous (verona.ide:query-result store id (namestring (truename library))))))
         (let* ((condition (handler-case (compile-file compiler root)
                             (verona:user-compilation-error (c) c)))
                (expected (verona:diagnostic-for-condition condition))
                (actual (first (getf (verona.ide:module-state store id (namestring (truename library)))
                                     :diagnostics))))
           (is (string= (verona:diagnostic-code expected) (verona:diagnostic-code actual)))
           (is (= (verona:source-location-offset
                   (verona:source-range-start (verona:diagnostic-primary-location expected)))
                  (verona:source-location-offset
                   (verona:source-range-start (verona:diagnostic-primary-location actual)))))))))))

