(test ide-analysis-cancellation-snapshot-and-supersession
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (dependency (verona.ide:open-buffer store id "dependency"
                       "(function value () i32 1) (export value)" :path "ide-dependency.vrn"))
         (source (verona.ide:open-buffer store id "selected"
                   "(import ide-dependency) (function value () i32 (ide-dependency:value))"
                   :path "ide-selected.vrn"))
         (request (verona.ide:begin-request store id source))
         (edited nil))
    (verona.ide:evaluate-request store id request
      :progress (lambda (current phase)
                  (when (and (eq current request) (eq phase :reading))
                    (setf edited t)
                    (verona.ide:edit-buffer store id "dependency" "invalid")
                    (verona.ide:edit-buffer store id "selected" "invalid"))))
    (is-true edited)
    (is (eq :complete (verona.ide:request-status request)))
    (is (< (getf (verona.ide:module-state store id (verona.ide:source-id dependency)) :source-revision)
           (verona.ide:source-revision dependency)))
    (verona.ide:edit-buffer store id "selected" "(function value () i32 1)")
    (let ((cancelled (verona.ide:begin-request store id source)))
      (verona.ide:evaluate-request store id cancelled
        :progress (lambda (current phase)
                    (when (eq phase :reading) (verona.ide:cancel-request store id current))))
      (is (eq :cancelled (verona.ide:request-status cancelled)))
      (is (null (verona.ide:request-text cancelled)))
      (is (null (verona.ide:query-result store id (verona.ide:source-id source)))))
    (let ((old (verona.ide:begin-request store id source)) (new nil))
      (verona.ide:evaluate-request store id old
        :progress (lambda (current phase)
                    (declare (ignore current))
                    (when (eq phase :reading)
                      (setf new (verona.ide:begin-request store id source)))))
      (is (eq :stale (verona.ide:request-status old)))
      (is (eq :pending (verona.ide:request-status new)))
      (is (null (getf (verona.ide:module-state store id (verona.ide:source-id source)) :products))))))

