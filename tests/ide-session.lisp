        (list (list :kind :semantic :target a :from "g" :to "f")
              (list :kind :import :target c :from "g" :to "h" :cycle-policy :forbidden)))
      (ide-test-evaluate store id (third sources)
        (list (list :kind :semantic :target b :from "h" :to "g")
              (list :kind :semantic :target exit :from "h" :to "done")
              (list :kind :semantic :target d :from "h" :to "self"
                    :unresolved t :lookup-context c)))
      (ide-test-evaluate store id (fourth sources)
        (list (list :kind :semantic :target d :from "self" :to "self")
              (list :kind :semantic :target c :from "self" :to "h")))
      (ide-test-evaluate store id (fifth sources) nil)
      (dolist (level '(:module :definition))
        (multiple-value-bind (components completeness) (verona.ide:dependency-cycles store id :level level)
          (is (= 2 (length components)))
          (let ((invalid (find :invalid components :key (lambda (component) (getf component :status))))
                (allowed (find :allowed components :key (lambda (component) (getf component :status)))))
            (is (= 3 (length (getf invalid :nodes))))
            (is (= 5 (length (getf invalid :edges))))
            (is (= 1 (length (getf allowed :nodes))))
            (is (= 1 (length (getf allowed :edges))))
            (is (equal '(1 2) (sort (loop for edge in (getf invalid :edges)
                                         when (getf edge :location) collect (getf (getf edge :location) :line)) #'<))))
          (is (not (getf completeness :complete)))
          (is (member c (getf completeness :incomplete-modules) :test #'equal))))
      ;; The unresolved edge did not join D to the other component. Once it
      ;; becomes a resolved edge, all four nodes belong to a single component.
      (ide-test-evaluate store id (third sources)
        (list (list :kind :semantic :target b :from "h" :to "g")
              (list :kind :semantic :target d :from "h" :to "self")))
      (multiple-value-bind (components completeness) (verona.ide:dependency-cycles store id)
        (is (= 1 (length components)))
        (is (= 4 (length (getf (first components) :nodes))))
        (is (eq :invalid (getf (first components) :status)))
        (is (getf completeness :complete))
        (is (null (getf completeness :incomplete-modules)))))))

(test ide-cycle-query-reports-incomplete-and-isolates-its-snapshot
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "pending" "" :module "pending"))
         (key (list "pending" (verona.ide:source-id source)))
         (missing '("missing" "/missing.vrn"))
         (request (verona.ide:begin-request store id source)))
    (verona.ide:record-dependencies store id request
      (list (list :kind :import :target missing :unresolved t :lookup-context key)))
    (multiple-value-bind (cycles completeness) (verona.ide:dependency-cycles store id)
      (is (null cycles))
      (is (not (getf completeness :complete)))
      (is (member key (getf completeness :incomplete-modules) :test #'equal))
      (is (member missing (getf completeness :incomplete-modules) :test #'equal))
      (setf (getf completeness :incomplete-modules) nil))
    (verona.ide:cancel-request store id request)
    (is (not (getf (nth-value 1 (verona.ide:dependency-cycles store id)) :complete)))
    (ide-test-evaluate store id source (list (list :kind :semantic :target key :location '(:line 7))))
    (multiple-value-bind (cycles completeness) (verona.ide:dependency-cycles store id)
      (is (getf completeness :complete))
      (setf (char (first (first (first (getf (first cycles) :nodes)))) 0) #\X)
      (setf (getf (first (getf (first cycles) :edges)) :location) '(:line 99)))
    (let ((cycles (verona.ide:dependency-cycles store id)))
      (is (equal key (first (first (getf (first cycles) :nodes)))))
      (is (equal '(:line 7) (getf (first (getf (first cycles) :edges)) :location))))
    (verona.ide:reset-session store id)
    (multiple-value-bind (cycles completeness) (verona.ide:dependency-cycles store id)
      (is (null cycles))
      (is (getf completeness :complete)))))

(test ide-cycle-query-scales-on-branching-acyclic-graphs
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (count 80)
         (sources (loop for i below count collect
                    (verona.ide:open-buffer store id i "" :module (format nil "node-~D" i))))
         (keys (mapcar (lambda (source) (list (verona.ide:source-module source)
                                            (verona.ide:source-id source))) sources)))
    ;; Edges to i+1 and i+2 create exponentially many paths but only O(N)
    ;; nodes and edges. Query the public API without a timing-based assertion.
    (loop for source in sources for i from 0 do
      (ide-test-evaluate store id source
        (loop for next in (list (1+ i) (+ i 2)) when (< next count) collect
          (list :kind :semantic :target (nth next keys) :from "f" :to "f"))))
    (dolist (level '(:module :definition))
      (multiple-value-bind (cycles completeness) (verona.ide:dependency-cycles store id :level level)
        (is (null cycles))
        (is (getf completeness :complete))))
    ;; Closing the graph joins every node into one SCC without enumerating
    ;; its exponentially many elementary cycles.
    (ide-test-evaluate store id (car (last sources))
      (list (list :kind :semantic :target (first keys) :from "f" :to "f" :cycle-policy :forbidden)))
    (let ((components (verona.ide:dependency-cycles store id :level :definition)))
      (is (= 1 (length components)))
      (is (= count (length (getf (first components) :nodes))))
      (is (= (- (* 2 count) 2) (length (getf (first components) :edges))))
      (is (eq :invalid (getf (first components) :status))))))

(test ide-cycle-components-handle-deep-graphs-without-recursion
  ;; Exercise traversal directly so request bookkeeping is not part of this
  ;; regression for the cycle algorithm's own stack and memory usage.
  (let* ((count 20000)
         (keys (loop for i below count collect (list "chain" i)))
         (edges (loop for tail on keys while (cdr tail) collect
                  (list :module (first tail) :target (second tail) :kind :semantic))))
    (is (null (verona.ide::cyclic-components edges :module)))
    (push (list :module (car (last keys)) :target (first keys) :kind :semantic) edges)
    (let ((components (verona.ide::cyclic-components edges :module)))
      (is (= 1 (length components)))
      (is (= count (length (getf (first components) :nodes))))
      (is (= count (length (getf (first components) :edges)))))))

(test ide-module-query-contract
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (a (verona.ide:open-buffer store id "qa" "" :module "same"))
         (b (verona.ide:open-buffer store id "qb" "" :module "same"))
         (ak (list "same" (verona.ide:source-id a)))
         (bk (list "same" (verona.ide:source-id b))))
    (is (= 2 (getf (verona.ide:list-modules store id :name "SAM") :total)))
    (is (= 1 (length (getf (verona.ide:list-modules store id :limit 1) :items))))
    (is (= 1 (getf (verona.ide:list-modules store id :limit 1) :next-offset)))
    (is (null (getf (verona.ide:list-modules store id :offset 10) :items)))
    (signals error (verona.ide:list-modules store id :limit 0))
    (is (eq :unevaluated (getf (verona.ide:inspect-module store id ak) :status)))
    (is (eq :unavailable (getf (verona.ide:module-contents store id ak) :availability)))
    (let ((r (verona.ide:begin-request store id a)))
      (is (eq :pending (getf (verona.ide:inspect-module store id ak) :status)))
      (verona.ide:record-phase store id r :reading)
      (verona.ide:record-phase store id r :expansion)
      (verona.ide:record-phase store id r :declarations :complete nil
                               :products '(:declarations ((:name "z") (:name "a")))
                               :diagnostics (list (verona:make-diagnostic :severity :warning :message "current")))
      (let* ((contents (verona.ide:module-contents store id ak :limit 1))
             (item (first (getf contents :items))))
        (is (eq :partial (getf contents :availability)))
        (is (equal "a" (getf item :name)))
        (setf (char (getf item :name) 0) #\X)
        (is (= 1 (getf (verona.ide:module-contents store id ak :name "a") :total))))
      (verona.ide:record-dependencies store id r (list (list :kind :import :target bk)))
      (is (= 1 (getf (verona.ide:module-relationships store id ak) :total)))
      (is (null (getf (verona.ide:module-relationships store id ak) :complete)))
      (is (= 1 (getf (verona.ide:module-relationships store id bk :direction :dependents :transitive t) :total)))
      (verona.ide:publish-result store id r nil :failed t)
      (let ((diagnostics (verona.ide:module-diagnostics store id ak :severity :warning)))
        (is (= 1 (getf diagnostics :total)))
        (is (eq :declarations (getf (first (getf diagnostics :items)) :phase))))
      (is (eq :failed (getf (verona.ide:inspect-module store id ak) :status))))
    (verona.ide:begin-request store id b)
    (is (getf (verona.ide:inspect-module store id ak) :needs-evaluation-p))
    (is (getf (verona.ide:inspect-module store id ak) :needs-evaluation-reasons))
    (verona.ide:begin-request store id a)
    (is (zerop (getf (verona.ide:module-diagnostics store id ak) :total)))
    (is (eq :unavailable (getf (verona.ide:module-contents store id ak) :availability)))))

