         (source (verona.ide:open-buffer store id "empty-nav" "" :module "empty-nav"))
         (key (list "empty-nav" (verona.ide:source-id source)))
         (before (verona.ide:module-state store id (verona.ide:source-id source)))
         (completion (verona.ide:complete-names store id key 0 :prefix "fun")))
    (is (eq :unavailable (getf completion :availability)))
    (is (equal "function" (getf (first (getf completion :items)) :insertion-text)))
    (is (null (getf (first (getf completion :items)) :replacement-range)))
    (is (eq :unresolved (getf (verona.ide:go-to-definition store id key 0) :status)))
    (is (eq :unavailable (getf (verona.ide:signature-help store id key 0) :signature-availability)))
    (is (equalp before (verona.ide:module-state store id (verona.ide:source-id source))))
    (verona.ide:edit-buffer store id "empty-nav" "(function value () i32 1)")
    (verona.ide:evaluate-module store id source)
    (let* ((before (verona.ide:module-state store id (verona.ide:source-id source)))
           (items (getf (verona.ide:complete-names store id key 0 :prefix "value") :items))
           (identifier (getf (first items) :id)))
      (setf (char (getf (first items) :name) 0) #\Z)
      (is (equal "value" (getf (first (getf (verona.ide:complete-names store id key 0 :prefix "value") :items)) :name)))
      (verona.ide:find-references store id identifier :limit 1)
      (verona.ide:related-definitions store id identifier)
      (is (equalp before (verona.ide:module-state store id (verona.ide:source-id source))))
      (signals error (verona.ide:complete-names store id key -1))
      (signals error (verona.ide:complete-names store id key 0 :limit 0)))))

(test ide-inspection-expansion-types-and-revisions
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (text "(macro keep (x) x) (keep (constant made i32 7)) (function f () i64 42)")
         (source (verona.ide:open-buffer store id "inspection" text :module "inspection"))
         (key (list "inspection" (verona.ide:source-id source)))
         (position (search "(keep (constant" text)))
    (is (eq :unavailable (getf (verona.ide:inspect-expansion store id key :offset 0) :expansion-availability)))
    (is (eq :unavailable (getf (verona.ide:type-at-position store id key 0) :status)))
    (verona.ide:evaluate-module store id source)
    (let* ((before (verona.ide:module-state store id (verona.ide:source-id source)))
           (expansion (verona.ide:inspect-expansion store id key :offset position))
           (type (verona.ide:type-at-position store id key (search "42" text)))
           (plain (verona.ide:inspect-expansion store id key :offset (search "(function" text))))
      (is (eq :found (getf expansion :status)))
      (is (equal "keep" (first (getf expansion :before))))
      (is (equal "%constant" (first (getf expansion :after))))
      (is (= 2 (length (getf expansion :steps))))
      (is (null (getf expansion :truncated-p)))
      (is (getf plain :expanded-p))
      (is (equal "%function" (first (getf plain :after))))
      (is (getf (verona.ide:inspect-expansion store id key :offset position :limit 2) :truncated-p))
      (is (eq :found (getf type :status)))
      (is (= 64 (getf (getf type :inferred-type) :width)))
      (is (equal "i64" (getf type :declared-type)))
      (is (equal "i64" (getf type :description)))
      (is (getf type :location))
      (is (equalp before (verona.ide:module-state store id (verona.ide:source-id source))))
      (setf (car (getf expansion :after)) "changed")
      (is (equal "%constant" (first (getf (verona.ide:inspect-expansion store id key :offset position) :after)))))
    (let ((definition (getf (first (getf (verona.ide:find-definitions store id "made") :items)) :id)))
      (is (eq :found (getf (verona.ide:inspect-expansion store id key :definition definition) :status)))
      (verona.ide:edit-buffer store id "inspection" "")
      (let ((expansion (verona.ide:inspect-expansion store id key :offset position))
            (type (verona.ide:type-at-position store id key (search "42" text))))
        (is (null (getf expansion :exact-p)))
        (is (null (getf expansion :location)))
        (is (getf expansion :evaluated-location))
        (is (null (getf type :location))))
      (verona.ide:evaluate-module store id source)
      (is (eq :unavailable (getf (verona.ide:inspect-expansion store id key :definition definition) :status)))
      (is (eq :unavailable (getf (verona.ide:type-at-position store id key 0) :status))))))

(test ide-inspection-diagnostics-and-generated-provenance
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (text "(macro keep (x) x) (keep (function broken () i32 missing))")
         (source (verona.ide:open-buffer store id "bad-inspection" text :module "bad-inspection"))
         (key (list "bad-inspection" (verona.ide:source-id source))))
    (verona.ide:evaluate-module store id source)
    (let* ((page (verona.ide:module-diagnostics store id key))
           (item (first (getf page :items))) (diagnostic (getf item :diagnostic))
           (definition (getf (first (getf (verona.ide:find-definitions store id "broken") :items)) :id)))
      (is (= 1 (getf page :total)))
      (is (eq :error (getf diagnostic :severity)))
      (is (stringp (getf diagnostic :code)))
      (is (stringp (getf diagnostic :message)))
      (is (getf diagnostic :location))
      (is (getf diagnostic :related-locations))
      (is (getf page :failed-phase))
      (is (= 1 (getf (verona.ide:project-diagnostics store id :definition definition :severity :error
                                            :phase (getf item :phase) :limit 1) :total)))
      (is (= 0 (getf (verona.ide:module-diagnostics store id key :severity :warning) :total)))
      (is (= 0 (getf (verona.ide:module-diagnostics store id key :phase :reading) :total)))
      (is (null (getf (verona.ide:project-diagnostics store id :offset 1) :items)))
      (is (eq :found (getf (verona.ide:inspect-expansion store id key :offset (search "(keep (function" text)) :status)))
      (verona.ide:edit-buffer store id "bad-inspection" "")
      (let ((diagnostic (getf (first (getf (verona.ide:module-diagnostics store id key) :items)) :diagnostic)))
        (is (null (getf diagnostic :location)))
        (is (getf diagnostic :evaluated-location))
        (is (every (lambda (x) (null (getf x :location))) (getf diagnostic :related-locations))))
      (verona.ide:evaluate-module store id source)
      (is (= 0 (getf (verona.ide:project-diagnostics store id) :total))))))

(test ide-inspection-expression-expansion-and-partial-types
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (text "(macro keep (x) x) (function good () i32 (keep 17)) (function bad () i32 missing)")
         (source (verona.ide:open-buffer store id "partial-inspect" text :module "partial-inspect"))
         (key (list "partial-inspect" (verona.ide:source-id source))))
    (verona.ide:evaluate-module store id source)
    (let ((type (verona.ide:type-at-position store id key (search "(keep 17" text)))
          (expansion (verona.ide:inspect-expansion store id key :offset (search "(keep 17" text))))
      (is (eq :partial (getf type :availability)))
      (is (eq :found (getf type :status)))
      (is (= 32 (getf (getf type :inferred-type) :width)))
      (is (equal '("keep" 17) (getf expansion :before)))
      (is (= 17 (getf expansion :after)))
      (is (getf expansion :steps)))
    (signals error (verona.ide:inspect-expansion store id key :offset -1))
    (signals error (verona.ide:inspect-expansion store id key :offset 0 :limit 0))
