(test ide-inspection-bounded-diagnostics-and-unexpanded-forms
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (source (verona.ide:open-buffer store id "warnings" "17" :module "warnings"))
         (key (list "warnings" (verona.ide:source-id source)))
         (request (verona.ide:begin-request store id source))
         (forms (verona:read-source (verona:make-source "<buffer warnings>" "17"))))
    (verona.ide:record-phase store id request :reading :products (list :syntax forms))
    (verona.ide:record-phase store id request :expansion :products (list :expanded-forms forms)
      :diagnostics (list (verona:make-diagnostic :severity :warning :code "W001" :message "first")
                         (verona:make-diagnostic :severity :warning :code "W002" :message "second")))
    (let* ((page (verona.ide:project-diagnostics store id :severity :warning :phase :expansion :limit 1))
           (next (verona.ide:module-diagnostics store id key :offset (getf page :next-offset) :limit 1))
           (expansion (verona.ide:inspect-expansion store id key :offset 0)))
      (is (= 2 (getf page :total)))
      (is (= 1 (getf page :next-offset)))
      (is (equal "W002" (getf (getf (first (getf next :items)) :diagnostic) :code)))
      (is (null (getf expansion :expanded-p)))
      (is (= 17 (getf expansion :before)))
      (is (= 17 (getf expansion :after)))
      (is (null (getf expansion :truncated-p))))
    (verona.ide:cancel-request store id request)))

(test ide-inspection-prerequisite-failure-and-replacement-gates
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (dependency (verona.ide:open-buffer store id "inspect-dep" "(function broken () i32 missing)"
                                            :path "ide-inspect-dep.vrn"))
         (source (verona.ide:open-buffer store id "inspect-root" "(import ide-inspect-dep)"
                                        :path "ide-inspect-root.vrn"))
         (key (list "ide-inspect-root" (verona.ide:source-id source))))
    (verona.ide:evaluate-module store id source)
    (is (plusp (getf (verona.ide:module-diagnostics store id key) :total)))
    (is (plusp (getf (verona.ide:project-diagnostics store id
                      :module (list "ide-inspect-dep" (verona.ide:source-id dependency))) :total)))
    (verona.ide:edit-buffer store id "inspect-root" "(function f () i32 4)")
    (verona.ide:evaluate-module store id source)
    (let ((request (verona.ide:begin-request store id source)))
      (is (= 0 (getf (verona.ide:module-diagnostics store id key) :total)))
      (is (eq :unavailable (getf (verona.ide:inspect-expansion store id key :offset 0) :expansion-availability)))
      (is (eq :unavailable (getf (verona.ide:type-at-position store id key 22) :status)))
      (verona.ide:evaluate-request store id request
        :progress (lambda (current phase)
                    (when (eq phase :reading) (verona.ide:cancel-request store id current))))
      (is (eq :cancelled (verona.ide:request-status request)))
      (is (null (getf (verona.ide:inspect-expansion store id key :offset 0) :after))))
    (let ((request (verona.ide:begin-request store id source)))
      (verona.ide:evaluate-request store id request
        :progress (lambda (current phase)
                    (declare (ignore current))
                    (when (eq phase :reading) (verona.ide:begin-request store id source))))
      (is (eq :stale (verona.ide:request-status request)))
      (let ((verona::*expansion-observer* (lambda (&rest args) (declare (ignore args)) (error "Query invoked macro")))
            (verona::*expression-observer* (lambda (&rest args) (declare (ignore args)) (error "Query inferred type"))))
        (is (null (getf (verona.ide:inspect-expansion store id key :offset 0) :after)))
        (is (eq :unavailable (getf (verona.ide:type-at-position store id key 0) :status)))
        (is (= 0 (getf (verona.ide:module-diagnostics store id key) :total)))))))

(test ide-inspection-selects-expansion-subtrees
  (let* ((store (verona.ide:make-session-store))
         (id (verona.ide:create-session store (verona.ide:make-configuration)))
         (text "(macro keep (x) x) (function f () i32 (do (keep 1) (keep 2)))")
         (source (verona.ide:open-buffer store id "subtrees" text :module "subtrees"))
         (key (list "subtrees" (verona.ide:source-id source))))
    (verona.ide:evaluate-module store id source)
    (let ((verona::*expansion-observer* (lambda (&rest args) (declare (ignore args)) (error "Unexpected expansion"))))
      (let ((first (verona.ide:inspect-expansion store id key :offset (search "(keep 1" text)))
            (second (verona.ide:inspect-expansion store id key :offset (search "(keep 2" text)))
            (whole (verona.ide:inspect-expansion store id key :offset (search "(function" text))))
        (is (= 1 (getf first :after)))
        (is (= 2 (getf second :after)))
        (is (= 1 (length (getf first :steps))))
        (is (= 1 (length (getf second :steps))))
        (is (equal '("do" 1 2) (second (fourth (getf whole :after)))))))))

