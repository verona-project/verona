(import base)
(import libc.types :as types)
(import libc.constants :as constants)
(import libc.errno :as errno)
(import libc.filesystem :as fs)
(import libc.descriptor :as fd)
(import libc.stdio :as stdio)
(import libc.string :as text)
(import libc.memory :as memory)
(import libc.process :as process)

(base:function equal-generic (for (t) ((base:equality t))) ((left t) (right t)) bool
  (= left right))

(base:function add-generic (for (t) ((base:numeric t))) ((left t) (right t)) t
  (+ left right))

(base:function pointer-bits ((value (pointer void))) usize
  (deref (cast (pointer usize) (cast (pointer void) (& value)))))

(base:function stream-errors ((path types:c-string)) bool
  (let ((file (pointer types:file-stream) (stdio:fopen path "rb")))
    (match (pointer-bits (cast (pointer void) file))
      (0 false)
      (_
        (let
          ((initial types:c-int (stdio:ferror file))
           (written types:c-int (stdio:fputs "read-only" file))
           (failed types:c-int (stdio:ferror file))
           (closed types:c-int (stdio:fclose file)))
          (match initial
            (0
              (match written
                (-1 (match failed (0 false) (_ (match closed (0 true) (_ false)))))
                (_ false)))
            (_ false)))))))

(base:function temporary-file ((path types:c-string)) bool
  (let ((descriptor types:file-descriptor (fs:mkstemp path)))
    (match descriptor
      (-1 false)
      (_
        (let
          ((closed types:c-int (fd:close descriptor))
           (stream-ok bool (stream-errors path))
           (removed types:c-int (fs:unlink path)))
          (match closed (0 (match removed (0 stream-ok) (_ false))) (_ false)))))))

(base:function child-status () bool
  (let ((child types:pid-t (process:fork)))
    (match child
      (-1 false)
      (0 (do (process:exit 7) false))
      (_
        (let ((status types:c-int 0) (waited types:pid-t (process:waitpid child (& status) 0)))
          (match (equal-generic child waited)
            (false false)
            (true
              ; Supported POSIX hosts encode normal exit status in bits 8..15.
              (match status
                (1792
                  (let ((again types:pid-t (process:waitpid child (& status) constants:WNOHANG)))
                    (match again
                      (-1 (equal-generic (deref (errno:errno-pointer)) constants:ECHILD))
                      (_ false))))
                (_ false)))))))))

(base:function main ((argc i32) (argv (pointer (pointer u8)))) exit-code
  (match argc
    (2
      (let
        ((template types:c-string (deref (pointer-offset argv 1)))
         (size usize (text:strlen template))
         (capacity usize (add-generic size (let ((one usize 1)) one)))
         (storage (pointer void) (memory:calloc capacity 1)))
        (match (pointer-bits storage)
          (0 1)
          (_
            (let ((path types:c-string (cast types:c-string storage)))
              (do
                (text:strcpy path template)
                (let ((file-ok bool (temporary-file path)) (wait-ok bool (child-status)))
                  (do
                    (memory:free storage)
                    (match file-ok (false 2) (true (match wait-ok (true 0) (false 3))))))))))))
    (_ 4)))
