(require :asdf)
(let* ((root (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
       (swank-asd (uiop:getenv "VERONA_SWANK_ASD")))
  (when swank-asd (asdf:load-asd (truename swank-asd)))
  (unless (and (asdf:find-system :swank nil) (asdf:find-system :fiveam nil))
    (load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
    (uiop:symbol-call :ql :quickload '(:swank :fiveam)))
  (asdf:load-asd (merge-pathnames "verona.asd" root))
  (asdf:load-system :verona/swank-tests)
  (unless (uiop:symbol-call :fiveam :run! :verona-swank) (uiop:quit 1)))
