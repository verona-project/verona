(import base)
(import testing)
(import foundation.compat.arithmetic :as n)
(import data)
(import formatter.test_support :as support)
(import allocator)
(import system_allocator :as system)
(import formatter)
(import formatter.model :as m)

(testing:test width-too-small
  (let ((output data:data (data:empty (system:create))))
    (let
      ((result
         testing:result
         (testing:checks
           (support:successful (m:from-storage (data:assign-bytes (& output) (support:view "old"))))
           (testing:check
             (match (formatter:format (support:view "(a)") 19 (& output) (system:create))
               ((limit-error offset message) true)
               (_ false)))
           (testing:check (data:equal (data:borrow output) (support:view "old"))))))
      (do (data:destroy (& output)) result))))

(testing:test width-too-large
  (let ((output data:data (data:empty (system:create))))
    (let
      ((result
         testing:result
         (testing:checks
           (support:successful (m:from-storage (data:assign-bytes (& output) (support:view "old"))))
           (testing:check
             (match (formatter:format (support:view "(a)") 241 (& output) (system:create))
               ((limit-error offset message) true)
               (_ false)))
           (testing:check (data:equal (data:borrow output) (support:view "old"))))))
