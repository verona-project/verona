(ert-deftest verona-server-start-is-idempotent ()
  (let ((verona-server--process 'owned) (verona-server--state 'starting))
    (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'process-live-p) (lambda (p) (eq p 'owned)))
              ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "duplicate server"))))
      (verona-start-server))))

(ert-deftest verona-server-stop-only-signals-owned-process ()
  (let ((verona-server--process 'owned) (verona-server--timer nil)
        (verona-server--ready-file nil) sent)
    (cl-letf (((symbol-function 'process-live-p) (lambda (p) (eq p 'owned)))
              ((symbol-function 'process-send-string) (lambda (p text) (setq sent (list p text)))))
      (verona-stop-server)
      (should (equal sent '(owned "STOP\n")))
      (should (eq verona-server--state 'stopping)))))

(ert-deftest verona-server-readiness-precedes-connection ()
  (let ((verona-server--state 'starting) (verona-server--host verona-server-host)
        (verona-server--process 'owned)
        (verona-server--deadline (+ (float-time) 30))
        (verona-server--ready-file (make-temp-file "verona-ready-test-"))
        (verona-server--connection nil) called)
    (unwind-protect
        (cl-letf (((symbol-function 'process-live-p) (lambda (p) (eq p 'owned)))
                  ((symbol-function 'slime-connect)
                   (lambda (host port) (setq called (list host port)) 'socket)))
          (verona-server--poll)
          (should-not called)
          (with-temp-file verona-server--ready-file (insert "54321\n"))
          (verona-server--poll)
          (should (equal called (list verona-server-host 54321)))
          (should (eq verona-server--connection 'socket))
          (should (eq verona-server--state 'connecting)))
      (delete-file verona-server--ready-file))))

(ert-deftest verona-server-requires-adapter-capabilities ()
  (let ((verona-server--state 'connecting) (verona-server--connection 'owned) failed)
    (cl-letf (((symbol-function 'slime-current-connection) (lambda () 'owned))
              ((symbol-function 'slime-eval-async) (lambda (_ callback)
                                                   (funcall callback '(:ok (:protocol-version 1 :operations nil)))))
              ((symbol-function 'verona-server--failed) (lambda (reason) (setq failed reason))))
      (verona-server--connected)
      (should failed))))

(ert-deftest verona-server-startup-timeout-reports-output ()
