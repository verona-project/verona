(ert-deftest verona-qualified-completion-uses-live-prefix-and-bounds ()
  (verona-test-buffer
   (insert "(stdio:ge)")
   (goto-char (1- (point-max)))
   (setq verona-ide--operations '(:complete-names))
   (let ((args (list verona-ide--module (verona-ide--offset) :prefix "stdio:ge" :limit 1000)))
     (puthash (cons :complete-names args)
              '(:exact-p nil :availability :partial
                :items ((:kind :function :insertion-text "stdio:getchar" :replacement-range nil)))
              verona-ide--cache)
     (let ((completion (verona-ide-completion-at-point)))
       (should (equal (cl-subseq completion 0 3) '(2 10 ("stdio:getchar"))))
       (delete-region (nth 0 completion) (nth 1 completion))
       (insert (car (nth 2 completion)))
       (should (equal (buffer-string) "(stdio:getchar)"))))))

(ert-deftest verona-colon-completion-shows-exports-without-evaluation ()
  (verona-test-buffer
   (insert "stdio:")
   (setq verona-ide-mode t verona-ide--operations '(:complete-names))
   (let ((last-command-event ?:) operation arguments displayed)
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (op args callback)
                  (setq operation op arguments args)
                  (puthash (cons op args)
                           '(:exact-p nil :items ((:kind :module :insertion-text "stdio:")
                                                  (:kind :function :insertion-text "stdio:getchar")))
                           verona-ide--cache)
                  (funcall callback '(:exact-p nil :availability :partial))))
               ((symbol-function 'completion-at-point)
                (lambda () (setq displayed (verona-ide-completion-at-point)))))
       (verona-ide--complete-after-colon)
       (should (eq operation :complete-names))
       (should (equal (plist-get (nthcdr 2 arguments) :prefix) "stdio:"))
       (should (equal (nth 2 displayed) '("stdio:getchar")))))))

(ert-deftest verona-colon-completion-ignores-comments-and-moved-point ()
  (verona-test-buffer
   (setq verona-ide-mode t verona-ide--operations '(:complete-names))
   (insert "; stdio:")
   (let ((last-command-event ?:) reply displayed)
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (_op _args callback) (setq reply callback)))
               ((symbol-function 'completion-at-point) (lambda () (setq displayed t))))
       (verona-ide--complete-after-colon)
       (should-not reply)
       (erase-buffer)
       (insert "stdio:")
       (verona-ide--complete-after-colon)
       (should reply)
       (goto-char (point-min))
       (funcall reply nil)
       (should-not displayed)))))

(ert-deftest verona-reload-adds-completion-hook-to-existing-buffers ()
  (verona-test-buffer
   (verona-ide-mode 1)
   (remove-hook 'post-self-insert-hook #'verona-ide--complete-after-colon t)
   (should-not (memq #'verona-ide--complete-after-colon post-self-insert-hook))
   (verona-ide--refresh-active-modes)
   (should (memq #'verona-ide--complete-after-colon post-self-insert-hook))
   (should verona-ide-mode)))

(ert-deftest verona-colon-displays-real-emacs-completion-list ()
  (verona-test-buffer
   (insert "stdio")
   (setq verona-ide--operations '(:complete-names))
   (verona-ide-mode 1)
   (let ((last-command-event ?:))
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (op args callback)
                  (let ((data '(:exact-p nil :availability :complete
                                :items ((:kind :function :insertion-text "stdio:getchar")
                                        (:kind :function :insertion-text "stdio:putchar")))))
                    (puthash (cons op args) data verona-ide--cache)
                    (funcall callback data)))))
       (unwind-protect
           (progn
             (self-insert-command 1)
             (should (equal (buffer-string) "stdio:"))
             (should (get-buffer "*Completions*"))
             (with-current-buffer "*Completions*"
               (should (string-match-p "stdio:getchar" (buffer-string)))
               (should (string-match-p "stdio:putchar" (buffer-string)))))
         (when (get-buffer "*Completions*") (kill-buffer "*Completions*")))))))

(ert-deftest verona-editor-save-build-commands-remain-explicit ()
