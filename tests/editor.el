   (should-not (eq (key-binding (kbd "C-c C-e")) #'verona-ide-evaluate))))

(ert-deftest verona-editor-build-project-requires-discovery ()
  (verona-test-buffer
   (let ((real-require (symbol-function 'require)) operations)
     (cl-letf (((symbol-function 'require)
                (lambda (feature &rest args)
                  (if (eq feature 'slime) t (apply real-require feature args))))
               ((symbol-function 'slime-current-connection) (lambda () 'connection))
               ((symbol-function 'verona-ide--rpc)
                (lambda (operation _args callback &optional _session)
                  (push operation operations)
                  (when (eq operation :capabilities)
                    (funcall callback '(:protocol-version 1 :operations (:create-session)))))))
       (should-error (verona-ide--start-project
                      (expand-file-name "../../projects/calculator-repl/"
                                        (file-name-directory (locate-library "verona-ide")))
                      "" "" #'ignore) :type 'user-error)
       (should (equal operations '(:capabilities)))
       (should (equal verona-ide--status "project discovery unavailable"))))))
(ert-deftest verona-editor-build-project-uses-discovery-and-target ()
  (verona-test-buffer
   (let ((real-require (symbol-function 'require)) created)
     (cl-letf (((symbol-function 'require)
                (lambda (feature &rest args)
                  (if (eq feature 'slime) t (apply real-require feature args))))
               ((symbol-function 'slime-current-connection) (lambda () 'connection))
               ((symbol-function 'verona-ide--rpc)
                (lambda (operation args callback &optional _session)
                  (pcase operation
                    (:capabilities (funcall callback '(:protocol-version 1 :operations (:inspect-project :create-project-session))))
                    (:inspect-project (funcall callback (list :root (expand-file-name default-directory) :build-file "verona.build"
                                                              :targets '((:name "calculator")))))
                    (:create-project-session (setq created args))))))
       (verona-ide--start-project default-directory "calculator" "" #'ignore)
