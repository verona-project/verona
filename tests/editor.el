                (lambda (_op _args callback &rest _)
                  (funcall callback '(:status :failed :current-module (:phase :resolution)))))
               ((symbol-function 'verona-ide-refresh) (lambda () (setq refreshed t))))
       (verona-ide--poll)
       (should refreshed)
       (should (string-match-p "failed" verona-ide--status))))))
(ert-deftest verona-editor-evaluation-key-requires-ide-mode ()
