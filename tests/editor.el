     (cl-letf (((symbol-function 'verona-ide--sync-project) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide--poll) #'ignore)
               ((symbol-function 'verona-ide--rpc)
                (lambda (_op _args callback &rest _) (push callback replies))))
       (verona-ide-evaluate)
       (verona-ide-evaluate)
       (funcall (car replies) '(:request "new"))
