;;; editor.el --- Verona editor regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'verona-ide)
(defmacro verona-test-buffer (&rest body)
  `(with-temp-buffer
     (verona-mode)
     (setq verona-ide--session "session" verona-ide--module '("test" "test.vrn")
           verona-ide--source "test.vrn" verona-ide--buffer-id "buffer"
           verona-ide--cache (make-hash-table :test #'equal)
           verona-ide--serials (make-hash-table :test #'eq))
     ,@body))
(ert-deftest verona-editor-rejects-edited-query ()
  (verona-test-buffer
   (let (reply published)
     (cl-letf (((symbol-function 'verona-ide--sync-project) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide--rpc) (lambda (_op _args callback &rest _) (setq reply callback))))
       (verona-ide--query :signature-help nil (lambda (_) (setq published t)))
       (insert "changed")
       (funcall reply '(:signatures (old)))
       (should-not published)))))
(ert-deftest verona-editor-rejects-superseded-query ()
  (verona-test-buffer
   (let (replies published)
     (cl-letf (((symbol-function 'verona-ide--sync-project) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide--rpc) (lambda (_op _args callback &rest _) (push callback replies))))
       (verona-ide--query :signature-help nil (lambda (_) (setq published 'old)))
       (verona-ide--query :signature-help nil (lambda (_) (setq published 'new)))
       (funcall (car replies) nil)
       (funcall (cadr replies) nil)
       (should (eq published 'new))))))
(ert-deftest verona-editor-stale-locations-withheld ()
  (should-not (verona-ide--location '(:exact-p nil :evaluated-location (:source "old" :line 1)))))
(ert-deftest verona-editor-overlay-does-not-evaluate ()
  (verona-test-buffer
   (setq verona-ide--source nil)
   (insert "unsaved")
   (let (operations done)
     (cl-letf (((symbol-function 'verona-ide--rpc)
                (lambda (op _args callback &rest _)
                  (push op operations)
                  (funcall callback '(:id (:buffer "buffer") :module "test")))))
       (verona-ide--sync (lambda () (setq done t)))
       (should done)
       (should (equal operations '(:open-buffer)))
       (insert " edit")
       (verona-ide--sync #'ignore)
       (should (equal operations '(:edit-buffer :open-buffer)))))))
(ert-deftest verona-editor-explicit-evaluation-uses-source ()
  (verona-test-buffer
   (let (operation arguments)
     (cl-letf (((symbol-function 'verona-ide--sync-project) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide--rpc)
                (lambda (op args _callback &rest _) (setq operation op arguments args))))
       (verona-ide-evaluate)
       (should (eq operation :evaluate))
       (should (equal arguments '("test.vrn")))))))
(ert-deftest verona-editor-capabilities-required ()
  (verona-test-buffer
   (should-error (verona-ide--rpc :evaluate nil #'ignore) :type 'user-error)))
(ert-deftest verona-editor-disabled-has-no-hooks ()
  (verona-test-buffer
   (verona-ide-mode 1)
   (should (memq #'verona-ide-flymake flymake-diagnostic-functions))
   (verona-ide-mode -1)
   (should-not (memq #'verona-ide-flymake flymake-diagnostic-functions))))

(ert-deftest verona-editor-completion-respects-exact-range ()
  (verona-test-buffer
   (setq verona-ide--operations '(:complete-names))
   (cl-letf (((symbol-function 'verona-ide--query) #'ignore))
     (puthash (cons :complete-names (list verona-ide--module 0))
              '(:exact-p t :items ((:insertion-text "name" :replacement-range (:start 0 :end 4))))
              verona-ide--cache)
     (should (equal (cl-subseq (verona-ide-completion-at-point) 0 3) '(1 5 ("name"))))
     (clrhash verona-ide--cache)
     (should-not (verona-ide-completion-at-point)))))
(ert-deftest verona-editor-flymake-only-current-locations ()
  (verona-test-buffer
   (insert "abc")
   (setq verona-ide--path "/test.vrn" verona-ide--operations '(:module-diagnostics))
   (let (reported operation)
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (op _args callback)
                  (setq operation op)
                  (funcall callback
                   '(:items ((:diagnostic (:exact-p t :location (:source "/test.vrn" :offset 0 :line 1)
                                                      :severity :warning :message "current"))
                             (:diagnostic (:exact-p nil :message "stale"))))))))
       (verona-ide-flymake (lambda (items) (setq reported items)))
       (should (eq operation :module-diagnostics))
       (should (= (length reported) 1))
       (should (eq (flymake-diagnostic-type (car reported)) :warning))))))
(ert-deftest verona-editor-eldoc-shows-incompleteness ()
  (verona-test-buffer
   (setq verona-ide--operations '(:signature-help))
   (let (text)
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (_op _args callback)
                  (funcall callback '(:signatures (example) :active-argument 1 :availability :partial :exact-p nil)))))
       (verona-ide-eldoc (lambda (result) (setq text result)))
       (should (string-match-p "partial" text))
       (should (string-match-p "argument 1" text))))))
(ert-deftest verona-editor-evaluation-replies-cannot-regress ()
  (verona-test-buffer
   (let (replies)
     (cl-letf (((symbol-function 'verona-ide--sync-project) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide--poll) #'ignore)
               ((symbol-function 'verona-ide--rpc)
                (lambda (_op _args callback &rest _) (push callback replies))))
       (verona-ide-evaluate)
       (verona-ide-evaluate)
       (funcall (car replies) '(:request "new"))
       (funcall (cadr replies) '(:request "old"))
       (should (equal verona-ide--request "new"))))))

(ert-deftest verona-editor-rpc-routes-and-rejects-old-session ()
  (verona-test-buffer
   (setq verona-ide--operations '(:module-state) verona-ide--connection 'connection)
   (let (reply form published)
     (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
               ((symbol-function 'slime-eval-async)
                (lambda (request callback &rest _) (setq form request reply callback))))
       (verona-ide--rpc :module-state '("source") (lambda (_) (setq published t)))
       (should (equal form '(verona.swank:rpc :module-state "session" (quote ("source")))))
       (cl-incf verona-ide--epoch)
       (funcall reply '(:ok (:status :complete)))
       (should-not published)))))
(ert-deftest verona-editor-session-negotiates-before-attach ()
  (verona-test-buffer
   (let ((real-require (symbol-function 'require)) operations)
     (cl-letf (((symbol-function 'require)
                (lambda (feature &rest args)
                  (if (eq feature 'slime) t (apply real-require feature args))))
               ((symbol-function 'slime-current-connection) (lambda () 'connection))
               ((symbol-function 'verona-ide--sync) (lambda (done) (funcall done)))
               ((symbol-function 'verona-ide-refresh) #'ignore)
               ((symbol-function 'verona-ide--rpc)
                (lambda (operation _args callback &optional session)
                  (push operation operations)
                  (pcase operation
                    (:capabilities (funcall callback '(:protocol-version 1 :operations (:attach-session :inspect-project :create-project-session))))
                    (:inspect-project (funcall callback (list :root (expand-file-name default-directory) :build-file "verona.build"
                                                              :targets '((:name "calculator")))))
                    (:attach-session (should (equal session "existing")) (funcall callback "existing"))))))
       (verona-ide--start-project default-directory "" "existing" (lambda (_project _target) nil))
       (should (equal (reverse operations) '(:capabilities :inspect-project :attach-session)))
       (should (equal verona-ide--session "existing"))
       (setq verona-ide--source nil)))))
(ert-deftest verona-editor-synchronizes-dependency-overlays ()
  (verona-test-buffer
   (let ((other (generate-new-buffer " *verona-dependency*")) seen done)
     (unwind-protect
         (progn
           (with-current-buffer other
             (setq verona-ide-mode t verona-ide--session "session"))
           (setq verona-ide-mode t)
           (cl-letf (((symbol-function 'verona-ide--sync)
                      (lambda (callback) (push (current-buffer) seen) (funcall callback))))
             (verona-ide--sync-project (lambda () (setq done t)))
             (should done)
             (should (memq other seen))
             (should (memq (current-buffer) seen))))
       (kill-buffer other)))))

(ert-deftest verona-editor-cancellation-targets-retained-request ()
  (verona-test-buffer
   (setq verona-ide--request "request-1")
