(ert-deftest verona-server-environment-rejects-missing-and-invalid-paths ()
  (let ((process-environment nil))
    (should-error (verona-server--validate-environment) :type 'user-error)
    (setenv "VERONA_SOURCE_DIR" "relative/path")
    (setenv "VERONA_LIBRARY_DIR" "/nonexistent/verona-library")
    (let ((message (condition-case err (verona-server--validate-environment)
                     (user-error (error-message-string err)))))
      (should (string-match-p "VERONA_SOURCE_DIR" message))
      (should (string-match-p "VERONA_LIBRARY_DIR" message))))
  (let ((process-environment nil))
    (setenv "VERONA_SOURCE_DIR" temporary-file-directory)
    (setenv "VERONA_LIBRARY_DIR" temporary-file-directory)
    ;; The Nix launcher can supply LLVM after editor-side validation.
    (should-not (verona-server--validate-environment))
    (setenv "VERONA_CL_LLVM" temporary-file-directory)
    (should-error (verona-server--validate-environment) :type 'user-error)))

(ert-deftest verona-server-environment-validates-effective-overrides-before-launch ()
  (let* ((process-environment nil)
         (directory (make-temp-file "verona-environment-" t))
         (verona-server-environment
          (mapcar (lambda (name) (concat name "=" directory))
                  '("VERONA_SOURCE_DIR" "VERONA_LIBRARY_DIR" "VERONA_CL_LLVM")))
         (verona-server--process nil) (verona-server--timer nil)
         (verona-server--ready-file nil))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "llvm.asd" directory) (insert "; fixture"))
          (let ((process-environment (append verona-server-environment process-environment)))
            (should-not (verona-server--validate-environment)))
          (let ((verona-server-environment '("VERONA_SOURCE_DIR=relative")))
            (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                      ((symbol-function 'locate-library) (lambda (_) "/tmp/slime.el"))
                      ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Server launched"))))
              (should-error (verona-start-server) :type 'user-error)
              (should-not verona-server--ready-file)
              (should-not verona-server--timer))))
      (delete-file (expand-file-name "llvm.asd" directory))
      (delete-directory directory))))

(ert-deftest verona-help-lists-all-settings-and-refreshes-effective-values ()
  (let ((process-environment nil)
        (verona-server-environment
         (list (concat "VERONA_SOURCE_DIR=" temporary-file-directory)
               "VERONA_LIBRARY_DIR=relative/path")))
    (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Launched server"))))
      (verona-help)
      (with-current-buffer "*Verona help*"
        (should (derived-mode-p 'special-mode))
        (should buffer-read-only)
        (should (eq (key-binding (kbd "g")) #'verona-help))
        (should (string-match-p "\\[OK\\] VERONA_SOURCE_DIR" (buffer-string)))
        (should (string-match-p "\\[INVALID\\] VERONA_LIBRARY_DIR" (buffer-string)))
        (should (string-match-p "\\[CHECK ON START\\] VERONA_CL_LLVM" (buffer-string))))
      (setq verona-server-environment nil)
      (verona-help)
      (with-current-buffer "*Verona help*"
        (should (string-match-p "\\[MISSING\\] VERONA_SOURCE_DIR" (buffer-string)))
        (should-not (string-match-p "relative/path" (buffer-string)))))))

(ert-deftest verona-startup-validation-displays-complete-checklist ()
  (let ((process-environment nil) displayed)
    (setenv "VERONA_SOURCE_DIR" temporary-file-directory)
    (cl-letf (((symbol-function 'display-buffer) (lambda (buffer &rest _) (setq displayed buffer))))
      (should-error (verona-server--validate-environment) :type 'user-error)
      (should (equal (buffer-name displayed) "*Verona help*"))
      (with-current-buffer displayed
        (should (string-match-p "\\[OK\\] VERONA_SOURCE_DIR" (buffer-string)))
        (should (string-match-p "\\[MISSING\\] VERONA_LIBRARY_DIR" (buffer-string)))
        (should (string-match-p "VERONA_CL_LLVM" (buffer-string)))
        (should (string-match-p "verona-start-server" (buffer-string)))))))

(ert-deftest verona-server-finds-local-build-when-launcher-is-not-on-path ()
  (let* ((root (make-temp-file "verona-launcher-" t))
         (verona-server-directory root)
         (verona-server-command '("verona-server"))
         (launcher (expand-file-name "build/verona-server" root)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory launcher))
          (with-temp-file launcher (insert "#!/bin/sh\nexit 0\n"))
          (set-file-modes launcher #o755)
          (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
                    ((symbol-function 'file-regular-p)
                     (let ((original (symbol-function 'file-regular-p)))
                       (lambda (file) (and (equal file launcher) (funcall original file))))))
            (should (equal (verona-server--resolved-command) (list launcher)))))
      (delete-directory root t))))

