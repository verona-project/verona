                                    :build-target "calculator")))))))

(ert-deftest verona-editor-displays-nested-compiler-errors ()
  (verona-test-buffer
   (setq verona-ide--operations '(:create-project-session)
         verona-ide--connection 'connection)
   (let (shown success)
     (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
               ((symbol-function 'message) (lambda (format-string &rest args)
                                            (setq shown (apply #'format format-string args))))
               ((symbol-function 'slime-eval-async)
                (lambda (_request callback &rest _)
                  (funcall callback
                   '(:error (:code :compiler-diagnostic
                             :diagnostic (:message "VERONA_SOURCE_DIR must name an absolute directory")))))))
       (verona-ide--rpc :create-project-session nil (lambda (_) (setq success t)))
       (should-not success)
       (should (equal shown "Verona: VERONA_SOURCE_DIR must name an absolute directory"))
       (should (eq (plist-get verona-ide--last-error :operation) :create-project-session))))))
(ert-deftest verona-editor-error-message-preserves-other-responses ()
  (should (equal (verona-ide--error-message '(:code :invalid-request :message "Unknown target"))
                 "Unknown target"))
  (should (string-match-p "unknown-error"
                         (verona-ide--error-message '(:code :unknown-error)))))

(ert-deftest verona-editor-target-selection-follows-project-inspection ()
  (dolist (names '(("only") ("first" "second")))
    (verona-test-buffer
     (let ((real-require (symbol-function 'require)) created prompted presented)
       (cl-letf (((symbol-function 'require)
                  (lambda (feature &rest args)
                    (if (eq feature 'slime) t (apply real-require feature args))))
                 ((symbol-function 'slime-current-connection) (lambda () 'connection))
                 ((symbol-function 'completing-read)
                  (lambda (_prompt choices _predicate require-match &rest _)
                    (should require-match) (should (equal choices names))
                    (setq prompted t) (car (last choices))))
                 ((symbol-function 'verona-ide--show-project)
                  (lambda (project) (setq presented project)))
                 ((symbol-function 'verona-ide--rpc)
                  (lambda (operation args callback &optional _session)
                    (pcase operation
                      (:capabilities (funcall callback '(:protocol-version 1 :operations (:inspect-project :create-project-session))))
                      (:inspect-project
                       (funcall callback (list :root "/project/" :build-file "/project/verona.build"
                                              :targets (mapcar (lambda (name) (list :name name)) names))))
                      (:create-project-session (should presented) (setq created args))
                      (_ (ert-fail "Unexpected RPC"))))))
         (verona-ide--start-project default-directory nil nil #'ignore)
         (should (equal created (list "/project/" :build-target (car (last names)))))
         (should (eq prompted (not (null (cdr names))))))))))
(ert-deftest verona-editor-rejected-inspection-never-creates-session ()
  (verona-test-buffer
   (let ((real-require (symbol-function 'require)) operations)
     (cl-letf (((symbol-function 'require)
                (lambda (feature &rest args)
                  (if (eq feature 'slime) t (apply real-require feature args))))
               ((symbol-function 'slime-current-connection) (lambda () 'connection))
               ((symbol-function 'verona-ide--rpc)
                (lambda (operation _args callback &optional _session)
                  (push operation operations)
                  (when (eq operation :capabilities)
                    (funcall callback '(:protocol-version 1 :operations (:inspect-project :create-project-session)))))))
       (verona-ide--start-project default-directory nil nil #'ignore)
       (should (equal (reverse operations) '(:capabilities :inspect-project)))))))

(ert-deftest verona-open-project-creates-context-and-opens-entry ()
  (let* ((verona-ide--projects nil)
         (real-require (symbol-function 'require))
         (root (file-truename
                (expand-file-name "../../projects/calculator-repl/"
                                  (file-name-directory (locate-library "verona-ide")))))
         selected opened)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'slime) t (apply real-require feature args))))
              ((symbol-function 'verona-ide--start-project)
               (lambda (directory target existing ready)
                 (should-not target) (should-not existing)
                 (setq selected directory verona-ide--session "project-session"
                       verona-ide--connection 'connection verona-ide--operations '(:open-buffer))
                 (funcall ready
                          (list :root root :targets
                                (list (list :name "calculator" :root-module "calculator"
                                            :search-paths (list (expand-file-name "src/" root)))))
                          "calculator")))
              ((symbol-function 'verona-ide--auto-attach) #'ignore)
              ((symbol-function 'verona-ide--open-project-file)
               (lambda (project file) (setq opened (list project file)))))
      (verona-open-project root)
      (should (equal selected root))
      (should (equal (cadr opened) (expand-file-name "src/calculator.vrn" root)))
      (should (equal (plist-get (car verona-ide--projects) :session) "project-session")))))

(ert-deftest verona-project-buffers-reuse-session-without-reattaching ()
  (verona-test-buffer
   (let ((project '(:root "/project/" :session "project-session" :connection connection
                         :operations (:open-buffer :edit-buffer)))
         (syncs 0))
     (cl-letf (((symbol-function 'verona-ide--sync)
                (lambda (_done) (cl-incf syncs))))
       (verona-ide--use-project project)
       (should verona-ide-mode)
       (should (eq (key-binding (kbd "C-c C-e")) #'verona-ide-evaluate))
       (should (equal verona-ide--session "project-session"))
       (verona-ide--use-project project)
       (should (= syncs 1))
       (setq verona-ide--source nil)))))

(ert-deftest verona-project-file-matching-prefers-nearest-project ()
  (let* ((root (file-truename (expand-file-name "../.." (file-name-directory (locate-library "verona-ide")))))
         (nested (expand-file-name "projects/calculator-repl/" root))
         (verona-ide--projects (list (list :root root :connection 'parent)
                                    (list :root nested :connection 'child))))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_) t)))
      (should (eq (plist-get (verona-ide--project-for-file
                             (expand-file-name "src/calculator.vrn" nested)) :connection) 'child))
      (should-not (verona-ide--project-for-file "/unrelated/file.vrn")))))

(ert-deftest verona-reopening-project-reuses-context ()
  (let* ((real-require (symbol-function 'require))
         (root (file-name-as-directory (file-truename default-directory)))
         (verona-ide--projects (list (list :root root :target "app" :session "retained")))
         selected)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'slime) t (apply real-require feature args))))
              ((symbol-function 'verona-ide--start-project)
               (lambda (directory target existing _ready)
                 (setq selected (list directory target existing)))))
      (verona-open-project root)
      (should (equal selected (list root "app" "retained"))))))

(ert-deftest verona-close-project-detaches-and-removes-context ()
  (verona-test-buffer
   (let* ((project '(:root "/project/" :session "session" :connection connection :operations (:detach-session)))
          (verona-ide--projects (list project)) operations)
     (setq verona-ide--root "/project/" verona-ide--connection 'connection)
     (verona-ide-mode 1)
     (setq verona-ide--source nil)
     (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
               ((symbol-function 'verona-ide--rpc)
                (lambda (operation _args _callback &rest _) (push operation operations))))
       (verona-close-project)
       (should-not verona-ide-mode)
       (should-not verona-ide--projects)
       (should (equal operations '(:detach-session)))))))

(ert-deftest verona-qualified-completion-uses-live-prefix-and-bounds ()
  (verona-test-buffer
   (insert "(stdio:ge)")
   (goto-char (1- (point-max)))
   (setq verona-ide--operations '(:complete-names))
   (let ((args (list verona-ide--module (verona-ide--offset) :prefix "stdio:ge" :limit 1000)))
     (puthash (cons :complete-names args)
              '(:exact-p nil :availability :partial
                :items ((:kind :function :insertion-text "stdio:getchar" :replacement-range nil)))
              verona-ide--cache)
     (let ((completion (verona-ide-completion-at-point)))
       (should (equal (cl-subseq completion 0 3) '(2 10 ("stdio:getchar"))))
       (delete-region (nth 0 completion) (nth 1 completion))
       (insert (car (nth 2 completion)))
       (should (equal (buffer-string) "(stdio:getchar)"))))))

(ert-deftest verona-colon-completion-shows-exports-without-evaluation ()
  (verona-test-buffer
   (insert "stdio:")
   (setq verona-ide-mode t verona-ide--operations '(:complete-names))
   (let ((last-command-event ?:) operation arguments displayed)
     (cl-letf (((symbol-function 'verona-ide--query)
                (lambda (op args callback)
                  (setq operation op arguments args)
                  (puthash (cons op args)
                           '(:exact-p nil :items ((:kind :module :insertion-text "stdio:")
                                                  (:kind :function :insertion-text "stdio:getchar")))
                           verona-ide--cache)
                  (funcall callback '(:exact-p nil :availability :partial))))
               ((symbol-function 'completion-at-point)
                (lambda () (setq displayed (verona-ide-completion-at-point)))))
       (verona-ide--complete-after-colon)
       (should (eq operation :complete-names))
       (should (equal (plist-get (nthcdr 2 arguments) :prefix) "stdio:"))
       (should (equal (nth 2 displayed) '("stdio:getchar")))))))

(ert-deftest verona-colon-completion-ignores-comments-and-moved-point ()
  (verona-test-buffer
   (setq verona-ide-mode t verona-ide--operations '(:complete-names))
   (insert "; stdio:")
