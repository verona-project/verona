     (cl-letf (((symbol-function 'verona-ide--rpc)
                (lambda (op args _callback &rest _) (setq operation op arguments args))))
       (verona-ide-cancel)
       (should (eq operation :cancel-request))
       (should (equal arguments '("request-1")))))))
(ert-deftest verona-editor-progress-refreshes-terminal-results ()
