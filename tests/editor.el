(ert-deftest verona-close-project-closes-and-removes-context ()
  (verona-test-buffer
   (let* ((project '(:root "/project/" :session "session" :connection connection :operations (:close-session)))
          (verona-ide--projects (list project)) operations)
     (setq verona-ide--root "/project/" verona-ide--connection 'connection)
