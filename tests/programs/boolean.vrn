(%import checks)

(%macro binary (name operator left right expected)
  `(checks:boolean ,name ,expected (,(symbol-concat "%" operator "-primitive-bool") ,left ,right)))

(checks:run
  (checks:boolean "not/false" true (%not-primitive-bool false))
  (checks:boolean "not/true" false (%not-primitive-bool true))
  (binary "and/false-false" and false false false)
  (binary "and/false-true" and false true false)
  (binary "and/true-false" and true false false)
  (binary "and/true-true" and true true true)
  (binary "or/false-false" or false false false)
  (binary "or/false-true" or false true true)
  (binary "or/true-false" or true false true)
  (binary "or/true-true" or true true true)
  (binary "equal/false-false" = false false true)
  (binary "equal/false-true" = false true false)
  (binary "equal/true-false" = true false false)
  (binary "equal/true-true" = true true true)
  (binary "unequal/false-false" /= false false false)
  (binary "unequal/false-true" /= false true true)
  (binary "unequal/true-false" /= true false true)
  (binary "unequal/true-true" /= true true false))
