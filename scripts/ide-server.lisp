;;; Managed SBCL entry point. Only the owning editor holds standard input.
(require :asdf)
(let* ((args (uiop:command-line-arguments))
       (root (uiop:ensure-directory-pathname (first args)))
       (loader (second args))
       (host (third args))
       (port (parse-integer (fourth args)))
       (ready (fifth args))
       (llvm (uiop:getenv "VERONA_CL_LLVM")))
  ;; Check the actual process environment, including settings supplied by Nix
  ;; or SBCL startup files, before loading Swank or compiler support.
  (dolist (name '("VERONA_SOURCE_DIR" "VERONA_LIBRARY_DIR" "VERONA_CL_LLVM"))
    (let ((value (uiop:getenv name)))
      (unless (and value (plusp (length value)))
        (error "Cannot start Verona: ~A is missing" name))
      (unless (and (uiop:absolute-pathname-p value) (uiop:directory-exists-p value))
        (error "Cannot start Verona: ~A must name an existing absolute directory: ~A" name value))))
  (let ((asd (merge-pathnames "llvm.asd" (uiop:ensure-directory-pathname llvm))))
    (unless (and (probe-file asd) (not (uiop:directory-pathname-p (probe-file asd))))
      (error "Cannot start Verona: VERONA_CL_LLVM must contain a readable llvm.asd: ~A" llvm))
    (with-open-file (in asd :direction :input) (read-char in nil nil)))
  (let ((directory (uiop:ensure-directory-pathname llvm)))
    (pushnew directory asdf:*central-registry* :test #'equal)
    (asdf:load-asd (merge-pathnames "llvm.asd" directory)))
  (let ((directory (uiop:pathname-directory-pathname loader)))
    (pushnew directory asdf:*central-registry* :test #'equal)
    (asdf:load-asd (merge-pathnames "swank.asd" directory)))
  (asdf:load-system :swank)
  (asdf:load-asd (merge-pathnames "verona.asd" root))
  (asdf:load-system :verona/ide/project)
  (asdf:load-system :verona/swank)
  (let ((actual (uiop:symbol-call :swank :create-server
                                 :port port :interface host :dont-close t)))
    (with-open-file (out ready :direction :output :if-exists :supersede)
      (format out "~D~%" actual)))
  ;; EOF (editor exit) also performs orderly resource cleanup.
  (unwind-protect
       (loop for line = (read-line *standard-input* nil nil)
             while (and line (not (string= line "STOP"))))
    (uiop:symbol-call :verona.swank :close-all-sessions)))
(uiop:quit 0)
