;; A fresh compiler process owns all LLVM and native build resources.
(require :sb-posix)
(sb-posix:setpgid 0 0)
(require :asdf)
(when (equal "run" (second (uiop:command-line-arguments)))
  ;; A small supervisor owns the entire program process group and inherits the
  ;; IDE's pipes. No compiler or IDE state is needed to run the artifact.
  (let* ((directory (uiop:ensure-directory-pathname (first (uiop:command-line-arguments))))
         (request (with-open-file (in (merge-pathnames "run-request.sexp" directory))
                    (let ((*read-eval* nil)) (read in)))))
    (dolist (entry (getf request :environment))
      (let ((split (position #\= entry)))
        (sb-posix:setenv (subseq entry 0 split) (subseq entry (1+ split)) 1)))
    (multiple-value-bind (out err code)
        (uiop:run-program (cons (getf request :artifact) (getf request :arguments))
                          :input :interactive :output :interactive :error-output :interactive
                          :ignore-error-status t)
      (declare (ignore out err))
      (uiop:quit code))))
(let* ((root (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
       (llvm (uiop:getenv "VERONA_CL_LLVM")))
  (when llvm (asdf:load-asd (merge-pathnames "llvm.asd" (uiop:ensure-directory-pathname llvm))))
  (asdf:load-asd (merge-pathnames "verona.asd" root))
  (asdf:load-system :verona/ide/project))
(in-package #:verona.ide)
(let* ((directory (uiop:ensure-directory-pathname (first (uiop:command-line-arguments))))
       (uiop:*temporary-directory* directory)
       (request (read-build-data (merge-pathnames "request.sexp" directory)))
       (verona.compiler::*tool-output-observer*
         (lambda (stdout stderr)
           (write-string stdout *standard-output*) (finish-output *standard-output*)
           (write-string stderr *error-output*) (finish-output *error-output*)))
       (verona.compiler::*build-stage-observer*
         (lambda (stage)
           (write-build-data (merge-pathnames "stage.tmp" directory) stage)
           (uiop:rename-file-overwriting-target (merge-pathnames "stage.tmp" directory)
                                              (merge-pathnames "stage.sexp" directory))
           (format t "~&~(~A~)~%" stage) (finish-output)))
       (status 1))
  (labels ((finish (data)
             (write-build-data (merge-pathnames "result.tmp" directory) data)
             (uiop:rename-file-overwriting-target (merge-pathnames "result.tmp" directory)
                                                (merge-pathnames "result.sexp" directory))))
    (handler-case
        (let* ((file (verona.compiler:parse-build-source
                      (verona:make-source (namestring (getf request :build-file)) (getf request :text))
                      :directory (getf request :root)))
               (target (verona.compiler:find-build-target file (getf request :target))))
          (setf (slot-value target 'verona.compiler::module-paths) (getf request :paths))
          (when (getf request :triple)
            (setf (slot-value target 'verona.compiler::compilation-target) (getf request :triple)))
          (let ((artifact (verona.compiler:execute-build
                           file (verona.compiler:make-build-invocation
                                 (getf request :target) (merge-pathnames "artifacts/" directory)
                                 :reader-features (getf request :features)))))
            (finish (list :artifact (verona.compiler:artifact-path artifact)
                          :artifact-kind (verona.compiler:artifact-kind artifact)
                          :artifact-target (verona.compiler:compilation-target-triple
                                            (verona.compiler:artifact-target artifact))))
            (setf status 0)))
      (verona:user-compilation-error (condition)
        (format *error-output* "~A~%" condition)
        (let ((data (query-data (verona:diagnostic-for-condition condition))))
          (labels ((remap (x)
                     (cond ((stringp x) (or (cdr (assoc x (getf request :mapping) :test #'equal)) x))
                           ((consp x) (cons (remap (car x)) (remap (cdr x)))) (t x))))
            (finish (list :diagnostics (list (remap data)))))))
      (error (condition)
        (format *error-output* "Build worker error: ~A~%" condition)
        (finish (list :diagnostics (list (list :severity :error :message (princ-to-string condition)
                                             :code :worker-error)))))))
  (uiop:quit status))
