; Temporary project-local compatibility shim pending Base/compiler review.
; Not part of the public Foundation API.
; Concrete operand types contextualize numeric literals before protocol dispatch.
; Operations forward to base protocols; they do not add overflow checking.
(import base)

(base:function add-generic (for (t) ((base:numeric t))) ((x t) (y t)) t
  (+ x y))

(base:function add ((x i64) (y i64)) i64
  (add-generic x y))

(base:function sub-generic (for (t) ((base:numeric t))) ((x t) (y t)) t
  (- x y))

(base:function sub ((x i64) (y i64)) i64
  (sub-generic x y))

(base:function lt-generic (for (t) ((base:ordering t))) ((x t) (y t)) bool
  (< x y))

(base:function lt ((x i64) (y i64)) bool
  (lt-generic x y))

(base:function gt-generic (for (t) ((base:ordering t))) ((x t) (y t)) bool
  (> x y))

(base:function gt ((x i64) (y i64)) bool
  (gt-generic x y))

(base:function eq-generic (for (t) ((base:equality t))) ((x t) (y t)) bool
  (= x y))

(base:function eq ((x i64) (y i64)) bool
  (eq-generic x y))

(export add sub lt gt eq)
