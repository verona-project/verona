(base:external-function puts "puts" ((pointer u8)) i32)

(base:external-function putchar "putchar" (i32) i32)

(base:function text-length ((text (pointer u8)) (length u64)) u64
  (let ((value u64 (base:convert (deref text))))
    (match (n:eq value 0)
      (true length)
      (false (text-length (pointer-offset text 1) (n:add length 1))))))

(base:external-function strncmp "strncmp" ((pointer u8) (pointer u8) u64) i32)

(base:variable selection (pointer u8) "")

(base:variable selected u64 0)

(base:function write-text ((text (pointer u8))) unit
  (let ((value u64 (base:convert (deref text))))
    (match (n:eq value 0)
      (true unit)
      (false
        (let ((character i32 (base:convert value)))
          (do (putchar character) (write-text (pointer-offset text 1))))))))

(base:function print-count ((value u64)) unit
  (do
    (match (n:ge value 10) (true (print-count (n:div value 10))) (false unit))
    (let ((digit i32 (base:convert (n:add 48 (n:sub value (n:mul (n:div value 10) 10))))))
      (do (putchar digit) unit))))

(base:function matches ((name (pointer u8))) bool
  (let ((length u64 (text-length selection 0)))
    (match (n:eq length 0)
      (true true)
      (false
        (match (strncmp name selection length)
          (0
            (let ((next u64 (base:convert (deref (pointer-offset name length)))))
              (match (n:eq next 0) (true true) (false (n:eq next 47)))))
          (_ false))))))

(base:function run-case ((name (pointer u8)) (test testing:test-function)) testing:result
  (match (matches name)
    (false (testing:empty))
    (true
      (let
        ((before testing:result (support:start))
         (body testing:result (testing:execute test))
         (after testing:result (support:finish))
         (result testing:result (testing:checks before body after))
         (failed u64 (base:convert (field result failed))))
        (do
          (assign selected (n:add selected 1))
          (match (n:eq failed 0) (true unit) (false (do (write-text "FAIL ") (puts name) unit)))
          result)))))

