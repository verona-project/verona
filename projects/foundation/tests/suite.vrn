      (true (do (puts "Foundation: no tests matched selector") 2))
      (false
        ; Normalize the exit code so 256 failed checks cannot wrap back to success.
        (match (field result failed)
          (0 (do (write-text "Foundation: ") (print-count selected) (puts " named tests passed") 0))
          (_ (do (puts "Foundation: unit test failures (names above)") 1)))))))
