(import base)
(import testing)
(import allocator)
(import foundation.compat.arithmetic)
(import foundation.compat.arithmetic :as n)
(import error)
(import system_allocator :as system)
(import support)
(import array)

(array:define ints u64)

(base:type integers (tuple (pointer u64) u64 u64 array:layout))

(base:function empty () integers
  (ints-empty (cast (pointer u64) (cast (pointer void) "")) (array:layout 8 8 (support:backend))))

(base:function populate ((owner (pointer integers)) (i u64) (count u64)) testing:result
  (match (n:eq i count)
    (true (testing:empty))
    (false
      (match (ints-append owner (n:add (n:mul i 17) 3))
        ((ok) (populate owner (n:add i 1) count))
        (_ (testing:fail))))))

(base:function verify ((items integers) (i u64) (count u64)) testing:result
  (match (n:eq i count)
    (true (testing:empty))
    (false
      (testing:checks
        (testing:check
          (match (ints-get items i)
            ((tuple true p) (n:eq (deref p) (n:add (n:mul i 17) 3)))
            (_ false)))
        (verify items (n:add i 1) count)))))

(base:function drain-front ((owner (pointer integers)) (i u64) (count u64) (acc testing:result))
  testing:result
  (match (n:eq i count)
    (true acc)
    (false
      (let
        ((result
           testing:result
           (testing:check
             (match (ints-get (deref owner) 0)
               ((tuple true p) (n:eq (deref p) (n:add (n:mul i 17) 3)))
               (_ false)))))
        (match (ints-remove owner 0)
          ((ok) (drain-front owner (n:add i 1) count (testing:checks acc result)))
          (_ (testing:checks acc (testing:fail))))))))

(base:function prepend ((owner (pointer integers)) (i u64)) testing:result
  (match (n:eq i 512)
    (true (testing:empty))
    (false (match (ints-insert owner 0 i) ((ok) (prepend owner (n:add i 1))) (_ (testing:fail))))))

(base:function verify-reversed ((items integers) (i u64)) testing:result
  (match (n:eq i 512)
    (true (testing:empty))
    (false
      (testing:checks
        (testing:check
          (match (ints-get items i) ((tuple true p) (n:eq (deref p) (n:sub 511 i))) (_ false)))
        (verify-reversed items (n:add i 1))))))

(base:variable visit-index u64 0)

(base:variable visit-errors u64 0)

(base:function visit ((value u64)) unit
  (do
    (match (n:eq value (n:add (n:mul visit-index 17) 3))
      (true unit)
      (false (do (assign visit-errors (n:add visit-errors 1)) unit)))
    (assign visit-index (n:add visit-index 1))
    unit))

(testing:test empty-does-not-allocate
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (ints-capacity items) 0))
           (testing:check (n:eq (support:attempts) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test reserve-preserves-zero-logical-length
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-reserve (& items) 31) ((ok) true) (_ false)))
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (ints-capacity items) 31)))))
      (do (ints-destroy (& items)) observed))))

(testing:test smaller-reserve-does-not-reallocate
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-reserve (& items) 31) ((ok) true) (_ false)))
           (testing:check (match (ints-reserve (& items) 0) ((ok) true) (_ false)))
           (testing:check (match (ints-reserve (& items) 17) ((ok) true) (_ false)))
           (testing:check (n:eq (support:attempts) 1)))))
      (do (ints-destroy (& items)) observed))))

(testing:test append-4096-elements-verifies-every-value
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 4096)
           (testing:check (n:eq (ints-length items) 4096))
           (verify items 0 4096)
           (testing:check (n:ge (ints-capacity items) 4096)))))
      (do (ints-destroy (& items)) observed))))

(testing:test prepend-512-elements-preserves-reverse-order
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (prepend (& items) 0)
           (verify-reversed items 0)
           (testing:check (n:eq (ints-length items) 512)))))
      (do (ints-destroy (& items)) observed))))

(testing:test remove-every-front-element-preserves-order
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 512)
           (drain-front (& items) 0 512 (testing:empty))
           (testing:check (n:eq (ints-length items) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test empty-rejects-get
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-get items 0) ((tuple false _) true) (_ false)))
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (support:attempts) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test empty-rejects-remove
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-remove (& items) 0) ((bounds) true) (_ false)))
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (support:attempts) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test empty-rejects-replace
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-replace items 0 99) ((bounds) true) (_ false)))
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (support:attempts) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test empty-rejects-insert-past-end
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (ints-insert (& items) 1 99) ((bounds) true) (_ false)))
           (testing:check (n:eq (ints-length items) 0))
           (testing:check (n:eq (support:attempts) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test get-rejects-index-3
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 3)
           (testing:check (match (ints-get items 3) ((tuple false _) true) (_ false)))
           (verify items 0 3))))
      (do (ints-destroy (& items)) observed))))

(testing:test get-rejects-maximum-index
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 3)
           (testing:check
             (match (ints-get items (base:maxBound)) ((tuple false _) true) (_ false)))
           (verify items 0 3))))
      (do (ints-destroy (& items)) observed))))

(testing:test insert-at-end-is-append
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 3)
           (testing:check (match (ints-insert (& items) 3 54) ((ok) true) (_ false)))
           (verify items 0 4))))
      (do (ints-destroy (& items)) observed))))

(testing:test insert-middle-shifts-entire-tail
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 3)
           (testing:check (match (ints-insert (& items) 1 99) ((ok) true) (_ false)))
           (testing:check (match (ints-get items 1) ((tuple true p) (n:eq (deref p) 99)) (_ false)))
           (testing:check (match (ints-get items 3) ((tuple true p) (n:eq (deref p) 37)) (_ false)))
           (testing:check (match (ints-remove (& items) 1) ((ok) true) (_ false)))
           (verify items 0 3))))
      (do (ints-destroy (& items)) observed))))

(testing:test replace-changes-only-selected-element
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 3)
           (testing:check (match (ints-replace items 1 99) ((ok) true) (_ false)))
           (testing:check (match (ints-get items 0) ((tuple true p) (n:eq (deref p) 3)) (_ false)))
           (testing:check (match (ints-get items 1) ((tuple true p) (n:eq (deref p) 99)) (_ false)))
           (testing:check (match (ints-get items 2) ((tuple true p) (n:eq (deref p) 37)) (_ false)))
           (testing:check (n:eq (ints-length items) 3)))))
      (do (ints-destroy (& items)) observed))))

(testing:test clear-retains-capacity-for-reuse
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 512)
           (do (ints-clear (& items)) (support:limit 0) (populate (& items) 0 512))
           (verify items 0 512))))
      (do (ints-destroy (& items)) observed))))

(testing:test copy-owns-independent-storage
  (let ((items integers (empty)) (copy integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 512)
           (testing:check (match (ints-copy-into items (& copy)) ((ok) true) (_ false)))
           (testing:check (match (ints-replace items 0 999) ((ok) true) (_ false)))
           (do (ints-destroy (& items)) (verify copy 0 512)))))
      (do (ints-destroy (& items)) (ints-destroy (& copy)) observed))))

(testing:test visitor-sees-each-element-once-in-order
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 1024)
           (do
             (assign visit-index 0)
             (assign visit-errors 0)
             (ints-visit items visit)
             (testing:check (n:eq visit-index 1024)))
           (testing:check (n:eq visit-errors 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test empty-visitor-is-not-called
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (do (assign visit-index 0) (ints-visit items visit) (testing:check (n:eq visit-index 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test failed-growth-preserves-length-capacity-and-values
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 4)
           (do
             (support:limit 0)
             (testing:check
               (match (ints-append (& items) 71) ((allocation-error reason) true) (_ false))))
           (testing:check (n:eq (ints-length items) 4))
           (testing:check (n:eq (ints-capacity items) 4))
           (verify items 0 4))))
      (do (ints-destroy (& items)) observed))))

(testing:test failed-insert-preserves-contents
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 4)
           (do
             (support:limit 0)
             (testing:check
               (match (ints-insert (& items) 1 99) ((allocation-error reason) true) (_ false))))
           (verify items 0 4)
           (testing:check (n:eq (ints-length items) 4)))))
      (do (ints-destroy (& items)) observed))))

(testing:test overflowing-reserve-never-calls-allocator
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (ints-reserve (& items) (base:maxBound)) ((overflow) true) (_ false)))
           (testing:check (n:eq (support:attempts) 0))
           (testing:check (n:eq (ints-capacity items) 0)))))
      (do (ints-destroy (& items)) observed))))

(testing:test failed-copy-preserves-existing-destination
  (let ((items integers (empty)) (copy integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 512)
           (populate (& copy) 0 3)
           (do
             (support:limit 0)
             (testing:check
               (match (ints-copy-into items (& copy)) ((allocation-error reason) true) (_ false))))
           (verify copy 0 3)
           (testing:check (n:eq (ints-length copy) 3)))))
      (do (ints-destroy (& items)) (ints-destroy (& copy)) observed))))

(testing:test destroy-is-idempotent-and-owner-can-be-reused
  (let ((items integers (empty)))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& items) 0 100)
           (do
             (ints-destroy (& items))
             (ints-destroy (& items))
             (testing:check (n:eq (support:outstanding) 0)))
           (populate (& items) 0 100)
           (verify items 0 100))))
      (do (ints-destroy (& items)) observed))))

(export
  empty-does-not-allocate
  reserve-preserves-zero-logical-length
  smaller-reserve-does-not-reallocate
  append-4096-elements-verifies-every-value
  prepend-512-elements-preserves-reverse-order
  remove-every-front-element-preserves-order
  empty-rejects-get
  empty-rejects-remove
  empty-rejects-replace
  empty-rejects-insert-past-end
  get-rejects-index-3
  get-rejects-maximum-index
  insert-at-end-is-append
  insert-middle-shifts-entire-tail
  replace-changes-only-selected-element
  clear-retains-capacity-for-reuse
  copy-owns-independent-storage
  visitor-sees-each-element-once-in-order
  empty-visitor-is-not-called
  failed-growth-preserves-length-capacity-and-values
  failed-insert-preserves-contents
  overflowing-reserve-never-calls-allocator
  failed-copy-preserves-existing-destination
  destroy-is-idempotent-and-owner-can-be-reused)
