(testing:test initial-allocation-failure-leaves-empty-table
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (do
             (support:limit 0)
             (testing:check
               (match (map-insert (& table) 1 2) ((allocation-error reason) true) (_ false))))
           (testing:check (n:eq (map-count table) 0))
           (testing:check (n:eq (map-capacity table) 0)))))
      (do (map-destroy (& table)) observed))))

(testing:test failed-rehash-preserves-every-key-and-value
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 4)
           (do
             (support:limit 0)
             (testing:check
               (match (map-insert (& table) 4 71) ((allocation-error reason) true) (_ false))))
           (verify table 0 4)
           (testing:check (n:eq (map-count table) 4))
           (testing:check (n:eq (map-capacity table) 8))
           (testing:check (match (map-contains table 4) (true false) (false true)))
           (do
             (support:limit 1)
             (testing:check (match (map-insert (& table) 4 71) ((ok) true) (_ false))))
           (verify table 0 5))))
      (do (map-destroy (& table)) observed))))

