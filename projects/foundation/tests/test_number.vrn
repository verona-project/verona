  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (number:format-u64 999 (& out)) ((ok) true) (_ false)))
           (testing:check (data:equal (data:borrow out) (data:view "999" 3))))))
