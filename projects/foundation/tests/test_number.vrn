  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (number:format-u64 1000 (& out)) ((ok) true) (_ false)))
           (testing:check (data:equal (data:borrow out) (data:view "1000" 4))))))
      (do (data:destroy (& out)) observed))))

(testing:test format-10000000000000000000
  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (number:format-u64 10000000000000000000 (& out)) ((ok) true) (_ false)))
           (testing:check (data:equal (data:borrow out) (data:view "10000000000000000000" 20))))))
      (do (data:destroy (& out)) observed))))

(testing:test format-unsigned-maximum
  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (number:format-u64 (base:maxBound) (& out)) ((ok) true) (_ false)))
           (testing:check (data:equal (data:borrow out) (data:view "18446744073709551615" 20))))))
      (do (data:destroy (& out)) observed))))

(testing:test format-replaces-longer-previous-number
  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (number:format-u64 (base:maxBound) (& out)) ((ok) true) (_ false)))
           (testing:check (match (number:format-u64 7 (& out)) ((ok) true) (_ false)))
           (testing:check (data:equal (data:borrow out) (data:view "7" 1))))))
      (do (data:destroy (& out)) observed))))

(testing:test format-failure-preserves-destination
  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (data:assign-bytes (& out) (data:view "old" 3)) ((ok) true) (_ false)))
           (do
             (support:limit 0)
             (testing:check
               (match (number:format-u64 42 (& out)) ((allocation-error reason) true) (_ false))))
           (testing:check (data:equal (data:borrow out) (data:view "old" 3))))))
      (do (data:destroy (& out)) observed))))

(testing:test thousands-of-format-parse-roundtrips
  (let ((out data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (roundtrips (& out) 0 (testing:empty))
           (testing:check (n:eq (support:attempts) 1)))))
      (do (data:destroy (& out)) observed))))

