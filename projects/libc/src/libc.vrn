(import base)

;; Build aggregator for the libc category modules.  Import the category that
;; owns an API, such as libc.network or libc.descriptor, in client code.
(import libc.types)
(import libc.constants)
(import libc.memory)
(import libc.string)
(import libc.stdio)
(import libc.descriptor)
(import libc.filesystem)
(import libc.process)
(import libc.time)
(import libc.math)
(import libc.network)
(import libc.pthread)
