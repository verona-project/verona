(import base)
(import testing)

(base:function lower (for (a) ((base:bounded a))) ((witness a)) a (minBound))
(base:function upper (for (a) ((base:bounded a))) ((witness a)) a (maxBound))
(base:function character-code ((value char)) u32 value)
(base:function consume-unit ((value unit)) bool true)

; No equality or ordering instance is defined for these user types.
(base:type color (sum (red) (green) (blue)))
(base:implementation (base:bounded color)
  (function minBound () color (red))
  (function maxBound () color (blue)))
(base:type box (product (value i8) (flag bool)))
(base:implementation (base:bounded box)
  (function minBound () box (box (base:minBound) (base:minBound)))
  (function maxBound () box (box (base:maxBound) (base:maxBound))))
(base:implementation (base:bounded (tuple i8 bool))
  (function minBound () (tuple i8 bool) (tuple (base:minBound) (base:minBound)))
  (function maxBound () (tuple i8 bool) (tuple (base:maxBound) (base:maxBound))))
(base:type singleton (sum (only)))
(base:implementation (base:bounded singleton)
  (function minBound () singleton (only))
  (function maxBound () singleton (only)))

(testing:test i8-minimum
  (let ((actual i8 (base:minBound)) (expected i8 -128))
    (testing:assert-equal actual expected)))

(testing:test i8-maximum
  (let ((actual i8 (base:maxBound)) (expected i8 127))
    (testing:assert-equal actual expected)))

(testing:test i16-minimum
  (let ((actual i16 (base:minBound)) (expected i16 -32768))
    (testing:assert-equal actual expected)))

(testing:test i16-maximum
  (let ((actual i16 (base:maxBound)) (expected i16 32767))
    (testing:assert-equal actual expected)))

(testing:test i32-minimum
  (let ((actual i32 (base:minBound)) (expected i32 -2147483648))
    (testing:assert-equal actual expected)))

(testing:test i32-maximum
  (let ((actual i32 (base:maxBound)) (expected i32 2147483647))
    (testing:assert-equal actual expected)))

(testing:test i64-minimum
  (let ((actual i64 (base:minBound)) (expected i64 -9223372036854775808))
    (testing:assert-equal actual expected)))

(testing:test i64-maximum
  (let ((actual i64 (base:maxBound)) (expected i64 9223372036854775807))
    (testing:assert-equal actual expected)))

(testing:test u8-minimum
  (let ((actual u8 (base:minBound)) (expected u8 0))
    (testing:assert-equal actual expected)))

(testing:test u8-maximum
  (let ((actual u8 (base:maxBound)) (expected u8 255))
    (testing:assert-equal actual expected)))

(testing:test u16-minimum
  (let ((actual u16 (base:minBound)) (expected u16 0))
    (testing:assert-equal actual expected)))

(testing:test u16-maximum
  (let ((actual u16 (base:maxBound)) (expected u16 65535))
    (testing:assert-equal actual expected)))

(testing:test u32-minimum
  (let ((actual u32 (base:minBound)) (expected u32 0))
    (testing:assert-equal actual expected)))

(testing:test u32-maximum
  (let ((actual u32 (base:maxBound)) (expected u32 4294967295))
    (testing:assert-equal actual expected)))

(testing:test u64-minimum
  (let ((actual u64 (base:minBound)) (expected u64 0))
    (testing:assert-equal actual expected)))

(testing:test u64-maximum
  (let ((actual u64 (base:maxBound)) (expected u64 18446744073709551615))
    (testing:assert-equal actual expected)))

(testing:test base-int-minimum
  (let ((actual base:int (base:minBound)) (expected base:int -9223372036854775808))
    (testing:assert-equal actual expected)))

(testing:test base-int-maximum
  (let ((actual base:int (base:maxBound)) (expected base:int 9223372036854775807))
    (testing:assert-equal actual expected)))

(testing:test exit-code-minimum
  (let ((actual exit-code (base:minBound)) (expected exit-code -2147483648))
    (testing:assert-equal actual expected)))

(testing:test exit-code-maximum
  (let ((actual exit-code (base:maxBound)) (expected exit-code 2147483647))
    (testing:assert-equal actual expected)))

#+pointer_32
(testing:test isize-minimum
  (let ((actual isize (base:minBound)) (expected isize -2147483648)) (testing:assert-equal actual expected)))

#+pointer_32
(testing:test isize-maximum
  (let ((actual isize (base:maxBound)) (expected isize 2147483647)) (testing:assert-equal actual expected)))

#+pointer_32
(testing:test usize-minimum
  (let ((actual usize (base:minBound)) (expected usize 0)) (testing:assert-equal actual expected)))

#+pointer_32
(testing:test usize-maximum
  (let ((actual usize (base:maxBound)) (expected usize 4294967295)) (testing:assert-equal actual expected)))

#+pointer_64
(testing:test isize-minimum
  (let ((actual isize (base:minBound)) (expected isize -9223372036854775808)) (testing:assert-equal actual expected)))

#+pointer_64
(testing:test isize-maximum
  (let ((actual isize (base:maxBound)) (expected isize 9223372036854775807)) (testing:assert-equal actual expected)))

#+pointer_64
(testing:test usize-minimum
  (let ((actual usize (base:minBound)) (expected usize 0)) (testing:assert-equal actual expected)))

#+pointer_64
(testing:test usize-maximum
  (let ((actual usize (base:maxBound)) (expected usize 18446744073709551615)) (testing:assert-equal actual expected)))

(testing:test bool-minimum
  (let ((value bool (base:minBound))) (match value (false (testing:pass)) (true (testing:fail)))))

(testing:test unit-minimum
  (let ((value unit (base:minBound))) (testing:check (consume-unit value))))

(testing:test char-minimum
  (let ((actual u32 (character-code (base:minBound))) (expected u32 0)) (testing:assert-equal actual expected)))

(testing:test order-minimum
  (let ((value base:order (base:minBound))) (match value ((less) (testing:pass)) (_ (testing:fail)))))

(testing:test custom-enum-minimum
  (let ((value color (base:minBound))) (match value ((red) (testing:pass)) (_ (testing:fail)))))

(testing:test singleton-minimum
  (let ((value singleton (base:minBound))) (match value ((only) (testing:pass)))))

(testing:test product-minimum
  (let ((value box (base:minBound)) (expected i8 -128))
    (testing:checks
      (testing:assert-equal (field value value) expected)
      (match (field value flag) (false (testing:pass)) (true (testing:fail))))))

(testing:test concrete-tuple-minimum
  (let ((value (tuple i8 bool) (base:minBound)) (expected i8 -128))
    (testing:checks
      (testing:assert-equal (tuple-get value 0) expected)
      (match (tuple-get value 1) (false (testing:pass)) (true (testing:fail))))))

(testing:test bool-maximum
  (let ((value bool (base:maxBound))) (match value (true (testing:pass)) (false (testing:fail)))))

(testing:test unit-maximum
  (let ((value unit (base:maxBound))) (testing:check (consume-unit value))))

(testing:test char-maximum
  (let ((actual u32 (character-code (base:maxBound))) (expected u32 127)) (testing:assert-equal actual expected)))

(testing:test order-maximum
  (let ((value base:order (base:maxBound))) (match value ((greater) (testing:pass)) (_ (testing:fail)))))

(testing:test custom-enum-maximum
  (let ((value color (base:maxBound))) (match value ((blue) (testing:pass)) (_ (testing:fail)))))

(testing:test singleton-maximum
  (let ((value singleton (base:maxBound))) (match value ((only) (testing:pass)))))

(testing:test product-maximum
  (let ((value box (base:maxBound)) (expected i8 127))
    (testing:checks
      (testing:assert-equal (field value value) expected)
      (match (field value flag) (true (testing:pass)) (false (testing:fail))))))

(testing:test concrete-tuple-maximum
  (let ((value (tuple i8 bool) (base:maxBound)) (expected i8 127))
    (testing:checks
      (testing:assert-equal (tuple-get value 0) expected)
      (match (tuple-get value 1) (true (testing:pass)) (false (testing:fail))))))

(testing:test constrained-i8
  (let ((witness i8 0) (lo i8 (lower witness)) (hi i8 (upper witness))
       (expected-lo i8 -128) (expected-hi i8 127))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-i16
  (let ((witness i16 0) (lo i16 (lower witness)) (hi i16 (upper witness))
       (expected-lo i16 -32768) (expected-hi i16 32767))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-i32
  (let ((witness i32 0) (lo i32 (lower witness)) (hi i32 (upper witness))
       (expected-lo i32 -2147483648) (expected-hi i32 2147483647))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-i64
  (let ((witness i64 0) (lo i64 (lower witness)) (hi i64 (upper witness))
       (expected-lo i64 -9223372036854775808) (expected-hi i64 9223372036854775807))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-u8
  (let ((witness u8 0) (lo u8 (lower witness)) (hi u8 (upper witness))
       (expected-lo u8 0) (expected-hi u8 255))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-u16
  (let ((witness u16 0) (lo u16 (lower witness)) (hi u16 (upper witness))
       (expected-lo u16 0) (expected-hi u16 65535))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-u32
  (let ((witness u32 0) (lo u32 (lower witness)) (hi u32 (upper witness))
       (expected-lo u32 0) (expected-hi u32 4294967295))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-u64
  (let ((witness u64 0) (lo u64 (lower witness)) (hi u64 (upper witness))
       (expected-lo u64 0) (expected-hi u64 18446744073709551615))
    (testing:checks (testing:assert-equal lo expected-lo) (testing:assert-equal hi expected-hi))))

(testing:test constrained-custom-without-ordering
  (let ((witness color (green)) (lo color (lower witness)) (hi color (upper witness)))
    (testing:checks (match lo ((red) (testing:pass)) (_ (testing:fail)))
      (match hi ((blue) (testing:pass)) (_ (testing:fail))))))

(testing:test constrained-character
  (let ((witness char #\space) (lo u32 (character-code (lower witness)))
       (hi u32 (character-code (upper witness))) (zero u32 0) (last u32 127))
    (testing:checks (testing:assert-equal lo zero) (testing:assert-equal hi last))))

(testing:runner main
  (i8-minimum)
  (i8-maximum)
  (i16-minimum)
  (i16-maximum)
  (i32-minimum)
  (i32-maximum)
  (i64-minimum)
  (i64-maximum)
