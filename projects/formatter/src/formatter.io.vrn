(import base)
(import allocator)
(import foundation.compat.arithmetic)
(import foundation.compat.arithmetic :as n)
(import foundation.compat.signed_arithmetic :as signed)
(import data)
(import libc.descriptor :as native)
(import libc.constants :as constants)
(import libc.string :as cstring)
(import formatter.model)
(import formatter.model :as m)

#+darwin (base:external-function errno-pointer "__error" () (pointer i32))

#+linux (base:external-function errno-pointer "__errno_location" () (pointer i32))

(base:function interrupted () bool
  (match (deref (errno-pointer)) (4 true) (_ false)))

(base:function read-loop ((fd i32) (input (pointer data:data)) (scratch data:data)) m:status
  (let
    ((count i64 (native:read fd (cast (pointer void) (data:bytes scratch)) (data:length scratch))))
    (match (signed:lt count 0)
      (true
        (match (interrupted) (true (read-loop fd input scratch)) (false (m:io "cannot read input"))))
      (false
        (match (signed:eq count 0)
          (true (m:success))
          (false
            (let ((size u64 (base:convert count)) (old u64 (data:length (deref input))))
              (match (n:gt size (n:sub 16777216 old))
                (true (m:limit old "input limit (16 MiB) exceeded"))
                (false
                  (m:steps
                    ; Reserve geometrically so streaming a large file remains linear.
                    (m:from-storage
                      (data:reserve
                        input
                        (match (n:le (n:add old size) (tuple-get (deref input) 2))
                          (true (tuple-get (deref input) 2))
                          (false
                            (match (n:eq (tuple-get (deref input) 2) 0)
                              (true 8192)
                              (false (n:mul (tuple-get (deref input) 2) 2)))))))
                    (m:from-storage (data:resize input (n:add old size)))
                    (do
                      (allocator:copy-bytes
                        (pointer-offset (data:bytes (deref input)) old)
                        (data:bytes scratch)
                        size)
                      (m:success))
                    (read-loop fd input scratch)))))))))))

(base:function read ((fd i32) (input (pointer data:data))) m:status
  (let
    ((scratch data:data (data:empty (field (tuple-get (deref input) 3) allocator)))
     (result
       m:status
       (m:steps (m:from-storage (data:resize (& scratch) 8192)) (read-loop fd input scratch))))
    (do (data:destroy (& scratch)) result)))

(base:function load ((path (pointer u8)) (input (pointer data:data))) m:status
  (match (cstring:strcmp path "-")
    (0 (read 0 input))
    (_
      (let ((fd i32 (native:open path constants:O-RDONLY 0)))
        (match fd
          (-1 (m:io "cannot open input"))
          (_
            (let ((result m:status (read fd input)) (closed i32 (native:close fd)))
              (match result
                ((ok) (match closed (0 (m:success)) (_ (m:io "cannot close input"))))
                (failure failure)))))))))

(base:function write ((fd i32) (view data:view)) m:status
  (match (n:eq (field view length) 0)
    (true (m:success))
    (false
      (let
        ((count i64 (native:write fd (cast (pointer void) (field view bytes)) (field view length))))
        (match (signed:lt count 0)
          (true (match (interrupted) (true (write fd view)) (false (m:io "cannot write output"))))
          (false
            (match (signed:eq count 0)
              (true (m:io "output made no progress"))
              (false
                (let ((size u64 (base:convert count)))
                  (write
                    fd
                    (data:view
                      (pointer-offset (field view bytes) size)
                      (n:sub (field view length) size))))))))))))

(base:function text ((fd i32) (value (pointer u8))) m:status
  (write fd (data:view value (cstring:strlen value))))

(base:function number ((fd i32) (value u64)) m:status
  (let ((digit u8 (base:convert (n:add 48 (n:sub value (n:mul (n:div value 10) 10))))))
    (m:steps
      (match (n:ge value 10) (true (number fd (n:div value 10))) (false (m:success)))
      (write fd (data:view (& digit) 1)))))

(export load write text number)
