(import base)
(import llvm.types :as t)
(import llvm.core :as core)
(import llvm.enums :as enum)

(base:external-function default-triple "LLVMGetDefaultTargetTriple" () (pointer u8))

(base:external-function
  from-triple
  "LLVMGetTargetFromTriple"
  ((pointer u8) (pointer t:target-ref) (pointer (pointer u8)))
  t:boolean)

(base:external-function
  machine-create
  "LLVMCreateTargetMachine"
  (t:target-ref (pointer u8) (pointer u8) (pointer u8) i32 i32 i32)
  t:machine-ref)

(base:external-function machine-dispose "LLVMDisposeTargetMachine" (t:machine-ref) void)

(base:external-function machine-layout "LLVMCreateTargetDataLayout" (t:machine-ref) t:layout-ref)

(base:external-function
  module-layout-set
  "LLVMSetModuleDataLayout"
  (t:module-ref t:layout-ref)
  void)

(base:external-function layout-dispose "LLVMDisposeTargetData" (t:layout-ref) void)

(base:external-function abi-size "LLVMABISizeOfType" (t:layout-ref t:type-ref) u64)

(base:external-function abi-align "LLVMABIAlignmentOfType" (t:layout-ref t:type-ref) u32)

(base:external-function element-offset "LLVMOffsetOfElement" (t:layout-ref t:type-ref u32) u64)

(base:external-function
  emit-file
  "LLVMTargetMachineEmitToFile"
  (t:machine-ref t:module-ref (pointer u8) i32 (pointer (pointer u8)))
  t:boolean)

; Explicit target selection initializes the two architectures supported by
; the Verona compiler's current 64-bit C ABI classifier.
(base:external-function init-aarch64-info "LLVMInitializeAArch64TargetInfo" () void)

(base:external-function init-aarch64 "LLVMInitializeAArch64Target" () void)

(base:external-function init-aarch64-mc "LLVMInitializeAArch64TargetMC" () void)

(base:external-function init-aarch64-printer "LLVMInitializeAArch64AsmPrinter" () void)

(base:external-function init-x86-info "LLVMInitializeX86TargetInfo" () void)

(base:external-function init-x86 "LLVMInitializeX86Target" () void)

(base:external-function init-x86-mc "LLVMInitializeX86TargetMC" () void)

(base:external-function init-x86-printer "LLVMInitializeX86AsmPrinter" () void)

(base:external-function pointer-size "LLVMPointerSize" (t:layout-ref) u32)

(base:external-function layout-string "LLVMCopyStringRepOfTargetData" (t:layout-ref) (pointer u8))

(base:function machine-for-triple-with-options
  ((module t:module-ref)
   (triple (pointer u8))
   (cpu (pointer u8))
   (features (pointer u8))
   (optimization i32)
   (out-message (pointer (pointer u8)))) t:machine-ref
  (let ((target t:target-ref (cast t:target-ref (null-pointer))))
    (do
      (init-aarch64-info)
      (init-aarch64)
      (init-aarch64-mc)
      (init-aarch64-printer)
      (init-x86-info)
      (init-x86)
      (init-x86-mc)
      (init-x86-printer)
      (match (from-triple triple (& target) out-message)
        (0
          (let
            ((machine
               t:machine-ref
               (machine-create
                 target
                 triple
                 cpu
                 features
                 optimization
                 enum:reloc-pic
                 enum:code-model-default)))
            (do
              (match (base:is-null machine)
                (true
                  (store
                    (deref out-message)
                    (core:message-create "LLVM could not create a target machine")))
                (false
                  (let ((layout t:layout-ref (machine-layout machine)))
                    (do
                      (core:module-target module triple)
                      (module-layout-set module layout)
                      (layout-dispose layout)
                      unit))))
              machine)))
        (_ (cast t:machine-ref (null-pointer)))))))

; Preserve the generic target defaults for existing binding consumers.
(base:function machine-for-triple
  ((module t:module-ref)
   (triple (pointer u8))
   (optimization i32)
   (out-message (pointer (pointer u8)))) t:machine-ref
  (machine-for-triple-with-options module triple "generic" "" optimization out-message))

; LLVMInitializeNativeTarget is a header inline function, not a library symbol.
(base:function initialize-native () unit
  (do
    (init-aarch64-info)
    (init-aarch64)
    (init-aarch64-mc)
    (init-aarch64-printer)
    (init-x86-info)
    (init-x86)
    (init-x86-mc)
    (init-x86-printer)
    unit))

; On success the caller owns the machine. On failure OUT-MESSAGE owns an LLVM
; message. Both outputs start null; strings assigned here use LLVMCreateMessage.
(base:function native-machine-with-optimization
  ((module t:module-ref) (optimization i32) (out-message (pointer (pointer u8)))) t:machine-ref
  (let
    ((triple (pointer u8) (default-triple))
     (target t:target-ref (cast t:target-ref (null-pointer))))
    (do
      (initialize-native)
      (match (base:is-null triple)
        (true
          (do
            (store
              (deref out-message)
              (core:message-create "LLVM could not determine the host triple"))
            (cast t:machine-ref (null-pointer))))
        (false
          (let ((status t:boolean (from-triple triple (& target) out-message)))
            (match status
              (0
                (let
                  ((machine
                     t:machine-ref
                     (machine-create
                       target
                       triple
                       "generic"
                       ""
                       optimization
                       enum:reloc-pic
                       enum:code-model-default)))
                  (do
                    (match (base:is-null machine)
                      (true
                        (store
                          (deref out-message)
                          (core:message-create "LLVM could not create a host target machine")))
                      (false
                        (let ((layout t:layout-ref (machine-layout machine)))
                          (do
                            (core:module-target module triple)
                            (module-layout-set module layout)
                            (layout-dispose layout)
                            unit))))
                    (core:message-dispose triple)
                    machine)))
              (_ (do (core:message-dispose triple) (cast t:machine-ref (null-pointer)))))))))))

; Preserve the original default for existing binding consumers.
(base:function native-machine ((module t:module-ref) (out-message (pointer (pointer u8))))
  t:machine-ref
  (native-machine-with-optimization module enum:codegen-default out-message))

(base:function null-pointer () (pointer void)
  (let ((zero usize 0)) (deref (cast (pointer (pointer void)) (cast (pointer void) (& zero))))))

(export
  machine-for-triple
  machine-for-triple-with-options
  pointer-size
  layout-string
  abi-size
  abi-align
  element-offset
  default-triple
  from-triple
  machine-create
  machine-dispose
  machine-layout
  module-layout-set
  layout-dispose
  emit-file
  initialize-native
  native-machine
  native-machine-with-optimization
  null-pointer)
