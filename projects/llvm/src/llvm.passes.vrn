(import base)
(import llvm.types :as t)
(import llvm.core :as ir)
(import llvm.target :as target)

; LLVM 23 llvm-c/Transforms/PassBuilder.h and llvm-c/Error.h.
(base:external-function options-create "LLVMCreatePassBuilderOptions" () t:pass-options-ref)
(base:external-function options-dispose "LLVMDisposePassBuilderOptions" (t:pass-options-ref) void)
(base:external-function verify-each "LLVMPassBuilderOptionsSetVerifyEach"
  (t:pass-options-ref t:boolean) void)
(base:external-function run-passes "LLVMRunPasses"
  (t:module-ref (pointer u8) t:machine-ref t:pass-options-ref) t:error-ref)
(base:external-function error-message "LLVMGetErrorMessage" (t:error-ref) (pointer u8))
(base:external-function error-message-dispose "LLVMDisposeErrorMessage" ((pointer u8)) void)

; Borrow module, target machine (which may be null), and pipeline spelling.
; Consume each LLVMErrorRef exactly once. OUT-MESSAGE is null on success or
; an owned LLVM message on failure, released with llvm.core:message-dispose.
; Error strings use a distinct allocator: copy them before releasing them with
; LLVMDisposeErrorMessage. Options are released on both success and failure.
(base:function run
  ((module t:module-ref) (machine t:machine-ref) (pipeline (pointer u8))
   (out-message (pointer (pointer u8)))) i32
  (let ((options t:pass-options-ref (options-create)))
    (do
      (store (deref out-message) (cast (pointer u8) (target:null-pointer)))
      (verify-each options 1)
      (let ((error t:error-ref (run-passes module pipeline machine options)))
        (do
          (options-dispose options)
          (match (base:is-null error)
            (true 0)
            (false
              (let ((text (pointer u8) (error-message error)))
                (do
                  (store (deref out-message) (ir:message-create text))
                  (error-message-dispose text)
                  1)))))))))

(export run)
