(import base)
(import leaf :as values)

(base:macro identity (form)
  form)

(base:generic echo (value))

(base:implementation echo ((value i32)) i32
  value)

(base:protocol measure (a)
  (measure ((value a)) i32))

(base:implementation (measure i32)
  (function measure ((value i32)) i32
    value))

(base:function answer () exit-code
  (values:answer))

(export answer identity)
