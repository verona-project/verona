(import base)

;; Application defines the executable entry point. BODY is an ordinary
;; S-expression, so the generated declaration is still compiled normally.
(base:macro application (body)
  `(base:function main () exit-code ,body))

;; This is expanded in the body emitted by APPLICATION, demonstrating that
;; macros work in executable expression positions as well as at top level.
(base:macro exit-status (status)
  status)

(application (exit-status 42))
