(import base)
(import libc.descriptor :as fd)
(import libc.filesystem :as fs)
(import libc.string :as text)
(import libc.types :as types)
(import libc.process :as process)
(import libc.memory :as memory)
(import libc.stdio :as stdio)

;; Process-local directory change keeps generated paths independent of name length.
(base:external-function chdir "chdir" ((pointer u8)) i32)

;; CREAT has a fixed C ABI, including on Darwin ARM64.
(base:external-function creat "creat" ((pointer u8) types:mode-t) i32)

(base:function size-zero-generic (for (a) ((base:equality a))) ((left a) (right a)) bool
  (= left right))

(base:function size-zero ((left usize) (right usize)) bool
  (size-zero-generic left right))

(base:function positive-generic (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (> left right))

(base:function positive ((left isize) (right isize)) bool
  (positive-generic left right))

(base:function subtract-size-generic (for (a) ((base:numeric a))) ((left a) (right a)) a
  (- left right))

(base:function subtract-size ((left usize) (right usize)) usize
  (subtract-size-generic left right))

(base:function byte-ge-generic (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (>= left right))

(base:function byte-ge ((left u8) (right u8)) bool
  (byte-ge-generic left right))

(base:function byte-le-generic (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (<= left right))

(base:function byte-le ((left u8) (right u8)) bool
  (byte-le-generic left right))

(base:function int-eq-generic (for (a) ((base:equality a))) ((left a) (right a)) bool
  (= left right))

(base:function int-eq ((left i32) (right i32)) bool
  (int-eq-generic left right))

(base:function int-lt-generic (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (< left right))

(base:function int-lt ((left i32) (right i32)) bool
  (int-lt-generic left right))

(base:function write-all ((descriptor i32) (value (pointer u8)) (length usize)) bool
  (match (size-zero length 0)
    (true true)
    (false
      (let ((written isize (fd:write descriptor (cast (pointer void) value) length)))
        (match (positive written 0)
          (false false)
          (true
            (let ((count usize (base:convert written)))
              (write-all descriptor (pointer-offset value count) (subtract-size length count)))))))))

(base:function emit ((descriptor i32) (value (pointer u8))) bool
  (write-all descriptor value (text:strlen value)))

(base:function fail ((message (pointer u8))) exit-code
  (do (emit 2 "verona-project: ") (emit 2 message) (emit 2 "\n") 1))

(base:function letter ((byte u8)) bool
  (match (byte-ge byte 65)
    (false false)
    (true
      (match (byte-le byte 90)
        (true true)
        (false (match (byte-ge byte 97) (false false) (true (byte-le byte 122))))))))

(base:function valid-tail ((value (pointer u8))) bool
  (let ((byte u8 (deref value)))
    (match byte
      (0 true)
      (_
        (match (letter byte)
          (true (valid-tail (pointer-offset value 1)))
          (false
            (match byte
              (45 (valid-tail (pointer-offset value 1)))
              (95 (valid-tail (pointer-offset value 1)))
              (_
                (match (byte-ge byte 48)
                  (false false)
                  (true
                    (match (byte-le byte 57)
                      (false false)
                      (true (valid-tail (pointer-offset value 1))))))))))))))

(base:macro step (operation rest)
  `(match ,operation (true ,rest) (false false)))

(base:macro steps (&rest actions)
  (compiler:reduce-right 'step 'true actions))

(base:function build-file ((name (pointer u8))) bool
  (let ((descriptor i32 (creat "verona.build" 420)))
    (match descriptor
      (-1 false)
      (_
        (let
          ((written
             bool
             (steps
               (emit descriptor "(executable ")
               (emit descriptor name)
               (emit descriptor "\n  (root main)\n  (module-path \"src\"))\n")))
           (closed i32 (fd:close descriptor)))
          (match written (false false) (true (int-eq closed 0))))))))

(base:function plain-file ((path (pointer u8)) (content (pointer u8))) bool
  (let ((descriptor i32 (creat path 420)))
    (match descriptor
      (-1 false)
      (_
        (let ((written bool (emit descriptor content)) (closed i32 (fd:close descriptor)))
          (match written (false false) (true (int-eq closed 0))))))))

(base:function readme-file ((name (pointer u8))) bool
  (let ((descriptor i32 (creat "README.md" 420)))
    (match descriptor
      (-1 false)
      (_
        (let
          ((written
             bool
             (steps
               (emit descriptor "# ")
               (emit descriptor name)
               (emit descriptor "\n\nBuild and run with Verona installed:\n\n```sh\nverona build ")
               (emit descriptor name)
               (emit descriptor " ./build\n./build/")
               (emit descriptor name)
               (emit descriptor "\n```\n")))
           (closed i32 (fd:close descriptor)))
          (match written (false false) (true (int-eq closed 0))))))))

(base:function create-project ((name (pointer u8))) exit-code
  (match (letter (deref name))
    (false (fail "project name must start with a letter"))
    (true
      (match (valid-tail name)
        (false (fail "project name may contain only ASCII letters, digits, - or _"))
        (true
          (match (fs:mkdir name 493)
            (0
              (match (chdir name)
                (0
                  (match (fs:mkdir "src" 493)
                    (0
                      (match
                        (steps
                          (build-file name)
                          (plain-file "src/main.vrn" "(function main () exit-code\n  0)\n")
                          (plain-file ".gitignore" "/build/\n")
                          (readme-file name))
                        (true (do (emit 1 "Created ") (emit 1 name) (emit 1 "\n") 0))
                        (false (fail "could not write project files"))))
                    (_ (fail "could not create source directory"))))
                (_ (fail "could not enter project directory"))))
            (_ (fail "destination already exists or cannot be created"))))))))

;; Intel Darwin requires inode64 symbols; ARM Darwin uses them by default.
#+darwin #+x86_64
(base:external-function read-entry "readdir$INODE64" ((pointer types:directory-stream)) (pointer u8))
#+darwin #+aarch64
(base:function read-entry ((directory (pointer types:directory-stream))) (pointer u8)
  (cast (pointer u8) (fs:readdir directory)))
#+linux
(base:function read-entry ((directory (pointer types:directory-stream))) (pointer u8)
  (cast (pointer u8) (fs:readdir directory)))
#+darwin
(base:external-function errno-pointer "__error" () (pointer i32))
#+linux
(base:external-function errno-pointer "__errno_location" () (pointer i32))

;; d_name follows the fixed dirent prefix on the supported 64-bit targets.
#+darwin
(base:function entry-name ((entry (pointer u8))) (pointer u8)
  (pointer-offset entry 21))
#+linux
(base:function entry-name ((entry (pointer u8))) (pointer u8)
  (pointer-offset entry 19))

;; Pointer equality is not yet exposed by Base. Read the pointer representation
;; through a pointer-sized integer on the supported native targets.
(base:function pointer-bits ((value (pointer void))) usize
  (deref (cast (pointer usize) (cast (pointer void) (& value)))))

#+darwin #+x86_64
(base:external-function open-directory "opendir$INODE64" ((pointer u8)) (pointer types:directory-stream))
#+darwin #+aarch64
(base:function open-directory ((name (pointer u8))) (pointer types:directory-stream)
  (fs:opendir name))
#+linux
(base:function open-directory ((name (pointer u8))) (pointer types:directory-stream)
  (fs:opendir name))

;; Four pointers and a flag, padded to 40 bytes on supported 64-bit targets.
(base:type library-record
  (product (next (pointer void)) (name (pointer u8)) (version (pointer u8)) (manifest (pointer void)) (unversioned bool)))

(base:function add-size-generic (for (a) ((base:numeric a))) ((left a) (right a)) a
  (+ left right))
(base:function add-size ((left usize) (right usize)) usize
  (add-size-generic left right))

(base:function digit ((byte u8)) bool
  (match (byte-ge byte 48) (false false) (true (byte-le byte 57))))

(base:function skip-digits ((value (pointer u8))) (pointer u8)
  (match (digit (deref value))
    (true (skip-digits (pointer-offset value 1))) (false value)))

;; A version starts with three numeric components; retain any release suffix.
(base:function version-component ((value (pointer u8)) (remaining i32)) bool
  (match (digit (deref value))
    (false false)
    (true
      (let ((end (pointer u8) (skip-digits value)))
        (match remaining
          (0 (match (deref end) (0 true) (45 true) (43 true) (_ false)))
          (_ (match (deref end)
               (46 (version-component (pointer-offset end 1) (match remaining (2 1) (_ 0))))
               (_ false))))))))

(base:function split-version ((value (pointer u8))) (pointer u8)
  (match (deref value)
    (0 value)
    (45 (match (version-component (pointer-offset value 1) 2)
          (true (do (store (deref value) 0) (pointer-offset value 1)))
          (false (split-version (pointer-offset value 1)))))
    (_ (split-version (pointer-offset value 1)))))

;; A small non-evaluating manifest reader. Token kinds: EOF=0, open=1,
;; close=2, atom=3, string=4, invalid=5. Comments and quoted strings are
;; consumed as tokens, so text resembling a version inside them is ignored.
(base:type manifest-token
  (product (kind i32) (value (pointer u8)) (length usize) (next (pointer u8))))

(base:function token-end ((kind i32) (value (pointer u8)) (length usize) (next (pointer u8))) manifest-token
  (manifest-token kind value length next))

(base:function skip-comment ((value (pointer u8))) (pointer u8)
  (match (deref value)
    (0 value) (10 value) (13 value)
    (_ (skip-comment (pointer-offset value 1)))))

(base:function manifest-space ((value (pointer u8))) (pointer u8)
  (match (deref value)
    (9 (manifest-space (pointer-offset value 1)))
    (10 (manifest-space (pointer-offset value 1)))
    (13 (manifest-space (pointer-offset value 1)))
    (32 (manifest-space (pointer-offset value 1)))
    (59 (manifest-space (skip-comment value)))
    (_ value)))

(base:function manifest-atom ((start (pointer u8)) (value (pointer u8)) (length usize)) manifest-token
  (match (deref value)
    (0 (token-end 3 start length value))
    (9 (token-end 3 start length value))
    (10 (token-end 3 start length value))
    (13 (token-end 3 start length value))
    (32 (token-end 3 start length value))
    (40 (token-end 3 start length value))
    (41 (token-end 3 start length value))
    (59 (token-end 3 start length value))
    (_ (manifest-atom start (pointer-offset value 1) (add-size length 1)))))

(base:function manifest-string ((start (pointer u8)) (value (pointer u8)) (length usize)) manifest-token
  (match (deref value)
    (0 (token-end 5 start length value))
    (34 (token-end 4 start length (pointer-offset value 1)))
    (92 (match (deref (pointer-offset value 1))
          (0 (token-end 5 start length value))
          (_ (manifest-string start (pointer-offset value 2) (add-size length 2)))))
    (_ (manifest-string start (pointer-offset value 1) (add-size length 1)))))

(base:function manifest-read ((input (pointer u8))) manifest-token
  (let ((value (pointer u8) (manifest-space input)))
    (match (deref value)
      (0 (token-end 0 value 0 value))
      (40 (token-end 1 value 1 (pointer-offset value 1)))
      (41 (token-end 2 value 1 (pointer-offset value 1)))
      (34 (manifest-string (pointer-offset value 1) (pointer-offset value 1) 0))
      (_ (manifest-atom value value 0)))))

(base:function token-equals ((token manifest-token) (value (pointer u8))) bool
  (steps (int-eq (field token kind) 3)
         (size-zero (field token length) (text:strlen value))
         (int-eq (text:strncmp (field token value) value (field token length)) 0)))

;; Skip one complete expression with a nesting bound for malformed manifests.
(base:function manifest-skip ((token manifest-token) (depth i32)) manifest-token
  (match depth
    (128 (token-end 5 (field token value) 0 (field token next)))
    (_ (match (field token kind)
      (1 (manifest-skip-list (manifest-read (field token next)) (add-depth depth)))
      (0 token) (2 (token-end 5 (field token value) 0 (field token next))) (5 token)
      (_ (manifest-read (field token next)))))))

(base:function add-depth ((depth i32)) i32
  (add-size-generic depth 1))

(base:function manifest-skip-list ((token manifest-token) (depth i32)) manifest-token
  (match (field token kind)
    (0 (token-end 5 (field token value) 0 (field token next)))
    (5 token)
    (2 (manifest-read (field token next)))
    (_ (manifest-skip-list (manifest-skip token depth) depth))))

;; Locate a direct version clause in the matching library target. Other
;; targets, nested clauses, comments, and string contents cannot supply it.
(base:function manifest-version-clause ((head manifest-token)) manifest-token
  (let ((value manifest-token (manifest-read (field head next))))
    (match (steps (int-eq (field value kind) 4)
                  (int-eq (field (manifest-read (field value next)) kind) 2))
      (true value)
      (false (token-end 5 (field value value) 0 (field value next))))))

(base:function manifest-options ((token manifest-token)) manifest-token
  (match (field token kind)
    (0 token)
    (2 token)
    (5 token)
    (1
      (let ((head manifest-token (manifest-read (field token next))))
        (match (token-equals head "version")
          (true (manifest-version-clause head))
          (false (manifest-options (manifest-skip token 0))))))
    (_ (manifest-options (manifest-skip token 0)))))

(base:function manifest-targets ((token manifest-token) (name (pointer u8))) manifest-token
  (match (field token kind)
    (0 token) (5 token)
    (1
      (let ((head manifest-token (manifest-read (field token next))))
        (match (match (token-equals head "static-library")
                 (true true) (false (token-equals head "shared-library")))
          (true
            (let ((target manifest-token (manifest-read (field head next))))
              (match (token-equals target name)
                (true (manifest-options (manifest-read (field target next))))
                (false (manifest-targets (manifest-skip token 0) name)))))
          (false (manifest-targets (manifest-skip token 0) name)))))
    (_ (token-end 5 (field token value) 0 (field token next)))))

;; Decode in place after tokenization. Versions must be nonempty single-line
;; strings, matching the manifest version rule. Escapes never execute code.
(base:function decode-version ((input (pointer u8)) (output (pointer u8)) (remaining usize)) bool
  (match remaining
    (0 (do (store (deref output) 0) true))
    (_ (match (deref input)
      (10 false) (13 false)
      (92 (match (deref (pointer-offset input 1))
            (34 (do (store (deref output) 34)
                    (decode-version (pointer-offset input 2) (pointer-offset output 1) (subtract-size remaining 2))))
            (92 (do (store (deref output) 92)
                    (decode-version (pointer-offset input 2) (pointer-offset output 1) (subtract-size remaining 2))))
            (116 (do (store (deref output) 9)
                     (decode-version (pointer-offset input 2) (pointer-offset output 1) (subtract-size remaining 2))))
            (_ false)))
      (_ (do (store (deref output) (deref input))
             (decode-version (pointer-offset input 1) (pointer-offset output 1) (subtract-size remaining 1))))))))

(base:function save-manifest-version ((node (pointer library-record)) (value (pointer u8))) bool
  (let ((storage (pointer void) (memory:malloc (add-size (text:strlen value) 1))))
    (match (pointer-bits storage)
      (0 false)
      (_ (do
        (text:strcpy (cast (pointer u8) storage) value)
        (store (deref node)
          (library-record (field (deref node) next) (field (deref node) name)
                          (cast (pointer u8) storage) storage (field (deref node) unversioned)))
        true)))))

(base:function read-manifest-version ((node (pointer library-record)) (path (pointer u8))) bool
  (let ((file (pointer types:file-stream) (stdio:fopen path "rb")))
    (match (pointer-bits (cast (pointer void) file))
      (0 (match (deref (errno-pointer)) (2 true) (_ false)))
      (_
        ;; A bounded metadata read avoids unbounded allocation on arbitrary files.
        (let ((storage (pointer void) (memory:calloc 1 1048577)))
          (match (pointer-bits storage)
            (0 (do (stdio:fclose file) false))
            (_
              (let ((count usize (stdio:fread storage 1 1048576 file))
                    (read-error i32 (manifest-file-error file))
                    (closed i32 (stdio:fclose file)))
                (match (steps (int-eq read-error 0) (int-eq closed 0))
                  (false (do (memory:free storage) false))
                  (true
                    (match (size-zero count 1048576)
                      (true (do (memory:free storage) true))
                      (false
                        (let ((token manifest-token
                                (manifest-targets (manifest-read (cast (pointer u8) storage))
                                                  (field (deref node) name))))
                          (match (steps (int-eq (field token kind) 4)
                                        (match (field token length) (0 false) (_ true))
                                        (decode-version (field token value) (field token value) (field token length)))
                            (false (do (memory:free storage) true))
                            (true
                              (let ((saved bool (save-manifest-version node (field token value))))
                                (do (memory:free storage) saved)))))))))))))))))

(base:external-function manifest-file-error "ferror" ((pointer types:file-stream)) i32)

(base:function manifest-fallback ((node (pointer library-record)) (directory (pointer u8))) bool
  (match (deref (field (deref node) version))
    (0
      (let ((length usize (text:strlen directory))
            (storage (pointer void) (memory:malloc (add-size (text:strlen directory) 14))))
        (match (pointer-bits storage)
          (0 false)
          (_
            (let ((path (pointer u8) (cast (pointer u8) storage)))
              (do
                (text:strcpy path directory)
                (text:strcpy (pointer-offset path length) "/verona.build")
                (let ((result bool (read-manifest-version node path)))
                  (do (memory:free storage) result))))))))
    (_ true)))

(base:function record-before ((left library-record) (right library-record)) bool
  (let ((order i32 (text:strcmp (field left name) (field right name))))
    (match order
      (0
        (let ((versions i32 (text:strcmp (field left version) (field right version))))
          (match versions
            (0 (steps (field left unversioned)
                      (match (field right unversioned) (true false) (false true))))
            (_ (int-lt versions 0)))))
      (_ (int-lt order 0)))))

(base:function set-next ((node (pointer library-record)) (next (pointer void))) bool
  (do
    (store (deref node) (library-record next (field (deref node) name) (field (deref node) version) (field (deref node) manifest) (field (deref node) unversioned)))
    true))

(base:function insert-record ((previous (pointer library-record)) (node (pointer library-record))) bool
  (let ((next (pointer void) (field (deref previous) next)))
    (match (pointer-bits next)
      (0 (do (set-next previous (cast (pointer void) node)) true))
      (_
        (let ((following (pointer library-record) (cast (pointer library-record) next)))
          (match (record-before (deref node) (deref following))
            (true (do
              (set-next node next)
              (set-next previous (cast (pointer void) node)) true))
            (false (insert-record following node))))))))

(base:function collect-library ((head (pointer library-record)) (name (pointer u8))) bool
  (let ((storage (pointer void) (memory:calloc 1 (add-size (text:strlen name) 41))))
    (match (pointer-bits storage)
      (0 false)
      (_
        (let ((node (pointer library-record) (cast (pointer library-record) storage))
              (copy (pointer u8) (pointer-offset (cast (pointer u8) storage) 40)))
          (do
            (text:strcpy copy name)
            (let ((version (pointer u8) (split-version copy)))
              (store (deref node)
                (library-record (field (deref node) next) copy version (field (deref node) manifest)
                                (match (deref version) (0 true) (_ false)))))
            (match (manifest-fallback node name)
              (true (insert-record head node))
              (false (do (memory:free storage) false)))))))))

(base:function print-records ((next (pointer void)) (previous (pointer u8)) (previous-version (pointer u8))) bool
  (match (pointer-bits next)
    (0 (match (deref previous) (0 true) (_ (emit 1 "\n"))))
    (_
      (let ((node library-record (deref (cast (pointer library-record) next))))
        (match (steps (int-eq (text:strcmp previous (field node name)) 0)
                      (int-eq (text:strcmp previous-version (field node version)) 0))
          (true (print-records (field node next) previous previous-version))
          (false (steps
          (match (text:strcmp previous (field node name))
            (0 (emit 1 ", "))
            (_ (steps
                 (match (deref previous) (0 true) (_ (emit 1 "\n")))
                 (emit 1 (field node name)) (emit 1 ": "))))
          (emit 1 (match (deref (field node version))
                    (0 "(unversioned)") (_ (field node version))))
          (match (field node unversioned)
            (true (match (deref (field node version)) (0 true) (_ (emit 1 "*"))))
            (false true))
          (print-records (field node next) (field node name) (field node version)))))))))

(base:function free-records ((next (pointer void))) bool
  (match (pointer-bits next)
    (0 true)
    (_
      (let ((following (pointer void) (field (deref (cast (pointer library-record) next)) next)))
        (do
          (memory:free (field (deref (cast (pointer library-record) next)) manifest))
          (memory:free next) (free-records following))))))

(base:function list-entry ((head (pointer library-record)) (name (pointer u8))) bool
  (match (text:strcmp name ".")
    (0 true)
    (_
      (match (text:strcmp name "..")
        (0 true)
        (_
          (let ((child (pointer types:directory-stream) (open-directory name)))
            (match (pointer-bits (cast (pointer void) child))
              (0
                (match (deref (errno-pointer))
                  (20 true) ;; ENOTDIR: ordinary file
                  (2 true)  ;; ENOENT: dangling link or removed entry
                  (_ false)))
              (_
                (let ((closed i32 (fs:closedir child)))
                  (steps (int-eq closed 0) (collect-library head name)))))))))))

(base:function list-entries ((directory (pointer types:directory-stream)) (head (pointer library-record))) bool
  (do
    (store (deref (errno-pointer)) 0)
    (let ((entry (pointer u8) (read-entry directory)))
      (match (pointer-bits (cast (pointer void) entry))
        (0 (int-eq (deref (errno-pointer)) 0))
        (_ (steps (list-entry head (entry-name entry)) (list-entries directory head)))))))

(base:function list-libraries () exit-code
  (let ((root (pointer u8) (process:getenv "VERONA_SOURCE_DIR")))
    (match (pointer-bits (cast (pointer void) root))
      (0 (fail "VERONA_SOURCE_DIR must name an absolute directory"))
      (_
        (match (deref root)
          (47
            (match (chdir root)
              (0
                (let ((directory (pointer types:directory-stream) (open-directory ".")))
                  (match (pointer-bits (cast (pointer void) directory))
                    (0 (fail "cannot open VERONA_SOURCE_DIR"))
                    (_
                      (let ((storage (pointer void) (memory:calloc 1 40)))
                        (match (pointer-bits storage)
                          (0 (do (fs:closedir directory) (fail "cannot allocate library listing")))
                          (_
                            (let ((head (pointer library-record) (cast (pointer library-record) storage))
                                  (listed bool (list-entries directory (cast (pointer library-record) storage)))
                                  (closed i32 (fs:closedir directory)))
                              (let ((printed bool (steps listed (int-eq closed 0)
                                                     (print-records (field (deref head) next) "" ""))))
                                (do
                                  (free-records (field (deref head) next))
                                  (memory:free storage)
                                  (match printed
                                    (true 0)
                                    (false (fail "cannot list VERONA_SOURCE_DIR or write output")))))))))))))
              (_ (fail "cannot enter VERONA_SOURCE_DIR"))))
          (_ (fail "VERONA_SOURCE_DIR must name an absolute directory")))))))

(base:function usage () exit-code
  (do
    (emit
      1
      "Usage: verona-project COMMAND [ARGUMENTS]\n\nCommands:\n  new NAME    Create an executable project\n  libraries   List libraries and available versions in VERONA_SOURCE_DIR\n  help        Show this help\n")
    0))

(base:function main ((argc i32) (argv (pointer (pointer u8)))) exit-code
  (match (int-lt argc 2)
    (true (fail "usage: verona-project COMMAND [ARGUMENTS]"))
    (false
      (let ((command (pointer u8) (deref (pointer-offset argv 1))))
        (match (text:strcmp command "new")
          (0
            (match argc
              (3 (create-project (deref (pointer-offset argv 2))))
              (_ (fail "usage: verona-project new NAME"))))
          (_
            (match argc
              (2
                (match (text:strcmp command "libraries")
                  (0 (list-libraries))
                  (_ (help-command command))))
              (_ (fail "unknown command or extra arguments")))))))))

(base:function help-command ((command (pointer u8))) exit-code
  (match (text:strcmp command "help")
    (0 (usage))
    (_ (match (text:strcmp command "--help")
      (0 (usage))
      (_ (match (text:strcmp command "-h")
        (0 (usage))
        (_ (fail "unknown command; see verona-project --help"))))))))
