(import base)

(base:function next
  (for (a)
    ((base:enum a)))
  ((value a))
  a
  (succ value))

(base:function add
  (for (a)
    ((base:num a)))
  ((left a) (right a))
  a
  (+ left right))

(base:function same
  (for (a)
    ((base:eq a)))
  ((left a) (right a))
  bool
  (= left right))

(base:function before
  (for (a)
    ((base:ord a)))
  ((left a) (right a))
  bool
  (< left right))

(base:function rational
  (for (a)
    ((base:real a)))
  ((value a))
  base:rational
  (toRational value))

(base:function quotient-and-remainder
  (for (a)
    ((base:integral a)))
  ((left a) (right a))
  (tuple a a)
  (quotRem left right))
